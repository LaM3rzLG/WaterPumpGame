/* A Keret sprite tényleges kirajzolása az aktuális (Keret.X/Y-ban beállított)
   pozícióra. Sorrend: pozíció érvényesítése -> a Keret alatti terület
   elmentése háttérként -> a keret grafika kirajzolása -> "utolsó pozíció"
   frissítése (ez alapján tudja majd a RestoreBackground, honnan kell
   visszaállítania a képet, ha a Keret elmozdul). */
Procedure Keret_SpriteKirak();
	begin;
		Keret.SetPosition();
		Keret.SaveBackground();
		Keret.Draw;
		Keret.UpdateLastPos;
	end;

/* Megkeresi az első szabad pool-slotot (Pumpa_X[i]=0). Ha nincs, MAX_PUMPAK-t
   ad vissza (a hívónak ellenőriznie kell). Csak lerakáskor fut, nem per-frame. */
Function TalalSzabadPumpaHely() : byte;
	var i								:	byte;
	begin;
		i:=0;
		while ((i<MAX_PUMPAK) and (Pumpa_X[i]<>0)) do
			i:=i+1;
		TalalSzabadPumpaHely:=i;
	end;

/* Új pumpa a poolba a megadott rács-koordinátára. NULLA osztás/szorzás:
   - a képernyőcím két TÁBLA összeadása (Mezo_SorCim_Tab[y] + Mezo_ByteX_Tab[x]);
   - a kezdőfázis egy forgó számláló (Pumpa_Uj_Faz), minden lerakásnál +1
     (deszinkron: a szomszédos pool-indexre kerülő pumpák sem "ugranak"
     egyszerre), a fázis-pointer a Pumpa_FazPtr_Tab-ból jön.
   Végül azonnal kirajzoljuk (nem kell a forgó frissítésre várni). */
Procedure Pumpa_Uj(x,y : byte);
	var i, f							:	byte;
		p								:	integer;
	begin;
		i:=TalalSzabadPumpaHely();
		if (i<MAX_PUMPAK) then
			begin;
				f:=Pumpa_Uj_Faz;
				Pumpa_X[i]:=x;
				Pumpa_Y[i]:=y;
				Pumpa_Faz[i]:=f;
				if (i>=Pumpa_Top) then Pumpa_Top:=i+1;	/* a forgó frissítés csak eddig forogjon (lásd PumpakFrissitesLepes) */
				Pumpa_Uj_Faz:=f+1;
				if (Pumpa_Uj_Faz>=PUMPA_FAZISOK) then Pumpa_Uj_Faz:=0;
				/* kész képernyőcím: két tábla összeadása */
				p:=Mezo_SorCim_Tab[y];
				p:=p+Mezo_ByteX_Tab[x];
				Pumpa_Pos[i]:=p;
				/* azonnali kirajzolás */
				Pumpa.Position:=p;
				Pumpa.Data:=Pumpa_FazPtr_Tab[f];
				Pumpa.Put;
				Pumpa_db:=Pumpa_db+1;			/* termeléshez: hány pumpa van összesen */
			end;
	end;

/* Egy pumpa kivétele a poolból - a vírus vagy a meteor "megette". Megkeresi
   az (x,y) rács-mezőn álló pumpát (Pumpa_X/Pumpa_Y), felszabadítja a helyét
   (Pumpa_X[i]:=0 -> a PumpakFrissit ezután átugorja), csökkenti a Pumpa_db-t,
   és FRISSÍTI a PUMP HUD-ot (különben a szám elavult marad, ha nem lerakással
   fogy a pumpa). A képernyőn a vírus/meteor bélyegzője írja felül a pumpát,
   ezért itt nem kell külön törölni. */
Procedure Pumpa_Torol(x, y : byte);
	var i								:	byte;
	begin;
		i:=0;
		while (i<MAX_PUMPAK) do
			begin;
				if (Pumpa_X[i]=x) then
				if (Pumpa_Y[i]=y) then
					begin;
						Pumpa_X[i]:=0;
						if (Pumpa_db>0) then Pumpa_db:=Pumpa_db-1;
						Pump_OSD();				/* pumpaszám-kijelző frissítése */
					end;
				i:=i+1;
			end;
	end;

/* Egy index-tartomány ([honnan..meddig]) pumpáinak fázisléptetése +
   újrarajzolása. Ezt hívja a PumpakFrissitesLepes egy kis forgó tartományra
   (max PUMPAK_CHUNK Put/frame).
   A per-pumpa munka SZORZÁS- ÉS SetPosition-MENTES: a fázisszámláló lép
   (+wrap), a fázis-pointer a Pumpa_FazPtr_Tab-ból jön, a kirakás a cache-elt
   Pumpa_Pos + a tábla-pointer közvetlen beírása + Put. */
Procedure PumpakFrissit(honnan, meddig : byte);
	var i, f							:	byte;
	begin;
		i:=honnan;
		while (i<=meddig) do
			begin;
				if (Pumpa_X[i]<>0) then
					begin;
						f:=Pumpa_Faz[i]+1;
						if (f>=PUMPA_FAZISOK) then f:=0;
						Pumpa_Faz[i]:=f;
						Pumpa.Position:=Pumpa_Pos[i];
						Pumpa.Data:=Pumpa_FazPtr_Tab[f];
						Pumpa.Put;
					end;
				i:=i+1;
			end;
	end;

/* Képkockánként egyszer hívandó: kiszámolja a soron következő forgó
   PUMPAK_CHUNK méretű tartományt, és azt frissíti. A tartomány a pool
   elején kezdődik újra, ha a végére ért - így minden pumpa
   ceil(Pumpa_Top/PUMPAK_CHUNK) képkockánként egyszer lép animációban.
   FONTOS: a forgás CSAK Pumpa_Top-ig megy (a legmagasabb valaha kiosztott
   slot+1), NEM MAX_PUMPAK-ig. A pumpák a tömb elejére tömörülnek
   (TalalSzabadPumpaHely mindig az első szabad slotot adja), ezért ha
   MAX_PUMPAK-ig forognánk, csak 1 "termő" képkocka lenne + sok üres ->
   "mind egyszerre frissül, majd hosszú szünet". Pumpa_Top-ig forogva a
   frissítés egyenletesen eloszlik a képkockák közt. */
Procedure PumpakFrissitesLepes();
	var vege							:	byte;
	begin;
		if (Pumpa_Top > 0) then
			begin;
				if (PumpakKezdo>=Pumpa_Top) then PumpakKezdo:=0;
				vege:=PumpakKezdo+PUMPAK_CHUNK-1;
				if (vege>=Pumpa_Top) then vege:=Pumpa_Top-1;
				PumpakFrissit(PumpakKezdo, vege);
				PumpakKezdo:=PumpakKezdo+PUMPAK_CHUNK;
				if (PumpakKezdo>=Pumpa_Top) then PumpakKezdo:=0;
			end;
	end;

/* Mindent egy eljárásban végez el a Keret körül, a helyes sorrendben:
     1) eldönti, kell-e frissíteni (mozgott VAGY pumpa van alatta - az
        animálódhat), és ha igen, MÁR ITT elvégzi a RestoreBackground-ot;
     2) lefuttatja a PumpakFrissitesLepes-t (pumpák animációjának forgó
        frissítése) - ez azért van KÖZBEN, mert ha a Keret alatti pumpa
        pont ekkor lép fázist, a friss képkockának a RestoreBackground UTÁN,
        de a SaveBackground ELŐTT kell megjelennie a képernyőn, különben a
        Keret alatti pumpa animációja "befagyna" (a Keret mindig egy régi,
        elmentett fázist állítana vissza rá). Ez az eredeti (4.0-ás) sorrend:
        RestoreBackground -> PumpakFrissitesLepes -> mentés+rajzolás;
     3) ha kellett a frissítés, elmenti a (már friss pumpa-animációt is
        tartalmazó) hátteret és ráteszi a Keret kerekét;
     4) a HUD-ot mindig frissíti, függetlenül attól, hogy a sprite
        frissült-e.
   (Korábban ez két külön eljárásra volt bontva egy globális boolean
   jelzővel közöttük - az ELÉG VOLT, hogy a TRSE fordító összeomoljon
   [exit code 3221225477 / access violation] rajta. Ez az egy-eljárásos,
   csak lokális boolean-okat használó forma bizonyítottan fordul. FONTOS:
   ennek a PumpakFrissitesLepes UTÁN kell állnia a fájlban, mert a TRSE
   deklaráció-előtti hívást nem enged - máskülönben ez a procedura a saját
   testében még nem létező PumpakFrissitesLepes-t hívná.) */
Procedure Keret_Frissit();
	var mozgott						:	boolean;
		pumpavan						:	boolean;
	begin;
		MapPos:=Keret_X_Pos-1+(Keret_Y_Pos-1)*30;
		mozgott:=((Keret_X_Pos<>Keret_Elozo_X_Pos) or (Keret_Y_Pos<>Keret_Elozo_Y_Pos));
		pumpavan:=(Map[MapPos]=PumpaMap);
		if (mozgott or pumpavan) then Keret.RestoreBackground();

		PumpakFrissitesLepes();

		if (mozgott or pumpavan) then
			begin;
				/* A RestoreBackground által elkent vírus-mezők helyreállítása a
				   valós fázisukra - CSAK ha a Keret MOZGOTT. Álló Keretnél
				   (pumpán ülve) a 16x12-es folt nem vándorol, tehát nincs mit
				   helyreállítani; viszont ez a sweep MINDEN aktív kolóniát
				   Put-ol, és a folyamatosan terjedő vírusnál ez képkockánként
				   sok Put -> pumpán állva "minden animáció nagyon lelassul".
				   Ezért itt a mozgás a feltétel, nem a (mozgott or pumpavan). */
				if (mozgott) then Enemyk_Ujrarajzol();
				Keret_XY_Calc();
				Keret_SpriteKirak();
				Keret_Elozo_X_Pos:=Keret_X_Pos;
				Keret_Elozo_Y_Pos:=Keret_Y_Pos;
			end;
		Keret_OSD();
	end;

/* A Keret_MoveXXX eljárások CSAK a rács-koordinátát (Keret_X_Pos/Y_Pos)
   módosítják - a tényleges háttér-visszaállítást és újrarajzolást a
   főciklus végi Keret_Frissit() végzi el (ami észleli a mozgást és emiatt
   restore-ol+újrarajzol), egyszer képkockánként. Ez azért fontos, mert ha
   itt is rajzolnánk, a Keret duplán rajzolódna ki minden mozgásnál. */
Procedure Keret_MoveLeft();
	begin
		Keret_X_Pos:=Keret_X_Pos-1;
	end;

Procedure Keret_MoveRight();
	begin
		Keret_X_Pos:=Keret_X_Pos+1;
	end;

Procedure Keret_MoveUp();
	begin
		Keret_Y_Pos:=Keret_Y_Pos-1;
	end;

Procedure Keret_MoveDown();
	begin
		Keret_Y_Pos:=Keret_Y_Pos+1;
	end;

/* Pumpa lerakása a Keret alatti mezőre (Space lenyomásakor hívódik).
   Saját, önálló restore->lerakás->mentés+rajzolás sorrendet használ, hogy a
   pumpa AZONNAL látszódjon. Ellenőrzi, hogy a mezőn már van-e pumpa, hogy
   ismételt Space lenyomásra ne fogyjon feleslegesen a Pumpak pool. */
Procedure DrillLerak();
	begin
		MapPos:=Keret_X_Pos-1+(Keret_Y_Pos-1)*30;
		/* Csak akkor rakható le pumpa, ha:
		   - a mező SZABAD TALAJ (Talaj1Map) - ez egyszerre zárja ki a már
		     lerakott pumpát (1-8) ÉS a bármilyen fázisú vírust (20-29),
		   - van rá fedezet (a Drill_Cash nem mehet 0 alá),
		   - és még nem értük el a maximális pumpaszámot (különben a Pumpa_Uj
		     úgyis eldobná, de az árat már levontuk / termelésnek vettük volna).
		   Két egymásba ágyazott if, mert a TRSE zárójelpáronként csak EGY
		   and-et enged (a háromtagú feltétel fordítási hibát adott). */
		if ((Map[MapPos]=Talaj1Map) and (Drill_Cash>=Pumpa_price)) then
		if (Pumpa_db<MAX_PUMPAK) then
			begin;
				Keret.RestoreBackground();		/* a keret alatti valós talajt tesszük láthatóvá lerakás előtt */
				Map[MapPos]:=PumpaMap;
				Pumpa_Uj(Keret_X_Pos, Keret_Y_Pos);
				Drill_Cash:=Drill_Cash-Pumpa_price;	/* a pumpa ára levonva a pénzből */
				Cash_OSD();							/* pénz-kijelző frissítése */
				Pump_OSD();							/* pumpaszám-kijelző frissítése */
				Keret_SpriteKirak();			/* elmenti a friss (pumpát tartalmazó) hátteret, majd ráteszi a keretet */
				Keret_OSD();
			end;
	end;

/* Fal-tégla lerakása a Keret alatti mezőre (F gomb). A DrillLerak mintájára
   önálló restore->lerakás->mentés+rajzolás. Csak SZABAD TALAJRA (Talaj1Map -
   ez kizárja a pumpát, vírust és a már lerakott falat is), és csak ha van rá
   Tegla_price fedezet. A falra ezután pumpa sem rakható (DrillLerak ugyanígy
   Talaj1Map-ot vár), és a vírus sem terjed rá (Enemy_Terjed_Ide). */
Procedure TeglaLerak();
	begin
		MapPos:=Keret_X_Pos-1+(Keret_Y_Pos-1)*30;
		if ((Map[MapPos]=Talaj1Map) and (Drill_Cash>=Tegla_price)) then
			begin;
				Keret.RestoreBackground();
				Map[MapPos]:=FalMap;
				Fal_Kirak(Keret_X_Pos, Keret_Y_Pos);
				Drill_Cash:=Drill_Cash-Tegla_price;
				Cash_OSD();
				Keret_SpriteKirak();
				Keret_OSD();
			end;
	end;

/* A lerakott pumpák termelése: a Drill_Cash annyiszor Pumpa_termel értékkel nő,
   ahány pumpa le lett rakva (Pumpa_db). A főciklus Termel_Utem képkockánként hívja.
   A szorzatot integer-ben számoljuk (Pumpa_db * Pumpa_termel akár 800 is lehet,
   ami byte-ban túlcsordulna), és 9999-re vágjuk, mert a HUD_Num4 csak 4 jegyet
   tud kiírni. */
Procedure Pumpak_Termelnek();
	var termeny : integer;
	begin
		if (Pumpa_db > 0) then
			begin
				termeny:=Pumpa_db;
				termeny:=termeny*Pumpa_termel;
				Drill_Cash:=Drill_Cash+termeny;
				if (Drill_Cash > 9999) then Drill_Cash:=9999;
				Cash_OSD();
			end;
	end;

/* ============================================================
   ENEMY_Szekcio - a terjedő "vírus" - a C64-es aqualiquex (units.tru +
   raster.tru) viselkedésének 1:1 lemodellezése (a raszter-időzítés nélkül;
   nálunk egy fociklus-iteráció = egy C64 raszter-IRQ).

   C64 megfeleltetések:
     units::makeVirus(x,y)      -> Enemy_Terjed_Ide(x,y)
     units::doVirusSpread       -> Enemy_Terjedhet (0/1)
     units::noOfColonies        -> Enemy_Kolonia_db  (VETETT kolóniák)
     units::maxColonies (10)    -> ENEMY_MAX_KOLONIA
     virusStart..-1  (192..201) -> Map = VirusMap + (0 .. ENEMY_MAX_FAZIS-1)  (NÖVEKVŐ)
     virusAnimFrames (202..208) -> Map = VirusMap +  ENEMY_MAX_FAZIS          (KIFEJLETT)
     raster.tru "for i:=0 to 15" -> Enemyk_Mukodnek, ENEMY_PROBA_DB minta/frame

   Menet:
   1) KOLÓNIA-VETÉS (fociklus, ~50 frame-enként = "másodperc"): 50% eséllyel
      (a C64-nél a másik 50% a meteor, ami nálunk nincs) egy véletlen mezőre
      Enemy_Terjed_Ide, amíg Enemy_Kolonia_db < ENEMY_MAX_KOLONIA (10). A
      10. VETETT kolónia után új nem jön: Enemy_Terjedhet := 1.
   2) NÖVEKEDÉS + TERJEDÉS (Enemyk_Mukodnek, minden frame): ENEMY_PROBA_DB
      véletlen minta. Növekvő vírus -> egy fázissal előre (nem terjed).
      Kifejlett vírus -> nem nő; ha Enemy_Terjedhet=1, a 3x3 környezet
      (átlók is!) egy véletlen mezőjére terjed (Enemy_Terjed_Ide).
   3) PUMPAEVÉS: Enemy_Terjed_Ide pumpára esve Pumpa_Torol (C64: makeVirus ->
      removeDrill). FAL: a C64-ben blokkol; nálunk fal még NINCS.
   ============================================================ */

/* C64 units::makeVirus(x,y) 1:1 mása. Az (x,y) rács-mezőn a mező 0. fázisú
   vírus lesz (C64: putChar(x,y, virusStart)):
   - ha ott FAL van -> a vírus NEM megy át (C64: makeVirus a fal-tartományt
     kihagyja) -> nem történik semmi;
   - ha ott PUMPA volt -> a vírus MEGESZI (Pumpa_Torol; C64: removeDrill),
     azután a mező vírus lesz;
   - ha ott SZABAD TALAJ volt -> egyszerűen vírus lesz;
   - ha ott MÁR VÍRUS volt -> a fázis VISSZAUGRIK 0-ra (a szomszédra vagy
     önmagára eső terjedés visszafiatalít - a C64 makeVirus is felülír).
   NINCS pool: a Map hordozza a teljes állapotot. */
Procedure Enemy_Terjed_Ide(x, y : byte);
	var mp								:	integer;
	begin;
		mp:=x-1+(y-1)*30;
		if (Map[mp]<>FalMap) then						/* FAL blokkol */
			begin;
				if (Map[mp]=PumpaMap) then Pumpa_Torol(x, y);	/* pumpát megeszi */
				Map[mp]:=VirusMap;							/* 0. fázisú vírus */
				Enemy_Kirak(x, y, 0);
			end;
	end;

/* Egy véletlen rács-mezőre vírust rak (C64: a kolónia-vetés
   makeVirus(rnd%40, rnd%23+1) hívása). RandomByte 0-255 -> mod 30/18 -> +1. */
Procedure Enemy_Random_Lerak();
	var rx, ry : byte;
	begin;
		rx:=Random::RandomByte();
		ry:=Random::RandomByte();
		rx:=1 + (rx - (rx/30)*30);
		ry:=1 + (ry - (ry/18)*18);
		Enemy_Terjed_Ide(rx, ry);
	end;

/* A vírus NÖVEKEDÉSE + TERJEDÉSE - a C64 raster.tru "for i:=0 to 15" ciklusának
   1:1 mása. A fociklus Enemy_Utem frame-enként hívja (C64-modell: minden
   képkockán, Enemy_Utem=1). Hívásonként ENEMY_PROBA_DB db VÉLETLEN cellát
   mintavételez. Minden mintára (rx,ry):
   - Map[mp] < VirusMap (nincs ott vírus)         -> semmi;
   - NÖVEKVŐ vírus (faz < ENEMY_MAX_FAZIS)        -> faz := faz+1 + újrarajz
     (NINCS terjedés, NINCS wrap; faz ENEMY_MAX_FAZIS-nál "beérik");
   - KIFEJLETT vírus (faz = ENEMY_MAX_FAZIS)      -> nem nő tovább; ha
     Enemy_Terjedhet=1, akkor TERJED: a 3x3 KÖRNYEZET (átlók is!) egy
     véletlen mezőjére Enemy_Terjed_Ide (a self-eset (dx=dy=0) visszafiatalítja
     a saját mezőjét - ez a C64-ben is így van).
   A fázist a Map-ből olvassuk, nincs pool-kereső ciklus mintánként. */
Procedure Enemyk_Mukodnek();
	var faz, nx, ny, dx, dy, rx, ry, p : byte;
		mp : integer;
	begin;
		p:=0;
		while (p<ENEMY_PROBA_DB) do
			begin;
				rx:=Random::RandomByte();
				ry:=Random::RandomByte();
				rx:=1 + (rx - (rx/30)*30);
				ry:=1 + (ry - (ry/18)*18);
				mp:=rx-1+(ry-1)*30;
				if (Map[mp] >= VirusMap) then
					begin;
						faz:=Map[mp]-VirusMap;
						if (faz < ENEMY_MAX_FAZIS) then
							begin;
								/* NÖVEKVŐ: egy lépcső előre (C64: putChar(tmp+1)) */
								faz:=faz+1;
								Map[mp]:=VirusMap+faz;
								Enemy_Kirak(rx, ry, faz);
							end
						else
							begin;
								/* KIFEJLETT: nem nő; terjed, ha engedélyezve */
								if (Enemy_Terjedhet=1) then
									begin;
										/* 3x3 környezet: dx,dy fuggetlenul -1/0/+1
										   (C64: x + rnd%3 - 1). +1-gyel eltolva a
										   byte-underflow ellen: 0..2 -> nx = rx-1+dx */
										dx:=Random::RandomByte();
										dx:=dx-(dx/3)*3;
										dy:=Random::RandomByte();
										dy:=dy-(dy/3)*3;
										nx:=rx-1+dx;			/* rx-1 .. rx+1 */
										ny:=ry-1+dy;
										/* clamp a rácsra (C64: 0..39 / 1..24) */
										if (nx<1)  then nx:=1;
										if (nx>30) then nx:=30;
										if (ny<1)  then ny:=1;
										if (ny>18) then ny:=18;
										Enemy_Terjed_Ide(nx, ny);
									end;
							end;
					end;
				p:=p+1;
			end;
	end;

/* ============================================================
   KEZDOKEPERNYO / RND-beallitas
   Letorli a kepernyot, kiirja kozepre a felhivast, es VAR a SPACE-re.
   A varakozas alatt minden kepkockan porget egyet a Random generatoron
   -> a seed a jatekos reakcioidejetol fugg (boot-onkent mas). TVC-n
   nincs jobb entropiaforras induláskor.
   MEGJ.: a felirat ekezet nelkuli - a CharSetGR4.bin ekezetkeszlete
   nem biztos, hogy teljes.
   ============================================================ */
Procedure Start_Kepernyo();
	begin;
		GE::ClearScreen(0);
		GE::WriteText(10, 116, "SPACE-RE INDUL A JATEK");
		Start_Wait:=1;
		while (Start_Wait = 1) do
			begin;
				GE::GetKeyboard();
				Rnd_Porgeto:=Random::RandomByte();
				if (GE::Pressed(GE::KEY_SPACE)) then Start_Wait:=0;
				GE::WaitForSync();
			end;
		GE::ClearScreen(0);
	end;

/* ============================================================
   IDEIGLENES METEOR-TESZT - NEM BLOKKOLÓ. A főciklusból random időnként
   elindul egy zuhanás (Meteor_Indit), és amíg tart, a "3." lépésben a
   Meteor_Keret_Frissit() fut a Keret_Frissit HELYETT (lásd ott a fejlécet)
   - eközben a pumpák / vírus TOVÁBB futnak, így látszik, bírja-e a gép a
   maszkolt 20x16 sprite mozgatását a pumpák mellett.
   Pálya: RANDOM belépő X-ről, MINDEN képkockán METEOR_LE_PX px LE; MINDEN
   METEOR_OLDAL_UTEM. képkockán 1 px BALRA (lépcsőzve, METEOR_X_CEL-ig).
   Y=Meteor_Y_Cel (RANDOM út-hossz) -nél ELTŰNIK. Maszkolt -> Draw + puffer. */
/* A TELJES fal-réteg újrarajzolása a Map-ból (minden FalMap mező). Egyszer
   fut le, amikor a meteor eltűnik - így a meteor útjába lerakott, a meteor
   elavult háttérpuffere által "letörölt" falak visszakerülnek. (A pumpát a
   pool forgó chunkja magától újrarajzolja, a fal statikus, ezért kell ez.)
   ~540 Map-olvasás egyszeri spike-ban - a meteor pont eltűnt, nem látszik. */
Procedure Fal_Mind_Kirak();
	var gx, gy : byte;
		mp : integer;
	begin;
		mp:=0;
		fori gy:=1 to 18 do
			fori gx:=1 to 30 do
				begin;
					if (Map[mp]=FalMap) then Fal_Kirak(gx, gy);
					mp:=mp+1;
				end;
	end;

/* METEOR BECSAPÓDÁS - a ciklus végén (a meteor eltűnésekor) fut le.
   A meteor UTOLSÓ képernyő-koordinátáiból (Meteor.X byte / Meteor.Y px)
   kiszámolja, melyik 3x3 rács-mező fölött állt (a meteor közepe köré
   centrálva), és MINDET üres talajjá roncsolja: a Map-ban Talaj1Map, a
   képen Talaj1 bélyegző. Ha ott PUMPA volt -> Pumpa_Torol (poolból ki,
   Pumpa_db--, PUMP HUD). Ha FAL vagy VÍRUS volt -> a Map felülírás + a
   talaj kirajzolása magától kitörli (a vírus állapota a Map-ben van,
   a fal statikus).
   gx0 = Meteor.X/2 (a 3x3 vízszintesen a sprite közepére esik). gy0 =
   (Meteor.Y-22)/10 = a sprite KÖZEPÉNÉL lévő rács-sor -> a 3x3 innen LEFELÉ
   3 sor (a zuhanó meteor "krátere/törmeléke" lefelé esik, nem a csóva felé).
   Clamp 1..30 / 1..18. */
Procedure Meteor_Becsapodas();
	var gx, gy, gx0, gy0, tx, ty, mx, my : byte;
		mp : integer;
	begin;
		mx:=Meteor.X;							/* sprite-mezők SIMA byte lokálba (a bare "Meteor.X/2" gyanús a TRSE-nek) */
		my:=Meteor.Y;
		gx0:=(mx + 1) / 2;						/* mint a működő 2x2-ben, csak 3x3-ra bővítve */
		gy0:=(my - 22) / 10;
		ty:=0;
		while (ty<3) do
			begin;
				gy:=gy0+ty;
				if (gy>=1) then
				if (gy<=18) then
					begin;
						tx:=0;
						while (tx<3) do
							begin;
								gx:=gx0+tx;
								if (gx>=1) then
								if (gx<=30) then
									begin;
										mp:=gx-1+(gy-1)*30;
										if (Map[mp]=PumpaMap) then Pumpa_Torol(gx, gy);
										Map[mp]:=Talaj1Map;
										Talaj1_Kirak(gx, gy);
									end;
								tx:=tx+1;
							end;
					end;
				ty:=ty+1;
			end;
	end;

Procedure Meteor_Indit();
	var r : byte;
	begin;
		/* a meteor közeledtének JELZÉSE: CSAK a 3. index (kék) -> sötétkék.
		   A szürkéhez / zöldhöz / border-hez NEM nyúlunk. Vissza a meteor VÉGÉN. */
		GE::SetPalette(3,GE::PALETTE_DarkBlue);
		Meteor_Faz:=0;
		Meteor.Data:=Meteor_FazPtr_Tab[0];	/* 0. fázis (szikla1) */
		/* RANDOM belépő X (METEOR_X_MIN .. METEOR_X_MIN+METEOR_X_RND-1) */
		r:=Random::RandomByte();
		r:=r - (r/METEOR_X_RND)*METEOR_X_RND;
		Meteor.X:=METEOR_X_MIN + r;
		Meteor.Y:=METEOR_START_Y;			/* belépő Y fix, fent */
		/* RANDOM út-hossz: ennél az Y-nál áll meg (becsapódási pont) */
		r:=Random::RandomByte();
		r:=r - (r/METEOR_Y_RND)*METEOR_Y_RND;
		Meteor_Y_Cel:=METEOR_Y_MIN + r;
		Meteor.SetPosition();
		Meteor.SaveBackground();
		Meteor.Draw;
		Meteor.UpdateLastPos;
		Meteor_Aktiv:=1;
		Meteor_UtemFrame:=0;
	end;

/* Meteor AKTÍV állapotban EZ fut a Keret_Frissit HELYETT a főciklusban -
   mert két, EGYMÁST ÁTFEDŐ maszkolt sprite (Keret + Meteor) külön
   háttérpufferrel "szemetel", ha nem szigorú z-sorrendben restore-oljuk /
   rajzoljuk (a GE::RenderAllSprites elve kézzel, 2 sprite-ra):
     1) fordított z-sorrendben LE:  Keret.Restore -> Meteor.Restore
     2) az alsó animált réteg:      PumpakFrissitesLepes (+ vírus, ha mozgott)
     3) Meteor lépés + rajz:        SetPosition/SaveBackground(map+pumpák)/Draw
     4) Keret LEGFELÜL:             SetPosition/SaveBackground(+meteor)/Draw
   Így minden sprite háttérpuffere PONTOSAN a saját maga alatti réteget
   tartalmazza -> a következő képkocka restore-jai nem írnak vissza elavult
   idegen pixeleket (nincs "szellem-Keret", nincs lyuk a meteorban). */
Procedure Meteor_Keret_Frissit();
	var mozgott						:	boolean;
	begin;
		MapPos:=Keret_X_Pos-1+(Keret_Y_Pos-1)*30;
		mozgott:=((Keret_X_Pos<>Keret_Elozo_X_Pos) or (Keret_Y_Pos<>Keret_Elozo_Y_Pos));

		Keret.RestoreBackground();			/* 1) legfelső réteg le */
		Meteor.RestoreBackground();			/* 1) középső réteg le (régi pozíción) */

		PumpakFrissitesLepes();				/* 2) alsó animált réteg */
		if (mozgott) then Enemyk_Ujrarajzol();

		/* 3) meteor lépés: MINDEN képkockán METEOR_LE_PX px LE; MINDEN
		   METEOR_OLDAL_UTEM. képkockán 1 PIXEL balra - a szikla 4 fázisával
		   (0->1->2->3 = 3 px), a 4. oldal-lépésnél VALÓDI Meteor.X -= 1 byte
		   + vissza a 0. fázisra. Csak amíg X > METEOR_X_CEL. Ha Y elérte
		   Meteor_Y_Cel-t (RANDOM) -> eltűnik + a fal-réteg egyszeri újrarajza. */
		if (Meteor.Y < Meteor_Y_Cel) then
			begin;
				Meteor.Y:=Meteor.Y+METEOR_LE_PX;			/* LE, képkockánként */
				Meteor_UtemFrame:=Meteor_UtemFrame+1;
				if (Meteor_UtemFrame>=METEOR_OLDAL_UTEM) then
					begin;
						Meteor_UtemFrame:=0;
						if (Meteor.X > METEOR_X_CEL) then
							begin;
								if (Meteor_Faz < 3) then
									Meteor_Faz:=Meteor_Faz+1		/* 0..3: pixelenként balra a fázissal */
								else
									begin;
										Meteor_Faz:=0;				/* 4. lépés: vissza a 0. fázisra ... */
										Meteor.X:=Meteor.X-1;		/* ... és 1 byte (4 px) balra -> net 1 px */
									end;
								Meteor.Data:=Meteor_FazPtr_Tab[Meteor_Faz];
							end;
					end;
			end
		else
			begin;
				Meteor_Aktiv:=0;			/* megérkezett -> nem rajzoljuk többet (a Restore törölte) */
				GE::SetPalette(3,GE::PALETTE_Blue);		/* meteor vége -> vissza világoskék */
				Meteor_Becsapodas();		/* a ~2x2 becsapódási mező roncsolása -> üres talaj (Map + kép); a Pumpa_Torol maga frissíti a PUMP HUD-ot */
				Fal_Mind_Kirak();			/* a meteor útjába lerakott, "letörölt" falak visszarajzolása */
			end;
		if (Meteor_Aktiv=1) then
			begin;
				Meteor.SetPosition();
				Meteor.SaveBackground();
				Meteor.Draw;
				Meteor.UpdateLastPos;
			end;

		/* 4) Keret LEGFELÜL, minden képkockán (a meteor rajzolhatott rá) */
		Keret_XY_Calc();
		Keret.SetPosition();
		Keret.SaveBackground();
		Keret.Draw;
		Keret.UpdateLastPos;
		Keret_Elozo_X_Pos:=Keret_X_Pos;
		Keret_Elozo_Y_Pos:=Keret_Y_Pos;
		Keret_OSD();
	end;

/* ============================================================
   FŐPROGRAM
   ============================================================ */
begin
	/* Egyszeri indítási beállítások. */
	ProgramInit;

	/* Kezdőképernyő: "SPACE-RE INDUL A JÁTÉK" - eddig NEM történik semmi
	   más, csak a szöveg látszik, és a Random generátor pörög. SPACE-re
	   megy tovább. */
	Start_Kepernyo();

	/* Térkép feltöltése és kirajzolása, a Keret kezdő kirajzolása. */
	MapReset;
	MapToScreen;


	/* Kezdő kirajzolás FELTÉTEL NÉLKÜL (nem a Keret_Frissit-en keresztül, mert az
	   mostantól csak mozgás/pumpa esetén frissít - induláskor viszont mindig
	   látszódnia kell a Keretnek). RestoreBackground-ot itt szándékosan NEM
	   hívunk: a ProgramInit-ben elmentett háttér még a MapToScreen előttről,
	   "üres" állapotból származna, annak visszaállítása most elrontaná a már
	   kirajzolt térképet. */
	Keret_XY_Calc();
	Keret_SpriteKirak();
	Keret_Elozo_X_Pos:=Keret_X_Pos;
	Keret_Elozo_Y_Pos:=Keret_Y_Pos;
	Keret_OSD();

	/* ENEMY_Szekcio: nincs külön kezdő-késleltetés (a C64 sem csinál ilyet).
	   A vírus a fociklus "5." lépésében kezd el kolóniákat vetni ~50
	   képkockánként ("másodperc"), az első ~1-2 mp-en belül megjelenik. */

    while (true) do
	begin

		/* 1. Bemenetkezelés: billentyűzet/joystick lekérdezése, és ez alapján
		   a Keret rács-pozíciójának módosítása vagy pumpa lerakása.
		   Ezek a lépések itt még NEM rajzolnak semmit a képernyőre. */
		GE::GetKeyboard();
		GE::GetJoysticks();

		/* A véletlenszám-generátort minden képkockán pörgetjük, hogy a
		   későbbi vírus-terjedés iránya se legyen determinisztikus. */
		Rnd_Porgeto:=Random::RandomByte();

		/* Keret-mozgás LASSÍTÁSA: csak minden Keret_Mozog_Utem. képkockán
		   léphet egyet a kurzor (Keret_Mozog_Utem kezdő értéke 2). */
		Keret_Mozog_Frame:=Keret_Mozog_Frame+1;
		if (Keret_Mozog_Frame >= Keret_Mozog_Utem) then
			begin;
				Keret_Mozog_Frame:=0;
				if (GE::Joystick(1, GE::JOY_LEFT) and (Keret_X_Pos > 1)) then Keret_MoveLeft();
				if (GE::Joystick(1, GE::JOY_RIGHT) and (Keret_X_Pos < 30)) then Keret_MoveRight();
				if (GE::Joystick(1, GE::JOY_UP) and (Keret_Y_Pos > 1)) then Keret_MoveUp();
				if (GE::Joystick(1, GE::JOY_DOWN) and (Keret_Y_Pos < 18)) then Keret_MoveDown();
			end;
		if (GE::Pressed(GE::KEY_SPACE)) then DrillLerak();
		if (GE::Pressed(GE::KEY_F)) then TeglaLerak();		/* F = fal-tégla lerakás */

		/* 2. Várakozás a képfrissítésre (raszter-megszakítás), hogy a
		   rajzolás ne okozzon szakadást/villogást a képen. */
		GE::WaitForSync();

		/* 3. Rajzolási fázis. Ha a meteor ÉPPEN zuhan, a Meteor_Keret_Frissit
		   fut a Keret_Frissit HELYETT: szigorú z-sorrendben restore-ol/rajzol,
		   hogy a két átfedő maszkolt sprite (Keret + Meteor) ne szemeteljen.
		   Egyébként a normál Keret_Frissit (pumpák + Keret). */
		if (Meteor_Aktiv = 1) then
			Meteor_Keret_Frissit()
		else
			Keret_Frissit();

		/* 4. Pumpák termelése: Termel_Utem képkockánként egyszer. */
		Termel_Frame:=Termel_Frame+1;
		if (Termel_Frame >= Termel_Utem) then
			begin
				Termel_Frame:=0;
				Pumpak_Termelnek();
			end;

		/* 5. KOLÓNIA-VETÉS - C64: aqualiquex.ras "if raster::newSecond".
		   ~50 képkockánként ("másodperc"): 50% eséllyel (a C64 másik 50%-a a
		   meteor, ami nálunk nincs) egy véletlen mezőre vírust vetünk, amíg
		   Enemy_Kolonia_db < ENEMY_MAX_KOLONIA. A 10. vetett kolónia után
		   nincs új: Enemy_Terjedhet := 1 (C64: doVirusSpread). */
		Enemy_Sec_Frame:=Enemy_Sec_Frame+1;
		if (Enemy_Sec_Frame >= 50) then
			begin;
				Enemy_Sec_Frame:=0;
				/* 50% (C64: mod(rnd,2)=0). Rnd_Porgeto = ebben a frame-ben
				   sorsolt RandomByte (lásd fentebb). */
				Enemy_Coin:=Rnd_Porgeto - (Rnd_Porgeto/2)*2;
				if (Enemy_Coin = 0) then
					begin;
						if (Enemy_Kolonia_db < ENEMY_MAX_KOLONIA) then
							begin;
								Enemy_Random_Lerak();
								Enemy_Kolonia_db:=Enemy_Kolonia_db+1;
							end
						else
							Enemy_Terjedhet:=1;
					end;
			end;

		/* 6. NÖVEKEDÉS + TERJEDÉS - C64: raster.tru "for i:=0 to 15".
		   Enemy_Utem frame-enként (C64-modell: minden frame, =1). */
		Enemy_Frame:=Enemy_Frame+1;
		if (Enemy_Frame >= Enemy_Utem) then
			begin;
				Enemy_Frame:=0;
				Enemyk_Mukodnek();
			end;

		/* 7. IDEIGLENES METEOR-TESZT trigger: ha NEM zuhan épp, visszaszámlálás
		   a következő random zuhanásig (100..299 képkocka ~ 2..6 mp). A
		   zuhanás magát a "3." lépés Meteor_Keret_Frissit-je végzi. */
		if (Meteor_Aktiv = 0) then
			begin;
				Meteor_TriggerFrame:=Meteor_TriggerFrame-1;
				if (Meteor_TriggerFrame <= 0) then
					begin;
						Meteor_Indit();
						/* 0..199 (byte-aritmetika), majd integer-ben +100 -> 100..299 */
						Meteor_TriggerFrame:=Rnd_Porgeto - (Rnd_Porgeto/200)*200;
						Meteor_TriggerFrame:=Meteor_TriggerFrame + 100;
					end;
			end;

	end;

