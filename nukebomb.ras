program nukebomb;
@use "TVC"
@use "GE"
@use "random"

/* nukebomb.ras - a bomba-robbanás (gombafelhő) animációjának kísérleti helye.
   Ugyanaz a mód/paletta, mint a WaterPumpGame.ras-ban: GRAPHICS4, szürke/fekete/zöld/kék, szürke border.

   HÁTTÉRKÉPERNYŐS (GE::USE_BACK_SCREEN) működés - a GE saját, erre tervezett módja:
     * a sprite-ok a háttérképernyőre ($C000, Page 3) rajzolódnak: GE::RenderAllSprites()
       (fordított sorrendű háttér-visszaállítás + sorrendi Draw; a sprite-ok háttérpuffereit a GE
       foglalja az Init(...,True)-val) - ez semmit nem mutat a képernyőn, nem is villog;
     * GE::WaitForSync() után GE::CopyAllSpritesToScreen() csak a sprite-ok (régi+új) téglalapjait
       másolja át a látható képernyőre (a kép alján indul, a vblank alatt fut).
   Sorrend egy képkockán: mozgás -> RenderAllSprites -> WaitForSync -> CopyAllSpritesToScreen.

   RÉSZECSKÉK: NB_DB db 8x8-as MASZKOLT blob = a felhő "buborékjai" (GE::Sprite tömb).
   A mozgás-fázisok (útvonal-pontok) a W_X/W_Y tömbben vannak (részecske*NB_WP + pont);
   a tömböket a resources\nukebomb_gen.ps1 generálja/írja át.
   ★ TRSE-hiba: sprite-tömb elem MEZŐjének írása (Parts[i].X := ..) hibás címet generálhat
   (byte index: 8 bitre vágott eltolás; X: az offset helyett az indexet adja hozzá) ->
   a mezőket KÉZI ASM-helperek írják (NB_Place / NB_Lathato), metódushívás (Show/Hide/Init) jó. */

var
		NukeBlob_Data	:	incbin("resources\tvc_sprites\nukebomb.bin");	/* NukeBlob.bmp-ből, MASZKOLT 8x8 */
		CharSet			:	incbin("resources\tvc_sprites\CharSetGR4.bin");

		const NB_DB		:	byte = 12;		/* részecskék száma */
		const NB_WP		:	byte = 5;		/* útvonal-pontok részecskénként */
		const NB_VY		:	byte = 3;		/* max függőleges lépés pixel/képkocka */
		const NB_VX		:	byte = 1;		/* max vízszintes lépés byte/képkocka */

		Parts			:	array[12] of GE::Sprite;		/* maszkolt -> Init(...,True): a GE foglal háttérpuffert */

		/* Részecskénként: aktuális X (byte-ban, 1 byte = 4 px) és Y (pixel), állapot */
		PX				:	array[12] of byte;
		PY				:	array[12] of byte;
		Act				:	array[12] of byte;		/* 1 = már elindult */
		WI				:	array[12] of byte;		/* hányadik útvonal-pont felé tart */
		/* ÚTVONAL-PONTOK (generált): 0 talaj, 1 behúzódás középre, 2 emelkedés középen, 3 ív a szél felé, 4 a kalap pereme (befordulva) */
		W_X				:	array[60] of byte = (33,30,30,30,31,27,30,30,30,29,35,30,30,32,34,25,30,30,28,26,37,30,30,34,37,23,30,30,26,23,39,30,30,36,40,21,30,30,24,20,41,30,30,37,41,19,30,30,23,19,43,30,30,36,39,17,30,30,24,21);
		W_Y				:	array[60] of byte = (172,160,90,84,88,172,160,90,84,88,172,160,90,84,88,172,160,90,84,88,172,160,90,84,90,172,160,90,84,90,172,160,90,86,94,172,160,90,86,94,172,160,90,88,100,172,160,90,88,100,172,160,90,90,106,172,160,90,90,106);
		Dly				:	array[12] of byte = (0,3,6,9,12,15,18,21,24,27,30,33);		/* inditasi keses (kep) */

		/* asm-helperek paraméterei */
		NB_I			:	byte = 0;
		NB_X			:	byte = 0;
		NB_Y			:	byte = 0;
		NB_V			:	byte = 0;

		Fr				:	byte = 0;		/* képkocka-számláló az indítás óta (255-nél megáll) */
		Dirty			:	byte = 1;		/* 1 = ezen a képkockán változott valami (kell Render+Copy) */
		Space_Volt		:	byte = 0;

/* Az NB_I. részecske X/Y mezőinek beírása + SetPosition (kézi ASM: elem-eltolás = NB_I*39) */
Procedure NB_Place();
	begin
		asm("
			ld  a,[NB_I]
			ld  hl,Parts
			ld  de,39
			or  a
			jr  z,nb_place_go
			ld  b,a
nb_place_add:
			add hl,de
			djnz nb_place_add
nb_place_go:
			ld  [GE_Sprite_this],hl
			push hl
			pop  ix
			ld  a,[NB_X]
			ld  (ix+15),a
			ld  a,[NB_Y]
			ld  (ix+16),a
			call GE_Sprite_SetPosition
		");
	end;

/* Az NB_I. részecske Visible mezőjének beírása (NB_V: 0/1) */
Procedure NB_Lathato();
	begin
		asm("
			ld  a,[NB_I]
			ld  hl,Parts
			ld  de,39
			or  a
			jr  z,nb_lat_go
			ld  b,a
nb_lat_add:
			add hl,de
			djnz nb_lat_add
nb_lat_go:
			ld  a,[NB_V]
			ld  (hl),a
		");
	end;

Procedure ProgramInit();
	var i : byte;
	begin
		GE::SetGraphics(GE::GRAPHICS4);
		GE::SetPalette(0,GE::PALETTE_Gray);
		GE::SetPalette(1,GE::PALETTE_Black);
		GE::SetPalette(2,GE::PALETTE_Green);
		GE::SetPalette(3,GE::PALETTE_Blue);
		GE::SetBorder(GE::BORDER_Gray);
		GE::InitCharSet(#CharSet, 118, 2, 7);
		GE::Init(GE::USE_BACK_SCREEN);
		GE::SetMemory(GE::MEM_VID_ON);
		GE::SetRasterInterruptPos(239);
		for i:=0 to NB_DB do
		begin
			Parts[i].Init(#NukeBlob_Data,30,172,True);
			NB_I:=i;
			NB_V:=0;
			NB_Lathato();			/* kezdetben rejtett: az első Show()-ig a GE nem nyúl hozzá */
		end;
		/* háttér: a szürke pálya a HÁTTÉRKÉPERNYŐRE (U3, $C000), majd egyszer át a látható képernyőre */
		asm(" di ");
		GE::SetMemory(GE::MEM_48K_VID);
		GE::ClearScreen(0);
		GE::SetMemory(GE::MEM_VID_ON);
		asm(" ei ");
		GE::CopyBackScreenToScreen();
	end;

/* Robbanás (újra)indítása: a látható részecskék eltüntetése (Hide -> a következő RenderAllSprites
   visszaállítja a hátterüket, a CopyAllSpritesToScreen kimásolja), minden részecske a talajról indul, késleltetve */
Procedure Robbanas_Reset();
	var i, o : byte;
	begin
		for i:=0 to NB_DB do
		begin
			Parts[i].Hide();
			o:=i*NB_WP;
			PX[i]:=W_X[o];
			PY[i]:=W_Y[o];
			Act[i]:=0;
			WI[i]:=1;			/* a 0. pont a kezdőhely, az 1. felé tart */
		end;
		Fr:=0;
		Dirty:=1;
	end;

/* Egy képkocka mozgása: a részecskék sorban követik az útvonal-pontjaikat */
Procedure Reszecskek_Lep();
	var i, o, tx, ty, d, ox, oy : byte;
	begin
		if (Fr<255) then Fr:=Fr+1;
		for i:=0 to NB_DB do
		begin
			if (Act[i]=0) then
				if (Fr>=Dly[i]) then
				begin
					Act[i]:=1;
					NB_I:=i;
					NB_X:=PX[i];
					NB_Y:=PY[i];
					NB_Place();
					Parts[i].Show();
					Dirty:=1;
				end;
			if (Act[i]=1) then
			begin
				ox:=PX[i];
				oy:=PY[i];
				o:=i*NB_WP;
				o:=o+WI[i];
				tx:=W_X[o];
				ty:=W_Y[o];
				if (PY[i]>ty) then
				begin
					d:=PY[i]-ty;
					if (d>NB_VY) then d:=NB_VY;
					PY[i]:=PY[i]-d;
				end;
				if (PY[i]<ty) then
				begin
					d:=ty-PY[i];
					if (d>NB_VY) then d:=NB_VY;
					PY[i]:=PY[i]+d;
				end;
				if (PX[i]>tx) then
				begin
					d:=PX[i]-tx;
					if (d>NB_VX) then d:=NB_VX;
					PX[i]:=PX[i]-d;
				end;
				if (PX[i]<tx) then
				begin
					d:=tx-PX[i];
					if (d>NB_VX) then d:=NB_VX;
					PX[i]:=PX[i]+d;
				end;
				if ((PX[i]=tx) and (PY[i]=ty)) then
					if (WI[i]<NB_WP-1) then WI[i]:=WI[i]+1;
				if ((PX[i]<>ox) or (PY[i]<>oy)) then
				begin
					NB_I:=i;
					NB_X:=PX[i];
					NB_Y:=PY[i];
					NB_Place();
					Dirty:=1;
				end;
			end;
		end;
	end;

begin
	ProgramInit();
	Robbanas_Reset();
	Dirty:=0;
	while (true) do
	begin
		GE::GetKeyboard();
		if (GE::Pressed(GE::KEY_SPACE)) then
		begin
			if (Space_Volt=0) then
			begin
				Robbanas_Reset();		/* ezen a képkockán nincs Lep: a Hide-ot előbb végre kell hajtania a RenderAllSprites-nak */
				Space_Volt:=2;
			end
			else Space_Volt:=1;
		end
		else Space_Volt:=0;
		if (Space_Volt<>2) then Reszecskek_Lep();
		if (Dirty=1) then GE::RenderAllSprites();		/* a háttérképernyőre rajzol */
		GE::WaitForSync();
		if (Dirty=1) then GE::CopyAllSpritesToScreen();	/* a változott téglalapok át a látható képernyőre */
		Dirty:=0;
	end;
end.
