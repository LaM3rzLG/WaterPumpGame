		Palya_CelCoop	:	array[10] of byte = (75,150,225,150,75,150,165,255,255,255);	/* co-op cél: a két játékos pumpáinak ÖSSZEGE (ideiglenesen a cél 3/2-e, max 255) */
		Palya_PumpaAr	:	array[10] of integer = (50,50,50,100,100,125,100,75,150,175);	/* pumpa ára */
		Palya_FalAr	:	array[10] of integer = (0,0,0,0,200,50,60,0,100,100);	/* fal ára */
