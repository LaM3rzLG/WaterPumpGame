/*==========================================================
	Game Engine (GE) for VIDEOTON TV-Computer
  TRSE Rascal unit
	Author:  BerySoft - Zsolt Bertok, 2023-2024
	Version: Marc 16, 2024
==========================================================*/
Unit GE;

var
	// constants for inner use	
	@define DIGI_FREQ_HI        15			// digi frequency hi byte	
	@define CRTC_CUR_START_CHAR	10      // CRTC register #10 - first character in the cursor-interrupt line
	@define CRTC_CUR_END_CHAR   11      // CRTC register #11 - last  character in the cursor-interrupt line
	// Constants
	const SCREEN_WIDTH 			: byte = 64;  			// screen width in bytes
	const SCREEN_HEIGHT			: byte = 240; 			// screen height in pixels	
	const SCREEN_SIZE       : integer = 15360;
	const SCREEN_ADDR  			: integer = $8000;
	const BACK_SCREEN_ADDR	: integer = $C000;	
	const USE_BACK_SCREEN 	: byte = 1; // True
	const DIRECT_TO_SCREEN	: byte = 0; // False
	// Global variables
	ScreenAddr							: integer = $8000;	// screen: $8000; back-screen: $C000
	SpriteListPtr           : integer = 256;		// pointer list of sprites (100x2 bytes at memory address 256-455 -> ASCII screen at $100-$1C7)
  LastSpritePtr           : integer = 254;		// initial value: SpriteListPtr - 2
  SpriteCount             : byte = 0;					// number of sprites in the SpriteList
  SpritePtr               : integer;					// pointer to the current sprite in the SpriteList
	MemAllocPtr							: integer = 2815;   // memory address to save sprite's background -> the ASCII Screen area(address 256)+200: 456-1855 ($1C8-$73F) + definalble characters: 1856-2815 ($740-$AFF))	
	FreeMemSize           	: integer = 2360;		// free memory size for sprite's background (2360 bytes on Page0 + 16K on Page2 or Page3)
  MemAllocPage         	  : byte = 0;					// TVC Page for memory allocation (Page 0: $AFF -> $1C8 + Page 2: $BFFF -> $8001 or Page 3: $FFFF -> $C001)
  ListsPtr                : integer = 6228;		// Memory allocation address for the List class. Size: 410 bytes from the BASIC Work Area (6228-6638 = $1854-$19EE)
  CRTC_ScreenOffset       : integer = 0;      // used for the hardware scroll
  CursorITPos             : integer = 3839;   // base value of the cursor-interrupt position (end of line 239)
  CursorIT_TVline         : byte = 3;         // CRTC register 10 and 11 value (the cursor starting and ending line in the TV line)
  TempSP                  : integer = 0;			// temporary storage of the SP register  
  CharSetPtr              : pointer;					// CharSet from SPACE to Z (ASCII: 32-90)
  CharSetImgWidth         : integer = 118;		// CharSet image width in bytes  
  CharWidth               : byte = 2;					// CharSet character width in bytes
  CharHeight              : byte = 6;					// CharSet image height in pixels
  i                       : byte;
  soundIsOn               : boolean = false;
  NumStr                  : array[6] of byte = (0, 0, 0, 0, 0, 0); // result of ByteToStr / IntToStr
  GameCardFound           : boolean = False;
  GameCardJoy3Port        : byte;							// port of the GameCard's 1st joystick - initialized by the InitGameCard procedure 
  GameCardJoy4Port        : byte;							// port of the GameCard's 1st joystick - initialized by the InitGameCard procedure 
  Joy3State               : byte;							// state of the GameCard's 1st joystick - set by GetJoysticks procedure
  Joy4State               : byte;							// state of the GameCard's 2nd joystick - set by GetJoysticks procedure
  // Digi Sound
  SoundITCounter					: byte = 0					;// SOUND-IT cycles counter for calc raster-interrupt time		
	NoDigiSoundIsPlaying		: byte = 64					;// bit 6 indicates that the digi sound FX has ended <- this is a technical variable for the case when not even a digi sound has been played
  // Mirror table for Sprite.DrawMirror: $1700-$17FF; size: 256 bytes
	// Global params	
	UseBackScreen         	: boolean at $0E70;	// $0E48 - $0E97 -> TV-Computer text Editor working area. Size: 80 bytes. $0E48-$0E6C used by tvc.tru
	GetBackgroundBuffer	    : boolean at $0E71;
	UpdateSpritePos         : boolean at $0E72;
	Width  									: byte at $0E73;
	Height                	: byte at $0E74;	
	Count    								: byte at $0E75;
	Pattern  								: byte at $0E76;	
	Mode                    : byte at $0E77;
	Nr                      : byte at $0E78;
	Color                   : byte at $0E79;	
	X                       : byte at $0E7A;
	Y                       : byte at $0E7B;
	AnimPhaseCount          : byte at $0E7C;
	AnimDelay               : byte at $0E7D;
	JoyCode                 : byte at $0E7E;
	Value                   : byte at $0E7F;
	SoundVolume             : byte at $0E80;	
	MemAddr                 : integer at $0E81;
	Position 								: integer at $0E83;
	Size                  	: integer at $0E85;
	DelayTicks              : integer at $0E87;
	Pitch                   : integer at $0E89;	
	IntNum                  : integer at $0E8B;
	IntNum2                 : integer at $0E8D;
	ImagePtr             	  : pointer at $0E8E;
	SourcePtr   						: pointer at $0E90;
	DestPtr     						: pointer at $0E92;
	Sprite2                 : pointer at $0E94;
	ItemAddr                : integer at $0E96;
	// 0E98- 0EAB -> TVC Poogram ID; size: 20 bytes
	SoundEffect             : pointer at $0E98;
	KeyCode                 : integer at $0E9A;
	GroupNr                 : byte at $0E9B;
	LineNr                  : byte at $0E9C;
	CharNr                  : byte at $0E9D;
	Text 										: ^byte;
	GAME_CARD_ID						: string no_term = (6,"JOY+SN");
	// Mirror Table address for draw mirrored sprite (start adress: $1700, size: 256 bytes)
	const MIRROR_TABLE      : integer = $1700;
	const MIRROR_TABLE_HI   : byte = $17;
	// Sprite class
	const SPRITE_CLASS_SIZE: byte = 33;
	// Memory mapping
	const MEM_DEFAULT  : byte = $70;
	const MEM_VID_ON   : byte = $50;
	const MEM_FULL_64K : byte = $B0;
	const MEM_48K_VID  : byte = $90;
	// System
	const PORT_3_MEM_MIRROR: address	= 2833;
	const PORT_5_MEM_MIRROR: address	= 2834;
	const PORT_6_MEM_MIRROR: address	= 2835;
	// Graphics  / Screen
	const SYS_GRAPH_MODE  : address = $0B13;
	const GRAPH_MODE_PORT : address = 6;
	const SYS_BORDER_COLOR: address = $0B4F;
	const SYS_BORDER_PORT	: address = $0;
	// Graphics modes
	const GRAPHICS2 : byte = 0;
	const GRAPHICS4 : byte = 1;
	const GRAPHICS16: byte = 2;
	// Interrupt
	const SYS_IT_PORT		    : address = $7;		// port for clearing the Cursor/Sound interrupt
	// Sound
	const SOUND_LO_PORT			:	address = 4;		// Sound PITCH low 8 bit
	const SOUND_HI_PORT			:	address = 5;		// Bits 0-3.: sound PITCH high 4 bits
	const SOUND_VOLUME_PORT	:	address = 6;		// Bits 2-5: sound VOLUME (0-15)
	const SILENT_SOUND 			: integer = 4095;
	const MAX_VOLUME 				: byte = 15;
	// Digi Sound Frequencies
	const DIGI_FREQ_8_KHZ		: byte = 232;			// 8 kHz digi frequency low byte
	const DIGI_FREQ_4_KHZ		: byte = 206;			// 4 kHz digi frequency low byte
	const DIGI_FREQ_2_KHZ		: byte = 158;			// 2 kHz digi frequency low byte
	const SOUND_IT_50HZ			: byte = 79;		  // at 4 kHz Hz -> 4000 / 50 Hz = 80, but 4 kHz is not entirely accurate and the screen refresh rate is not exactly 50 Hz, so it works fine with 79. The TVC refresh rate = 1000 / 20.096 = 49,76146...	
	// CRTC
  const CRTC_REG_PORT     : byte = $70; 			// port to select the CRTC register
  const CRTC_DATA_PORT    : byte = $71;  			// port to the CRTC data
  // External slots
  const EXT_SLOT_COUNT		: byte = 4;
	const SLOT_0_BASE_ADDR	: byte = $40;
	const SLOT_1_BASE_ADDR	: byte = $70;
	const SLOT_2_BASE_ADDR	: byte = $A0;
	const SLOT_3_BASE_ADDR	: byte = $D0;
	const SLOT_RAM_AREA_SIZE: byte = 48;
	// GameCard joystick ports
	const SLOT_0_JOY3_PORT	: byte = $12;
	const SLOT_0_JOY4_PORT	: byte = $13;
	const SLOT_1_JOY3_PORT	: byte = $22;
	const SLOT_1_JOY4_PORT	: byte = $23;
	const SLOT_2_JOY3_PORT	: byte = $32;
	const SLOT_2_JOY4_PORT	: byte = $33;
	const SLOT_3_JOY3_PORT	: byte = $42;
	const SLOT_3_JOY4_PORT	: byte = $43;	
	// Keyboard
	const KEYBOARD_ROW_SEL_PORT : byte = 3;
	const KEY_READ_PORT         : byte = 88;
	const KEYBOARD_0 	: address = 2897;       // keyboard mátrix line 0: 4 ! | 1 ' |  Í  | 6 / | 0 & | 2 " | 3 + | 5 % |
	const KEYBOARD_1 	: address = 2898;       // keyboard mátrix line 1: 7 = |  Ö  |  Ó  | É # |  Ü  | 9 ) | 8 ( | ^ ~ |        
	const KEYBOARD_2 	: address = 2899;       // keyboard mátrix line 2:  R  |  Q  | @ ' |  Z  | ; $ |  W  |  E  |  T  |
	const KEYBOARD_3 	: address = 2900;       // keyboard mátrix line 3:  U  |  P  |  Ú  | [ { |  Ő  |  O  |  I  | ] } |
	const KEYBOARD_4 	: address = 2901;       // keyboard mátrix line 4:  F  |  A  | < > |  H  | \ | |  S  |  D  |  G  |
	const KEYBOARD_5 	: address = 2902;       // keyboard mátrix line 5:  J  |  É  |  Ü  | Ret |  Á  |  L  |  K  | Del |
	const KEYBOARD_6 	: address = 2903;       // keyboard mátrix line 6:  V  |  Y  |Lock |  N  |Shift|  X  |  C  |  B  |
	const KEYBOARD_7 	: address = 2904;       // keyboard mátrix line 7:  M  |  =  |Space|Ctrl | Esc | : . | ? , | Alt |
	const JOY1_STATE 	: address = 2905;       // keyboard mátrix line 8:  -  |Left |Right| Acc |Fire |Down | Up  | Ins |
	const JOY2_STATE 	: address = 2906;       // keyboard mátrix line 9:  -  |Left |Right| Acc |Fire |Down | Up  |  -  |
	// Key codes
	// Keyboard Matrix row 0:
	const KEY_4				: integer = $8000;
	const KEY_1				: integer = $4000;
	const KEY_II			: integer = $2000;			// Í
	const KEY_6				: integer = $1000;
	const KEY_0				: integer = $0800;
	const KEY_2				: integer = $0400;
	const KEY_3				: integer = $0200;
	const KEY_5				: integer = $0100;
	// Keyboard Matrix row 1:
	const KEY_7				: integer = $8001;
	const KEY_OE 			: integer = $4001;			// Ö
	const KEY_OO 			: integer = $2001;			// Ó
	const KEY_STAR		: integer = $1001;      // *
	const KEY_UE			: integer = $0801;      // Ü
	const KEY_9				: integer = $0401;
	const KEY_8				: integer = $0201;
	const KEY_CARET		: integer = $0101;      // ^
	// Keyboard Matrix row 2:
	const KEY_R				: integer = $8002;
	const KEY_Q				: integer = $4002;
	const KEY_AT			: integer = $2002;			// @
	const KEY_Z				: integer = $1002;
	const KEY_$				: integer = $0802;
	const KEY_W				: integer = $0402;
	const KEY_E				: integer = $0202;
	const KEY_T				: integer = $0102;
	// Keyboard Matrix row 3:
	const KEY_U				: integer = $8003;
	const KEY_P				: integer = $4003;
	const KEY_UU			: integer = $2003;      // Ú
	const KEY_BRACKET1: integer = $1003;			// [ {
	const KEY_OOE			: integer = $0803;      // Ő
	const KEY_O				: integer = $0403;
	const KEY_I				: integer = $0203;
	const KEY_BRACKET2: integer = $0103;			// ] }
	// Keyboard Matrix row 4:
	const KEY_F				: integer = $8004;
	const KEY_A				: integer = $4004;
	const KEY_LESS		: integer = $2004;      // <
	const KEY_H       : integer = $1004;
	const KEY_BACKSLASH : integer = $0804;		// \
	const KEY_S				: integer = $0404;
	const KEY_D 			: integer = $0204;
	const KEY_G       : integer = $0104;
	// Keyboard Matrix row 5:
	const KEY_J 			: integer = $8005;
	const KEY_EE			: integer = $4005;      // É
	const KEY_UUE  		: integer = $2005;      // Ű
	const KEY_RET     : integer = $1005;
	const KEY_AA      : integer = $0805;			// Á
	const KEY_L				: integer = $0405;
	const KEY_K  			: integer = $0205;
	const KEY_DEL     : integer = $0105;
	// Keyboard Matrix row 6:
	const KEY_V  			: integer = $8006;
	const KEY_Y  			: integer = $4006;
	const KEY_LOCK 		: integer = $2006;
	const KEY_N       : integer = $1006;
	const KEY_SHIFT   : integer = $0806;
	const KEY_X				: integer = $0406;
	const KEY_C  			: integer = $0206;
	const KEY_B       : integer = $0106;
	// Keyboard Matrix row 7:
	const KEY_M  			: integer = $8007;
	const KEY_EQUAL		: integer = $4007;			// =
	const KEY_SPACE		: integer = $2007;
	const KEY_CTRL    : integer = $1007;
	const KEY_ESC     : integer = $0807;
	const KEY_DOT			: integer = $0407;			// .
	const KEY_COMMA		: integer = $0207;			// ,
	const KEY_ALT     : integer = $0107;
	// Keyboard Matrix row 8:
	const JOY1_LEFT		: integer = $4008;
	const JOY1_RIGHT	: integer = $2008;
	const JOY1_ACC    : integer = $1008;
	const JOY1_FIRE   : integer = $0808;
	const JOY1_DOWN		: integer = $0408;
	const JOY1_UP		  : integer = $0208;
	const KEY_INS     : integer = $0108;
	// Keyboard Matrix row 9:
	const JOY2_LEFT		: integer = $4009;
	const JOY2_RIGHT	: integer = $2009;
	const JOY2_ACC    : integer = $1009;
	const JOY2_FIRE   : integer = $0809;
	const JOY2_DOWN		: integer = $0409;
	const JOY2_UP		  : integer = $0209;
	// Joystick
	const JOY_UP			: byte = 2;
	const JOY_DOWN		: byte = 4;
	const JOY_LEFT		: byte = 64;
	const JOY_RIGHT		: byte = 32;
	const JOY_FIRE		: byte = 8;	
	// Gamecard joystick
	const GAMECARD_JOY_UP		: byte = 1;
	const GAMECARD_JOY_DOWN	: byte = 2;
	const GAMECARD_JOY_LEFT	: byte = 4;
	const GAMECARD_JOY_RIGHT: byte = 8;
	const GAMECARD_JOY_FIRE	: byte = 16;
	// Palette colors
	const PALETTE_BLACK 			: byte = $00;
	const PALETTE_DARKBLUE 		: byte = $1;
	const PALETTE_DARKRED 		: byte = $4;
	const PALETTE_DARKMAGENTA : byte = $5;
	const PALETTE_DARKGREEN 	: byte = $10;
	const PALETTE_DARKCYAN 		: byte = $11;
	const PALETTE_DARKYELLOW 	: byte = $14;
	const PALETTE_GRAY 				: byte = $15;
	const PALETTE_BLACK2 			: byte = $40;
	const PALETTE_BLUE 				: byte = $41;
	const PALETTE_RED					: byte = $44;
	const PALETTE_MAGENTA 		: byte = $45;
	const PALETTE_GREEN 			: byte = $50;
	const PALETTE_CYAN 				: byte = $51;
	const PALETTE_YELLOW 			: byte = $54;
	const PALETTE_WHITE 			: byte = $55;
	// Border colors
	const BORDER_BLACK 			: byte = 0;
	const BORDER_DARKBLUE		: byte = 2;
	const BORDER_DARKRED 		: byte = 8;
	const BORDER_DARKMAGENTA: byte = 10;
	const BORDER_DARKGREEN 	: byte = 32;
	const BORDER_DARKCYAN		: byte = 34;
	const BORDER_DARKYELLOW	: byte = 40;
	const BORDER_GRAY				: byte = 42;
	const BORDER_BLACK2			: byte = 128;
	const BORDER_BLUE				: byte = 130;
	const BORDER_RED				: byte = 136;
	const BORDER_MAGENTA		: byte = 138;
	const BORDER_GREEN			: byte = 160;
	const BORDER_CYAN				: byte = 162;
	const BORDER_YELLOW			: byte = 168;
	const BORDER_WHITE			: byte = 170;
	// Graphics 16 mode's colors in 1 byte
	const GR16_COLOR_BLACK  		: byte = 0;
	const GR16_COLOR_DARKBLUE		: byte = 3;
	const GR16_COLOR_DARKRED    : byte = 12;
	const GR16_COLOR_DARKMAGENTA: byte = 15;
	const GR16_COLOR_DARKGREEN  : byte = 48;
	const GR16_COLOR_DARKCYAN   : byte = 51;
	const GR16_COLOR_DARKYELLOW : byte = 60;
	const GR16_COLOR_GRAY       : byte = 63;
	const GR16_COLOR_BLACK2     : byte = 192;
	const GR16_COLOR_BLUE       : byte = 195;
	const GR16_COLOR_RED        : byte = 204;
	const GR16_COLOR_MAGENTA    : byte = 207;
	const GR16_COLOR_GREEN      : byte = 240;
	const GR16_COLOR_CYAN       : byte = 243;
	const GR16_COLOR_YELLOW     : byte = 252;
	const GR16_COLOR_WHITE      : byte = 255;

	
	/*===============================================
             S P R I T E   C L A S S
	===============================================*/	
	Sprite								= class
    Visible             : boolean;  // 0    - false: the sprite will not be drawn in the DrawAllSprites, RanderAllSprites, CopyAllSpritesToScreen, PutAllSprite, RestoreBackground, Draw, Put and CopyToScreen procedures
    SpriteType          : byte;     // 1    - 1: sprite bitmap (no mask); 2: masked sprite (mask byte + sprite byte)
    Data                : integer;	// 2-3  - sprite mask (optional) + bitmap (Put uses bitmap only; Draw uses mask byte + bitmap byte data)
    Background          : integer;	// 4-5  - memory address of the background buffer to save sprite's background (size: Width * Height bytes)
    Position            : integer;	// 6-7	- position on the screen or back-buffer
    LastPosition        : integer;	// 8-9  - last position on the screen or back-buffer - for internal use!
    RedrawIsRequired    : boolean;	// 10   - redraw is required - for internal use!
    Width               : byte;     // 11   - width in bytes
    Height              : byte;     // 12		- height in pixels
    Size                : integer;  // 13-14- sprite size in bytes = Width * Height (+ mask - optional) - for internal use!
    X                   : byte;     // 15		- horizontal position (0-63)
    Y                   : byte;     // 16   - vertical position (0-239)		
    LastX               : byte;     // 17   - last X (horizontal) position
    LastY               : byte;     // 18   - last Y (vertical) position
    ToNextRow           : byte;     // 19   - SCREEN_WIDTH - Width (64 - Width) - for internal use!		
    AnimSet             : pointer;  // 20-21- set of animation phases (sprites)
    AnimType            : byte;     // 22   - currently not used (0: circular; 1: alternating)
    AnimPhaseCount      : byte;     // 23 	- number of animation phases (if the sprite is animated)
    AnimPhaseNr         : byte;     // 24 	- current animation phase number
    AnimDelayValue      : byte;     // 25 	- delay between two animation phases
    AnimDelay           : byte;     // 26   - anim delay counter
    UseBackground       : boolean;  // 27   - uses background buffer to save the background of the sprite (the Background pointer <> 0)
 		GroupNr             : byte;     // 28   - group number
    State               : byte;     // freely usable
    Direction           : byte;     // freely usable
    Timer               : byte;     // freely usable
    Counter             : byte;     // freely usable
		
	  
    /**
    Sprite inicializálása<br/>
    <br/>
		Paraméterek:
		<ul>
		<li>ImagePtr: a sprite bitmap memóriacíme</li>
		<li>X: a sprite kezdő vízszintes pozíciója. Értékei 0-63 között lehetnek.</li>
		<li>Y: a sprite kezdő függőleges pozíciója. Értékei 0-255 között lehetnek.</li>
		<li>GetBackgroundBuffer: foglaljon-e automatikusan a sprite háttérének elmentésére buffert. True: igen, False: nem.</li>
		</ul>
		<br/>
    Példa a használatára:<br/>    
		var<br/>
 		  PlayerBitmap: incbin("resources/images/Player.bin");<br/>
			Player : GE::Sprite;<br/>
		begin<br/>
		  Player.Init(#PlayerBitmap, 0, 0, True);<br/>
		end;<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Sprite initialization<br/>
    <br/>
		Params:
		<ul>
		<li>ImagePtr: nenory address of the sprite bitmap </li>
		<li>X: sprite initial horizontal position (0-63)</li>
		<li>Y: sprite initial vertical position (0-255)</li>
		<li>GetBackgroundBuffer: get background buffer for the sprite</li>
		</ul>
		<br/>
    Example:<br/>    
		var<br/>
 		  PlayerBitmap: incbin("resources/images/Player.bin");<br/>
			Player : GE::Sprite;<br/>
		begin<br/>
		  Player.Init(#PlayerBitmap, 0, 0, True);<br/>
		end;<br/>
		**/
    procedure Init(GE::ImagePtr : global pointer; GE::X, GE::Y : global byte; GE::GetBackgroundBuffer : global boolean);
		begin			
			Asm("
          ;// Init Sprite class
          ld  IX,[GE_Sprite_this]			;// IX -> Sprite class
          ld  (IX+0),1								;// this.Visible = True
			    ;// init sprite width, height, sprite bitmap and mask
			    ld  HL,[GE_ImagePtr]
			    ld  A,(HL)									;// A = sprite type
			    ld  (IX+1),A                ;// this.SpriteType = A
			    inc HL
			    ld  A,(HL)									;// A = sprite width
			    ld  (IX+11),A               ;// this.Width = A
			    inc HL
			    ld  A,(HL)									;// A = sprite height
			    ld  (IX+12),A               ;// this.Height = A
			    inc HL
			    ld  (IX+2),L
			    ld  (IX+3),H                ;// this.Data = HL
			    ld  (IX+4),0
			    ld  (IX+5),0                ;// this.Background := 0
			    ld  (IX+10),0               ;// this.RedrawIsRequired := False
			    ld  (IX+27),0               ;// this.UseBackground := False;
			    ld  (IX+28),0               ;// this.GroupNr := 0;
					;// calc Size -> this.Size := this.Width * this.Height;
					ld  D,0
					ld  E,(IX+12)								;// DE: this.Height
					ld  HL,0
					ld  B,(IX+11)								;// B: this.Width
			calc_spr_size:
			    add HL,DE               		;// HL += this.Height
			    djnz calc_spr_size
			    ld  (IX+13),L
			    ld  (IX+14),H								;// this.Size = HL
			    ;// calc ToNextRow -> this.ToNextRow := SCREEN_WIDTH - this.Width;
			    ld  A,GE_SCREEN_WIDTH   		;// A: SCREEN_WIDTH
			    sub (IX+11)            			;// A = SCREEN_WIDTH - this.Width
			    ld  (IX+19),A			      		;// this.ToNextRow := SCREEN_WIDTH - this.Width;
			    ;// set sprite X, Y
			    ld  A,[GE_X]
			    ld  (IX+15),A	              ;// this.X = X
			    ld  A,[GE_Y]
			    ld  (IX+16),A	              ;// this.Y = Y			   
			    call GE_Sprite_SetPosition
			    ;// update last position
			    ld  A,(IX+6)	;// A = Lo(Position)
					ld  (IX+8),A	;// Lo(LastPosition) = A
					ld  A,(IX+7)  ;// A = Hi(Position)
					ld  (IX+9),A  ;// Hi(LastPosition) = A
					ld  A,[IX+15] ;// A = X
					ld  (IX+17),A ;// LastX := X
					ld  A,[IX+16] ;// A = Y
					ld  (IX+18),A ;// LastY := Y
			    ;// add sprite to SpriteList
			    ld  HL,(GE_LastSpritePtr)
			    inc HL
			    inc HL
			    ld  (GE_LastSpritePtr),HL		;// LastSpritePtr := LastSpritePtr + 2
			    ld  DE,[GE_Sprite_this]
			    ld  (HL),E
			    inc HL
			    ld  (HL),D									;// LastSpritePtr^ := this
			    ld  HL,GE_SpriteCount
			    inc (HL)									  ;// Inc(SpriteCount)
					");
			if (GetBackgroundBuffer) then
			begin
				if ((MemAllocPage = 0) and (FreeMemSize < this.Size)) then
				begin
					if (UseBackScreen) then
					begin
						MemAllocPage := 2;
						MemAllocPtr	 := $BFFF; // top of the Page #2 (49151)
  				end
  				else
  				begin
	  				MemAllocPage := 3;
	  				if (Peek(2842, 0) = 191) then // has 64K RAM (address 2842: HI_MEM system variable HI byte)
	  				  MemAllocPtr := $FFFF  // top of the Page #3 (65535)
	  				else
	  				  MemAllocPtr := $7FFF  // top of the Page #1 (32767)
  				end;
  				FreeMemSize := 4096; // 4 kbyte
				end;
				if (FreeMemSize >= this.Size) then
				begin
				  MemAllocPtr := MemAllocPtr - this.Size;
				  FreeMemSize := FreeMemSize - this.Size;
				  this.Background := MemAllocPtr;
				  Asm("
				  		ld  IX,[GE_Sprite_this]			;// IX -> Sprite class
				  		ld  (IX+27),1               ;// UseBackground := true;
				  		");				  
				end;
			end;			
		end; /* Sprite.Init */		
		
		
    /**
    Maszkolt (átlátszó hátterű) sprite gyors kirakása a hátterének elmentésével<br/>
    <br/>
		Használja a processzor SP regisztert, ezért letiltja a megszakításokat, így digitális hangeffekt lejátszása mellett nem ajánlott a használata.<br/>
		<br/>
    Példa a használatára:<br/>    
		var<br/>
 		  PlayerBitmap: incbin("resources/images/Player.bin");<br/>
			Player : GE::Sprite;<br/>
		begin<br/>
		  Player.Init(#PlayerBitmap, 0, 0, True);<br/>
		  Player.X := 30;<br/>
		  Player.Y := 100;<br/>
		  Player.SetPosition();<br/>
		  Player.FastDraw();<br/>
		end;<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Save sprite's background and draws fast a masked sprite to the screen.<br/> 
		It uses the SP register and disables interrupts.<br/> 
		<br/>
		Example:<br/>
		var<br/>
			Player : GE::Sprite;<br/>
		begin<br/>			  
		  Player.Init(#PlayerBitmap, 4, 20, True);<br/>
		  Player.X := 30;<br/>
		  Player.Y := 100;<br/>		  
		  Player.SetPosition();<br/>
		  Player.FastDraw;<br/>	
		**/
    procedure FastDraw;
    begin
      Asm("
	        ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
			fast_draw_sprite:
			    ld  H,0			
	        ld  L,(IX+19)	       ;// HL = Sprite.ToNextRow (SCREEN_WDITH - Sprite.Width)
	        ld (fdraw_spr_new_line+1),HL ;// self-modifying code: ld DE,10 -> ld DE,SCREEN_WDITH-Sprite.Width
	        ld  A,(IX+12)        ;// A:   Sprite.Height
	        ld  IYL,A            ;// IYL: Sprite.Height
	        ld  C,(IX+4)
	        ld  B,(IX+5)         ;// BC -> Sprite.Background
	        ld  L,(IX+2)
			    ld  H,(IX+3)         ;// HL -> Sprite.Data (mask + sprite)
	        ld  (GE_TempSP),SP   ;// save SP register
	        di                   ;// disable interrupts because of using SP register
	        ld  SP,HL            ;// SP -> Sprite.Data (mask + sprite)
	        ld  L,(IX+6)
	        ld  H,(IX+7)         ;// HL -> Sprite.Position
	        ld  A,(IX+11)        ;// A: Sprite.Width
	        ld  IXH,A            ;// IXH: Sprite.Width
			fast_draw_spr:
	        ld  IXL,IXH          ;// IXL: sprite width
			fdraw_spr_row:					
	        ld  A,(HL)           ;// A: screen byte
	        ld  (BC),A           ;// save the background of the sprite
	        inc BC               ;// BC -> next byte in the background buffer
	        pop DE               ;// E: sprite mask byte, D: sprite image byte
	        and E                ;// and mask
	        or  D                ;// or sprite
	        ld  (HL),A           ;// put mixed sprite byte to screen
	        inc HL               ;// HL -> next byte on screen
	        dec IXL					     ;// decrement remaining bytes from the sprite width
	        jp  nz,fdraw_spr_row ;// continue if the remaining bytes is not zero
	    fdraw_spr_new_line:
	        ld  DE,10					   ;// DE = SCREEN_WDITH - Sprite.Width
	        add HL,DE            ;// HL -> next line on the screen
	        dec IYL              ;// decrement remaining rows from the sprite height
	        jp  nz,fast_draw_spr ;// continue if the remaining rows is not zero
	        ld  SP,(GE_TempSP)   ;// restore the value of the SP register
	        ei                   ;// enable interrupts					
					");
	  end; /* Sprite.FastDraw */
		
		
		/**
		Maszkolt (átlátszó hátterű) sprite gyors kirakása vízszintesen tükrözve<br/>
    <br/>
		Használja a processzor SP regisztert, ezért letiltja a megszakításokat, így digitális hangeffekt lejátszása mellett nem ajánlott a használata.<br/>
		<br/>
    Példa a használatára:<br/>    
		var<br/>
 		  PlayerBitmap: incbin("resources/images/Player.bin");<br/>
			Player : GE::Sprite;<br/>
		begin<br/>
		  Player.Init(#PlayerBitmap, 0, 0, True);<br/>
		  Player.X := 30;<br/>
		  Player.Y := 100;<br/>
		  Player.SetPosition();<br/>
		  Player.FastDrawMirror();<br/>
		end;<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Saves the background of the sprite and then draws the masked sprite onto the screen, fast and mirroring it.<br/> 
		It uses the SP register and disables interrupts.<br/> 
		<br/>
		Example:<br/>
		var<br/>
			Player : GE::Sprite;<br/>
		begin<br/>			  
		  Player.Init(#SpriteLeftBin, 4, 20, True);<br/>
		  Player.X := 30;<br/>
		  Player.Y := 100;<br/>		  
		  Player.SetPosition();<br/>
		  Player.FastDrawMirror;<br/>	
		**/
    procedure FastDrawMirror;
    begin
      Asm("
	        ld  IX,[GE_Sprite_this]	;// IX -> Sprite class		      
	        ld  A,(IX+12)        	;// A   = Sprite.Height
	        ld  IYH,A 						;// IYH = Sprite.Height
	        ld  L,(IX+2)
			    ld  H,(IX+3)         	;// HL -> Sprite.Data (mask + sprite)
	        ld  (GE_TempSP),SP   	;// save SP register
	        di                   	;// disable interrupts because of using SP register
	        ld  SP,HL            	;// SP -> Sprite.Data (mask + sprite)
	        ld  D,0
	        ld  H,D
	        ld  L,(IX+11)    	    ;// HL = Sprite.Width
	        ld  E,L               ;// DE = Sprite.Width
	        ld  BC,GE_SCREEN_WIDTH
	        add HL,BC             ;// HL = SCREEN_WIDTH + Sprite.Width
	        ld  (fast_draw_mirror_next_row+1),HL ;// self-modifying code: ld DE,10 -> ld DE,SCREEN_WIDTH + Sprite.Width
	        ld  A,E             	;// A: Sprite.Width
	        ld  (fast_draw_mirror_spr+2),A ;// self-modifying code: ld IYL,10 -> ld IYL,Sprite.Width
	        ex  DE,HL
	        add HL,HL             ;// HL = 2*Sprite.Width
	        ld  (fast_draw_mirror_next_row2+1),HL ;// self-modifying code: ld DE,20 -> ld DE,2*Sprite.Width
	        ex  DE,HL
	        ld  H,(IX+7)         	
	        ld  L,(IX+6)          ;// HL -> Sprite.Position
	        dec A                 ;// A  = Sprite.Width - 1
	        ld  C,A               ;// BC = Sprite.Width - 1
			    add HL,BC				  		;// HL = Sprite.Position + (Sprite.Width - 1) -> last byte of the current sprite row
			    ld  D,(IX+5)         	
			    ld  E,(IX+4)          ;// DE -> Sprite.Background
			    ex  DE,HL
			    add HL,BC
			    ex  DE,HL							;// DE -> Sprite.Background + (Sprite.Width - 1) -> last byte of the Background buffer 1st row
	        ld  IXH,D
	        ld  IXL,E             ;// IX -> Sprite.Background
	        ld  B,GE_MIRROR_TABLE_HI ;// B = Hi(MIRROR_TABLE)
			fast_draw_mirror_spr:
	        ld  IYL,10          	;// IYL: sprite width (its value is set by the code above)
			fast_draw_mirror_spr_row:					
	        ld  A,(HL)           	;// A: screen byte
	        ld  (IX+0),A          ;// save the background of the sprite
	        dec IX               	;// IX -> prev byte in the background buffer
	        pop DE               	;// E: sprite mask byte, D: sprite image byte
	        ld  C,E		 			      ;// C = mask byte: BC -> Mirror Table
	        ld  A,(BC)       			;// A = mirrored mask byte
	        and (HL)							;// A = mirrored mask byte AND screen byte
	        ld  E,A         		  ;// saving the mirrored mask byte AND screen byte to register E
	        ld  C,D     		 			;// C = sprite byte: BC -> Mirror Table
	        ld  A,(BC)       			;// A = mirrored sprite byte
	        or  E             		;// A = mirrored sprite byte OR (mirrored mask byte AND screen byte)
	        ld  (HL),A           	;// put mixed sprite byte to screen
	        dec HL               	;// HL -> pervious byte on screen
	        dec IYL					     	;// decrement remaining bytes from the sprite width
	        jp  nz,fast_draw_mirror_spr_row ;// continue if the remaining bytes is not zero	        
      fast_draw_mirror_next_row:
	        ld  DE,10            	;// DE  = SCREEN_WIDTH + Sprite.Width (its value is set by the code above)
	        add HL,DE            	;// HL -> next row on the screen
	    fast_draw_mirror_next_row2:
					ld  DE,20            	;// DE  = 2*Sprite.Width (its value is set by the code above)
	        add IX,DE             ;// IX -> next row in the Background buffer
	        dec IYH				 	  		;// decrementing the remaining rows of the sprite
	        jp  nz,fast_draw_mirror_spr ;// continue if the remaining rows is not zero
	        ld  SP,(GE_TempSP)   	;// restore the value of the SP register
	        ei                   	;// enable interrupts					
					");
	  end; /* Sprite.FastDrawMirror */
		
		/**
		Maszkolt (átlátszó hátterű) sprite gyors kirakása a hátterének elmentésével hardver scroll használata mellett<br/>
    <br/>
		Használja a processzor SP regisztert, ezért letiltja a megszakításokat, így digitális hangeffekt lejátszása mellett nem ajánlott a használata.<br/>
		<br/>
    Példa a használatára:<br/>    
	  GE::WaitForSync();<br/>
	  GE::ScrollDown(True);<br/>
	  Player.ScrollFastDraw();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Save sprite's background and draws fast a masked sprite to the screen<br/> 
		when using ScrollUp or ScrollDown hardware scroll.<br/> 
		It uses the SP register and disables interrupts.<br/> 
		<br/>
		Example:<br/>
		GE::WaitForSync();<br/>
	  GE::ScrollDown(True);<br/>
	  Player.ScrollFastDraw();<br/>
		**/
    procedure ScrollFastDraw;
    begin
      Asm("
	        ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
	        ld  A,(IX+19)	       ;// A = Sprite.ToNextRow (SCREEN_WDITH - Sprite.Width)
			    ld  IYH,A            ;// IYH: SCREEN_WDITH - Sprite.Width
	        ld  A,(IX+12)        ;// A:   Sprite.Height
	        ld  IYL,A            ;// IYL: Sprite.Height
	        ld  C,(IX+4)
	        ld  B,(IX+5)         ;// BC -> Sprite.Background
	        ld  L,(IX+2)
			    ld  H,(IX+3)         ;// HL -> Sprite.Data (mask + sprite)
	        ld  (GE_TempSP),SP   ;// save SP register
	        di                   ;// disable interrupts because of using SP register
	        ld  SP,HL            ;// SP -> Sprite.Data (mask + sprite)
	        ld  L,(IX+6)
	        ld  H,(IX+7)         ;// HL -> Sprite.Position
	        ld  A,(IX+11)        ;// A: Sprite.Width
	        ld  IXH,A            ;// IXH: Sprite.Width
			scroll_fast_draw_spr:
	        ld  IXL,IXH          ;// IXL: sprite width
			scroll_fast_draw_spr_row:					
	        ld  A,(HL)           ;// A: screen byte
	        ld  (BC),A           ;// save the background of the sprite
	        inc BC               ;// BC -> next byte in the background buffer
	        pop DE               ;// E: sprite mask byte, D: sprite image byte
	        and E                ;// and mask
	        or  D                ;// or sprite
	        ld  (HL),A           ;// put mixed sprite byte to screen
	        inc HL               ;// HL -> next byte on screen
	        dec IXL					     ;// decrement remaining bytes from the sprite width
	        jp  nz,scroll_fast_draw_spr_row ;// continue if the remaining bytes is not zero
	        ld  D,0              ;// D = 0
	        ld  E,IYH            ;// DE = SCREEN_WDITH - Sprite.Width
	        add HL,DE            ;// HL -> next line on the screen
	        res 6,H              ;// if bit 6 is 1, the addressing is above 48K (over the VIDEORAM), so bit 6 is cleared. This means that HL will always be between 32K and 48K, i.e. in the VIDEORAM range.
	        dec IYL              ;// decrement remaining rows from the sprite height
	        jp  nz,scroll_fast_draw_spr ;// continue if the remaining rows is not zero
	        ld  SP,(GE_TempSP)   ;// restore the value of the SP register
	        ei                   ;// enable interrupts					
					");
	  end; /* Sprite.ScrollFastDraw */
			
		/**
		Maszkolt (átlátszó hátterű) sprite kirakása a hátterének elmentésével<br/>
    <br/>
		Digitális hangeffekt lejátszása mellett is használható.<br/>
		<br/>
    Példa a használatára:<br/>    
	  var<br/>
			Player : GE::Sprite;<br/>
		begin<br/>			  
		  Player.Init(#SpriteBitmap, 4, 20, True);<br/>
		  Player.X := 30;<br/>
		  Player.Y := 100;<br/>		  
		  Player.SetPosition();<br/>
		  Player.Draw;<br/>	
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Save sprite's background and draws masked sprite to the screen.<br/> 
		It does not use the SP register or disable interrupts.<br/> 
		<br/>
    Example:<br/>
		var<br/>
			Player : GE::Sprite;<br/>
		begin<br/>			  
		  Player.Init(#SpriteBinData, 4, 20, True);<br/>
		  Player.X := 30;<br/>
		  Player.Y := 100;<br/>		  
		  Player.SetPosition();<br/>
		  Player.Draw;<br/>	
		**/
	  procedure Draw;
	  begin
	    Asm("
	        ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
	    draw_sprite:
	        ld  H,0
	        ld  L,(IX+19)    ;// HL = Sprite.ToNextRow (SCREEN_WDITH - Sprite.Width)
	        ld  (draw_next_row+1),HL ;// self-modifying code: ld BC,10 -> ld BC,SCREEN_WDITH - Sprite.Width
	        ld  L,(IX+2)
	        ld  H,(IX+3)     ;// HL -> sprite mask and image
	        ld  C,(IX+4)
			    ld  B,(IX+5)     ;// BC -> Sprite.Background		      
	        ld  E,(IX+6)
			    ld  D,(IX+7)     ;// DE -> Sprite.Position
			    ld  A,(IX+11)    ;// A: Sprite.Width
	        ld  IYL,A        ;// IYL: Sprite.Width
			    ld  A,(IX+12)    ;// A: Sprite.Height
	        ld  IXL,A        ;// IXL: Sprite.Height
			draw_spr:
				  ld  IYH,IYL      ;// IXH: sprite width
			draw_spr_row:
	        ld  A,(DE)       ;// A: screen byte
	        ld (BC),A        ;// save the background of the sprite
	        inc BC           ;// BC -> next byte on the background buffer
	        and (HL)         ;// and mask
	        inc HL           ;// HL -> sprite image byte
	        or  (HL)         ;// or sprite
	        inc HL           ;// HL -> next mask byte
	        ld  (DE),A       ;// put the mixed sprite byte to the screen
	        inc DE					 ;// DE -> next byte on the screen
	        dec IYH          ;// decrement remaining bytes from the sprite width
	        jp  nz,draw_spr_row ;// continue if the remaining bytes is not zero
	        push BC
	        ex  DE,HL
			draw_next_row:
	        ld  BC,10        ;// will be overwritten with the required value (SCREEN_WDITH - Sprite.Width)
	        add HL,BC	        
	        ex  DE,HL        ;// DE -> next line on the screen
	        pop BC
	        dec IXL          ;// decrement remaining rows from the sprite height
	        jp  nz,draw_spr  ;// continue if the remaining rows is not zero
	        ");
	  end; /* Sprite.Draw */
			
			
		/**
		Maszkolt (átlátszó hátterű) sprite kirakása vízszintesen tükrözve<br/>
    <br/>
		Digitális hangeffekt lejátszása mellett is használható.<br/>
		<br/>
    Példa a használatára:<br/>    
	  var<br/>
			Player : GE::Sprite;<br/>
		begin<br/>			  
		  Player.Init(#SpriteBitmap, 4, 20, True);<br/>
		  Player.X := 30;<br/>
		  Player.Y := 100;<br/>		  
		  Player.SetPosition();<br/>
		  Player.DrawMirror;<br/>	
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Saves the background of the sprite and then draws the masked sprite onto the screen, mirroring it.<br/> 
		It does not use the SP register or disable interrupts.<br/> 
		<br/>
    Example:<br/>
		var<br/>
			Player : GE::Sprite;<br/>
		begin<br/>			  
		  Player.Init(#SpriteLeftBin, 4, 20, True);<br/>
		  Player.X := 30;<br/>
		  Player.Y := 100;<br/>		  
		  Player.SetPosition();<br/>
		  Player.DrawMirror;<br/>	
		**/
	  procedure DrawMirror;
	  begin
	    Asm("b
	        ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
		      ld  A,(IX+11)    	;// A = Sprite.Width
	        ld  (draw_mirror_spr+2),A ;// self-modifying code: ld IYH,10 -> ld IYH,Sprite.Width
	        ld  H,0
	        ld  L,A           ;// HL = Sprite.Width
	        ld  BC,GE_SCREEN_WIDTH
	        add HL,BC         ;// HL = SCREEN_WIDTH + Sprite.Width
	        ld  (draw_mirror_next_row+1),HL ;// self-modifying code: ld BC,10 -> ld BC,SCREEN_WIDTH+Sprite.Width
	        ld  L,A						;// HL = Sprite.Width
	        add HL,HL					;// HL = 2*Sprite.Width
	        ld  (draw_mirror_next_row2+1),HL ;// self-modifying code: ld BC,20 -> ld BC,2*Sprite.Width
	        ld  H,(IX+5)     	
					ld  L,(IX+4)      ;// HL -> Sprite.Background
			    dec A             ;// A  = Sprite.Width-1
			    ld  C,A           ;// BC = Sprite.Width-1
			    add HL,BC         ;// HL -> Sprite.Background + (Sprite.Width-1)
			    ex  DE,HL					;// DE -> Sprite.Background + (Sprite.Width-1) -> the last byte of 1st row of the background buffer
			    ld  H,(IX+7)
	        ld  L,(IX+6)      ;// HL -> Sprite.Position
			    add HL,BC				  ;// HL = Sprite.Position + (Sprite.Width-1) -> the last byte of 1st row of the sprite on the screen
			    ld  A,(IX+12)    	;// A: Sprite.Height
			    ld  (GE_Height),A ;// Height = Sprite.Height
			    ld  B,(IX+3)			
			    ld  C,(IX+2)      ;// DE -> Sprite.Data (mask and bitmap)
	        ld  IXH,B
	        ld  IXL,C			   	;// IX -> Sprite.Data (mask and bitmap)
			draw_mirror_spr:
				  ld  IYH,10       	;// IYH: Sprite.Width (its value is set by the code above)
				  ld  B,GE_MIRROR_TABLE_HI ;// BC -> Hi(MIRROR_TABLE)
			draw_mirror_spr_row:
	        ld  A,(HL)       	;// A: screen byte
	        ld  (DE),A     	  ;// save the background of the sprite
	        dec DE           	;// DE -> prev. byte in the background buffer
	        ld  C,(IX+0)		 	;// C = mask byte: BC -> Mirror Table
	        ld  A,(BC)       	;// A = mirrored mask byte
	        and (HL)					;// A = mirrored mask byte AND screen byte
	        ld  IYL,A         ;// IYL = mirrored mask byte AND screen byte
	        inc IX						;// IX -> sprite byte
	        ld  C,(IX+0)		 	;// C = sprite byte: BC -> Mirror Table	        
	        ld  A,(BC)       	;// A = mirrored sprite byte
	        or  IYL           ;// A = mirrored sprite byte OR (mirrored mask byte AND screen byte)
	        ld  (HL),A       	;// put the mixed sprite byte to the screen
	        dec HL					 	;// HL -> previous byte on the screen
	        inc IX						;// IX -> next mask byte
	        dec IYH          	;// decrement remaining bytes from the sprite width
	        jp  nz,draw_mirror_spr_row ;// continue if the remaining bytes is not zero
			draw_mirror_next_row:
	        ld  BC,10        	;// BC = SCREEN_WIDTH + Sprite.Width (its value is set by the code above)
	        add HL,BC					;// HL -> last byte of the next sprite row
	    draw_mirror_next_row2:
	        ld  BC,20         ;// BC  = 2*Sprite.Width (its value is set by the code above)
	        ex  DE,HL
	        add HL,BC         ;// DE -> last byte of the next row in the Background buffer
	        ex  DE,HL
	        ld  A,(GE_Height) ;// A = the remaining rows of the sprite
	        dec A					 	  ;// decrementing the remaining rows of the sprite
	        ld  (GE_Height),A ;// Height = the decremented remaining rows of the sprite
	        jp  nz,draw_mirror_spr ;// continue if the remaining rows is not zero
	        ");
	  end; /* Sprite.DrawMirror */
			
	  /**
	  Maszkolt (átlátszó hátterű) sprite kirakása scroll használata közben<br/>
    <br/>
		Digitális hangeffekt lejátszása mellett is használható.<br/>
		<br/>
    Példa a használatára:<br/>    
	  GE::WaitForSync();<br/>
	  GE::ScrollDown(True);<br/>
	  Player.ScrollDraw();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
	  Save sprite's background and draws masked sprite to the screen<br/> 
	  when using ScrollUp or ScrollDown hardware scroll.<br/> 
	  <br/>
	  Example:<br/>
	    GE::ScrollUp(true);<br/>
	    Player.Draw;<br/>	
	  **/
	  procedure ScrollDraw;
	  begin
	    Asm("
	        ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
	        ld  H,0
	        ld  L,(IX+19)    ;// HL = Sprite.ToNextRow (SCREEN_WDITH - Sprite.Width)
	        ld  (scroll_draw_next_row+1),HL ;// self-modifying code: ld BC,SCREEN_WDITH - Sprite.Width
	        ld  L,(IX+2)
	        ld  H,(IX+3)     ;// HL -> sprite mask and image
	        ld  C,(IX+4)
			    ld  B,(IX+5)     ;// BC -> Sprite.Background		      
	        ld  E,(IX+6)
			    ld  D,(IX+7)     ;// DE -> Sprite.Position
			    ld  A,(IX+11)    ;// A: Sprite.Width
	        ld  IYL,A        ;// IYL: Sprite.Width
			    ld  A,(IX+12)    ;// A: Sprite.Height
	        ld  IXL,A        ;// IXL: Sprite.Height
			scroll_draw_spr:
				  ld  IYH,IYL      ;// IXH: sprite width
			scroll_draw_spr_row:
	        ld  A,(DE)       ;// A: screen byte
	        ld	  (BC),A       ;// save the background of the sprite
	        inc BC           ;// BC -> next byte on the background buffer
	        and (HL)         ;// and mask
	        inc HL           ;// HL -> sprite image byte
	        or  (HL)         ;// or sprite
	        inc HL           ;// HL -> next mask byte
	        ld  (DE),A       ;// put the mixed sprite byte to the screen
	        inc DE           ;// DE -> next byte on the screen
	        dec IYH          ;// decrement remaining bytes from the sprite width
	        jp  nz,scroll_draw_spr_row ;// continue if the remaining bytes is not zero
	        push BC
	        ex  DE,HL
			scroll_draw_next_row:
	        ld  BC,10        ;// will be overwritten with the required value (SCREEN_WDITH - Sprite.Width)
	        add HL,BC
	        res 6,H          ;// if bit 6 is 1, the addressing is above 48K (over the VIDEORAM), so bit 6 is cleared. This means that HL will always be between 32K and 48K, i.e. in the VIDEORAM range.
	        ex  DE,HL        ;// DE -> next line on the screen
	        pop BC
	        dec IXL          ;// decrement remaining rows from the sprite height
	        jp  nz,scroll_draw_spr ;// continue if the remaining rows is not zero
	        ");
	  end; /* Sprite.ScrollDraw */
			
			
	  /**
	  Sprite háttér-bufferének beállítása<br/>
    <br/>
		Paraméterek:
		<ul>
		<li>BackgoundBuffer: a sprite háttér-bufferének memóriacíme</li>
		</ul>
		<br/>
    Példa a használatára:<br/>    
		var<br/>
 		  PlayerBitmap: incbin("resources/images/Player.bin");<br/>
			Player : GE::Sprite;<br/>
			PlayerBackground : array[200] of byte;<br/>
		begin<br/>
		  Player.Init(#PlayerBitmap, 0, 0, False);<br/>
		  Player.SetBackground(#PlayerBackground);<br/>
		end;<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
	  Set the sprite's backgroud buffer<br/>
	  **/
	  procedure SetBackground(BackgoundBuffer : pointer);
	  begin
	    this.Background := BackgoundBuffer;
	    this.UseBackground := BackgoundBuffer <> 0;
	  end; /* Sprite.SetBackground */
			
			
	  /**
	  Elmenti a sprite hátterét<br/>
    <br/>
    Leginkább a játék pályájának kirajzolása után, egy első, inicializáló háttér mentéshez érdemes használni.<br/>
    Több sprite esetén praktikusabb a GE::SaveAllSpritesBackground() eljárás használata.<br/>
    <br/>
    Példa a használatára:<br/>    
		begin<br/>
		  Player.Init(#PlayerBitmap, 0, 0, False);<br/>
		  Player.SaveBackground();<br/>
		end;<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
	  Saves the background of the sprite to the background buffer.<br/>
	  **/
	  procedure SaveBackground;
	  begin
	    Asm("													  		
	        ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
	        ld  E,(IX+4)
			    ld  D,(IX+5)         ;// DE -> Sprite.Backgound
			    ld  A,(IX+11)        ;// A: sprite width
			    ld  (save_spr_bg+1),A ;// self-modifying code: ld C,10 -> ld C,Sprite.Width
			    ld  A,(IX+19)        ;// A = SCREEN_WDITH - Sprite.Width (value for new row)
			    ld  (save_spr_bg_next_row+1),A ;// self-modifying code: ld C,20 -> ld C,SCREEN_WDITH - Sprite.Width
			    ld  A,(IX+12)        ;// A: sprite height
			    ld  L,(IX+6)
			    ld  H,(IX+7)         ;// HL -> Sprite.Position
			    ld  (IX+8),L
			    ld  (IX+9),H         ;// Sprite.LastPosition := Sprite.Position
			    ld  B,0
				save_spr_bg:
	        ld  C,10             ;// BC = Width (will be overwritten with the Sprite.Width value -> ld C,Width)
	        ldir                 ;// copy a sprite background row to the background buffer
				save_spr_bg_next_row:
					ld  C,20             ;// will be overwritten with the required value (SCREEN_WDITH - Sprite.Width)
					add HL,BC						    ;// HL -> next line on the screen
					dec A                ;// decrement remaining rows from the sprite height
					jp  nz,save_spr_bg   ;// continue if the remaining rows is not zero
					ld  A,[IX+15]        ;// A = X
					ld  (IX+17),A        ;// LastX := X
					ld  A,[IX+16]        ;// A = Y
					ld  (IX+18),A        ;// LastY := Y
					");
	  end; /* Sprite.SaveBackground */
	
	
	  /**
	  Elmenti a sprite hátterét scrollozás közben.<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
	  Saves the background of the sprite to the background buffer when using ScrollUp or ScrollDown hardware scroll.<br/>
	  **/
	  procedure ScrollSaveBackground;
	  begin
	    Asm("													  		
	        ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
	        ld  E,(IX+4)
			    ld  D,(IX+5)				    ;// DE -> Sprite.Backgound
			    ld  A,(IX+11)        ;// A: sprite width
			    ld  (scroll_save_spr_bg+1),A ;// self-modifying code: ld C,Sprite.Width
			    ld  A,(IX+19)        ;// A = SCREEN_WDITH - Sprite.Width (value for new row)
			    ld (scroll_save_spr_bg_next_row+1),A ;// self-modifying code: ld C,SCREEN_WDITH - Sprite.Width
			    ld  A,(IX+12)        ;// A: sprite height
			    ld  L,(IX+6)
			    ld  H,(IX+7)				    ;// HL -> Sprite.Position
			    ld  (IX+8),L
			    ld  (IX+9),H				    ;// Sprite.LastPosition := Sprite.Position
			    ld  B,0
				scroll_save_spr_bg:
	        ld	  C,10             ;// BC = Width (will be overwritten with the Sprite.Width value -> ld C,Width)
	        ldir                 ;// copy a sprite background row to the background buffer
				scroll_save_spr_bg_next_row:
	        ld  C,10             ;// will be overwritten with the required value (SCREEN_WDITH - Sprite.Width)
	        add HL,BC            ;// HL -> next line on the screen
	        res 6,H              ;// if bit 6 is 1, the addressing is above 48K (over the VIDEORAM), so bit 6 is cleared. This means that HL will always be between 32K and 48K, i.e. in the VIDEORAM range.
	        dec A                ;// decrement remaining rows from the sprite height
	        jp  nz,scroll_save_spr_bg ;// continue if the remaining rows is not zero
	        ld  A,[IX+15]        ;// A = X
	        ld  (IX+17),A        ;// LastX := X
	        ld  A,[IX+16]        ;// A = Y
	        ld  (IX+18),A        ;// LastY := Y
					");
	  end; /* Sprite.ScrollSaveBackground */


		/**
		Visszamásolja a képernyőre a sprite korábban elmentett hátterét.<br/>
    <br/>
    Példa a használatára:<br/>    
    GE::WaitForSync();<br/>
    PlayerSprite.RestoreBackground();<br/>
    PlayerSprite.MoveUp();<br/>
    PlayerSprite.SaveBackground();<br/>
    PlayerSprite.Put();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Restores the background of the sprite<br/>
    Copy the sprite's saved background back to the screen.<br/>
		**/
		procedure RestoreBackground;
		begin
		  Asm("		          
		      ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
          ld  E,(IX+8)
		      ld  D,(IX+9)				 ;// DE -> Sprite.LastPosition
		      ld  A,(IX+11)        ;// A: sprite width
		      ld  (restore_spr_bg+1),A ;// self-modifying code: ld C,Sprite.Width
		      ld  A,(IX+19)        ;// A = SCREEN_WDITH - Sprite.Width (value for new row)
		      ld  (restore_spr_bg_next_row+1),A ;// self-modifying code: ld C,SCREEN_WDITH - Sprite.Width
		      ld  A,(IX+12)        ;// A: sprite height
		      ld  L,(IX+4)
		      ld  H,(IX+5)				 ;// DE -> Sprite.Backgound
 		      ld  B,0
			restore_spr_bg:
					ld  C,10             ;// BC = Width (will be overwritten with the Sprite.Width value -> ld C,Width)
					ldir                 ;// Copy a row from the sprite's background buffer to the screen
					ex  DE,HL
			restore_spr_bg_next_row:
					ld  C,10             ;// will be overwritten with the required value (SCREEN_WDITH - Sprite.Width)
					add HL,BC						 
					ex  DE,HL						 ;// DE -> next line on the screen
					dec A                ;// decrement remaining rows from the sprite height
					jp  nz,restore_spr_bg;// continue if the remaining rows is not zero
					");
		end; /* Sprite.RestoreBackground */
		
		
		/**
		Visszamásolja a képernyőre a sprite korábban elmentett hátterét scrollozás közben.<br/>
    <br/>
    Példa a használatára:<br/>    
    GE::WaitForSync();<br/>
    GE::ScrollDown();<br/>
    PlayerSprite.ScrollRestoreBackground();<br/>
    PlayerSprite.MoveUp();<br/>
    PlayerSprite.ScrollDraw();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Restores the background of the sprite when using ScrollUp or ScrollDown hardware scroll.<br/>
    Copy the sprite's saved background back to the screen.<br/>
		**/
	  procedure ScrollRestoreBackground;
	  begin
	    Asm("		          
	        ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
	        ld  E,(IX+8)
			    ld  D,(IX+9)         ;// DE -> Sprite.LastPosition
			    ld  A,(IX+11)        ;// A: sprite width
			    ld  (scroll_restore_spr_bg+1),A ;// self-modifying code: ld C,Sprite.Width
			    ld  A,(IX+19)        ;// A = SCREEN_WDITH - Sprite.Width (value for new row)
			    ld  (scroll_restore_spr_bg_next_row+1),A ;// self-modifying code: ld C,SCREEN_WDITH - Sprite.Width
			    ld  A,(IX+12)        ;// A: sprite height
			    ld  L,(IX+4)
			    ld  H,(IX+5)         ;// DE -> Sprite.Backgound
	 		    ld  B,0
				scroll_restore_spr_bg:
	        ld  C,10             ;// BC = Width (will be overwritten with the Sprite.Width value -> ld C,Width)
	        ldir                 ;// Copy a row from the sprite's background buffer to the screen
	        ex  DE,HL
				scroll_restore_spr_bg_next_row:
					ld  C,10             ;// will be overwritten with the required value (SCREEN_WDITH - Sprite.Width)
					add HL,BC						 
					res 6,H              ;// if bit 6 is 1, the addressing is above 48K (over the VIDEORAM), so bit 6 is cleared. This means that HL will always be between 32K and 48K, i.e. in the VIDEORAM range.
					ex  DE,HL						    ;// DE -> next line on the screen
					dec A                ;// decrement remaining rows from the sprite height
					jp  nz,scroll_restore_spr_bg;// continue if the remaining rows is not zero
					");
	  end; /* Sprite.ScrollRestoreBackground */
	  
	  
	  /**
	  NEM maszkolt (NEM átlátszó hátterű) sprite kirakása a képernyőre<br/>
    <br/>
		Digitális hangeffekt lejátszása mellett is használható.<br/>
		<br/>
    Példa a használatára:<br/>    
	  var<br/>
			Player : GE::Sprite;<br/>
		begin<br/>			  
		  Player.Init(#PlayerBitmap, 0, 0, False);<br/>
		  Player.X := 30;<br/>
		  Player.Y := 100;<br/>		  
		  Player.SetPosition();<br/>
		  Player.Put();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Put sprite to screen by overwrite mode<br/> 
		<br/>
		**/
		procedure Put;
		begin
		  Asm("													  		
		      ld  IX,[GE_Sprite_this]	;// IX -> Sprite class		      
		      ld  A,(IX+19)       	;// A = SCREEN_WIDTH - Sprite.Width (value for new row)
		      ld  (put_spr_next_row+1),A ;// self-modifying code: ld BC,20 -> ld BC,SCREEN_WDITH-Sprite.Width
		      add A,A               ;// A = 2*(SCREEN_WDITH-Sprite.Width)
		      ld  B,0
					ld  C,A	              ;// BC = 2*(SCREEN_WIDTH-Sprite.Width)
					ld  HL,put_spr_ldi ;// HL -> fastput_64_ldi
					add HL,BC							;// HL -> fastput_64_ldi + 2*(SCREEN_WIDTH-Sprite.Width) => for jump out (SCREEN_WIDTH-Sprite.Width) x LDI instruction
		      ld  (put_spr_jump+1),HL     ;// self-modifying code: overwrite address of jp fastput_64_ldi
		  		ld  (put_spr_loop_end+1),HL	;// self-modifying code: overwrite address of jp nz,fastput_spr_64_ldi
		      ld  L,(IX+2)
		      ld  H,(IX+3)        	;// HL -> Sprite.Data (sprite bitmap)
		      ld  E,(IX+6)
		      ld  D,(IX+7)         	;// DE -> sprite.Position
		      ld  A,(IX+12)       	;// A: sprite height
		  put_spr_jump:
		      jp  put_spr_ldi       ;// jump to the first LDI instruction for putting a sprite row
		  put_spr_ldi:
		      repeat 64
					ldi
					repend					         	
         	ex  DE,HL
			put_spr_next_row:
         	ld  BC,20             ;// will be overwritten with the required value (SCREEN_WDITH - Sprite.Width)
         	add HL,BC
         	res 6,H               ;// if bit 6 is 1, the addressing is above 48K (over the VIDEORAM), so bit 6 is cleared. This means that HL will always be between 32K and 48K, i.e. in the VIDEORAM range.
         	ex  DE,HL            	;// DE -> new line on the screen
         	dec A                	;// decrement remaining rows from the sprite height
      put_spr_loop_end:
         	jp  nz,put_spr_ldi    ;// continue if the remaining height is not zero
					");
		end; /* Sprite.Put */
				
	
	  /**
	  Sprite kimásolás a háttér képernyőről a képernyőre.<br/>
    <br/>
    Több sprite használata esetén érdemes helyette a GE::CopyAllSpritesToScreen() eljárást használni.<br/>
    <br/>
    Példa a használatára:<br/>    
	  var<br/>
			Player : GE::Sprite;<br/>
		begin<br/>			  		  
		  Player.MoveLeft();<br/>
		  Player.Draw();<br/>
		  Player.CopyToScreen();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
	  Copy sprite from the BackScreen to the Screen
	  **/
		procedure CopyToScreen;
		begin
		  Asm("													  		
		      ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
		      ;// init copy rectangle
			    ld  A,(IX+16)     ;// A = Y
			    ld  B,(IX+18)     ;// B = LastY
			    cp  B             
			    jp  c,cTos_Y_less ;// if Y < LastY then jump
			    ;// Y >= LastY
          sub B             ;// A = Y - LastY
          add A,(IX+12)     ;// A = (Y - LastY) + Sprite.Height
          ld  IYL,A					;// IYL = (Y - LastY) + Sprite.Height -> IYL = the rectangle height in pixels
          ld  L,(IX+8)
			    ld  H,(IX+9)      ;// HL -> Sprite.LastPosition (the top-left position of the rectangle )
			    ;// check LastX
			    ld  A,(IX+17)     ;// A = LastX
			    ld  B,(IX+15)     ;// B = X
			    cp  B
			    jp  c,cTos_LastX_less
			    jp  z,cTos_LastX_equal
     			;// LastX > X
          sub B             ;// A = LastX - X
          ld  C,A           ;// C = LastX - X
          add A,(IX+11)     ;// A = (LastX - X) + Sprite.Width;
          ld  IYH,A         ;// IYH = the rectangle width in bytes
          ld  A,L						;// A = LastPosition low byte
          sub C             ;// A = LastPosition low byte - (LastX - X)
          ld  L,A					  ;// HL -> Sprite.LastPosition - (LastX - X) -> the top-left position of the rectangle
          jp  cTos_set_screen_pos
      cTos_LastX_equal:
          ld  A,(IX+11)     ;// B = Sprite.Width
          ld  IYH,A         ;// IYH = the rectangle width in bytes
          jp  cTos_set_screen_pos
      cTos_LastX_less:
          ;// LastX < X
          ld  C,A           ;// C = LastX
          ld  A,B           ;// A = X
          sub C             ;// A = X - LastX
          add A,(IX+11)     ;// A = (X - LastX) + Sprite.Width;
          ld  IYH,A         ;// IYH = the rectangle width in bytes
          jp  cTos_set_screen_pos
      cTos_Y_less:
          ;// LastY > Y (A = Y; B = LastY)
          ld  C,A						;// C = Y
          ld  A,B           ;// A = LastY
          sub C             ;// A = LastY - Y
          add A,(IX+12)     ;// A = (LastY - Y) + Sprite.Height
          ld  IYL,A					;// IYL = (LastY - Y) + Sprite.Height -> IYL = the rectangle height in pixels
          ld  L,(IX+6)
			    ld  H,(IX+7)      ;// HL -> Sprite.Position
			    ;// check X
			    ld  A,(IX+15)     ;// A = X
			    ld  B,(IX+17)     ;// B = LastX
			    cp  B
			    jp  c,cTos_X_less
			    jp  z,cTos_LastX_equal
			    ;// X >= LastX
			    sub B             ;// A = X - LastX
          ld  C,A           ;// C = X - LastX
          add A,(IX+11)     ;// A = (X - LastX) + Sprite.Width;
          ld  IYH,A         ;// IYH = the rectangle width in bytes
          ld  A,L						;// A = Sprite.Position low byte
          sub C             ;// A = Sprite.Position low byte - (X - LastX)
          ld  L,A					  ;// HL -> Sprite.Position - (X - LastX)
          jp  cTos_set_screen_pos
      cTos_X_less:
          ;// X < LastX
          ld  C,A           ;// C = X
          ld  A,B           ;// A = LastX
          sub C             ;// A = LastX - X
          add A,(IX+11)     ;// A = (X - LastX) + Sprite.Width;
          ld  IYH,A         ;// IYH = the rectangle width in bytes
			cTos_set_screen_pos:
					ld  A,H
		      sub 64						;// A = A - 64 (64*256 = 16384)
		      ld  D,A							
		      ld  E,L						;// DE = HL - 16384 -> sprite position on the screen     
          ld  A,GE_SCREEN_WIDTH
          sub IYH           ;// A = SCREEN_WIDTH - rectangle width
          ld  (copy_sprToscr_next_row+1),A ;// self-modifying code: ld C,SCREEN_WDITH - rectangle width
          ld  B,0
			    ld  A,IYL         ;// A = height
			copy_sprToscr:
					ld	C,IYH					;// BC: rectangle width in bytes
					ldir              ;// copy one sprite line to the screen
			copy_sprToscr_next_row:
					ld  C,10          ;// will be overwritten with the required value (SCREEN_WDITH - rectangle width)
					add	HL,BC					;// HL -> next line on the Back Screen
					ex	DE,HL			
					add	HL,BC
					ex	DE,HL         ;// DE -> next line on the screen
					dec A             ;// decrement remaining rows from the sprite height
					jp  nz,copy_sprToscr
					");
		end; /* Sprite.CopyToScreen */


		/**
		A sprite X, Y pozíciója alapján kiszámolja a sprite képernyőpizícióját.<br/>
    <br/>
    Több sprite használata esetén érdemesebb a GE::RenderAllSprites() eljárást használni, ami egy lépésben elvégez mindent a sprite-ok kirakásával kapcsolatban.<br/>
    <br/>
    Példa a használatára:<br/>    
	  var<br/>
			Player : GE::Sprite;<br/>
		begin<br/>			  
		  Player.Init(#SpriteBinData, 0, 0, True);<br/>
		  Player.X := 30;<br/>
		  Player.Y := 100;<br/>		  
		  Player.SetPosition();<br/>
		  Player.Draw();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Adjust the sprite's screen position using the sprite's X and Y values.<br/> 
		**/
	  procedure SetPosition();
	  begin   
	    Asm("
	        ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
	        xor A
	        ld  H,A        ;// H = 0
	        ld  L,(IX+16)  ;// HL = Sprite.Y
	        srl H
	        rr  L
	        rra
	        srl H
	        rr  L
	        rra
	        ld  H,L
	        ld  L,A        ;// HL = Y * 64
	        ld  BC,(GE_ScreenAddr) ;// BC -> screen start address
	        add HL,BC      ;// HL = screen start + (Y * 64)
	        ld  A,(IX+15)  ;// A  = Sprite.X
	        ld  B,0				
	        ld  C,A        ;// BC = X
	        add HL,BC      ;// HL -> screen start address + (Y * 64) + X
	        ld  (IX+6),L
	        ld  (IX+7),H   ;// Sprite.Position := HL
	        ");
	  end; /* Sprite.SetPosition */
		
		
		/**
		Beállítja a sprite utolsó pozícióját.<br/>
    <br/>
    A sprite X, Y és Position változóit értékül adja a LastX, LastY, és LastPosition változóknak.<br/>
    A sprite RestoreBackground() és CopyToScreen() eljárásai ezek a változók alapjn másolják vissza a sprite mögötti hátteret.<br/>
    Az alábbi esetekben érdemes használni:<br/> 
    1. Ha a sprite RestoreBackground és FastDraw/Draw/Put eljárásait használjuk a GE::RenderAllSprites() helyett.<br/>
    2. Ha a sprite CopyToScreen eljárását használjuk a GE::CopyAllSpritesToScreen() eljárás helyett.<br/>
    <br/>
    Példa a használatára:<br/>    
	  Sprite.RestoreBackground;<br/>
		Sprite.Draw;<br/>
		Sprite.UpdateLastPos;<br/>
		<br/>
		vagy<br/>
		<br/>
		Sprite.RestoreBackground;<br/>
		Sprite.SaveBackground;<br/>
		Sprite.Put;<br/>
		Sprite.UpdateLastPos;<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Updates the last position of sprite with the current position.<br/> 
		It does this:<br/>
		Sprite.LastPosition := Sprite.Position;<br/>
		Sprite.LastX := Sprite.X;<br/>
		Sprite.LastY := Sprite.Y;<br/>
		<br/>
		It should be called when:<br/> 
    1. If you render your sprites using RestoreBackground and FastDraw/Draw/Put instead of RenderAllSprites.<br/>
    2. If you copy your sprites from BackScreen to screen using CopyToScreen instead of using the CopyAllSpritesToScreen.<br/>
		<br/>
		**/
	  procedure UpdateLastPos;
	  begin
	    Asm("
	        ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
	        ld  A,(IX+6)  ;// A = Lo(Position)
	        ld  (IX+8),A  ;// Lo(LastPosition) = A
	        ld  A,(IX+7)  ;// A = Hi(Position)
	        ld  (IX+9),A  ;// Hi(LastPosition) = A
	        ld  A,[IX+15] ;// A = X
	        ld  (IX+17),A ;// LastX := X
	        ld  A,[IX+16] ;// A = Y
	        ld  (IX+18),A ;// LastY := Y
					");
	  end; /* Sprite.UpdateLastPos */
		
		
		/**
		Balra mozgatja a sprite-ot egy byte-tal.<br/>
    <br/>
    Graphics 2 módban 8, Graphics 4 módban 4, Graphics 16 módban pedig 2 pixel elmozdulást eredményez balra.<br/>
    Gyorsabb, mint az Dec(sprite.X), majd sprite.SetPosition().<br/>
    <br/>
    Példa a használatára:<br/>    
	  PlayerSprite.MoveLeft();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Moves the sprite position to LEFT by one byte.<br/> 
		Faster than SetSpritePos.<br/>
		<br/>
		Example:<br/> 
		Player.MoveLeft();<br/> 
		**/
		procedure MoveLeft();
		begin
			Asm("
					ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
					ld  L,(IX+6)
					ld  H,(IX+7)					;// HL = Sprite.Position
		     	dec HL            		;// Dec (Sprite.Position)
		     	ld  (IX+6),L
					ld  (IX+7),H					;// Sprite.Position := HL
					dec (IX+15)           ;// Dec (Sprite.X)
					");
		end;
		
		
		/**
		Jobbra mozgatja a sprite-ot egy byte-tal.<br/>
    <br/>
    Graphics 2 módban 8, Graphics 4 módban 4, Graphics 16 módban pedig 2 pixel elmozdulást eredményez jobbra.<br/>
    Gyorsabb, mint az Inc(sprite.X), majd sprite.SetPosition().<br/>
    <br/>
    Példa a használatára:<br/>    
	  PlayerSprite.MoveRight();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Moves the sprite position to RIGHT by one byte.<br/> 
		Faster than SetSpritePos.<br/>
		<br/>
		Example:<br/> 
		Player.MoveRight();<br/>
		**/
		procedure MoveRight();
		begin
			Asm("
					ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
					ld  L,(IX+6)
					ld  H,(IX+7)					;// HL = Sprite.Position
		     	inc HL            		;// Inc (Sprite.Position)
		     	ld  (IX+6),L
					ld  (IX+7),H					;// Sprite.Position := HL
					inc (IX+15)           ;// Inc (Sprite.X)
					");
		end;
		
		
		/**
		Felfelé mozgatja a sprite-ot egy pixelsorral.<br/>
    <br/>
    Gyorsabb, mint az Dec(sprite.Y), majd sprite.SetPosition().<br/>
    <br/>
    Példa a használatára:<br/>    
	  PlayerSprite.MoveUp();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Moves the sprite position UP by one line.<br/> 
		Faster than SetSpritePos.<br/>
		<br/>
		Example:<br/> 
		Player.MoveUp();<br/> 
		<br/>
		**/
		procedure MoveUp();
		begin
			Asm("
					ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
					ld  L,(IX+6)
					ld  H,(IX+7)					;// DE = Sprite.Position
					ld  BC,$FFC0          ;// BC = -SCREEN_WIDTH
					add HL,BC          		;// Sprite.Position -= SCREEN_WIDTH
					set 7,H               ;// if bit 7 is 0, the addressing is under 32K (under the VIDEORAM), so bit 7 is set. This means that HL will always over 32K, i.e. in the VIDEORAM range.
		     	ld  (IX+6),L
					ld  (IX+7),H					;// Sprite.Position := HL
					dec (IX+16)           ;// Dec (Sprite.Y)
					");
		end;
		
		
		/**
		Felfelé mozgatja a sprite-ot 2 pixelsorral.<br/>
    <br/>
    Gyorsabb, mint az sprite.Y := sprite.Y - 2, majd sprite.SetPosition().<br/>
    <br/>
    Példa a használatára:<br/>    
	  PlayerSprite.MoveUpBy2();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Moves the sprite position UP by 2 lines.<br/> 
		Faster than SetSpritePos.<br/>
		<br/>
		Example:<br/> 
		Player.MoveUpBy2();<br/> 
		<br/>
		**/
		procedure MoveUpBy2();
		begin
			Asm("
					ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
					ld  L,(IX+6)
					ld  H,(IX+7)					;// DE = Sprite.Position
					ld  BC,$FF80          ;// BC = -2*SCREEN_WIDTH
					add HL,BC          		;// Sprite.Position -= SCREEN_WIDTH
					set 7,H               ;// if bit 7 is 0, the addressing is under 32K (under the VIDEORAM), so bit 7 is set. This means that HL will always over 32K, i.e. in the VIDEORAM range.
		     	ld  (IX+6),L
					ld  (IX+7),H					;// Sprite.Position := HL
					ld   A,(IX+16)        ;// A := Sprite.Y
					sub  2                ;// A := A - 2
					ld  (IX+16),A         ;// Sprite.Y := A
					");
		end;
		
		
		/**
		Felfelé mozgatja a sprite-ot 4 pixelsorral.<br/>
    <br/>
    Gyorsabb, mint az sprite.Y := sprite.Y - 4, majd sprite.SetPosition().<br/>
    <br/>
    Példa a használatára:<br/>    
	  PlayerSprite.MoveUpBy4();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Moves the sprite position UP by 4 lines.<br/> 
		Faster than SetSpritePos.<br/>
		<br/>
		Example:<br/> 
		Player.MoveUpBy4();<br/> 
		<br/>
		**/
		procedure MoveUpBy4();
		begin
			Asm("
					ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
					dec (IX+7)						;// decrement sprite position hight byte -> pos = pos - 256 (4*SCREENWIDTH = 256)
					set 7,(IX+7)          ;// if bit 7 is 0, the addressing is under 32K (under the VIDEORAM), so bit 7 is set. This means that HL will always over 32K, i.e. in the VIDEORAM range.					
					ld   A, (IX+16)       ;// A := Sprite.Y
					sub  4                ;// A := A - 4
					ld  (IX+16),A         ;// Sprite.Y := A
					");
		end;
		
		
		/**
		Lefelé mozgatja a sprite-ot 1 pixelsorral.<br/>
    <br/>
    Gyorsabb, mint az Inc(sprite.Y), majd sprite.SetPosition().<br/>
    <br/>
    Példa a használatára:<br/>    
	  PlayerSprite.MoveDown();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Moves the sprite position DOWN by one line.<br/> 
		Faster than SetSpritePos.<br/>
		<br/>
		Example:<br/> 
		Player.MoveDown();<br/> 
		<br/>
		**/
		procedure MoveDown();
		begin
			Asm("
					ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
					ld  L,(IX+6)
					ld  H,(IX+7)					;// DE = Sprite.Position
					ld  BC,GE_SCREEN_WIDTH
					add HL,BC          		;// Sprite.Position += SCREEN_WIDTH 
					res 6,H               ;// if bit 6 is 1, the addressing is above 48K (over the VIDEORAM), so bit 6 is cleared. This means that HL will always be between 32K and 48K, i.e. in the VIDEORAM range.
		     	ld  (IX+6),L
					ld  (IX+7),H					;// Sprite.Position := HL
					inc (IX+16)           ;// Inc (Sprite.Y)
					");
		end;
		
		
		/**
		Lefelé mozgatja a sprite-ot 2 pixelsorral.<br/>
    <br/>
    Gyorsabb, mint az sprite.Y := sprite.Y + 2, majd sprite.SetPosition().<br/>
    <br/>
    Példa a használatára:<br/>    
	  PlayerSprite.MoveDownBy2();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Moves the sprite position DOWN by 2 lines.<br/> 
		Faster than SetSpritePos.<br/>
		<br/>
		Example:<br/> 
		Player.MoveDownBy2();<br/> 
		<br/>
		**/
		procedure MoveDownBy2();
		begin
			Asm("
					ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
					ld  L,(IX+6)
					ld  H,(IX+7)					;// DE = Sprite.Position
					ld  BC,128            ;// BC = 2*SCREEN_WIDTH
					add HL,BC          		;// Sprite.Position += SCREEN_WIDTH 
					res 6,H               ;// if bit 6 is 1, the addressing is above 48K (over the VIDEORAM), so bit 6 is cleared. This means that HL will always be between 32K and 48K, i.e. in the VIDEORAM range.
		     	ld  (IX+6),L
					ld  (IX+7),H					;// Sprite.Position := HL
					ld   A, (IX+16)       ;// A := Sprite.Y
					add A,2               ;// A := A + 2
					ld  (IX+16),A         ;// Sprite.Y := A
					");
		end;		
		
		
		/**
		Lefelé mozgatja a sprite-ot 4 pixelsorral.<br/>
    <br/>
    Gyorsabb, mint az sprite.Y := sprite.Y + 4, majd sprite.SetPosition().<br/>
    <br/>
    Példa a használatára:<br/>    
	  PlayerSprite.MoveDownBy4();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Moves the sprite position DOWN by 4 lines.<br/> 
		Faster than SetSpritePos.<br/>
		<br/>
		Example:<br/> 
		Player.MoveDownBy4();<br/> 
		<br/>
		**/
		procedure MoveDownBy4();
		begin
			Asm("
					ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
					inc (IX+7)						;// increment sprite position hight byte -> pos = pos + 256 (4*SCREENWIDTH = 256)
					res 6,(IX+7)          ;// if bit 6 is 1, the addressing is above 48K (over the VIDEORAM), so bit 6 is cleared. This means that HL will always be between 32K and 48K, i.e. in the VIDEORAM range.
					ld   A, (IX+16)       ;// A := Sprite.Y
					add A,4               ;// A := A + 4
					ld  (IX+16),A         ;// Sprite.Y := A
					");
		end;
		
		
		/**
		Megvizsgálja, hogy a sprite üzközött-e (átfedésben van-e) a paraméterben megadott másik sprite-tal<br/>
    <br/>
    Paramétere:<br/>
    Sprite2: a másik sprite, amivel az ütközést meg akarjuk vizgálni<br/>
    <br/>
    Példa a használatára:<br/>    
	  if (PlayerSprite.Collided(EnemySprite)) then PlayerChrashed();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Checks for the sprite collided with another sprite specified in the parameter.<br/> 
		<br/>
		Example:<br/> 
		if (PlayerSprite.Collided(EnemySprite) then PlayerChrased;<br/>
		<br/>
		**/
		function Collided(GE::Sprite2 : global pointer) : boolean;
		begin
			Asm("
					ld  IX,[GE_Sprite_this]	;// IX -> this Sprite class
					ld  IY,(GE_Sprite2)			;// IY -> Sprite2
					;// Sprite.X >= Sprite2.X + Sprite2.Width?
					ld  A,(IY+15)						;// A = Sprite2.X
					ld  E,A									;// E = Sprite2.X
					add A,(IY+11)						;// A = Sprite2.X + Sprite2.Width
					ld  C,A									;// C = Sprite2.X + Sprite2.Width
					ld  A,(IX+15)						;// A = Sprite.X
					cp  C										;// Sprite.X >= Sprite2.X + Sprite2.Width?
					jp  nc,sprite_did_not_collide
					;// Sprite.X + Sprite.Width - 1 < Sprite2.X?
					add A,(IX+11)						;// A = Sprite.X + Sprite.Width
					dec A                   ;// A = Sprite.X + Sprite.Width - 1
					cp  E										;// Sprite.X + Sprite.Width - 1 < Sprite2.X?
					jp  c,sprite_did_not_collide
					;// Sprite.Y >= Sprite2.Y + Sprite2.Height?
					ld  A,(IY+16)						;// A = Sprite2.Y
					ld  E,A									;// E = Sprite2.Y
					add A,(IY+12)						;// A = Sprite2.Y + Sprite2.Height
					ld  C,A									;// C = Sprite2.Y + Sprite2.Height
					ld  A,(IX+16)						;// A = Sprite.Y
					cp  C										;// Sprite.Y >= Sprite2.Y + Sprite2.Height?
					jp  nc,sprite_did_not_collide
					;// Sprite.Y + Sprite.Height - 1 < Sprite2.Y?
					add A,(IX+12)						;// A = Sprite.Y + Sprite.Height
					dec A                   ;// A = Sprite.Y + Sprite.Height - 1
					cp  E										;// Sprite.Y + Sprite.Height - 1 < Sprite2.Y?
					jp  c,sprite_did_not_collide
					;// Sprite collides with Sprite2
					ld  A,1									;// A := True
					ret
			sprite_did_not_collide:
					xor A										;// A := 0 (False)
					ret					
					");
		end; /* Collided */
		
		
		/**
		Megvizsgálja, hogy a sprite üzközött-e a paraméterben megadott sprite csoportból bármelyik sprite-tal.<br/>
    <br/>
    Paramétere:<br/>
    GroupNr: sprite-ok csoportjának sorszáma.<br/>
    <br/>
    Visszatérési értéke:<br/>
    Ha nem ütközött a megadott csoportból egy sprite-tal sem, akkor 0-át ad vissza<br/>
    Ha ütközött, akkor arra a sprite-ra mutató pointert ad vissza, amelyikkel az ütközés történt.<br/>
    <br/>
    Példa a használatára:<br/>    
	  var<br/> 
		const ENEMIES_GROUP : byte = 2;<br/> 		
		Enemies : array[10] of GE::Sprite;<br/> 
		EnemySprite : pointer of GE::Sprite;<br/> 
		<br/> 
		for i := 0 to 10 do Enemies[i].GroupNr := ENEMIES_GROUP;<br/> 
		EnemySprite := PlayerSprite.CollidedWith(ENEMIES_GROUP);<br/> 
		if EnemySprite <> 0 then PlayerCollided();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Checks for the sprite collided with another sprite from the specified sprites group.<br/> 
		<br/>
		**/
		function CollidedWith(GE::GroupNr : global byte) : integer;
		begin
			Asm("
			    ld  A,[GE_GroupNr]
					ld  B,A                 ;// B := GroupNr
					ld  IX,[GE_Sprite_this]	;// IX -> this Sprite class
					ld  DE,(GE_SpriteListPtr)
	    		ld  HL,GE_SpritePtr
	    		ld  (HL),E
	    		inc HL
	    		ld  (HL),D							;// SpritePtr := SpriteListPtr;
					xor A                   ;// A := 0
	    		ld  [GE_i],A            ;// i := 0
			CollidedWithLoop:
					ld  HL,[GE_SpritePtr]
					ld  E,(HL)
					inc HL
					ld  D,(HL)							;// DE -> sprite from SpriteList
					inc HL									;// HL -> next sprite from SpriteList
					ld  [GE_SpritePtr],HL		;// SpritePtr := next sprite from SpriteList
					ld  A,(DE)							;// A = Sprite.Visible
					or  A                   ;// Sprite.Visible = False? (A == 0?)
					jp  z,CollidedWithLoopNext
					push DE
					pop  IY                 ;// IY -> sprite class
					ld  A,(IY+28)           ;// A = sprite.GroupNr
					cp  B                   ;// sprite.GroupNr == GroupNr? (B: GroupNr)
					jp  nz,CollidedWithLoopNext
					;// Collision check with a sprite from the specified group. IY -> GroupSprite
					;// Sprite.X >= GroupSprite.X + GroupSprite.Width?
					ld  A,(IY+15)						;// A = GroupSprite.X
					ld  E,A									;// E = GroupSprite.X
					add A,(IY+11)						;// A = GroupSprite.X + GroupSprite.Width
					ld  C,A									;// C = GroupSprite.X + GroupSprite.Width
					ld  A,(IX+15)						;// A = Sprite.X
					cp  C										;// Sprite.X >= GroupSprite.X + GroupSprite.Width?
					jp  nc,CollidedWithLoopNext
					;// Sprite.X + Sprite.Width - 1 < GroupSprite.X?
					add A,(IX+11)						;// A = Sprite.X + Sprite.Width
					dec A                   ;// A = Sprite.X + Sprite.Width - 1
					cp  E										;// Sprite.X + Sprite.Width - 1 < GroupSprite.X?
					jp  c,CollidedWithLoopNext
					;// Sprite.Y >= GroupSprite.Y + GroupSprite.Height?
					ld  A,(IY+16)						;// A = GroupSprite.Y
					ld  E,A									;// E = GroupSprite.Y
					add A,(IY+12)						;// A = GroupSprite.Y + GroupSprite.Height
					ld  C,A									;// C = GroupSprite.Y + GroupSprite.Height
					ld  A,(IX+16)						;// A = Sprite.Y
					cp  C										;// Sprite.Y >= GroupSprite.Y + GroupSprite.Height?
					jp  nc,CollidedWithLoopNext
					;// Sprite.Y + Sprite.Height - 1 < GroupSprite.Y?
					add A,(IX+12)						;// A = Sprite.Y + Sprite.Height
					dec A                   ;// A = Sprite.Y + Sprite.Height - 1
					cp  E										;// Sprite.Y + Sprite.Height - 1 < GroupSprite.Y?
					jp  nc,CollidedWithGroupSprite
			CollidedWithLoopNext:
					ld  A,[GE_SpriteCount]
					ld  HL,GE_i
					inc (HL)                ;// Inc (i)
					cp  (HL)                ;// i = SpriteCount?
					jp  nz,CollidedWithLoop					
					;// the sprite did not collided
					ld 	HL,0								;// the result in HL. HL -> 0 (the sprite did not collided)
					ret
			CollidedWithGroupSprite:
			    push IY
			    pop  HL 								;// the result in HL. HL -> the sprite it collided with
					ret					
					");
		end; /* CollidedWith */
		
		/**
		Sprite animáció inicializálása<br/>
    <br/>
    Paraméterek:<br/>
    <ul>
			<li>AnimPhaseCount: az animációs fázisok száma</li>
			<li>AnimDelay: hányadik animálásra lépjen a következő animációs fázisba (animáció lassítása)</li>
		</ul>
  	<br/>
  	Példa a használatára:<br/>
  	// 6 animációs fázis, minden amimálásra új animációs fázist rakjon ki:<br/>
  	PlayerSprite.InitAnimation(6, 1);<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Initalization of the sprite animation<br/>
		Params:
		<ul>
			<li>AnimPhaseCount: number of the animation phases</li>
			<li>AnimDelay: the number of calls of the Animation procedure when the sprite moves to the next animation phase</li>
		</ul>
  	<br/>
  	Example:<br/>
  	PlayerSprite.InitAnimation(6, 1);<br/>
		**/
		procedure InitAnimation(GE::AnimPhaseCount, GE::AnimDelay : global byte);
		begin
			Asm("
			    ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
				  ld  L,(IX+2)
				  ld  H,(IX+3)            ;// HL -> this.Data
				  ld  (IX+20),L
				  ld  (IX+21),H           ;// this.AnimSet = this.Data
				  ld  (IX+22),0           ;// this.AnimType = 0 (default)
				  ld  A,[GE_AnimPhaseCount]
				  ld  (IX+23),A           ;// this.AnimPhaseCount = AnimPhaseCount
				  ld  (IX+24),A           ;// this.AnimPhaseNr = AnimPhaseCount
				  ld  A,[GE_AnimDelay]
				  ld  (IX+25),A           ;// this.AnimDelayValue = AnimDelay
				  ld  (IX+26),A           ;// this.AnimDelay = AnimDelay
					");
		end; /* InitAnimation */
		
		
		/**
		Sprite animáció<br/>
    <br/>
    A sprite következő animációs fázisát állítja be. Az utolsó animációs fázis után ismét az elsőt állítja be.<br/>
  	<br/>
  	Példa a használatára:<br/>
  	PlayerSprite.Animation();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Sets the next phase of the sprite animation.<br/>
    The animation is set to the beginning if it has reached the end.<br/>
    <br/>
		Example:<br/> 
		PlayerSprite.Animation();<br/> 
		<br/>
		**/
		procedure Animation();
		begin
			Asm("
			    ld  IX,[GE_Sprite_this]	;// IX -> Sprite class
				  dec (IX+26)             ;// Dec(this.AnimDelay)
			    ret nz                  ;// if this.AnimDelay > 0 then return to the caller
			    ld  A,(IX+25)           ;// A = this.AnimDelayValue
			    ld  (IX+26),A           ;// this.AnimDelay = this.AnimDelayValue
			    dec (IX+24)             ;// Dec(this.AnimPhaseNr)
			    jp  z,reset_spr_anim    ;// if this.AnimPhaseNr == 0 then jump to reset
			    ld  C,(IX+13)
			    ld  B,(IX+14)           ;// BC = this.Size
			    ld  L,(IX+2)
			    ld  H,(IX+3)            ;// HL = this.Data (sprite + mask)
			    add HL,BC               ;// HL -> the next anim sprite without mask
			    ld  A,(IX+1)            ;// A = this.SpriteType
			    sub 1
			    jp  z,save_spr_anim_phase
			    add HL,BC               ;// HL -> the next anim sprite with mask
			save_spr_anim_phase:
			    ld  (IX+2),L
			    ld  (IX+3),H            ;// this.Data = the next anim sprite
			    ret                     ;// return to the caller
			reset_spr_anim:
			    ld  L,(IX+20)
			    ld  H,(IX+21)           ;// HL = this.AnimSet (the first sprite of the animation)
			    ld  (IX+2),L
			    ld  (IX+3),H            ;// this.Data = the first anim sprite
			    ld  A,(IX+23)           ;// this.AnimPhaseCount
			    ld  (IX+24),A           ;// this.AnimPhaseNr = this.AnimPhaseCount
					");
		end; /* Animation */
		
	end; /* Sprite class */
	
	
	/*===============================================
              I M A G E   C L A S S
	===============================================*/	
	Image 								= class
		Bitmap     					: pointer;	// 0-1 	- image bitmap in TVC format
		Position						: integer;	// 2-3	- position on the screen or back-buffer
		Width               : byte;			// 4   	- width in bytes
		Height              : byte;			// 5	  - height in pixels
		Size                : integer;	// 6-7 	- image size in bytes = Width * Height - for internal use!
		X										: byte;			// 8 		- horizontal position (0-63)
		Y										: byte;			// 9    - vertical position (0-239)
		ToNextRow        	  : byte;			// 10   - SCREEN_WIDTH - Width (64 - Width) - for internal use!
		
	  
	  /**
	  Image inicializálása<br/> 
		<br/>
		Paraméterek:
		<ul>
		  <li>ImagePtr: az image bitmap memóriacíme</li>
		  <li>Width: 		az image szélessége byte-okban (1-64)</li>
		  <li>Height: 	image magassága pixelekben (1-255)</li>
		</ul>
  	<br/>
		Példa a használatára:<br/>
		var<br/>
		  TitleBitmap : incbin("images/TestImage.bin");<br/>
			TileImage : GE::image;<br/>
		begin<br/>			  
		  TileImage.Init(#TitleBitmap, 4, 20);<br/>
		  TileImage.X := 10;<br/>
		  TileImage.Y := 0;<br/>		  
		  TileImage.Put();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Image initialization<br/> 
		<br/>
		Params:
		<ul>
		  <li>ImagePtr: address of the image bitmap</li>
		  <li>Width: 		image width in bytes (1-64)</li>
		  <li>Height: 	image height in pixels (1-255)</li>
		</ul>
		**/
		procedure Init(GE::ImagePtr : global pointer; GE::Width, GE::Height : global byte);
		begin
			this.Bitmap := GE::ImagePtr;
			this.Width  := GE::Width;
			this.Height := GE::Height;
			Asm("			   
			    ;// calc Size -> this.Size := Width * Height;
					ld  IX,[GE_Image_this]			;// IX -> Image class
					ld  D,0
					ld  E,(IX+5)								;// DE: Image.Height
					ld  HL,0
					ld  B,(IX+4)								;// B: Image.Width
			calc_img_size:
			    add HL,DE               		;// HL += Image.Height
			    djnz calc_img_size
			    ld  (IX+6),L
			    ld  (IX+7),H								;// Image.Size = HL
			    ;// calc ToNextRow -> this.ToNextRow := SCREEN_WIDTH - this.Width;
			    ld  A,GE_SCREEN_WIDTH   		;// A: SCREEN_WIDTH
			    sub (IX+4)               		;// A = SCREEN_WIDTH - Image.Width
			    ld  (IX+10),A			      		;// Image.ToNextRow := SCREEN_WIDTH - Image.Width;
					");
		end; /* Image.Init */
			
		
		/**
		Image kirakása a képernyőre<br/> 
		<br/>
		Példa a használatára:<br/>
		var<br/>
		  TitleBitmap : incbin("images/TestImage.bin");<br/>
			TileImage : GE::image;<br/>
		begin<br/>			  
		  TileImage.Init(#TitleBitmap, 4, 20);<br/>
		  TileImage.X := 10;<br/>
		  TileImage.Y := 0;<br/>		  
		  TileImage.Put();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Put image to screen<br/> 
		It can also be used for vertical hardware scroll.<br/>
		**/
		procedure Put;
		begin
		  Asm("
		      ;// calc image positon on the screen
		      ld  IX,[GE_Image_this];// IX -> Image class			   		      
					Xor A               	;// A = 0
					ld  H,A								;// H = 0
					ld  L,(IX+9)					;// HL = Image.Y
  				srl H
  				rr  L
  				rra
  				srl H
  				rr  L
  				rra
  				ld  H,L
  				ld  L,A           		;// HL = Image.Y * 64
					ld 	BC,(GE_ScreenAddr);// BC -> screen start address
					add HL,BC							;// HL = ScreenAddr + (Image.Y * 64)
					ld 	B,0				
					ld 	C,(IX+8) 					;// BC = Image.X
					add HL,BC							;// HL -> ScreenAddr + (Image.Y * 64) + Image.X
					ld  (IX+2),L
					ld  (IX+3),H					;// Image.Position := HL
          ex  DE,HL         		;// DE = Image.Position
          ;// set width depended jumps
          ld  A,(IX+10)         ;// A = SCREEN_WDITH - Image.Width (value for new row)
		      ld  (put_img_next_row+1),A ;// self-modifying code: ld BC,20 -> ld BC,SCREEN_WDITH-Sprite.Width
		      add A,A               ;// A = 2*(SCREEN_WDITH-Image.Width)
					ld  C,A	              ;// BC = 2*(SCREEN_WIDTH-Image.Width)
					ld  HL,put_img_ldi    ;// HL -> put_img_ldi
					add HL,BC							;// HL -> put_img_ldi + 2*(SCREEN_WIDTH-Image.Width) => for jump out (SCREEN_WIDTH-Image.Width) x LDI instruction
		      ld  (put_img_jump+1),HL     ;// self-modifying code: overwrite address of jp put_img_ldi
		  		ld  (put_img_loop_end+1),HL	;// self-modifying code: overwrite address of jp nz,put_img_ldi
		  		;// init image bitmap and image height
		      ld  L,(IX+0)
		      ld  H,(IX+1)				  ;// HL -> Bitmap		      
		      ld  A,(IX+5)          ;// A: Image.Height
		      ;// put image
		  put_img_jump:
		      jp  put_img_ldi       ;// jump to the first LDI instruction for putting an image row (the memory address is modified during preparation)
		  put_img_ldi:
		      repeat 64
					ldi
					repend
         	ex  DE,HL
			put_img_next_row:
         	ld  BC,20             ;// will be overwritten with the required value (SCREEN_WDITH-Image.Width)
         	add HL,BC
         	res 6,H             	;// if bit 6 is 1, the addressing is above 48K (over the VIDEORAM), so bit 6 is cleared. This means that HL will always be between 32K and 48K, i.e. in the VIDEORAM range.
         	ex  DE,HL            	;// DE -> new line on the screen
         	dec A                	;// decrement remaining rows from the image height
      put_img_loop_end:
         	jp  nz,put_img_ldi    ;// continue if the remaining height is not zero (the memory address is modified during preparation)
					");
		end; /* Image.Put */
		
		
		/**
		Image kirakása a képernyőre a megadott képernyőpozícióba<br/> 
		<br/>
		Példa a használatára:<br/>
		var<br/>
		  TitleBitmap : incbin("images/TestImage.bin");<br/>
			TileImage : GE::image;<br/>
		begin<br/>			  
		  TileImage.Init(#TitleBitmap, 4, 20);<br/>
		  TileImage.X := 10;<br/>
		  TileImage.Y := 0;<br/>	
			TileImage.SetPosition();<br/>	  
		  TileImage.Put();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Put image to screen at the position specified by the Position variable<br/> 
		It can also be used for vertical hardware scroll.<br/>
		**/
		procedure PutToPos;
		begin
		  Asm("
		      ;// calc image positon on the screen
		      ld  IX,[GE_Image_this];// IX -> Image class					
					ld  E,(IX+2)
					ld  D,(IX+3)					;// DE = Image.Position
          ;// set width depended jumps
          ld  A,(IX+10)         ;// A = SCREEN_WDITH - Image.Width (value for new row)
		      ld  (put_to_pos_next_row+1),A ;// self-modifying code: ld BC,20 -> ld BC,SCREEN_WDITH-Sprite.Width
		      add A,A               ;// A = 2*(SCREEN_WDITH-Image.Width)
		      ld  B,0
					ld  C,A	              ;// BC = 2*(SCREEN_WIDTH-Image.Width)
					ld  HL,put_to_pos_ldi	;// HL -> put_img_ldi
					add HL,BC							;// HL -> put_img_ldi + 2*(SCREEN_WIDTH-Image.Width) => for jump out (SCREEN_WIDTH-Image.Width) x LDI instruction
		      ld  (put_to_pos_jump+1),HL     	;// self-modifying code: overwrite address of jp put_img_ldi
		  		ld  (put_to_pos_loop_end+1),HL	;// self-modifying code: overwrite address of jp nz,put_img_ldi
		  		;// init image bitmap and image height
		      ld  L,(IX+0)
		      ld  H,(IX+1)				  ;// HL -> Bitmap		      
		      ld  A,(IX+5)          ;// A: Image.Height
		      ;// put image
		  put_to_pos_jump:
		      jp  put_to_pos_ldi		;// jump to the first LDI instruction for putting an image row (the memory address is modified during preparation)
		  put_to_pos_ldi:
		      repeat 64
					ldi
					repend
         	ex  DE,HL
			put_to_pos_next_row:
         	ld  BC,20             ;// will be overwritten with the required value (SCREEN_WDITH-Image.Width)
         	add HL,BC
         	res 6,H             	;// if bit 6 is 1, the addressing is above 48K (over the VIDEORAM), so bit 6 is cleared. This means that HL will always be between 32K and 48K, i.e. in the VIDEORAM range.
         	ex  DE,HL            	;// DE -> new line on the screen
         	dec A                	;// decrement remaining rows from the image height
      put_to_pos_loop_end:
         	jp  nz,put_to_pos_ldi ;// continue if the remaining height is not zero (the memory address is modified during preparation)
					");
		end; /* Image.PutToPos */
		
		
		/**
		Image képernyőpozíciójának kiszámolása az X, Y változóiból<br/> 
		<br/>
		Példa a használatára:<br/>
		  TileImage.X := 10;<br/>
		  TileImage.Y := 0;<br/>	
			TileImage.SetPosition();<br/>	  
		  TileImage.Put();<br/>
    <br/>
		<br/>
		ENGLISH:<br/>
		-------------<br/>
		Adjust the image's screen position using the image's X and Y values.<br/> 
		**/
	  procedure SetPosition();
	  begin   
	    Asm("
	        ld  IX,[GE_Image_this]	;// IX -> Image class
	        xor A
	        ld  B,A        ;// B = 0
	        ld  H,A        ;// H = 0
	        ld  L,(IX+9)   ;// HL = Y
	        srl H
	        rr  L
	        rra
	        srl H
	        rr  L
	        rra
	        ld  H,L
	        ld  L,A        ;// HL = Y*64
	        ld  A,(IX+8)   ;// A  = X
	        ld  C,A        ;// BC = X
	        add HL,BC      ;// HL = (Y*64)+X
	        ld  BC,(GE_ScreenAddr) ;// BC -> screen start address
	        add HL,BC      ;// HL = screen start address + (Y*64)+X
	        ld  (IX+2),L
	        ld  (IX+3),H   ;// Position := HL
	        ");
	  end; /* Image.SetPosition */
		
		
		/**
		Moves the image position to LEFT by one byte.<br/>
		<br/>
		Example:<br/> 
		Title.MoveLeft();<br/> 
		<br/>
		**/
		procedure MoveLeft();
		begin
			Asm("
					ld  IX,[GE_Image_this]	;// IX -> Image class
					ld  L,(IX+2)
					ld  H,(IX+3)						;// HL = Position
		     	dec HL            			;// Dec (Position)
		     	ld  (IX+2),L
					ld  (IX+3),H						;// Sprite.Position := HL
					dec (IX+8)            	;// Dec (X)
					");
		end;
		
		
		/**
		Moves the image position to RIGHT by one byte.<br/> 
		<br/>
		Example:<br/> 
		Title.MoveRight();<br/> 
		<br/>
		**/
		procedure MoveRight();
		begin
			Asm("
					ld  IX,[GE_Image_this]	;// IX -> Image class
					ld  L,(IX+2)
					ld  H,(IX+3)						;// HL = Position
		     	inc HL            			;// Inc (Position)
		     	ld  (IX+2),L
					ld  (IX+3),H						;// Position := HL
					inc (IX+8)            	;// Inc (X)
					");
		end;
		
		
		/**
		Moves the image position UP by one line.<br/> 
		<br/>
		Example:<br/> 
		Title.MoveUp();<br/> 
		<br/>
		**/
		procedure MoveUp();
		begin
			Asm("
					ld  IX,[GE_Image_this]	;// IX -> Image class
					ld  L,(IX+2)
					ld  H,(IX+3)						;// DE = Position
					ld  BC,$FFC0          	;// BC = -SCREEN_WIDTH
					add HL,BC          			;// Position -= SCREEN_WIDTH
					set 7,H               	;// if bit 7 is 0, the addressing is under 32K (under the VIDEORAM), so bit 7 is set. This means that HL will always over 32K, i.e. in the VIDEORAM range.
		     	ld  (IX+2),L
					ld  (IX+3),H						;// Position := HL
					dec (IX+9)           		;// Dec (Y)
					");
		end;
		
		
		/**
		Moves the image position UP by 2 lines.<br/> 
		<br/>
		Example:<br/> 
		Title.MoveUpBy2();<br/> 
		<br/>
		**/
		procedure MoveUpBy2();
		begin
			Asm("
					ld  IX,[GE_Image_this]	;// IX -> Image class
					ld  L,(IX+2)
					ld  H,(IX+3)						;// DE = Position
					ld  BC,$FF80          	;// BC = -2*SCREEN_WIDTH
					add HL,BC          			;// Position -= 2*SCREEN_WIDTH
					set 7,H               	;// if bit 7 is 0, the addressing is under 32K (under the VIDEORAM), so bit 7 is set. This means that HL will always over 32K, i.e. in the VIDEORAM range.
		     	ld  (IX+2),L
					ld  (IX+3),H						;// Position := HL
					ld   A,(IX+9)         	;// A := Y
					sub  2                	;// A := A - 2
					ld  (IX+9),A          	;// Y := A
					");
		end;
		
		
		/**
		Moves the image position UP by 4 lines.<br/> 
		<br/>
		Example:<br/> 
		Title.MoveUpBy4();<br/> 
		<br/>
		**/
		procedure MoveUpBy4();
		begin
			Asm("
					ld  IX,[GE_Image_this]	;// IX -> Image class
					dec (IX+3)							;// decrement image position hight byte -> Position = Position - 256 (4*SCREEN_WIDTH = 256)
					set 7,(IX+3)          	;// if bit 7 is 0, the addressing is under 32K (under the VIDEORAM), so bit 7 is set. This means that HL will always over 32K, i.e. in the VIDEORAM range.					
					ld   A, (IX+9)       		;// A := Y
					sub  4                	;// A := A - 4
					ld  (IX+9),A         		;// Y := A
					");
		end;
		
		/**
		Moves the image position DOWN by one line.<br/> 
		<br/>
		Example:<br/> 
		Title.MoveDown();<br/> 
		<br/>
		**/
		procedure MoveDown();
		begin
			Asm("
					ld  IX,[GE_Image_this]	;// IX -> Image class
					ld  L,(IX+2)
					ld  H,(IX+3)						;// DE = Position
					ld  BC,GE_SCREEN_WIDTH
					add HL,BC          			;// Position += SCREEN_WIDTH 
					res 6,H               	;// if bit 6 is 1, the addressing is above 48K (over the VIDEORAM), so bit 6 is cleared. This means that HL will always be between 32K and 48K, i.e. in the VIDEORAM range.
		     	ld  (IX+2),L
					ld  (IX+3),H						;// Position := HL
					inc (IX+9)           		;// Inc (Y)
					");
		end;
		
		
		/**
		Moves the image position DOWN by 2 lines.<br/> 
		<br/>
		Example:<br/> 
		Title.MoveDownBy2();<br/> 
		<br/>
		**/
		procedure MoveDownBy2();
		begin
			Asm("
					ld  IX,[GE_Image_this]	;// IX -> Image class
					ld  L,(IX+2)
					ld  H,(IX+3)						;// DE = Position
					ld  BC,128            	;// BC = 2*SCREEN_WIDTH
					add HL,BC          			;// Position += 2*SCREEN_WIDTH 
					res 6,H               	;// if bit 6 is 1, the addressing is above 48K (over the VIDEORAM), so bit 6 is cleared. This means that HL will always be between 32K and 48K, i.e. in the VIDEORAM range.
		     	ld  (IX+2),L
					ld  (IX+3),H						;// Position := HL
					ld   A, (IX+9)       		;// A := Y
					add A,2               	;// A := A + 2
					ld  (IX+9),A         		;// Y := A
					");
		end;		
		
		
		/**
		Moves the image position DOWN by 4 lines.<br/> 
		<br/>
		Example:<br/> 
		Title.MoveDownBy4();<br/> 
		<br/>
		**/
		procedure MoveDownBy4();
		begin
			Asm("
					ld  IX,[GE_Image_this]	;// IX -> Image class
					inc (IX+3)							;// increment image position hight byte -> Position = Position + 256 (4*SCREENWIDTH = 256)
					res 6,(IX+3)          	;// if bit 6 is 1, the addressing is above 48K (over the VIDEORAM), so bit 6 is cleared. This means that HL will always be between 32K and 48K, i.e. in the VIDEORAM range.
					ld  A, (IX+9)       		;// A := Y
					add A,4               	;// A := A + 4
					ld  (IX+9),A         		;// Y := A
					");
		end;
		
	end; /* Image class */
	
	
/*===============================================
              L I S T   C L A S S
              
  This object class is used to create a list of 
  pointers. A List can have up to 20 elements.
  The elements of List can be the addresses of 
  any variables, class or memory areas.

  For example, a List can be a list of sprites 
  passed as a parameter to a sprite function, 
  such as Sprite.CollidedWith(EnemiesList);
  
  Example:
  
  var
	  PlayerSprite	: GE::Sprite;
	  EnemySprite1	: GE::Sprite;
	  EnemySprite2  : GE::Sprite;
	  EnemySprite3  : GE::Sprite;
	  EmemyList 		: GE::List;
	  
	procedure Init();
	begin
		PlayerSprite.Init(#PlayerSpriteBin,30, 200, True);
		EnemySprite1.Init(#EnemySpriteBin,  0,  50, True);
		EnemySprite2.Init(#EnemySpriteBin, 30,  50, True);
		EnemySprite3.Init(#EnemySpriteBin, 60,  50, True);
		EmemyList.Init();
		EmemyList.Add(Enemy1);
		EmemyList.Add(Enemy2);
		EmemyList.Add(Enemy3);
	end;
	
	procedure CollisionCheck();
	var
		enemySprite : GE::Sprite;
	begin
    enemySprite := PlayerSprite.CollidedWith(EnemyList);
	  if enemySprite > 0 then
	  begin
		  // The player collided with an enemy.
	  end;
	end;
	  
===============================================*/	

	List						= class
		MemAddr 			: integer;	// 0-1: the memory address of List (The 1st byte is the count of items, followed by the memory addresses of the list's items.)
		NextItemAddr	: integer;	// 2-3: the memory address of the next item in the list
		
	  
		procedure Init();
		begin
			Asm("
					ld  IX,[GE_List_this]	;// IX -> this List class					
					ld  HL,(GE_ListsPtr)	;// HL = ListsPtr
					ld  (IX+0),L
					ld  (IX+1),H					;// List.MemAddr := ListsPtr
					ld  (HL),0						;// List.Count = 0
					inc HL								;// HL = List.MemAddr + 1
					ld  (IX+2),L
					ld  (IX+3),H					;// List.NextItemAddr := List.MemAddr + 1					
			    ld  BC,40							;// 40 = (size of a list)-1 -> 1st byte for the Count + 20x2 bytes for the 20 items
			    add HL,BC							;// HL = ListsPtr + 41
			    ld  (GE_ListsPtr),HL	;// ListsPtr := ListsPtr + 41
					");			
		end; /* List.Init */	
		
		
		procedure Add(ItemAddr : global integer);
		begin
			Asm("
					ld  IX,[GE_List_this]	;// IX -> this List class
					ld  L,(IX+0)
					ld  H,(IX+1)					;// HL -> List.MemAddr
					inc (HL)							;// Inc(List.Count)
					ld  L,(IX+2)
					ld  H,(IX+3)					;// HL -> List.NextItemAddr
					ld  DE,[GE_ItemAddr]	;// DE = ItemAddr
					ld  (HL),E
					inc HL
					ld  (HL),D						;// ItemAddr put to NextItemAddr
					inc HL
					ld  (IX+2),L
					ld  (IX+3),H					;// List.NextItemAddr = HL
					");
		end; /* List.Add */		
		
		
		function Count : byte;
		begin
			Asm("
					ld  IX,[GE_List_this]	;// IX -> this List class
					ld  L,(IX+0)
					ld  H,(IX+1)					;// HL -> List.MemAddr
					ld  A,(HL)  					;// A = 1st byte, which is the count of the items
					");
		end; /* List.Count */
	
	
	  /*
	  Returns the Nr-th item from the list.
	  The List is zero-based - the 0-th is the first element.
	  Params:
      Nr: 0-19
	  Exemple:
	    EnemySprite := EnemyList.Get(2);
	  */
		function Get(Nr : global byte) : integer;
		begin
			Asm("
					ld  IX,[GE_List_this]	;// IX -> this List class
					ld  L,(IX+0)
					ld  H,(IX+1)					;// HL -> List.MemAddr
					ld  A,(HL)						;// A = count of items
					ld  C,A								;// C = count of items
					inc HL								;// HL -> 1st item
					ld  A,[GE_Nr]					;// A = Nr
					cp  C									;// Nr >= Count?
					jp  nc,list_get_result;// if Nr >= Count then return with the item 0
					or  A									;// A == 0?
					jp  z,list_get_result	;// if Nr == 0 then return with the item 0
					add A,A								;// A = 2*Nr
					ld  B,0
					ld  C,A								;// BC = 2*Nr
					add HL,BC							;// HL -> item Nr
			list_get_result:
					ret										;// return with HL
					");
		end; /* List.Count */
	
	
		procedure Clear();
		begin
			Asm("
					ld  IX,[GE_List_this]	;// IX -> this List class
					ld  L,(IX+0)
					ld  H,(IX+1)					;// HL -> List.MemAddr
					ld  (HL),0						;// List.Count = 0
					");
		end; /* List.Clear */
				
	end; /* List class */

	
/*================================================
          M E M O R Y   M A P P I N G 
          
  TV-Computer has 32 KB or 64 KB RAM models
  and 16 KB VIDEO RAM (or 4x16 KB on 64k+ model)
	and with 20 KB ROM, of which 16 KB can be mapped.
  4x16 KB memory pages can be used and addressed at
  the same time.
  
	U0, U1, U2, U3 - user RAM (4 x 16 KB)
	VID  - video RAM (16 KB)
	SYS  - system ROM (16 KB)
	CART - external cartridge (max. 16 KB)
	EXT  - memory on external card (max. 16 KB)
=================================================*/

/**
Memória lapozás beállítása<br/>
<br/>
Paraméterek:
<ul>
<li>MEM_DEFAULT : U0, U1, U2,  SYS</li>
<li>MEM_VID_ON  : U0, U1, VID, SYS</li>
<li>MEM_FULL_64K: U0, U1, U2,  U3</li>
<li>MEM_48K_VID : U0, U1, VID, U3</li>
<li>vagy bármilyen egyéb numerikus érték (0-255), amiket például az Operációs Rendszer könyvből ki lehet nézni.</li>
</ul>
<br/>
A memória 16 kbyte-os  lapokból áll. Ezek jelölése:<br/>
U0,U1,U2,U3: felhasználói memória (RAM); VID: VIDEORAM; SYS: sysem ROM<br/>
<br/>
Például a VIDEORAM belapozása:<br/>
GE::SetMemory(GE::MEM_VID_ON);<br/>
<br/>
vagy a teljes 64k RAM belapozása:<br/>
GE::SetMemory(GE::MEM_FULL_64K);<br/>
<br/>
vagy 48k RAM + VIDEORAM belapozása (U0,U1,VID,U3):<br/>
GE::SetMemory(GE::MEM_48K_VID);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Set memory mapping<br/>
Params:
<ul>
<li>MEM_DEFAULT : U0, U1, U2,  SYS</li>
<li>MEM_VID_ON  : U0, U1, VID, SYS</li>
<li>MEM_FULL_64K: U0, U1, U2,  U3</li>
<li>MEM_48K_VID : U0, U1, VID, U3</li>
<li>or any other value</li>
</ul>
<br/>
16K pages:<br/>
U0-U3: user memory; VID: video RAM; SYS: sysem ROM<br/>
<br/>
Example: GE::SetMemory(GE::MEM_VID_ON);<br/>
<br/>
**/
procedure SetMemory(Mode : global byte);
begin
	Asm("
	    ld  A,[GE_Mode]
			ld  ($3),A
			out ($2),A
	    ");
end; /* SetMemory */


/*===============================================
   Enable / Disable the TVC Interrupt Handler
===============================================*/

/**
A TV-Computer rendszer megszakítás-kezelő engedélyezése<br/>
Más szavakkal: visszaállítja a TVC eredeti megszakítás-kezelőjét a Game Engine megszakítás-kezelőjéről.<br/>
<br/>
A GE::Init eljárás átírányítja a megszakítás-kezelőt egy saját megoldásra, ami nem vesz el extra időt a program futásától, ezzel gyakorlatilag letiltva a rendszer megszakítás-kezelőt. Ezért például a billentyűzet mátrix sem lesz automatikusan feltöltve.<br/>
<br/>
Ha a program futásához szükség van az eredeti megszakítás-kezelő működésére, akkor érdemes meghívni ezt az eljárást.<br/>
Ha már nincs szükség rá, akkor a GE::DisableTVCITHandler() eljárással visszaállítható a Game Engine saját megszakítás-kezelőjének működése, ami gyorsabb működést eredményez.<br/>
<br/>
Példa a használatra:<br/>
GE::EnableTVCITHandler();
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Enable the TV-Computer's Interrupt Handler<br/>
(Recovery of the original Interrupt Handler)<br/>
<br/>
The Game Engine Init procedure disables the TV-Computer's Interrupt Handler.<br/>
<br/>
You must call this procedure if you want to perform some file operation after Game Engin's Init or need any of the functions performed by the original Interrupt Handler.
**/
procedure EnableTVCITHandler;
begin
	Asm("
			di							;// disable interruptsű
			;// Recovery of the first 3 bytes of the original Interrupt Handler
			ld	HL,$38			;// HL -> start address of System Interrupt Handler
			ld	(HL),$F5		;// $F5: PUSH AF
			inc	HL
			ld	(HL),$3E
			inc	HL
			ld	(HL),$70		;// $3E $70: LD A,$70
			ei							;// enable interrupts
			");
end; /* EnableTVCITHandler */


/**
A TV-Computer rendszer megszakítás-kezelő letiltása<br/>
Más szavakkal: beállítja a Game Engine saját megszakítás-kezelőjét a TVC eredeti megszakítás-kezelője helyett.<br/>
<br/>
A GE::Init() eljárás automatikusan meghívja ezt az eljárást, mert a rendszer megszakítás-kezelő sok olyan műveletet végez, ami csak lassítja a programot, de egy játékhoz általában nincs szükség ezekre.<br/>
A Game Engine megszakítás-kezelője nem tölti fel a billentyűzet mátrixot, ezért ilyenkor minden billentyűzet lekérdezés előtt meg kell hívni a GE:Getkeyboard() eljárást.<br/>
<br/>
Ha a program futásához mégis szükség lenne az eredeti megszakítás-kezelő működésére, akkor az a GE::EnableTVCITHandler() eljárással visszaállítható.<br/>
<br/>
Példa a használatra:<br/>
GE::DisableTVCITHandler();
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Disable the TV-Computer's Interrupt Handler<br/>
<br/>
The Game Engine's Init calls this procedure.<br/>
This procedure redirects the Interrupt Handler to the Game Engine's minimal functionality interrupt handler.<br/>
<br/>
You can save CPU time with this. You can save up to 1-2 sprites drawing time every screen refresh by disabling the TV-Computer's interrupt handler.
**/
procedure DisableTVCITHandler;
begin
	Asm("
			di										;// disable interruptsű
			ld	HL,$38						;// HL -> start address of System Interrupt Handler
			;// Overwrite the first 3 bytes of the TVC Interrupt Handler
			;// to redirect it to its own interrupt handler
			ld	(HL),195					;// 195: JP
			ld  DE,GE_IT_HANLDER
			inc	HL
			ld	(HL),E
			inc	HL
			ld	(HL),D 						;// $38: JP IT_HANLDER
			ei			
	    ret
	    ;// The Game Engine minimal Interrupt Handler
	GE_IT_HANLDER:
			out	($7),A	          ;// reset interrupt
			ei              			;// enable interrupts
			ret
			");
end; /* DisableTVCITHandler */
 
  
/*===============================================
                  I N I T                           
===============================================*/

/**
A Game Engine inicializálása<br/>
<br/>
Minden sprite inicializálást és képernyőre történő műveletet meg kell, hogy előzzön.
<br/>
Paraméter:<br/>
<ul>
<li>USE_BACK_SCREEN  - háttér képernyő használata (64k memória szükséges hozzá)</li>
<li>DIRECT_TO_SCREEN - direkt a képernyő használata</li>
</ul>
Háttér képernyő használata esetén a legfelső 16k memórialapot (U3) használja a Game Engine, mint egy másolataként az eredeti képernyőnek. Minden sprite- és image kirakás, és bármilyen képernyőre rajzoló, író művelet a háttér képernyőre fog írni. A háttér képernyőről (Backscreen) külön utasításokkal (sprite.CopyToScreen, GE::CopyBackScreenRectToScreen, GE::CopyBackScreenToSceen) másolhatóak ki ezek a tartalmak a valódi képernyőre.<br/>
<br/>
Példa a használatra:<br/>
GE::Init(GE::DIRECT_TO_SCREEN);<br/>
vagy háttér képernyő használata esetén:<br/>
GE::Init(GE::USE_BACK_SCREEN);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Init game engine<br/>
Param:<br/>
<ul>
<li>USE_BACK_SCREEN - drawing to the back-screen on memory Page 3 (64K memory required)</li>
<li>DIRECT_TO_SCREEN - drawing to the screen</li>
</ul>
<br/>
Example: GE::Init(GE::DIRECT_TO_SCREEN);<br/>
<br/>
**/
procedure Init(UseBackScreen : global boolean);
begin
	Asm("	
	    ;// init ScreenAddr
	    ld  HL,GE_SCREEN_ADDR
      ld  A,[GE_UseBackScreen]
      or  A
      jr  z,set_screen_addr      
      ;// set memory mapping to U0, U1, U2, U3
      ld  A,$B0
			ld  ($3),A
			out ($2),A
      ld  HL,GE_BACK_SCREEN_ADDR
      ;// set ScreenAddr
  set_screen_addr:
      ld (GE_ScreenAddr),HL
			");	
	DisableTVCITHandler;
	Asm("
	    ret
	    ");
	// So that the optimizer keeps the SetPosition procedure for the Init method of the Sprite class.
	call(GE_Sprite_SetPosition);
end; /* Init */


/*===============================================
               S P R I T E S
===============================================*/


/**
Minden sprite kirakása a képernyőre<br/>
Az összes sprite.Init aljárással inicializált sprite-ot kirakja a képernyőre az inicialilás sorrendjében.<br/>
<br/>
Az alábbi műveleteket végzi el:<br/>
<ul>
<li>Visszamásolja az összes olyan sprite hátterét, aminél beállításra került, hogy mentse a hátterét.</li>
<li>Kirajzolja az összes sprite-ot. Amelyik sprite-nak el kell menteni a hátterét, azoknál előtte elmenti azt.</li>
</ul>
<br/>
Példa a használatára:<br/> 
GE::WaitForSync();<br/> 
GE::RenderAllSprites();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Render all sprites<br/>
1. Restore all sprites' background<br/>
2. Draws all sprites and saves sprite backgrounds<br/>
<br/>
Example: GE::RenderAllSprites;<br/>
<br/>
**/
procedure RenderAllSprites;
begin	
	Asm("
	    ld  A,(GE_SpriteCount)
	    or  A                   ;// SpriteCount == 0?
	    ret Z                   ;// if yes then return to caller
	    ld  A,($3)
	    ld  (GE_Mode),A		      ;// save current memory mapping
	    ld  A,$90								;// set memory mapping to U0, U1, VID, U3
			ld  ($3),A							;// set value to the system variable
			out ($2),A							;// send value to the memory pages port
			;// Restore all sprites' background	
	    ld  DE,(GE_LastSpritePtr)
	    ld  HL,GE_SpritePtr
	    ld  (HL),E
	    inc HL
	    ld  (HL),D							;// SpritePtr := LastSpritePtr;
	    xor A                   ;// A = 0
	    ld  [GE_i],A            ;// i := 0
	restore_all_spr_loop:
			ld  HL,[GE_SpritePtr]
			ld  E,(HL)
			inc HL
			ld  D,(HL)							;// DE -> sprite class
			dec HL
			dec HL
			dec HL
			ld  [GE_SpritePtr],HL	  ;// SpritePtr := prev. sprite
			ld  [GE_Sprite_this],DE	;// init Sprite class
			ld  A,(DE)							;// A = Sprite.Visible
			or  A                   ;// Sprite.Visible = False?			
			jp  z,restore_all_spr_next
			ex  DE,HL								;// HL -> Sprite.Visible
			ld  BC,27
			add HL,BC								;// HL -> Sprite.UseBackground
			ld  A,(HL)              ;// A = Sprite.UseBackground
			or  A                   ;// Sprite.UseBackground? (A == 0?)
			call nz,GE_Sprite_RestoreBackground
	restore_all_spr_next:
			ld  A,[GE_SpriteCount]
			ld  HL,GE_i
			inc (HL)                ;// Inc (i)
			cp  (HL)                ;// i = SpriteCount?
			jp  nz,restore_all_spr_loop
			;// Draws all sprites and saves sprite backgrounds	
	    ld  DE,(GE_SpriteListPtr)
	    ld  HL,GE_SpritePtr
	    ld  (HL),E
	    inc HL
	    ld  (HL),D							;// SpritePtr := SpriteListPtr;
	    xor A                   ;// A = 0
	    ld  [GE_i],A            ;// i := 0
	render_all_spr_loop:
			ld  HL,[GE_SpritePtr]
			ld  E,(HL)
			inc HL
			ld  D,(HL)							;// DE -> sprite class
			inc HL									;// HL -> next sprite
			ld  [GE_SpritePtr],HL		;// SpritePtr := next sprite
			ld  [GE_Sprite_this],DE	;// init Sprite class
			ld  A,(DE)							;// A = Sprite.Visible
			or  A                   ;// Sprite.Visible == False?
			jp  z,render_all_spr_next
			inc DE                  ;// DE -> Sprite.SpriteType
			ld  A,(DE)              ;// A = Sprite.SpriteType
			dec A                   ;// if Sprite.SpriteType == 1 then dec A -> A = 0
			jp  z,render_all_spr_type_1;// if SpriteType = 1, this is a sprite without a mask; jump to put
			call GE_Sprite_Draw
	render_all_spr_next:
			ld  A,[GE_SpriteCount]
			ld  HL,GE_i
			inc (HL)                ;// Inc (i)
			cp  (HL)                ;// i = SpriteCount?
			jp  nz,render_all_spr_loop
			;// restore memory mapping
	    ld  A,(GE_Mode) 	  		;// last memory mapping
			ld ($3),A								;// set value to the system variable
			out ($2),A							;// send value to the memory pages port
			;// check ScreenAddr
			ld  HL,GE_ScreenAddr+1
			ld  A,(HL)		          ;// A = ScreenAddr hight byte
			cp  $80							 		;// ScreenAddr = $8000 (DIRECT_TO_SCREEN)
			ret nz									;// if not direct to screen then return
			;// Update last position of all sprites
			ld  DE,(GE_SpriteListPtr)
	    ld  HL,GE_SpritePtr
	    ld  (HL),E
	    inc HL
	    ld  (HL),D							;// SpritePtr := SpriteListPtr;
			xor A                   ;// A = 0
	    ld  [GE_i],A            ;// i := 0
	upd_all_spr_lastpos_loop:
			ld  HL,[GE_SpritePtr]
			ld  E,(HL)
			inc HL
			ld  D,(HL)							;// DE -> sprite class
			inc HL									;// HL -> next sprite
			ld  [GE_SpritePtr],HL		;// SpritePtr := next sprite
			ld  [GE_Sprite_this],DE	;// init Sprite class
			ld  A,(DE)							;// A = Sprite.Visible
			or  A                   ;// Sprite.Visible == False?
			jp  z,upd_all_spr_lastpos_next
			;// update sprites last position
			ld  IX,[GE_Sprite_this]
			ld  A,(IX+6)	;// A = Lo(Position)
			ld  (IX+8),A	;// Lo(LastPosition) = A
			ld  A,(IX+7)  ;// A = Hi(Position)
			ld  (IX+9),A  ;// Hi(LastPosition) = A
			ld  A,[IX+15] ;// A = X
			ld  (IX+17),A ;// LastX := X
			ld  A,[IX+16] ;// A = Y
			ld  (IX+18),A ;// LastY := Y
			;// loop test
	upd_all_spr_lastpos_next:			
			ld  A,[GE_SpriteCount]
			ld  HL,GE_i
			inc (HL)                ;// Inc (i)
			cp  (HL)                ;// i = SpriteCount?
			jp  nz,upd_all_spr_lastpos_loop
			ret
			;// put sprite without mask
	render_all_spr_type_1:
			ex  DE,HL								;// HL -> Sprite.SpriteType
			ld  BC,26
			add HL,BC								;// HL -> Sprite.UseBackground
			ld  A,(HL)              ;// A = Sprite.UseBackground
			or  A                   ;// Sprite.UseBackground = false? (A == 0?)
			call nz,GE_Sprite_SaveBackground ;// if the sprite used a background buffer, its background will be saved
	render_all_sprites_put:
	    ;// ld  A,GE_BORDER_RED
	    ;// out (GE_SYS_BORDER_PORT),A	
	    call GE_Sprite_Put
	    jp  render_all_spr_next	    
	    ");	    
	// so that the optimizer keeps this procedures
	call(GE_Sprite_Put);
	call(GE_Sprite_Draw);
	call(GE_Sprite_RestoreBackground);
	call(GE_Sprite_SaveBackground);
end; /* RenderAllSprites */


/**
Minden sprite kimásolása a háttérképernyőről a képernyőre<br/>
<br/>
Akkor kell használni, ha a Game Engine háttér képernyő (Backscreen) használatával lett inicializálva - GE::Init(GE::USE_BACK_SCREEN)<br/>
<br/>
Példa a használatára:<br/>
GE::RenderAllSprites();<br/>
GE::CopyAllSpritesToScreen;<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Copy all sprites from the Back Screen to the screen<br/>
<br/>
Example:<br/>
GE::RenderAllSprites();<br/>
GE::CopyAllSpritesToScreen;<br/>
<br/>
**/
procedure CopyAllSpritesToScreen;
begin
	Asm("
	    ld  A,(GE_SpriteCount)
	    or  A                   ;// SpriteCount == 0?
	    ret Z                   ;// if yes then return to caller
	    ld  DE,(GE_SpriteListPtr)
	    ld  HL,GE_SpritePtr
	    ld  (HL),E
	    inc HL
	    ld  (HL),D							;// SpritePtr := SpriteListPtr;
	    ;// set memory to: U0, U1, VID, U3
	    ld A,$90		
			ld ($3),A
			out ($2),A
			;// copy all sprites to screen
			xor A                   ;// A = 0
	    ld  [GE_i],A            ;// i := 0
	copy_all_spr_loop:
			ld  HL,[GE_SpritePtr]
			ld  E,(HL)
			inc HL
			ld  D,(HL)							;// DE -> sprite class
			inc HL									;// HL -> next sprite
			ld  [GE_SpritePtr],HL		;// SpritePtr := next sprite
			ld  [GE_Sprite_this],DE	;// init Sprite class
			ld  A,(DE)							;// A = Sprite.Visible
			or  A                   ;// Sprite.Visible = False?
			call nz,GE_Sprite_CopyToScreen ;// if Sprite.Visible then call
			;// update sprites last position
			ld  IX,[GE_Sprite_this]
			ld  A,(IX+6)	;// A = Lo(Position)
			ld  (IX+8),A	;// Lo(LastPosition) = A
			ld  A,(IX+7)  ;// A = Hi(Position)
			ld  (IX+9),A  ;// Hi(LastPosition) = A
			ld  A,[IX+15] ;// A = X
			ld  (IX+17),A ;// LastX := X
			ld  A,[IX+16] ;// A = Y
			ld  (IX+18),A ;// LastY := Y
			;// loop test
			ld  A,[GE_SpriteCount]
			ld  HL,GE_i
			inc (HL)                ;// Inc (i)
			cp  (HL)                ;// i = SpriteCount?
			jp  nz,copy_all_spr_loop
	    ;// set memory to 64k (U0, U1, U2, U3)
	    ld A,$B0		
			ld ($3),A
			out ($2),A
			ret
	    ");	
	// so that the optimizer keeps the procedure
	call(GE_Sprite_CopyToScreen); // an empty call so that the optimizer keeps the procedure
end; /* CopyAllSpritesToScreen */


/**
Minden sprite hátterének elmentése<br/>
<br/>
Például akkor érdemes használni, ha a játék kezdőképernyője már ki van rajzolva. Ekkor egy első, előkészítő háttér mentést elvégez azokon a sprite-okon, amiknél kell hátteret menteni.<br/>
<br/>
Példa a használatára:<br/>
GE::SaveAllSpritesBackground();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Saves the background of all sprites<br/>
<br/>
Example: GE::SaveAllSpritesBackground;<br/>
<br/>
**/
procedure SaveAllSpritesBackground;
begin
	Asm("
	    ld  A,(GE_SpriteCount)
	    or  A                   ;// SpriteCount == 0?
	    ret Z                   ;// if yes then return to caller
	    ld  DE,(GE_SpriteListPtr)
	    ld  HL,GE_SpritePtr
	    ld  (HL),E
	    inc HL
	    ld  (HL),D							;// SpritePtr := SpriteListPtr;
			xor A                   ;// A = 0
	    ld  [GE_i],A            ;// i := 0
	save_all_spr_bg_loop:
			ld  HL,[GE_SpritePtr]
			ld  E,(HL)
			inc HL
			ld  D,(HL)							;// DE -> sprite class
			inc HL									;// HL -> next sprite
			ld  [GE_SpritePtr],HL		;// SpritePtr := next sprite
			ld  [GE_Sprite_this],DE	;// init Sprite class
			ld  A,(DE)							;// A = Sprite.Visible
			or  A                   ;// Sprite.Visible = False?
			jp  z,save_all_spr_bg_next			
			ex  DE,HL								;// HL -> Sprite.Visible
			ld  BC,27
			add HL,BC								;// HL -> Sprite.UseBackground
			ld  A,(HL)              ;// A = Sprite.UseBackground
			or  A                   ;// Sprite.UseBackground?
			call nz,GE_Sprite_SaveBackground
			;// loop test
	save_all_spr_bg_next:		
			ld  A,[GE_SpriteCount]
			ld  HL,GE_i
			inc (HL)                ;// Inc (i)
			cp  (HL)                ;// i = SpriteCount?
			jp  nz,save_all_spr_bg_loop
			ret
	    ");
	call(GE_Sprite_SaveBackground); // an empty call so that the optimizer keeps the procedure
end; /* SaveAllSpritesBackground */


/**
Visszamásolja az összes sprite hátterét a képernyőre vagy a háttérképernyőre.<br/>
<br/>
Például akkor lehet használni, ha az összes sprite-ot szeretnénk letörölni a képernyőről a hátterük visszamásolásával, vagy ha egyesével rakjuk ki a sprite-okat, nem a GE::RendeAllSprites() eljárással.
<br/>
Példa a használatára:<br/> 
GE::RestoreAllSpritesBackground;<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Restores the background of all sprites<br/>
<br/>
Example: GE::RestoreAllSpritesBackground;<br/>
<br/>
**/
procedure RestoreAllSpritesBackground;
begin
	Asm("
	    ld  A,(GE_SpriteCount)
	    or  A                   ;// SpriteCount == 0?
	    ret Z                   ;// if yes then return to caller
	    ld  DE,(GE_SpriteListPtr)
	    ld  HL,GE_SpritePtr
	    ld  (HL),E
	    inc HL
	    ld  (HL),D							;// SpritePtr := SpriteListPtr;
			xor A                   ;// A = 0
	    ld  [GE_i],A            ;// i := 0
	restore_all_spr_bg_loop:
			ld  HL,[GE_SpritePtr]
			ld  E,(HL)
			inc HL
			ld  D,(HL)							;// DE -> sprite class
			inc HL									;// HL -> next sprite
			ld  [GE_SpritePtr],HL		;// SpritePtr := next sprite
			ld  [GE_Sprite_this],DE	;// init Sprite class
			ld  A,(DE)							;// A = Sprite.Visible
			or  A                   ;// Sprite.Visible = False?
			jp  z,restore_all_spr_bg_next			
			ex  DE,HL								;// HL -> Sprite.Visible
			ld  BC,27
			add HL,BC								;// HL -> Sprite.UseBackground
			ld  A,(HL)              ;// A = Sprite.UseBackground
			or  A                   ;// Sprite.UseBackground?
			call nz,GE_Sprite_RestoreBackground
			;// loop test
	restore_all_spr_bg_next:		
			ld  A,[GE_SpriteCount]
			ld  HL,GE_i
			inc (HL)                ;// Inc (i)
			cp  (HL)                ;// i = SpriteCount?
			jp  nz,restore_all_spr_bg_loop
			ret
	    ");
	call(GE_Sprite_RestoreBackground); // an empty call so that the optimizer keeps the procedure
end; /* RestoreAllSpritesBackground */


/**
Kirajzolja az összes sprite-ot a képernyőre a Draw metódussal.<br/>
<br/>
Ez az eljárás nem másolja vissza a sprite-ok hátterét a kirajzolás előtt, csak a kirajzolást végzi el.<br/>
Az átlátszó hátterű, azaz maszkolt sprite-okra vonatkozó kirajzolást végzi el, így csak akkor fog jól működni, ha minden sprite maszkolt.<br/>
Helyette kényelmesebb és erdemesebb használni a GE::RenderAllSprites() eljárást.<br/>
<br/>
Példa a használatára:<br/> 
GE::RestoreAllSpritesBackground;<br/>
GE::DrawAllSprites();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Draws all sprites<br/>
It doesn't restore sprite backgrounds; it just draws all sprites<br/>
<br/>
Example: GE::DrawAllSprites;<br/>
<br/>
**/
procedure DrawAllSprites;
begin
	Asm("
	    ld  A,(GE_SpriteCount)
	    or  A                   ;// SpriteCount == 0?
	    ret Z                   ;// if yes then return to caller
	    ld  DE,(GE_SpriteListPtr)
	    ld  HL,GE_SpritePtr
	    ld  (HL),E
	    inc HL
	    ld  (HL),D							;// SpritePtr := SpriteListPtr;
			xor A                   ;// A = 0
	    ld  [GE_i],A            ;// i := 0
	draw_all_spr_loop:
			ld  HL,[GE_SpritePtr]
			ld  E,(HL)
			inc HL
			ld  D,(HL)							;// DE -> sprite class
			inc HL									;// HL -> next sprite
			ld  [GE_SpritePtr],HL		;// SpritePtr := next sprite
			ld  [GE_Sprite_this],DE	;// init Sprite class
			ld  A,(DE)							;// A = Sprite.Visible
			or  A                   ;// Sprite.Visible = False?
			call nz,GE_Sprite_Draw 	;// if Sprite.Visible then call Sprite.Draw
			;// loop test
			ld  A,[GE_SpriteCount]
			ld  HL,GE_i
			inc (HL)                ;// Inc (i)
			cp  (HL)                ;// i = SpriteCount?
			jp  nz,draw_all_spr_loop
			ret
	    ");
	call(GE_Sprite_Draw); // an empty call so that the optimizer keeps the procedure
end; /* DrawAllSprites */


/**
Kirakja az összes sprite-ot a képernyőre a Put metódussal.<br/>
<br/>
Ez az eljárás nem másolja vissza a sprite-ok hátterét a kirajzolás előtt, csak a kirajzolást végzi el.<br/>
A nem átlátszó hátterű, azaz a NEM maszkolt sprite-okra vonatkozó kirajzolást végzi el, így csak akkor fog jól működni, ha minden sprite maszk nélküli.<br/>
Helyette kényelmesebb és erdemesebb használni a GE::RenderAllSprites() eljárást.<br/>
<br/>
Példa a használatára:<br/> 
GE::PutAllSprites();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Put all sprites<br/>
It doesn't restore sprite backgrounds; it just put all sprites<br/>
<br/>
Example: GE::PutAllSprites;<br/>
<br/>
**/
procedure PutAllSprites;
begin
	Asm("
	    ld  A,(GE_SpriteCount)
	    or  A                   ;// SpriteCount == 0?
	    ret Z                   ;// if yes then return to caller
	    ld  DE,(GE_SpriteListPtr)
	    ld  HL,GE_SpritePtr
	    ld  (HL),E
	    inc HL
	    ld  (HL),D							;// SpritePtr := SpriteListPtr;
			xor A                   ;// A = 0
	    ld  [GE_i],A            ;// i := 0
	put_all_spr_loop:
			ld  HL,[GE_SpritePtr]
			ld  E,(HL)
			inc HL
			ld  D,(HL)							;// DE -> sprite class
			inc HL									;// HL -> next sprite
			ld  [GE_SpritePtr],HL		;// SpritePtr := next sprite
			ld  [GE_Sprite_this],DE	;// init Sprite class
			ld  A,(DE)							;// A = Sprite.Visible
			or  A                   ;// Sprite.Visible = False?
			call nz,GE_Sprite_Put   ;// if Sprite.Visible then call Sprite.Put
			;// loop test
			ld  A,[GE_SpriteCount]
			ld  HL,GE_i
			inc (HL)                ;// Inc (i)
			cp  (HL)                ;// i = SpriteCount?
			jp  nz,put_all_spr_loop
			ret
	    ");
	// so that the optimizer keeps the procedure
	call(GE_Sprite_Put); // an empty call so that the optimizer keeps the procedure
end; /* PutAllSprites */


/**
A teljes háttérképernyőt kimásolja a képernyőre.<br/>
<br/>
Például akkor érdemes használni, ha a háttérképernyőn elkészült a játék kezdőképernyőjének megrajzolása, így azt ezzel az egy utasítással ki lehet másolni a képernyőre.<br/>
Ahhoz viszont túl lassú, hogy a játék főciklusában mindig meghívásra kerüljön, ílyen módon kifrissítve a háttérképernyőt a képernyőre. Erre a GE::CopyAllSpritesToScreen() eljárást kell használni.<br/>
Példa a használatása:<br/>
GE::CopyBackScreenToScreen();
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Copies the entire Back Screen to the screen<br/>
<br/>
**/
procedure CopyBackScreenToScreen;
begin
	Asm("
	    ;// save memory mapping
			ld  A,($3)				;// A = current memory mapping from system variable
			ld  [GE_Mode],A		;// save current memory mapping to Mode variable
			;// mapping the VideoRAM to $8000-BFFF; and U3 ($C000-$FFFF)
      ld  A,$90				  ;// memory mapping: U0, U1, VID, U3
			ld  ($3),A				;// set memory mapping to system variable
			out ($2),A				;// send memory mapping to port #2
			;// Copy the Back Screen to the screen
			ld  HL,GE_BACK_SCREEN_ADDR
			ld  DE,GE_SCREEN_ADDR
			ld  BC,GE_SCREEN_SIZE
			ldir
			;// restore memory mapping
			ld	A,[GE_Mode]		;// A = saved memory mapping
			ld	($3),A				;// restore memory mapping to system variable
			out ($2),A				;// restore memory mapping on port #2
	    ");	
end; /* CopyBackScreenToScreen */


/**
Átmásolja a megadott négyszög által határolt területet a háttérképernyőről a képernyőre<br/> 
<br/>
Háttérképernyős működés esetén a háttérképernyőről a képernyőre lehet frissíteni a játéktér egy részét vele.<br/>
Például arra lehet használni, hogy a háttérképernyőre kiírt pontszámot kimásoljuk a képernyőre, vagy egy lelőtt ellenség, vagy felszedett tárgy letörlését kifrissítsük a háttérképernyőről a képernyőre.<br/>
<br/>
Paraméterek:
<ul>
<li>X: a négyszög bal felső sarkának vízszintes pozíciója. Értéke 0 - 63 között lehet.</li>
<li>Y: a négyszög bal felső sarkának függőleges pozíciója. Értéke 0 - 239 között lehet.</li>
<li>Width : a négyszög szélessége. Értéke 1- 64 között lehet.</li>
<li>Height: a négyszög magassága. Értéke 1-255 között lehet.</li>
</ul>
A képernyő 64 byte széles és 240 pixel magas<br/>
A képernyő bal felső sarka a 0, 0 pozíció. A jobb alsó pedig a 63, 239 pozíció<br/>
<br/>
Példa a használatára:<br/>
GE::CopyBackScreenRectToScreen(10, 100, 30, 80);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Copy the specified rectangle from the Back Screen to the screen.<br/> 
Screen width is 64 characters and screen height is 240 pixels<br/>
Left top corner: 0, 0; right bottom corner: 63, 239<br/>
Params:
<ul>
<li>X: left position:0 - 63</li>
<li>Y: top position: 0 - 239</li>
<li>Width : 1- 64</li>
<li>Height: 1-240</li>
</ul>
<br/>
Example: GE::CopyBackScreenRectToScreen(10, 100, 30, 80);<br/>
<br/>
**/
procedure CopyBackScreenRectToScreen(X, Y, Width, Height : global byte);
begin
	Asm("
	    ;// memory mapping to U0, U1, VID, U3
      ld  A,$90
			ld  ($3),A
			out ($2),A
			;// calc Back Screen top-left corner address
			ld  A,[GE_Y]
			ld  L,A
			ld  H,0					;// HL = Y
			add HL,HL				;// HL = HL * 2
			add HL,HL				;// HL = HL * 4
			add HL,HL				;// HL = HL * 8
			add HL,HL				;// HL = HL * 16
			add HL,HL				;// HL = HL * 32
			add HL,HL				;// HL = Y * 64				
			ld 	BC,(GE_ScreenAddr) // BC -> screen start address
			add HL,BC				;// HL := screen start + (Y * 64)
			ld A,[GE_X]			;// A  := X
			ld B,0				
			ld C,A					;// BC := X
			add HL,BC				;// HL -> screen start start + Y * 64 + X -> left top pos. on the screen
			;// calc screen address
			ld  A,H
		  sub 64					;// A = A - 64 (64*256 = 16384)
		  ld  D,A							
		  ld  E,L					;// DE = HL - 16384 -> rectangle position on the screen
		  ;// calc SCREEN_WIDTH - rectangle Width
		  ld  A,[GE_Width];// A = Width
		  ld  IYH,A       ;// IYH = Width
		  ld  A,GE_SCREEN_WIDTH
      sub IYH         ;// A = SCREEN_WIDTH - rectangle Width
      ld  (copy_bb_rect_next_row+1),A ;// self-modifying code: ld C,SCREEN_WDITH - rectangle width
      ld  A,[GE_Height];// A = rectangle Height
		copy_bb_rect_lines:
			ld	C,IYH				;// BC: rectangle width in bytes
			ldir            ;// copy one rectangle line to the screen
		copy_bb_rect_next_row:
			ld  C,10        ;// will be overwritten with the required value (SCREEN_WDITH - rectangle width)
			add	HL,BC				;// HL -> next line on the Back Screen
			ex	DE,HL			
			add	HL,BC
			ex	DE,HL       ;// DE -> next line on the screen
			dec A           ;// decrement remaining rows from the rectangle height
			jp nz,copy_bb_rect_lines
      ;// mapping full 64k RAM
      ld  A,$B0				;// memory mapping: U0, U1, U2, U3
			ld  ($3),A			;// set memory mapping to system variable
			out ($2),A			;// send memory mapping to port #2
			");
end; /* CopyBackScreenRectToScreen */


/*================================================
  		            S C R E E N 
=================================================*/

/**
Grafikus mód beállítása ROM funkcióval.<br/>
<br/>
A grafikus mód beállítása mellett a képernyőt is letörli és inicializálja a TVC rendszer szöveg kiíró rutinját.<br/>
Paraméterek:
<ul>
<li>GE::GRAPHICS2:  2 színű mód</li>
<li>GE::GRAPHICS4:  4 színű mód</li>
<li>GE::GRAPHICS16: 16 színű mód</li>
</ul>
<br/>
Példa a használatára:<br/>
GE::SetGraphics(GE::GRAPHICS_16);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Sets graphics mode. 
<ul>
<li>GRAPHICS2:  512x240  2 color mode (code: 0)</li>
<li>GRAPHICS4:  256x240  4 color mode (code: 1)</li>
<li>GRAPHICS16: 128x240 16 color mode (code: 2).</li>
</ul>
<br/>
Example: GE::SetGraphics(GE:GRAPHICS_16);<br/>
<br/>
Uses the System ROM (firmware) function.
**/
procedure SetGraphics(Mode : global byte);
begin
	asm("
			ld  A,[GE_Mode]
			ld 	C,A 							;// C = graphics mode code
			rst $30 							;// system function call
			db $4 								;// VMODE function code
			ld  A,[GE_Mode]
			cp  2		              ;// Mode == Graphics16?
			ret nz                ;// if Mode != Graphics16, return to caller
			;// fill Mirror Table for DrawMirror
      ld  HL,GE_MIRROR_TABLE ;// start address of the Mirror Table
      ld  B,0
  fill_mirror_table_loop:
      or  A
      ld  A,B               ;// A = byte pattern (2 pixels in a byte)
      srl A                 ;// shifts bits to the right: pixel 1 bits -> pixel 2 bits 
      and 85                ;// clearing the bits of pixel 1
      ld  C,A		            ;// C = A
      ld  A,B								;// A = byte pattern (2 pixels in a byte)
      or  A
      sla A                 ;// shifts bits to the left: pixel 2 bits -> pixel 1 bits
      and 170               ;// clearing the bits of pixel 2
      or  C                 ;// A = swapped pixels
      ld  (HL),A            ;// store mirrored byte
      inc HL                ;// HL -> next element in the Mirror Table
      inc B                 ;// next byte pattern (2 pixels in a byte)
      jp  nz,fill_mirror_table_loop
			");
end;


/**
Az aktuális grafikus módot lekérdező függvény.<br/>
Visszatérési értékei:
<ul>
<li>0: GE::GRAPHICS_2</li>
<li>1: GE::GRAPHICS_4</li>
<li>2: GE::GRAPHICS_16</li>
</ul>
<br/>
Példa a használatára:<br/> 
if (GE::GetGraphics() <> GE::GRAPHICS_4) then GE::SetGraphics(GE::GRAPHICS_4);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Gets graphics mode.<br/>
Result:
<ul>
<li>0: GRAPHICS_2</li>
<li>1: GRAPHICS_4</li>
<li>2: GRAPHICS_16</li>
</ul>
<br/>
Example: if (GE::GetGraphics() <> GE::GRAPHICS_4) then GE::SetGraphics(GE::GRAPHICS_4);<br/>
<br/>
**/
function GetGraphics() : byte;
begin
	Asm("
			ld	A,($0B13)		// A = port #6 mirror system variable
			and 3						// A = bit #1 and #2 of port #6 mirror -> graphics mode
			");
end;

/**
Grafikus mód beállítása port írással.<br/>
<br/>
A grafikus mód beállítása mellett NEM TÖRLI LE a képernyőt.<br/>
Például arra használható, hogy ha a képernyő felső felén más grafikus módot szeretnénk használni, mint az alsó felén. Ekkor a raster-megszakítás pozíciójának adott sorra történő beállításával, a megszakítás bekövetkeztekor, ezzel az utasítással beállítható az adott képernyőfél grafikus módja.<br/>
Paraméterek:
<ul>
<li>GE::GRAPHICS2:  2 színű mód</li>
<li>GE::GRAPHICS4:  4 színű mód</li>
<li>GE::GRAPHICS16: 16 színű mód</li>
</ul>
<br/>
Példa a használatára:<br/>
GE::SetGraphMode(GE::GRAPHICS_16);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Sets graphics mode.
<ul>
<li>GRAPHICS2:  512x240  2 color mode (code: 0)</li>
<li>GRAPHICS4:  256x240  4 color mode (code: 1)</li>
<li>GRAPHICS16: 128x240 16 color mode (code: 2).</li>
</ul>
<br/>
Example: GE::SetGraphMode(GE::GRAPHICS_16);<br/>
<br/>
**/
procedure SetGraphMode(Mode : global byte);
begin
	asm("
			ld  A,[GE_Mode]   						;// A = the Mode param
			ld  C,A           						;// C = the Mode param
			LD  A,(GE_PORT_6_MEM_MIRROR)	;// A = mirror of port 6 in memory
      AND 255-2-1       						;// clear 0 and 1 bits (graphics mode)
      OR  C             						;// set the graphics specified in the Mode parameter.
      LD  ($0B13),A     						;// save the value to the mirror of port 6
      OUT (GE_GRAPH_MODE_PORT),A    ;// send the value to port 6
			");
end;


/**
A paletta megadott színét állítja be Graphics 2 vagy Graphics 4 módokban.<br/>
Paraméterek:
<ul>
<li>Nr: a palettán szereplő szín sorszáma. Graphics 2 esetén: 0 vagy 1; Graphics 4 esetén: 0, 1, 2 vagy 3</li>
<li>Color: paletta színkód</li>
</ul>
<br/>
Példa a használatára:<br/>
// 1. szín beállítása pirosra:<br/>
GE::SetPalette(1, GE::PALETTE_RED);<br/>
<br/>
Színkódok(Game Engin konstansok):
<ul>
<li> 0: GE::PALETTE_BLACK</li>
<li> 1: GE::PALETTE_DARKBLUE</li>
<li> 4: GE::PALETTE_DARKRED</li>
<li> 5: GE::PALETTE_DARKMAGENTA</li>
<li>16: GE::PALETTE_DARKGREEN</li>
<li>17: GE::PALETTE_DARKCYAN</li>
<li>20: GE::PALETTE_DARKYELLOW</li>
<li>21: GE::PALETTE_GRAY</li>
<li>64: GE::PALETTE_BLACK2</li>
<li>65: GE::PALETTE_BLUE</li>
<li>68: GE::PALETTE_RED</li>
<li>69: GE::PALETTE_MAGENTA</li>
<li>80: GE::PALETTE_GREEN</li>
<li>81: GE::PALETTE_CYAN</li>
<li>84: GE::PALETTE_YELLOW</li>
<li>85: GE::PALETTE_WHITE</li>
</ul>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Sets 2-color or 4-color palette.<br/>
Params:
<ul>
<li>Nr: Palette index (Graph.2: 0 - 1 or Graph.4: 0 - 3)</li>
<li>Color: Color code </li>
</ul>
<br/>
Example: GE::SetPalette(1, GE::PALETTE_RED);<br/>
<br/>
Color codes (decimal code: GE const):
<ul>
<li> 0: GE::PALETTE_BLACK</li>
<li> 1: GE::PALETTE_DARKBLUE</li>
<li> 4: GE::PALETTE_DARKRED</li>
<li> 5: GE::PALETTE_DARKMAGENTA</li>
<li>16: GE::PALETTE_DARKGREEN</li>
<li>17: GE::PALETTE_DARKCYAN</li>
<li>20: GE::PALETTE_DARKYELLOW</li>
<li>21: GE::PALETTE_GRAY</li>
<li>64: GE::PALETTE_BLACK2</li>
<li>65: GE::PALETTE_BLUE</li>
<li>68: GE::PALETTE_RED</li>
<li>69: GE::PALETTE_MAGENTA</li>
<li>80: GE::PALETTE_GREEN</li>
<li>81: GE::PALETTE_CYAN</li>
<li>84: GE::PALETTE_YELLOW</li>
<li>85: GE::PALETTE_WHITE</li>
</ul>
<br/>
**/
procedure SetPalette(Nr, Color : global byte);
begin
	if (Nr >= 0 and (Nr <= 3 and Color <= 85)) then
	begin		
		Asm("
				ld A,[GE_Nr]
				ld C,$60
				add A,C
				ld C,A					;// C = $60 + Nr
				ld A,[GE_Color]	;// A = Color code
				out (C),A				;// send Color code to desired palette port
				");
	end;
end;


/**
A keret színének beállítása<br/>
<br/>
Példa a használatára:<br/>
// Kék keretszín beállítása:<br/>
GE::SetBorder(GE::BORDER_BLUE);<br/>
<br/>
A használható keret színek:
<ul>
<li>GE::BORDER_BLACK</li>
<li>GE::BORDER_DARKBLUE</li>
<li>GE::BORDER_DARKRED</li>
<li>GE::BORDER_DARKMAGENTA</li>
<li>GE::BORDER_DARKGREEN</li>
<li>GE::BORDER_DARKCYAN</li>
<li>GE::BORDER_DARKYELLOW</li>
<li>GE::BORDER_GRAY</li>
<li>GE::BORDER_BLACK2</li>
<li>GE::BORDER_BLUE</li>
<li>GE::BORDER_RED</li>
<li>GE::BORDER_MAGENTA</li>
<li>GE::BORDER_GREEN</li>
<li>GE::BORDER_CYAN</li>
<li>GE::BORDER_YELLOW</li>
<li>GE::BORDER_WHITE</li>
</ul>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Sets the border color<br/>
<br/>
Example: GE::SetBorder(GE::BORDER_BLUE);<br/><br/>
<br/>
Border colors:
<ul>
<li>GE::BORDER_BLACK</li>
<li>GE::BORDER_DARKBLUE</li>
<li>GE::BORDER_DARKRED</li>
<li>GE::BORDER_DARKMAGENTA</li>
<li>GE::BORDER_DARKGREEN</li>
<li>GE::BORDER_DARKCYAN</li>
<li>GE::BORDER_DARKYELLOW</li>
<li>GE::BORDER_GRAY</li>
<li>GE::BORDER_BLACK2</li>
<li>GE::BORDER_BLUE</li>
<li>GE::BORDER_RED</li>
<li>GE::BORDER_MAGENTA</li>
<li>GE::BORDER_GREEN</li>
<li>GE::BORDER_CYAN</li>
<li>GE::BORDER_YELLOW</li>
<li>GE::BORDER_WHITE</li>
</ul>
**/
procedure SetBorder(Color : global byte);
begin
	asm("		
    ld A,[GE_Color]
    ld (GE_SYS_BORDER_COLOR),A
		out (GE_SYS_BORDER_PORT),A
	");
end;


/**
Képernyőfrissítéshez történő időzítés.<br/>
<br/>
Várakozás a raster-megszakításra, azaz arra, hogy a képernyőfrissítés a raster-megszakítás pozíciójába érjen, ami alapértelmezetten a képernyő jobb alsó sarka.<br/>
Az összes sprite kirakás és egyéb képernyőművelet előtt célszerű meghívni.<br/>
<br/>
A raster-megszakítás pozíciója a GE::SetRasterInterruptPos eljárással átállítható be.<br/>
<br/>
Példa a használatára:<br/>
GE::WaitForSync();<br/>
GE::RenderAllSprites();<br/>
<br/>
FIGYELEM! Ha digitális hangeffekt lejátszás inicializálva lett a GE::DigiSoundOn() eljárással, akkor a GE::WaitForDigiSoundSync() eljárást kell helyette használni.<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Waits until a vertical sync (raster-interrupt) has been performed.<br/>
Example:<br/>
GE::WaitForSync();<br/>
GE::RenderAllSprites();<br/>
<br/>
**/
procedure WaitForSync();
begin
	asm("
			halt
			");
end;


/**
A raster-megszakítás pozíciójának beállítása<br/>
<br/>
Megadható, hogy akkor váltódjon ki a raster-megszakítás, amikor a képernyőfrissítés a megadott sor végére ér.<br/>
Paraméterek:
<ul>
<li>LineNr: a képernyősor, aminek a végén a raster-megszakítás kiváltódjon. Értéke 0-239 között lehet.</li>
</ul>
<br/>
Példa a használatára:<br/>
// Beállítás a 200. sorra:<br/>
GE::SetRasterInterruptPos(200);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Set the raster-interrupt position on the screen<br/>
Params:
<ul>
<li>LineNr: 0-239</li>
</ul>
<br/>
Example: GE::SetRasterInterruptPos(200);<br/>
<br/>
**/
procedure SetRasterInterruptPos(LineNr : global byte);
begin
	Asm("
			ld  A,[GE_LineNr]
			srl A
			srl A       	;// A = LineNr div 4
			ld  L,A       ;// C = LineNr div 4
			// calc the cursor starting and ending line in the TV line
			add A,A
			add A,A       ;// A = (LineNr div 4)*4
			ld  B,A       ;// B = (LineNr div 4)*4
			ld  A,[GE_LineNr]
			sub B         ;// A = LineNr - (LineNr div 4)*4 -> LineNr mod 4
			ld  [GE_CursorIT_TVline],A
			ld  E,A       ;// E = LineNr - int(LineNr/4) <- the cursor starting and ending line in the TV line			
			// calc cursor_it position
			ld  B,0
			ld  H,B				;// H = 0 -> HL = LineNr div 4
			add HL,HL			;// HL = HL * 2
			add HL,HL			;// HL = HL * 4
			add HL,HL			;// HL = HL * 8
			add HL,HL			;// HL = HL * 16
			add HL,HL			;// HL = HL * 32
			add HL,HL			;// HL = (LineNr div 4) * 64
			ld  BC,63     ;// last logical character in the line
      add HL,BC     ;// HL = int(LineNr/4)*64+63
      ld  [GE_CursorITPos],HL
			// sends the calculated values to the CRTC ports
			ld  C,$71     ;// C = port $71
			ld	A,14
			out	($70),A		;// select CRTC R14 register - register of raster-interrupt position high byte
			out	(C),H 		;// send the hight byte of raster-interrupt position to CRTC R14 register
			ld	A,15
			out	($70),A		;// select CRTC R15 register - register of raster-interrupt position low byte
			out	(C),L  		;// send the low byte of raster-interrupt position to CRTC R15 register
			ld	A,10
			out	($70),A		;// select CRTC R10 register - the cursor starting line in the TV line
			out	(C),E 		;// set the cursor starting line (R10) in the TV line
			ld	A,11
			out	($70),A		;// select CRTC R11 register - the cursor ending line in the TV line
			out	(C),E 		;// set the cursor ending line (R11) in the TV line
			ret
			");
end; /* SetRasterInterruptPos */


/**
A raster-megszakítás pozíciójának pontos beállítása<br/>
<br/>
Megadható, hogy akkor váltódjon ki a raster-megszakítás, amikor a képernyőfrissítés a megadott sor, megadott logikai karakteréhez ér.<br/>
Paraméterek:
<ul>
<li>LineNr: képernyősor, amelyikben a raster-megszakítás kiváltódjon. Értéke 0-239 között lehet.</li>
<li>CharNr: soron belül hányadik logikai karakterpozíciójában legyen a raster-megszakítás pozíciója. Értéke 0-63 között lehet.</li>
</ul>
<br/>
Példa a használatára:<br/>
// Beállítás a 200. sor, 32. logikai karakterpozíciójára:<br/>
GE::SetRasterInterruptPos(200, 32);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Set the raster-interrupt position on the screen<br/>
Params:
<ul>
<li>LineNr: line of the raster-interrup position (0-239)</li>
<li>CharNr: logical character position in the raster-interrupt line (0-63)</li>
</ul>
<br/>
Example: GE::SetRasterInterruptPos(200, 32);<br/>
<br/>
**/
procedure SetRasterInterruptPosEx(LineNr, CharNr : global byte);
begin
	Asm("
			ld  A,[GE_LineNr]
			srl A
			srl A       	;// A = LineNr div 4
			ld  L,A       ;// C = LineNr div 4
			// calc the cursor starting and ending line in the TV line
			add A,A
			add A,A       ;// A = (LineNr div 4)*4
			ld  B,A       ;// B = (LineNr div 4)*4
			ld  A,[GE_LineNr]
			sub B         ;// A = LineNr - (LineNr div 4)*4 -> LineNr mod 4
			ld  [GE_CursorIT_TVline],A
			ld  E,A       ;// E = LineNr - int(LineNr/4) <- the cursor starting and ending line in the TV line			
			// calc cursor_it position
			ld  B,0
			ld  H,B				;// H = 0 -> HL = LineNr div 4
			add HL,HL			;// HL = HL * 2
			add HL,HL			;// HL = HL * 4
			add HL,HL			;// HL = HL * 8
			add HL,HL			;// HL = HL * 16
			add HL,HL			;// HL = HL * 32
			add HL,HL			;// HL = (LineNr div 4) * 64
      ld  A,[GE_CharNr]
      ld  C,A       ;// BC = CharNr
      add HL,BC     ;// HL = int(LineNr/4)*64+CharNr
      ld  [GE_CursorITPos],HL
			// sends the calculated values to the CRTC ports
			ld  C,$71     ;// C = port $71
			ld	A,14
			out	($70),A		;// select CRTC R14 register - register of raster-interrupt position high byte
			out	(C),H 		;// send the hight byte of raster-interrupt position to CRTC R14 register
			ld	A,15
			out	($70),A		;// select CRTC R15 register - register of raster-interrupt position low byte
			out	(C),L  		;// send the low byte of raster-interrupt position to CRTC R15 register
			ld	A,10
			out	($70),A		;// select CRTC R10 register - the cursor starting line in the TV line
			out	(C),E 		;// set the cursor starting line (R10) in the TV line
			ld	A,11
			out	($70),A		;// select CRTC R11 register - the cursor ending line in the TV line
			out	(C),E 		;// set the cursor ending line (R11) in the TV line
			ret
			");
end;

/*================================================
                 S C R O L L 
=================================================*/


/**
A képernyő felfelé scrollozása egy egységgel, azaz 4 pixelsorral<br/>
Ez az eljárás hardvert scroll-t használ.<br/>
Csak direkt a képernyőre történő rajzolásnál van értelme használni, mivel a háttérképernyőt nem tudja scrollozni.<br/>
<br/>
Paramétere:<br/>
UpdateSpritePos<br/>
<ul>
<li>true: frissíti a sprite-ok pozícióját, azaz nem fognak a scrollal együtt elmozdulni</li>
<li>false: nem frissít a sprite-ok pozícióját, azaz a scroll elmozdítja azokat is</li>
</ul>
<br/>
Példa a használatára:<br/>
GE::WaitForSync();<br/>
GE::ScrollUp(True);<br/>	
GE::RenderAllSprites();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Scrolling up the screen<br/>
This is a handware scroll using the CRTC<br/>
Use only with DIRECT_TO_SCREEN<br/>
<br/>
Params: UpdateSpritePos
<ul>
<li>true : update the positions of sprites with the amount of scroll displacement</li>
<li>false: do not update the positions of sprites</li>
</ul>
<br/>
Example:<br/>
	GE::WaitForSync;<br/>
	GE::ScrollUp(True);<br/>	
	Sprite.ScrollRestoreBackground();<br/>	
	Sprite.ScrollDraw();<br/>
	Sprite.UpdateLastPos();<br/>
<br/>
**/
procedure ScrollUp(UpdateSpritePos : global boolean);
begin
	Asm("
      ;// increment the CRTC_ScreenOffset
	    ld  HL,[GE_CRTC_ScreenOffset]
      ld  BC,64                     ;// CRTC line width in bytes
      add HL,BC                     ;// CRTC_ScreenOffset += 64                               
      res 4,H                       ;// handle overflow (64 ligical lines * 64 chars = 4096)
      ld (GE_CRTC_ScreenOffset),HL  ;// store the new value of CRTC_ScreenOffset
      ;// set screen start by CRTC	
      ld  A,12                      ;// 12: CRTC port to screen start high
      out (GE_CRTC_REG_PORT),A			;// selecting Register #12 of the CRTC
      ld  A,H
      out (GE_CRTC_DATA_PORT),A     ;// sending the screen start address high value to the CRTC data port
      ld  A,13                      ;// 13: CRTC port to screen start high
      out (GE_CRTC_REG_PORT),A      ;// selecting Register #13 of the CRTC
      ld  A,L                                
      out (GE_CRTC_DATA_PORT),A     ;// sending the screen start address low value to the CRTC data port
      ;// set the cursor-interrupt position
      ld  DE,[GE_CursorITPos]
      add	HL,DE                     ;// HL = position of the cursor-interrupt
      ld  A,14                      ;// 14: CRTC port to the high value of the cursor-interrupt position
      out	(GE_CRTC_REG_PORT),A      ;// selecting Register #14 of the CRTC
      ld  A,H
      out	(GE_CRTC_DATA_PORT),A     ;// sending the high value of cursor-interrupt position to the CRTC data port
      ld  A,15                      ;// 15: CRTC port to the low value of the cursor-interrupt position
      out	(GE_CRTC_REG_PORT),A      ;// selecting Register #15 of the CRTC
      ld  A,L
      out (GE_CRTC_DATA_PORT),A     ;// sending the low value of cursor-interrupt position to the CRTC data port
      ;// update sprite positions
      ld  A,[GE_UpdateSpritePos]
      or  A                         ;// UpdateSpritePos = False?
      ret z                         ;// if UpdateSpritePos = False then return to caller      
      ld  DE,(GE_SpriteListPtr)
	    ld  HL,GE_SpritePtr
	    ld  (HL),E
	    inc HL
	    ld  (HL),D							      ;// SpritePtr := SpriteListPtr;
			xor A                         ;// A = 0
	    ld  [GE_i],A                  ;// i := 0
	upd_spr_scroll_up:
			ld  HL,[GE_SpritePtr]
			ld  E,(HL)
			inc HL
			ld  D,(HL)							      ;// DE -> sprite class
			inc HL									      ;// HL -> next sprite
			ld  [GE_SpritePtr],HL		      ;// SpritePtr := next sprite
			ld	IXL,E
			ld	IXH,D                     ;// IX -> Sprite class
			inc (IX+7)                    ;// sprite.Position += 256 -> +4 lines on the VIDEORAM
			res 6,(IX+7)                  ;// overflow handling
			;// loop test
			ld  A,[GE_SpriteCount]
			ld  HL,GE_i
			inc (HL)                      ;// Inc (i)
			cp  (HL)                      ;// i = SpriteCount?
			jp  nz,upd_spr_scroll_up
		  ");		  
end; /* ScrollUp */


/**
A képernyő lefelé scrollozása egy egységgel, azaz 4 pixelsorral<br/>
Ez az eljárás hardvert scroll-t használ.<br/>
Csak direkt a képernyőre történő rajzolásnál van értelme használni, mivel a háttérképernyőt nem tudja scrollozni.<br/>
<br/>
Paramétere:<br/>
UpdateSpritePos<br/>
<ul>
<li>true: frissíti a sprite-ok pozícióját, azaz nem fognak a scrollal együtt elmozdulni</li>
<li>false: nem frissít a sprite-ok pozícióját, azaz a scroll elmozdítja azokat is</li>
</ul>
<br/>
Példa a használatára:<br/>
GE::WaitForSync;<br/>
GE::ScrollDown(True);<br/>	
GE::RenderAllSprites();<br/>	
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Scrolling down the screen<br/>
This is a handware scroll using the CRTC<br/>
Use only with DIRECT_TO_SCREEN<br/>
<br/>
Params: UpdateSpritePos
<ul>
<li>true : update the positions of sprites with the amount of scroll displacement</li>
<li>false: do not update the positions of sprites</li>
</ul>
<br/>
Example:<br/>
GE::WaitForSync;<br/>  
GE::ScrollDown(true);<br/>  
Sprite.ScrollRestoreBackground();<br/>
Sprite.ScrollDraw();<br/>
Sprite.UpdateLastPos();<br/>
<br/>
**/
procedure ScrollDown(UpdateSpritePos : global boolean);
begin
	Asm("
      ;// decrement the CRTC_ScreenOffset
	    ld  HL,[GE_CRTC_ScreenOffset]
      ld  BC,$ffc0                  ;// -> -64 (64 is the CRTC line width in bytes)
      add HL,BC                     ;// CRTC_ScreenOffset -= 64
      res 4,H                       ;// handle overflow (64 ligical lines * 64 chars = 4096)
      ld (GE_CRTC_ScreenOffset),HL  ;// store the new value of CRTC_ScreenOffset
      ;// set screen start by CRTC	
      ld  A,12                      ;// 12: CRTC port to screen start high
      out (GE_CRTC_REG_PORT),A			;// selecting Register #12 of the CRTC
      ld  A,H
      out (GE_CRTC_DATA_PORT),A     ;// sending the screen start address high value to the CRTC data port
      ld  A,13                      ;// 13: CRTC port to screen start high
      out (GE_CRTC_REG_PORT),A      ;// selecting Register #13 of the CRTC
      ld  A,L                                
      out (GE_CRTC_DATA_PORT),A     ;// sending the screen start address low value to the CRTC data port
      ;// set the cursor-interrupt position
      ld  DE,[GE_CursorITPos]
      add	HL,DE                     ;// HL = position of the cursor-interrupt
      ld  A,14                      ;// 14: CRTC port to the high value of the cursor-interrupt position
      out	(GE_CRTC_REG_PORT),A      ;// selecting Register #14 of the CRTC
      ld  A,H
      out	(GE_CRTC_DATA_PORT),A     ;// sending the high value of cursor-interrupt position to the CRTC data port
      ld  A,15                      ;// 15: CRTC port to the low value of the cursor-interrupt position
      out	(GE_CRTC_REG_PORT),A      ;// selecting Register #15 of the CRTC
      ld  A,L
      out (GE_CRTC_DATA_PORT),A     ;// sending the low value of cursor-interrupt position to the CRTC data port
      ;// update sprite positions
      ld  A,[GE_UpdateSpritePos]
      or  A                         ;// UpdateSpritePos = False?
      ret z                         ;// if UpdateSpritePos = False then return to caller      
      ld  DE,(GE_SpriteListPtr)
	    ld  HL,GE_SpritePtr
	    ld  (HL),E
	    inc HL
	    ld  (HL),D							      ;// SpritePtr := SpriteListPtr;
			xor A                         ;// A = 0
	    ld  [GE_i],A                  ;// i := 0
	upd_spr_scroll_down:
			ld  HL,[GE_SpritePtr]
			ld  E,(HL)
			inc HL
			ld  D,(HL)							      ;// DE -> sprite class
			inc HL									      ;// HL -> next sprite
			ld  [GE_SpritePtr],HL		      ;// SpritePtr := next sprite
			ld	IXL,E
			ld	IXH,D                     ;// IX -> Sprite class
			dec (IX+7)                    ;// sprite.Position -= 256 -> -4 lines on the VIDEORAM
			set 7,(IX+7)                  ;// if bit 7 is 0, the addressing is under 32K (under the VIDEORAM), so bit 7 is set. This means that HL will always over 32K, i.e. in the VIDEORAM range.
			;// loop test
			ld  A,[GE_SpriteCount]
			ld  HL,GE_i
			inc (HL)                      ;// Inc (i)
			cp  (HL)                      ;// i = SpriteCount?
			jp  nz,upd_spr_scroll_down
		  ");		  
end; /* ScrollDown */


/*===============================================
               G R A P H I C S 
===============================================*/

/**
Képernyő törlése egy megadott byte mintával<br/>
<br/>
Paramétere:<br/>
Pattern: a byte minta (0-255)<br/>
Például, ha a Pattern 0, akkor a 0. palette színnel, vagy Graphics 16 esetén fekete színnel törli a képernyőt.<br/>
<br/>
Példa a használatára:<br/>
GE::ClearScreen(0);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Clear screen<br/>
<br/>
Param:<br/>
Patter: byte for clear<br/>
For example 0: color of palette #0 or black in Graphics 16<br/>
<br/>
Example:<br/>
GE::ClearScreen(0);<br/>
<br/>
**/
procedure ClearScreen(Pattern : global byte);
begin
		Asm("
				;// save memory mapping
				ld  A,($3)				;// A = current memory mapping from system variable
				ld  [GE_Mode],A		;// save current memory mapping to Mode variable
				// mapping the VideoRAM to $8000-BFFF; and U3 ($C000-$FFFF)
        ld  A,$90					;// memory mapping: U0, U1, VID, U3
				ld  ($3),A				;// set memory mapping to system variable
				out ($2),A				;// send memory mapping to port #2
				;// clear screen
				ld  A,[GE_Pattern];// A := fill pattern byte
				ld  HL,(GE_ScreenAddr) ;// HL -> VIDEORAM / BACK-BUFFER start address				
				ld  (HL),A        ;// put fill pattern to VIDEORAM first byte
				ld  D,H
				ld  E,L           ;// DE = HL
				inc DE            ;// DE -> HL + 1
				ld  BC,16383	    ;// BC = 16K - 1 -> VIDEORAM size - 1
				ldir				      ;// copy fill pattern to all bytes of the VIDEORAM
				;// restore memory mapping
				ld	A,[GE_Mode]		;// A = saved memory mapping
				ld	($3),A				;// restore memory mapping to system variable
				out ($2),A				;// restore memory mapping on port #2
				");
end; /* ClearScreen */


/**
Egy kitöltött négyszög rajzolása<br/> 
Paraméterek:
<ul>
<li>X: a bal felső sarok vízszintes pozíciója byte-okban (0-63)</li>
<li>Y: a bal felső sarok függőleges pozíciója pixelekben (0-239)</li>
<li>Width : a négyszög szélessége byte-okben (1- 64)</li>
<li>Height: a négyszög magassága pixelekben (1-240)</li>
<li>Pattern: kitöltő byte minta (0-255)</li>
</ul>
Ha a Pattern 0, akkor az a 0. palette szín, vagy Graphics 16 esetén fekete szín lesz.<br/>
Ha a Pattern 255, az 4 vagy 8 pixel lesz a paletta utolsó színével Graphics 2 vagy 4 módban, vagy 2 fehér pixel Graphics16 módban.<br/>
<br/>
Példa a használatára:<br/> 
// Kirazol a 100. sor 20. byte-jától egy 30 byte széles és 80 pixel magas négyszöget, sárga színben Graphics 16 mód esetén:<br/>
GE::FillRect(20, 100, 30, 80, GE::GR16_COLOR_YELLOW);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Draw a filled rectangle<br/> 
Params:
<ul>
<li>X: top horizontal position in bytes (0-63)</li>
<li>Y: top vertical position in pixels (0 - 239)</li>
<li>Width: width of the rectangle in bytes (1- 64)</li>
<li>Height: height of the rectangle in pixels (1-255)</li>
<li>Pattern: fill pattern byte (0-255)<br/>
</ul>
The screen width is 64 characters and the screen height is 240 pixels<br/>
Left top corner: 0, 0; right bottom corner: 63, 239<br/>
<br/>
Example: GE::FillRect(10, 100, 30, 80, 255);<br/>
<br/>
**/
procedure FillRect(X, Y, Width, Height, Pattern : global byte);
begin
	Asm("
				// save memory mapping				
				ld  A,($3)				;// A = current memory mapping
				ld  [GE_Mode],A		;// save current memory mapping to Mode variable
				// enable Video RAM
        ld  A,$90					;// Pages: U0, U1, VID, U3
				ld  ($3),A
				out ($2),A
				// calc left top pos. on the screen
				ld  A,[GE_Y]      ;// A = param Y
				ld  L,A						;// L = param Y
				xor A             ;// A = 0
				ld  H,A						;// H = 0 -> HL = param Y
 				srl H
 				rr  L
 				rra
 				srl H
 				rr  L
 				rra
 				ld  H,L
 				ld  L,A           ;// HL = Y * 64
				ld 	BC,(GE_ScreenAddr) ;// BC -> screen start address
				add HL,BC					;// HL := screen start + (Y * 64)
				ld  A,[GE_X]			;// A  := X
				ld  B,0				
				ld  C,A						;// BC := X
				add HL,BC					;// HL -> screen start address + (Y * 64) + X -> left top pos. on the screen
				// set Width, Height, Pattern				
        ld  A,[GE_Height] ;// A := Height
				ld  C,A						;// C := Height
				ld  A,[GE_Width]	;// A := Width
				ld  IXL,A					;// IXL := width				
				ld  B,A						;// B := Width
				ld  A,64
				sub B						  ;// A := 64 - Width
				ld  D,0
				ld  E,A						;// DE := 64 - Width
				ld  A,[GE_Pattern];// A := fill pattern byte
				// draw filled rectangle
	fill_rect_lines:			
				ld  B,IXL					;// B := Width
	fill_rect_line:
				ld  (HL),A				;// put a byte to the screen
				inc HL					  ;// HL -> next byte
				djnz fill_rect_line
				add  HL,DE				;// HL -> next line
				dec  C						;// decrement remaining lines
				jp nz,fill_rect_lines
				// restore memory mapping
				ld  A,[GE_Mode]		;// A = saved memory mapping
				ld  ($3),A				;// restore memory mapping on system memory variable
				out ($2),A				;// restore memory mapping on port
			");
end;


/**
Függőleges, 1 byte széles vonal rajzolása.<br/>
<br/>
Params:
<ul>
<li>Position: pozíció a képernyőn</li>
<li>Count: hossza pixelekben. Értéke 1-255 között lehet</li>
<li>Pattern: byte minta</li>
</ul>
<br/>
Példa a használatára:<br/>
// Fekete, 1 byte széles függőleges vonal rajzolása a 100. sor 30. byte-jától 50 pixel hosszan:<br/>
GE::VBytesLine(GE::ScreenAddr+100*GE::SCREEN_WIDTH+30, 50, 0);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Draw a vertical line with a byte pattern (overwrite mode).<br/>
Coordinates of the upper left corner x: 0, y: 0, and the right lower X: 64, Y: 239.<br/>
Params:
<ul>
<li>Position: position on the screen - $8000 + Y*64 + X</li>
<li>Count: 1-255</li>
<li>Pattern: byte pattern</li>
</ul>
Example: GE::VBytesLine(GE::ScreenAddr+100*GE::SCREEN_WIDTH+30, 50, 128);<br/>
<br/>
**/
procedure VBytesLine(Position : global integer; Count, Pattern : global byte);
begin	
	Asm("
				ld  HL,[GE_Position]	;// HL := Position
				ld  A,[GE_Count]			;// A := Length
				ld  B,A								;// B := Length
				ld  A,[GE_Pattern]		;// A := vline pattern byte
				ld  DE,GE_SCREEN_WIDTH
	vert_byte_line:
				ld  (HL),A						;// put line pattern byte to screen
				add HL,DE							;// HL -> next line
				djnz vert_byte_line
			");
end;


/**
Vízszintes, byte-okból álló vonal rajzolása.<br/>
<br/>
Params:
<ul>
<li>Position: pozíció a képernyőn</li>
<li>Count: a vonal hossza byte-okban. Értéke 1-64 között lehet</li>
<li>Pattern: byte minta</li>
</ul>
<br/>
Példa a használatára:<br/>
// A 100. sor bal szélétől 64 byte, azaz teljes képrnyő széles fehér vonal rajzolása:<br/>
GE::HBytesLine(GE::ScreenAddr+100*GE::SCREEN_WIDTH, 64, 255);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Draw a horizontal line with a byte pattern (overwrite mode).<br/>
Coordinates of the upper left corner x: 0, y: 0, and the right lower X: 64, Y: 239.<br/>
Params:
<ul>
<li>Position: position on the screen - $8000 + Y*64 + X</li>
<li>Count: 1-64</li>
<li>Pattern: byte pattern</li>
</ul>
<br/>
Example: GE::HBytesLine(GE::ScreenAddr+100*GE::SCREEN_WIDTH, 64, 255);<br/>
<br/>
**/
procedure HBytesLine(Position : global integer; Count, Pattern : global byte);
begin	
	Asm("
				ld  HL,[GE_Position]	;// HL := Position
				ld  A,[GE_Count]			;// A := Length
				ld  B,A								;// B := Length
				ld  A,[GE_Pattern]		;// A := vline pattern byte
	horiz_byte_line:
				ld  (HL),A						;// put line pattern byte to screen
				inc HL								;// HL -> next byte
				djnz horiz_byte_line
			");
end;


/**
Egy byte minta kirakása a megadott képernyőpozícióba<br/>
Paraméterek:
<ul>
<li>Position: pozíció a képernyőn</li>
<li>Pattern: byte minta. Értéke 0-255 között lehet.</li>
</ul>
<br/>
Példa a használatára:<br/>
// Egy fekete vagy 0. paletta színű byte kirakása a 100. sor 32. byte-jába:<br/>
GE::PutByte(GE::ScreenAddr+100*GE::SCREEN_WIDTH+32, 0);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Put a byte pattern to the specified screen position.<br/>
Params:
<ul>
<li>Position: position on the screen - $8000 + Y*64 + X</li>
<li>Pattern: byte pattern (0-255)</li>
</ul>
<br/>
Example: GE::PutByte(GE::ScreenAddr+100*GE::SCREEN_WIDTH, 255);<br/>
<br/>
**/
procedure PutByte(Position : global integer; Pattern : global byte);
begin	
	Asm("
				ld  HL,[GE_Position]	;// HL := Position
				ld  A,[GE_Pattern]		;// A := vline pattern byte
				ld  (HL),A						;// put line pattern byte to screen
			");
end;


/**
Egy byte lekérdezése a megadott memóriacímról<br/>
Megfelel a BASIC PEEK utasításának.<br/>
<br/>
Paramétere:<br/>
MemAddr: memóriacím. Értéke 0-65535 között lehet.<br/>
<br/>
Példa a használatára:<br/>
if (GE::GetMemByte(Sprite.Position-64) > 0 then<br/>
    SpriteUtkozes();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Get a byte from the specified memory address<br/>
Params:<br/>
  MemAddr: 0-65535<br/>
<br/>
Example:<br/>
if (GE::GetMemByte(Sprite.Position-64) > 0 then<br/>
  SpriteCollision();<br/>
<br/>
**/
function GetMemByte(MemAddr : global integer) : byte;
begin
	Asm("
     	ld  HL,[GE_MemAddr]
     	ld  A,(HL)
     	");
end;


/**
Egy integer (2 byte) érték lekérdezése a megadott memóriacímről<br/>
Paramétere:<br/>
MemAddr: memóriacím. Értéke 0-65535 között lehet.<br/>
<br/>
Példa a használatára:<br/>
var Himem : integer;<br/>
// A BaSIC HI-MEM változójának lekérdezése:
HiMem := GE::GetMemByte(2841);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Get an integer (2 bytes) from the specified memory address<br/>
Params:<br/>
  MemAddr: 0-65535<br/>
<br/>
Example:<br/>
var TimerTick : integer;<br/>
<br/>
TimerTick := GE::GetMemByte(2845);<br/>
<br/>
**/
function GetMemInt(MemAddr : global integer) : integer;
begin
	Asm("
     	ld  HL,[GE_MemAddr]
     	ld  E,(HL)
     	inc HL
     	ld  D,(HL)				;// DE = integer from the specified memory address
     	ex  DE,HL					;// HL = the result
     	");
end;

/*================================================
    K E Y B O A R D   A N D   J O Y S T I C K 
=================================================*/


/**
A billentyűzet állapotának lekérdezése.<br/>
Lekérdezi, hogy melyik gombok vannak lenyomva a két joystick-kel együtt.<br/>
Meg kell hívni mielőtt a GE::Pressed vagy a GE::KeyPressed függvényeket használnánk.<br/>
<br/>
Példa a használatára:<br/>
GE::GetKeyboard();<br/>
if (GE::Pressed(GE::KEY_SPACE)) then Fire();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Get keyboard.<br/>
It must be called before using keyboard functions (such as GE::KeyPressed, GE::SpacePressed, etc.)<br/>
It fills the keyboard matrix as KEYBOARD_0 - KEYBOARD_7, JOY1_STATE, JOY2_STATE<br/>
<br/>
Example:<br/>
GE::GetKeyboard();<br/>
if (GE::Pressed(GE::KEY_SPACE)) then Fire();<br/>
<br/>
**/
procedure GetKeyboard;
begin
	Asm("
		  ld	A,(GE_PORT_3_MEM_MIRROR)      ;// 0-3 bits: keyboard row select
			and	240                           ;// clear 0-3 bits
			ld	C,A
			ld	HL,GE_KEYBOARD_0              ;// HL -> Keyboard matrix row #0
			ld	B,10                          ;// Keyboard matrix length in bytes
	fill_keyboard_matrix:
			ld	A,C                           ;// A: value to select keyboard matrix row
			out	(GE_KEYBOARD_ROW_SEL_PORT),A  ;// select keyboard matrix row
			in	A,(GE_KEY_READ_PORT)          ;// read keyboard matrix row data
			cpl                               ;// invert bits
			ld	(HL),A                        ;// store keyboard matrix row data
			inc	HL                            ;// HL -> next row in the keyboard matrix
			inc	C                             ;// next value to select keyboard matrix row
			djnz fill_keyboard_matrix
		  ");
end; /* GetKeyboard */


/**
Visszaadja, hogy a paraméterben megadott gomb le van-e nyomva.<br/>
Paramétere:<br/>
KeyCode: a lekérdezni kíván billentyű Game Engine kódja<br/>
<br/>
Példa a használatára:<br/>
GE::GetKeyboard();<br/>
if (GE::Pressed(GE::KEY_SPACE)) then Fire();<br/>
<br/>
Minden gombra van egy KeyCode konstans definiálva a Game Engine-ban. Pélául:<br/>
KEY_A<br/>
KEY_B<br/>
KEY_ESC<br/>
KEY_RET<br/>
KEY_CRTL<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Returns whether the specified button is pressed.<br/>
<br/>
Param:<br/>
KeyCode: key code of the specified button<br/>
<br/>
Example:<br/>
GE::GetKeyboard();<br/>
if (GE::Pressed(GE::KEY_SPACE)) then Fire();<br/>
<br/>
**/
function Pressed(KeyCode : global integer) : boolean;
begin
  Asm("
      ld  DE,[GE_KeyCode]		;// KeyCode = hi byte: key code; lo byte: number of keyboard matrix row
      ld  HL,GE_KEYBOARD_0	;// HL -> keyboard matrix row 0
      ld  B,0
      ld  C,E								;// BC: number of keyborad matrix row
      add HL,BC							;// HL -> the KeyCode specified keyboard matrix row
			ld  A,(HL)						;// A: the specified keyboard matrix row
			and D                 ;// D: the specified key code
			jp  nz,PressedTrue    ;// if A <> 0, the specified key is pressed
			ret										;// A = 0 -> the result = False (the specified key is not pressed)
	PressedTrue:
			ld  A,1								;// A = 1 -> the result = True
			ret      
      ");	
end; /* KeyPressed */


/**
Visszaadja, hogy bármilyen gomb le van-e nyomva<br/>
<br/>
Visszatérési értékei:<br/>
True: valamelyik gomb le van nyomva<br/>
False: egyik gomb sincs lenyomva<br/>
<br/>
Példa a használatára:<br/>
GE::GetKeyboard();<br/>
if (GE::KeyPressed()) then Start();<br/>
<br/>
Vagy várakozás bármelyik gomb lenyomására:<br/>
GE::GetKeyboard();<br/>
while (not GE::KeyPressed()) do GE::GetKeyboard();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Returns whether any key has been pressed.<br/>
Result: TRUE: any key is pressed; False: none of the buttons are pressed<br/>
<br/>
Example:<br/>
GE::GetKeyboard();<br/>
if (GE::KeyPressed()) then<br/>
<br/>
Or waiting for any button press:<br/>
GE::GetKeyboard();<br/>
while (not GE::KeyPressed()) do GE::GetKeyboard();<br/>
<br/>
**/
function KeyPressed() : boolean;
begin
	Asm("
			ld 	HL,$0B51	// Keyboard matrix (10 row -> 10 bytes)
			ld  B,10			// Keyboard matrix length in bytes
	key_is_pressed_loop:	
			ld  A,(HL)		// A = a keyboard matrix row
			or  A					// A = 0?
			jp nz,key_is_pressed // if not then any key is pressed
			inc HL				// HL -> next row in Keyboard matrix
			djnz key_is_pressed_loop
			xor A					// A = 0 -> result is FALSE
			ret
	key_is_pressed:
			ld  A,1				// result is TRUE
			");
end;


/**
A joystick-ek állapotát kérdezi le.<br/>
Meg kell hívni mielőtt a GE::Joystick függvényt használnánk.<br/>
A GE::GetKeyboard() eljárás meghívása kiváltja, annak használata esetén nem kell a GE::GetJoysticks() eljárást meghívni.<br/>
<br/>
Példa a használatára:<br/>
GE::GetJoysticks();<br/>
if (GE::Joystick(1, GE::JOY_LEFT)) then PlayerMoveLeft();<br/>
if (GE::Joystick(1, GE::JOY_RIGHT)) then PlayerMoveRight();<br/>
<br/>
A GameCard joystick-jainak használatához a program inicializációs részében meg kell hívni a GE::InitGameCard() eljárást.<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Gets the state of the joysticks.<br/>
It must be called before using the GE::Joystick function unless you have already called GE::GetKeyboard.<br/>
<br/>
Example:<br/>
GE::GetJoysticks();<br/>
if (GE::Joystick(1, GE::JOY_LEFT)) then PlayerMoveLeft();<br/>
if (GE::Joystick(1, GE::JOY_RIGHT)) then PlayerMoveRight();<br/>
<br/>
If you also want to query the GameCard joysticks, call the InitGameCard() procedure in an initialization section.<br/>
**/
procedure GetJoysticks;
begin
  Asm("
  		ld	A,(GE_PORT_3_MEM_MIRROR)			;// 0-3 bit of Port #3: select keyboard matrix line
			and	128+64+32+16									;// clear 0-3 bits
			;// get Joystick #1
			add	A,8														;// set bits 0-3 to keyboard matrix line #8
			ld  C,A                       		;// save A register value to C register
			out	(GE_KEYBOARD_ROW_SEL_PORT),A	;// select keyboard mátrix line #8
			in	A,(GE_KEY_READ_PORT)					;// read joystick #1 line
			cpl																;// invert bits
			ld	(GE_JOY1_STATE),A							;// store to JOY1_STATE
			;// get Joystick #2
			ld  A,C
			inc A
			out	(GE_KEYBOARD_ROW_SEL_PORT),A	;// select keyboard mátrix line #9
			in	A,(GE_KEY_READ_PORT)					;// read joystick #2 line
			cpl																;// invert bits
			ld	(GE_JOY2_STATE),A							;// store to JOY2_STATE
			;// get GameCard joysticks
			ld  A,(GE_GameCardFound)
			or  A
			ret z
			;// Joystick #3 (GameCard joystick #1)
			ld	A,(GE_GameCardJoy3Port)
			ld	C,A														;// read joystick port
			in	A,(C)													;// GameCard első joystick port kiolvasása
			cpl																;// invert bits -> 0: not pressd; 1: pressed
			ld	(GE_Joy3State),A							;// save joystick #3 state
			;// Joystick #4 (GameCard joystick #2)
			ld	A,(GE_GameCardJoy4Port)
			ld	C,A
			in	A,(C)													;// read joystick port
			cpl																;// invert bits -> 0: not pressd; 1: pressed
			ld	(GE_Joy4State),A							;// save joystick #4 state
  		");				
end; /* GetJoysticks */


/**
A megadott számú joystick megadott irányának vagy gombjának használatát adja vissza.<br/>
FIGYELEM! A lekérdezés előtt meg kell hívni a GE::GetJoysticks() vagy a GE::GetKeyboard() eljárások valamelyikét.<br/>
<br/>
Paraméterek:
<ul>
<li>Nr - a lekérdezni kívánt joystick száma<br/>
  &nbsp;1: joystick 1. vagy beépített<br/>
  &nbsp;2: joystick 2.<br/>
  &nbsp;3: GameCard 1. jostick<br/>
  &nbsp;4: GameCard 2. joystick<br/>
</li>
<li>JoyCode - a lekérdezni kívánt joystick irány vagy tűzgomb<br/>
  &nbsp;GE::JOY_LEFT - bal<br/>
  &nbsp;GE::JOY_RIGHT - jobb<br/>
  &nbsp;GE::JOY_UP - fel<br/>
  &nbsp;GE::JOY_DOWN - le<br/>
  &nbsp;GE::JOY_FIRE - tűz<li> 
<li>A GameCard JoyCode-jai:<br/>
  &nbsp;GE::GAMECARD_JOY_LEFT<br/>
  &nbsp;GE::GAMECARD_JOY_RIGHT<br/>
  &nbsp;GE::GAMECARD_JOY_UP<br/>
  &nbsp;GE::GAMECARD_JOY_DOWN<br/>
  &nbsp;GE::GAMECARD_JOY_FIRE<li> 
</ul>
A függvény ereménye:
<ul>
<li>True:  a megadott irány vagy a tűz gomb le van nyomva</li>
<li>False: a megadott irány vagy a tűz gomb NINCS lenyomva</li>
</ul>
<br/>
Példa a használatára:<br/> 
GE::GetJoysticks();<br/>
if (GE::Joystick(1, GE::JOY_LEFT)) then PlayerMoveLeft();<br/>
if (GE::Joystick(1, GE::JOY_FIRE)) then PlayerFire();<br/>
<br/>
Példa GameCard joystickok használatára:<br/>
GE::GetJoysticks();<br/>
if (GE::Joystick(3, GE::GAMECARD_JOY_LEFT)) then Player2_MoveLeft();<br/>
if (GE::Joystick(3, GE::GAMECARD_JOY_FIRE)) then Player2_Fire();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Get the status of joystick directions or fire button.<br/>
Params:
<ul>
<li>1. Nr:<br/>
  &nbsp;1: joystick #1 or internal<br/>
  &nbsp;2: joystick #2<br/>
  &nbsp;3: GameCard 1st jostick<br/>
  &nbsp;4: GameCard 2nd joystick<br/>
</li>
<li>2. JoyCode:<br/>
  &nbsp;GE::JOY_LEFT<br/>
  &nbsp;GE::JOY_RIGHT<br/>
  &nbsp;GE::JOY_UP<br/>
  &nbsp;GE::JOY_DOWN<br/>
  &nbsp;GE::JOY_FIRE<li> 
<li>JoyCode for GameCard:<br/>
  &nbsp;GE::GAMECARD_JOY_LEFT<br/>
  &nbsp;GE::GAMECARD_JOY_RIGHT<br/>
  &nbsp;GE::GAMECARD_JOY_UP<br/>
  &nbsp;GE::GAMECARD_JOY_DOWN<br/>
  &nbsp;GE::GAMECARD_JOY_FIRE<li> 
</ul>
Result
<ul>
<li>true:  the specified direction or fire button is pressed</li>
<li>false: not pressed</li>
</ul>
<br/>
Example:<br/> 
GE::GetJoysticks();<br/>
if (GE::Joystick(1, GE::JOY_LEFT)) then PlayerMoveLeft();<br/>
if (GE::Joystick(1, GE::JOY_FIRE)) then PlayerFire();<br/>
<br/>
Example for GameCard joysticks:<br/>
if (GE::Joystick(3, GE::GAMECARD_JOY_LEFT)) then Player2_MoveLeft();<br/>
if (GE::Joystick(3, GE::GAMECARD_JOY_FIRE)) then Player2_Fire();<br/>
<br/>
WARNING! It only works if you call the GetJoysticks() procedure before.<br/>
<br/>
If you also want to query the GameCard joysticks, call the InitGameCard() procedure in the initialization section.<br/>
<br/>
**/
function Joystick(Nr, JoyCode : global byte) : boolean;
begin	
	Asm("
	    ld  A,[GE_Nr]
	    cp  1
	    jp  z,joy1_test
	    cp  2
	    jp  z,joy2_test
	    cp  3
	    jp  z,joy3_test
	    cp  4
	    jp  z,joy4_test
			ret
	    ;// Joystick #1
	joy1_test:
			ld  A,[GE_JoyCode]
			ld  C,A							;// C = JoyCode
			ld	A,($0B59)				;// A = Line #8 of Keyboard Matrix -> Joystick #2
			and	C
			ret z								;// if A = 0 then return with 0 (FALSE)
			ld  A,1							;// set return value to 1 (TRUE)
			ret
			; // Joystick #2
	joy2_test:
			ld  A,[GE_JoyCode]
			ld  C,A							;// C = JoyCode
			ld	A,($0B5A)				;// A = Line #9 of Keyboard Matrix -> Joystick #2
			and	C
			ret z								;// if A = 0 then return with 0 (FALSE)
			ld  A,1							;// set return value to 1 (TRUE)
			ret
			;// Joystick #3
	joy3_test:
			ld  A,[GE_JoyCode]
			ld  C,A							;// C = JoyCode
			ld	A,(GE_Joy3State);// A = Joy3State
			and	C
			ret z								;// if A = 0 then return with 0 (FALSE)
			ld  A,1							;// set return value to 1 (TRUE)
			ret
	joy4_test:
			ld  A,[GE_JoyCode]
			ld  C,A							;// C = JoyCode
			ld	A,(GE_Joy4State);// A = Joy4State
			and	C
			ret z								;// if A = 0 then return with 0 (FALSE)
			ld  A,1							;// set return value to 1 (TRUE)
			ret
			");
end; /* Joystick */


/**
A GameCard kártya inicializálása.<br/>
Meg kell hívni mielőtt a GE::Joystick függvénnyel a GameCard-hoz csatlakoztatott joystick-eket lekérdeznénk.<br/>
Célszerű a program inicializációs részében meghívni.<br/>
<br/>
Példa a használatára:<br/>
GE::InitGameCard();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Initialization of the GameCard.<br/>
It must be called before using the GE::Joystick function for GameCard joysticks.<br/>
<br/>
Example:<br/>
GE::InitGameCard();<br/>
**/
procedure InitGameCard();
begin
	Asm("
			xor  A                    	;// A = 0 (False)
			ld  (GE_GameCardFound),A		;// GameCardFound = False
			ld	DE,GE_SLOT_0_BASE_ADDR 	;// DE -> ID of the Slot #0
			ld	IYL,4										;// IYL = number of slots
			ld	IYH,GE_SLOT_0_JOY3_PORT	;// Joystick port #3 on GameCard in the Slot #0
	GC_DETECT_SLOT:
			ld	HL,GE_GAME_CARD_ID			;// HL -> GameCard ID
			ld	B,7											;// length of GAME_CARD_ID
			push DE
	GC_FIND_ID_ITER:
			ld	A,(DE)									;// A = current Slot's ID byte
			cp	(HL)										;// compare to GAME_CARD_ID
			jp	nz,GC_NEXT_SLOT					;// if not equal, jump to next Slot
			inc	DE											;// DE -> next byte of the Slot ID
			inc	HL											;// HL -> next byte of GAME_CARD_ID
			djnz GC_FIND_ID_ITER
			pop	DE											;// DE -> ID of the current Slot
			ld	A,IYH										;// A = GameCard 1st joystick port
			ld	HL,GE_GameCardJoy3Port		
			ld	(HL),A									;// GameCardJoy3Port = A
			inc	A												;// A = GameCard 2nd joystick port
			inc	HL											;// HL -> GameCardJoy4Port
			ld	(HL),A									;// GameCardJoy4Port = A
			ld  A,1											;// A = 1 (true)
			ld  (GE_GameCardFound),A		;// GameCardFound = True;
			ret													;// GameCard is found -> return to caller
			;// next slot
	GC_NEXT_SLOT:
			pop	DE											;// DE -> ID of the last checked Slot
			dec	IYL											;// decrement the number of slots
			ret z												;// GameCard not found -> return to caller
			ld	A,IYH										;// A = 1st joystick port in the current Slot
			add	A,$10										;// A = 1st joystick port in the next slot
			ld	IYH,A										;// save value to IYH
			ex	DE,HL
			ld	BC,GE_SLOT_RAM_AREA_SIZE
			add	HL,BC
			ex	DE,HL										;// DE -> ID of the next Slot
			jp	GC_DETECT_SLOT					;// continue searching for GameCard.
			");
end; /* InitGameCard */


/*================================================
  		            S O U N D 		
=================================================*/

procedure Volume(SoundVolume : global byte); forward;

/**
A hangjel bekapcsolása.<br/>
A Sound() eljárás automatikusan meghívja, ha a hangjel nincs bekapcsolva.<br/>
<br/>
Példa a használatára:<br/>
GE::SoundOn();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
TVC OS sound sign initialization.<br/>
<br/>
Example: GE::SoundOn();<br/>
<br/>
Not necessary to use before calls Sound procedure.<br/>
You are only used if you have previously called SoundOff and want to turn the sound on again.
**/
procedure SoundOn();
begin
	Asm("
			ld	A,(GE_PORT_5_MEM_MIRROR)
			and	128+64										;// clear low 6 bits
			or	16												;// set bit #4 - sound sign enabled
			ld	(GE_PORT_5_MEM_MIRROR),A	;// set new value to system variable
			out	(GE_SOUND_HI_PORT),A			;// send new value to port #5
			ld  A,1
			ld  (GE_soundIsOn),A          ;// soundIsOn := True
	");
	Volume(15);
end;


/**
A hangjel kikapcsolása.<br/>
Meghívásakor elnémul az éppen szóló hang.<br/>
<br/>
Példa a használatára:<br/>
GE::SoundOff();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Disable firmware sound sign.<br/>
<br/>
Example: GE::SoundOff();<br/>
**/
procedure SoundOff();
begin
	Asm("
			xor	A													;// A = 0
		  out	(GE_SOUND_LO_PORT),A			;// send value to port (clear PITCH lower 8 bits)
			ld	A,(GE_PORT_5_MEM_MIRROR)
			and	128+64										;// clear low 6 bits (#0-#3: PITCH high 4 bits; #4:SOUND IT, #5:SOUND SIGN)
			out	(GE_SOUND_HI_PORT),A			;// send new value to port -> disable SOUND-IT, disable SOUND-SIGN, and clear PITCH high 4 bits
			xor A
			ld  (GE_soundIsOn),A          ;// soundIsOn := False
	");
end;


/**
A paraméterben megadott hang megszólaltatása.<br/>
<br/>
Paraméter:
<ul>
<li>Pitch: 0 - 4095 (4095: elnémítás)</li>
</ul>
Példa a használatára:<br/>
GE::Sound(3677);<br/>
<br/>
A hang addig fog szólni, amíg nem másik hang kiadásra nem kerül, vagy a NoSound() eljárást meg nem hívjuk.<br/>
A Pitch értékek megtalálhatóak a TV-Computer Kezelési útmutató című könyvében.<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Plays the sound specified in Pitch param.<br/>
Params:
<ul>
<li>Pitch (sound value): 0 - 4095 (4095: silent)</li>
</ul>
<br/>
Example: GE::Sound(3677);<br/>
<br/>
The sound plays until calls NoSound() procedure.<br/>
Calculation sound Hz: 195312.5 / (4096 - Pitch)<br/>
For example, the octave 4, #A sound (466.16 Hz) value is $E5D (decimal: 3677)<br/>
**/
procedure Sound(Pitch : global integer);
begin
	if (not soundIsOn) then
		SoundOn();
	Asm("
			ld	HL,[GE_Pitch]
			ld	A,L												;// A = pitch low byte
			out	(GE_SOUND_LO_PORT),A			;// send pitch low byte to port #4
			ld	A,(GE_PORT_5_MEM_MIRROR)
			and	128+64+32+16							;// clear low 4 bits
			or	H													;// set pitch high 4 bits
			out	(GE_SOUND_HI_PORT),A			;// send pitch 4 bits to port #5
	");
end;


/**
Az éppen szóló hang elnémítása.<br/>
<br/>
Példa a használatára:<br/>
GE::NoSound();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Stops the currently played sound.
**/
procedure NoSound();
begin
	Asm("
			ld	HL,4095										;// silent value
			ld	A,L												;// A = pitch low byte
			out	(GE_SOUND_LO_PORT),A			;// send pitch low byte to port #4
			ld	A,(GE_PORT_5_MEM_MIRROR)
			and	128+64+32+16							;// clear low 4 bits
			or	H													;// set pitch high 4 bits
			out	(GE_SOUND_HI_PORT),A			;// send pitch 4 bits to port #5
	");
end;


/**
Hangerő beállítása.<br/>
<br/>
Paraméter:<br/>
SoundVolume: hangerő. Értékei 0 - 15 között lehetnek. 15 a leghangosabb.<br/>
<br/>
Példa a használatára:<br/>
GE::Volume(15);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Sets sound volume to specified value<br/>
Params:<br/>
Volume: 0 - 15<br/>
<br/>
Example: GE::Volume(15);<br/>
**/
procedure Volume(SoundVolume : global byte);
begin
	/*
	if (SoundVolume > 15) then
		SoundVolume := 15;
	*/
	Asm("
			ld A,[GE_SoundVolume]					; // A = Volume
			sla	A													;// shift left volume bits
			sla	A													;// shift left again
			ld	E,A												;// E = shifted volume bits
			ld	A,(GE_PORT_6_MEM_MIRROR)	;// A = port #6 memory mirror
			and	128+64+2+1								;// clear bit #2 - #5 in A register
			or	E													;// set volume to A register bits #2 - #5
			ld	(GE_PORT_6_MEM_MIRROR),A	;// set value to port #6 mirror
			out	(GE_SOUND_VOLUME_PORT),A	;// send value to port #6
	");
end;


/*================================================
               D I G I   S O U N D 		
=================================================*/

/**
Digitális hangeffekt lejátszás inicializálása.<br/>
<br/>
Meg kell hívni mielőtt először használnánk a GE::PlayDigiSound eljárást.<br/>
<br/>
Példa a használatára:
GE::DigiSoundOn();<br/>
<br/>
Ez az eljárás engedélyezi a hangmegszakítást, letiltja a raster-megszakítást, és beállítja a megszakítás-kezelőt a Game Engine hangmegszakítás-kezelőjére.<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Initialization of playback of digi sounds.<br/>
<br/>
This procedure must be called before using GE::PlayDigiSound.<br/>
<br/>
Example: GE::DigiSoundOn();<br/>
<br/>
This procedure enables the sound interrupt, disables the cursor interrupt (raster interrupt) and sets the Interrupt Handler to the Game Engine's Sound Interrupt Handler.<br/>
**/
procedure DigiSoundOn();
begin
	Asm("halt												;// wait for cursor-interrupt for screen refresh syncronization
			xor	A
			ld	(GE_SoundITCounter),A		;// SoundITCounter = 0
      di													;// disable interrupts
			;// overwrite the system interrupt handler entry point to JP SOUND_IT_HANDLER instruction
			ld	HL,$38									;// HL -> start address of System Interrupt Handler
			ld	(HL),195								;// 195: JP
			ld  DE,SoundITHandler
			inc	HL
			ld	(HL),E
			inc	HL
			ld	(HL),D 									;// $38: JP SOUND_IT_HANDLER
			;// set frequency and enable sound interrupt
			ld	A,(GE_PORT_5_MEM_MIRROR)
			and	128+64									;// clear lower 6 bits (#0-#3: PITCH high 4 bits; #4:SOUND IT, #5:SOUND SIGN)
			or	@DIGI_FREQ_HI+32				;// set frequency on high 4 bits and set bit #5 to enable SOUND-IT
			ld	C,91										;// port #91: sound generator frequency divider
			in	B,(C)										;// clear sound generator frequency divider port for precise timing
			out	(GE_SOUND_HI_PORT),A		;// send register A value to port
			ld	A,GE_DIGI_FREQ_4_KHZ		;// digi frequency lower 8 bits
			out	(GE_SOUND_LO_PORT),A		;// send value to port
      ;// disable the cursor-interrupt
      ld	A,@CRTC_CUR_START_CHAR
			out	(GE_CRTC_REG_PORT),A		;// select CRTC register #10
			ld	A,3+32                  ;// set bit #5 (+ the default value 3) to disable the cursor-interrupt
			out	(GE_CRTC_DATA_PORT),A		;// send value to CRTC data port
			ld	B,A											;// save value to register B
			ld	A,@CRTC_CUR_END_CHAR
			out	(GE_CRTC_REG_PORT),A		;// select CRTC register #11
			ld	A,B                     ;// restore value from register B
			out	(GE_CRTC_DATA_PORT),A		;// send value to CRTC data port
			;// init shadow registers for SOUND-IT
			exx													;// switch to shadow registers (HL', DE', BC')
			ld	DE,GE_SoundITCounter		;// DE' -> SoundITCounter
			ld	HL,GE_NoDigiSoundIsPlaying ;// HL' -> NoDigiSoundIsPlaying - bit #6 is set to indicate that no digi sound FX need to be playing
			ld	C,GE_SOUND_VOLUME_PORT	;//  C' = SOUND_VOLUME_PORT
			exx													;// switch to back to normal registers (HL, DE, BC)
			ei													;// enable interrupts
			ret
			;// ===========================
			;// THE SOUND INTERRUPT HANDLER
			;// ===========================
	SoundITHandler:
	    di
			out	(GE_SYS_IT_PORT),A			;// reset IT
			ex	AF,AF'									;// switch to AF'
			exx													;// switch to shadow registers (HL', DE', BC')
			ld	A,(DE)									;// A = SoundITCounter (DE' -> SoundITCounter)
			inc	A												;// Inc (SoundITCounter)
			ld	(DE),A                  ;// save the SoundITCounter value
			bit	6,(HL)									;// the bit #6 of the byte addressed by (HL) indicates that this is the last byte of the sound effect
			jp	nz,SoundITHandlerEnd		;// if bit #6 is not zero then jump to SOUND_FX_PLAY_DONE
			outi												;// send a byte from (HL) address to port C, and INC HL, DEC B
	SoundITHandlerEnd:
			exx													;// switch back to normal registers (HL, DE, BC)
			ex	AF,AF'									;// switch back to AF
			ei													;// enable interrupts
			ret		
	    ");
end; /* DigiSoundOn */ 


/**
A digitális hangeffekt lejátszás kikapcsolása.<br/>
<br/>
Akkor érdemes meghívni ezt az eljárást, ha korábban a DigiSoundOn() eljárás meg volt hívva, de az adott programrészben nincs szükség digitális hangeffekt lejátszásra. Ez kis mértékben gyorsítja a programot. Vagy mielőtt visszakapcsolnánk a TV-Computer eredeti megszakítás-kezelőjét a GE::EnableTVCITHandler() eljárással.<br/>
<br/>
Ez az eljárás letiltja a hangmegszakítást, engedélyezi a raster-megszakítást, és beállítja a megszakítás-kezelőt a Game Engine megszakítás-kezelőjére.<br/>
Példa a használatára:
GE::DigiSoundOff();<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Finishing of playback of digi sounds.<br/>
<br/>
Use this procedure if you stop using the GE::PlayDigiSound or before you want to enable TVC's system interrupt handler (GE::EnableTVCITHandler).<br/>
<br/>
This procedure disables the sound interrupt, enables the cursor interrupt (raster interrupt) and sets the Interrupt Handler to the Game Engine's Interrupt Handler.<br/>
**/
procedure DigiSoundOff();
begin
	Asm("di													;// disable interrupts	    
      ;// enable the cursor-interrupt
			ld	A,@CRTC_CUR_START_CHAR
			out	(GE_CRTC_REG_PORT),A		;// cursor pos felső byte regiszter kiválasztása 
			ld	A,3                     ;// clear the bit #5 and #6 to disable the cursor-interrupt and set the default value (3)
			out	(GE_CRTC_DATA_PORT),A		;// H-ban levő cursor pos felső byte kiírása
			;// overwrite the system interrupt handler entry point to JP CURSOR_IT_HANDLER instruction
			ld	HL,$38									;// HL -> start address of System Interrupt Handler
			ld	(HL),195								;// 195: JP
			ld  DE,GE_IT_HANLDER
			inc	HL
			ld	(HL),E
			inc	HL
			ld	(HL),D 									;// $38: JP GE_IT_HANLDER
			;// disables the sound interrupt
			ld	A,(GE_PORT_5_MEM_MIRROR)
			and	128+64									;// clear lower 6 bits (#0-#3: PITCH high 4 bits; #4:SOUND IT, #5:SOUND SIGN)
			out	(GE_SOUND_HI_PORT),A		;// send register A value to port -> disable SOUND-IT, disable SOUND-SIGN, and clear PITCH high 4 bits
			xor	A												;// A = 0
			out	(GE_SOUND_LO_PORT),A		;// send value to port (clear PITCH lower 8 bits)
			ei													;// enable interrupts
	    ");
end; /* DigiSoundOff */ 


/**
Digitális hangeffekt lejátszása.<br/>
<br/>
Paraméter:
<ul>
<li>SoundEffect: 4 bites/4 KHz-es hangminta memóriacíme</li>
</ul>
<br/>
Példa a használatára:<br/>
var ExplosionSFX : incbin("resources/ExplosionSFX.bin");<br/>
<br/>  
GE::DigiSoundOn();<br/>
<br/>
GE::PlayDigiSound(#ExplosionSFX);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Starts playing a digi sound effect<br/>
Params:
<ul>
<li>SoundEffect: adress of the 4 bit / 4 KHz sound effect</li>
</ul>
<br/>
Example:<br/>
var ExplosionSFX : incbin("resources/ExplosionSFX.bin");<br/>
GE::DigiSoundOn();<br/>
GE::PlayDigiSound(#ExplosionSFX);<br/>
<br/>
**/
procedure PlayDigiSound(SoundEffect : global pointer);
begin
	Asm("
      di												;// disable interrupts because will use shadow registers
			exx												;// switch to shadow registers (HL', DE', BC')
			ld	HL,[GE_SoundEffect]		;// HL' -> SoundEffect
			exx												;// switch back to normal registers (HL, DE, BC)
			ei												;// enable interrupts
	    ");
end; /* PlayDigiSound */


/**
Várakozás a képernyőfrissítésre.<br/>
<br/>
Ezt kell használni a GE::WaitForSync() helyett, ha a GE::DigiSoundOn() eljárás korábban meghívásra került.<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Waits until a vertical sync has been performed.<br/>
<br/>
Use this procedure instead of GE::WaitForSync() if you have previously enabled the sound interrupt with the GE::DigiSoundOn() procedure.<br/>
**/
procedure WaitForDigiSoundSync();
begin
	Asm("
	WaitDigiSync:
			ld	A,(GE_SoundITCounter)
			cp	GE_SOUND_IT_50HZ
			jp	c,WaitDigiSync  			;// if SoundITCounter < SOUND_IT_50HZ, then wait, else the counter reached the 50 Hz value
			sub	GE_SOUND_IT_50HZ			;// A = A - SOUND_IT_50HZ -> reset the SoundITCounter
			ld	(GE_SoundITCounter),A
		  ");
end; /* WaitForDigiSoundSync */


/**
Visszadja, hogy éppen folyik-e digitális hangeffekt lejátszás, vagy az már véget ért.<br/>
A függvény visszatérő értékei:<br/>
True: folyamatban van digitális hangeffekt lejátszása<br/>
False: NINCS folyamatban digitális hangeffekt lejátszása<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Returns whether a digital sound effect is playing.<br/>
<br/>
If the result is True, then the digi sound is playing.<br/>
If the result is False, then the digi sound is not playing.<br/>
<br/>
Example:<br/>
if (not GE::IsDigiSoundPlaying()) then GE::PlayDigiSound(#MissileLaunchSFX);<br/>
<br/>   
**/
function IsDigiSoundPlaying : boolean;
begin
	Asm("			
	    di                    ;// disable interrupts
			exx										;// switch to shadow registers (HL', DE', BC')
			bit	6,(HL)						;// Is any sound FX playing? (if bit 6 is zero, then sound FX is playing)
			exx
			ei                    ;// enable interrupts
			jp	z,PlayingSFXTrue	;// if any digi sound is playing, then jump
			xor	A									;// A = 0 -> the result is False
			ret
  PlayingSFXTrue:
      ld  A,1								;// A = 1 -> the result is true
      ret
			");
end; /* IsDigiSoundPlaying */


/*===============================================
                  W R I T E 
===============================================*/

/**
Karakterkészlet beállítása. A WriteText használata előtt meg kell hívni.<br/>
<br/>
Paraméterek:
<ul>
<li>CharSetPtr: a karaterkészletet tartalmazó bitmap memóriacíme</li>
<li>CharSetImgWidth: a karaterkészletet tartalmazó bitmap szélessége byte-okban<li> 
<li>CharWidth: egy karakter szélessége byte-okban<li> 
<li>CharHeight: egy karakter magassága pixelekben<li> 
</ul>
Példa a használatára:<br/>
var CharSet	: incbin("resources/images/CharSet2.bin");<br/>
GE::InitCharSet(#CharSet, 118, 2, 8);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Initialization of the character set<br/>
<br/>
This procedure must be called before using GE::WriteText.<br/>
<br/>
<br/>
Params:
<ul>
<li>CharSetPtr: address of charset bitmap</li>
<li>CharSetImgWidth: with of the charset image in bytes<li> 
<li>CharWidth: width of a character in bytes<li> 
<li>CharHeight: height of a character in pixels<li> 
</ul>
<br/>
**/
procedure InitCharSet(CharSetPtr : global pointer; CharSetImgWidth : global integer; CharWidth : global byte; CharHeight : global byte);
begin	
end; /* InitCharSet */


/**
Szöveg kiírása a megadott képernyőpozícióba.<br/>
<br/>
Előtte az InitCharSet eljárással inicializálni kell a karakterkészletet.<br/>
<br/>
Params:
<ul>
<li>X: vízszintes pozíció. Értéke 0-63 között lehet.</li>
<li>Y: függőleges pozíció. Értéke 0-239 között lehet.</li>
<li>Text: egy idézőjelek közötti szöveg, vagy egy string memóriacíme.</li>
</ul>
<br/>
Példa a használatára:<br/>
var CharSet : incbin("resources/images/CharSet.bin");<br/>
Text1 : string = ("TV-COMPUTER");<br/>
// init CharSet<br/>
GE::InitCharSet(#CharSet, 118, 2, 7);<br/>
// write text<br/>
GE::WriteText(0, 100, "HELLO WORLD!");<br/>
GE::WriteText(0, 130, #Text1);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Write a text to the specified screen position.<br/>
<br/>
Must be called the GE::InitCharSet procedure before using GE::WriteText.<br/>
Params:
<ul>
<li>X: horizontal position (0-63)</li>
<li>Y: vertical position (0-239)</li>
<li>Text: pointer to a 0 terminated string</li>
</ul>
<br/>
Example:<br/>
var CharSet : incbin("resources/images/CharSet.bin");<br/>
Text1 : string = ("TV-COMPUTER");<br/>
// init CharSet<br/>
GE::InitCharSet(#CharSet, 118, 2, 7);<br/>
// write text<br/>
GE::WriteText(0, 100, "HELLO WORLD!");<br/>
GE::WriteText(0, 130, #Text1);<br/>
<br/>
**/
procedure WriteText(X, Y : global byte; Text : global ^byte);
begin
  Asm("  
      ;// init
      ld  IX,(GE_Text]  ;// IX -> Text
      ld  A,(GE_CharWidth)
			ld  L,A           ;// L = CharWidth
			ld  (write_text_calc_char+1),A ;// modify the ld B,2 to ld B,CharWidth
			ld  (write_text_next_char+1),A ;// modify the ld BC,2 to ld BC,CharWidth
			ld  A,GE_SCREEN_WIDTH
			sub L             ;// A = SCREEN_WIDTH - CharWidth
			ld  L,A           ;// L = SCREEN_WIDTH - CharWidth
			ld  H,0           ;// HL = SCREEN_WIDTH - CharWidth
			ld (write_text_set_next_line+1),HL ;// modify the ld BC,62 to ld BC,SCREEN_WIDTH-CharWidth
			ld	A,[GE_CharHeight]
			ld (write_text_init_char_loop+1),A ;// modify the ld A,8 to ld A,CharHeight
      ;// calc screen position      
      ld  A,[GE_Y]			;// A = Y pos
			ld  L,A
			xor A             ;// A = 0
			ld  H,A						;// H = 0
			srl H
			rr  L
			rra
			srl H
			rr  L
			rra
			ld  H,L
			ld  L,A           ;// HL = Y * 64
			ld 	BC,(GE_ScreenAddr);// BC -> screen start address
			add HL,BC					;// HL = ScreenAddr + (Y * 64)
			ld 	A,[GE_X]  		;// A  = X pos
			ld 	B,0
			ld 	C,A						;// BC = X
			add HL,BC
			ex  DE,HL					;// DE -> screen start address + (Y * 64) + X
			;// write text
	write_text:      
			ld	A,(IX+0)			;// A = character from the text
			or	A							;// A == 0?
			ret	z							;// end of the text -> return to caller
			cp	32						;// char < SPACE?
			jp	c,write_text_skip_char
			cp  144           ;// 144: Á
			jp  c,write_text_check_skip
	    sub 53            ;// init Á,É,Í,Ó,Ö,Ő,Ú,Ü,Ű chars: Á=Z+1(144->91); É=Z+2(145->92), etc.
	    jp  write_text_set_charset
  write_text_check_skip:			
			cp	91						;// char >= [ -> Z+1
			jp	nc,write_text_skip_char
	write_text_set_charset:
      ld	HL,(GE_CharSetPtr) ;// HL -> character set image
			sub	32            ;// A = char - 32
			jp	Z,write_text_char
			;// calc current char address in the CharSet
  write_text_calc_char:
      ld  B,2           ;// modified in the init section to ld B,CharWidth
      ld	C,A           ;// C = char - 32
      xor A             ;// A = 0
  write_text_calc_char_loop:    
			add	A,C
			djnz write_text_calc_char_loop
			ld	C,A			      ;// BC = (char - 32) * CharWidth
			add	HL,BC					;// HL -> current character in the charset image
	write_text_char:
      push DE
  write_text_init_char_loop:
      ld  A,8           ;// modified in the init section to ld A,CharHeight
	write_text_char_loop:			
	    ld	BC,[GE_CharSetImgWidth]
	    ldi
	    ldi
			add	HL,BC					;// HL -> next line in the charset
			ex	DE,HL			
	write_text_set_next_line:
			ld  BC,62         ;// modified in the init section to ld BC,SCREEN_WIDTH-CharWidth
			add	HL,BC
			ex	DE,HL					;// DE -> next line on the screen
			dec	A
			jp	NZ,write_text_char_loop
			pop	DE
	write_text_next_char:
	    ld  BC,2          ;// modified in the init section to ld BC,CharWidth
	    ex  DE,HL
	    add HL,BC
	    ex  DE,HL					;// DE -> next char screen pos.
	write_text_skip_char:
			inc	IX						;// IX -> next character in the text
			jp	write_text
			");
 end; /* WriteText */


/*===============================================
               H E L P E R S 
===============================================*/

/**
Egy byte érték lekérése a megadott sorszámú portról<br/>
<br/>
Paraméter:
<ul>
<li>Nr: a hardver port száma (0 - 255)</li>
</ul>
<br/>
Példa a használatára:<br/> 
KeretSzín := GE::In(0);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Input value from a hardware port<br/> 
<br/>
Params:
<ul>
<li>Nr: the hardware port number (0 - 255)</li>
</ul>
<br/>
Example: Value := GE::In(0);<br/>
<br/>
**/
function In(Nr : global byte) : byte;
begin
	Asm("
			ld 	A,[GE_Nr]
			ld  C,A
			in	A,(C)
			ret
			");
end;


/**
Egy byte érték kiküldése a megadott sorszámú portra<br/>
<br/>
Paraméterek:
<ul>
<li>Nr: a port sorszáma (0 - 255)</li>
<li>Value: az érték, amit ki küldünk (0 - 255)</li>
</ul>
<br/>
Példa a használatára:<br/> 
// Keret színének átállítása:<br/> 
GE::Out(0, 130);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Output a value to a hardware port<br/> 
<br/>
Params:
<ul>
<li>Nr: the hardware port number (0 - 255)</li>
<li>Value: the value to send to the port (0 - 255)</li>
</ul>
<br/>
Example: GE::Out(0, 130);<br/>
<br/>
**/
procedure Out(Nr, Value : global byte);
begin
	Asm("
			ld 	A,[GE_Nr]
			ld  C,A
			ld 	A,[GE_Value]
			out	(C),A
			");
end;


/**
Egy random byte-ot ad vissza, aminek az értéke 0-255 között lesz.<br/>
<br/>
Közvetlenül egymás után hívva közeli, növekvő értékeket fog adni, de egy játék főciklusában egyszer-egyszer meghívva megfelelő lehet.<br/>
<br/>
Ettől jobb véletlenszámot ad a TRSE Random unitjában levő függvény.<br/>
<br/>
Példa a használatára:<br/>
veletlen := GE::Rnd();<br/>
if (veletlen > 30) then JobbraFordul else BalraFordul;<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Get random number (byte) between 0-255<br/>
**/
function Rnd() : byte;
begin
	Asm("
			ld 	A,R
			");
end;


/**
Várakozik a paraméterben megadott egységnyi ideig<br/> 
<br/>
Paraméter:<br/>
DelayTicks: ennyi egységnyi ideig fog várakozni. 1 egység 20.096 ms<br/>
<br/>
Példa a használatára:<br/>
// várakozás 1 másodpercig:<br/>
GE::Delay(50);<br/>
<br/>
FIGYELEM! A GE::DigiSoundOn() használata után az egység 1/4 ms lesz.
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Waiting for param DelayTicks * 20 ms<br/> 
The accurate value: 20.096 ms - the default Raster-interrupt frequency<br/>
<br/>
Example: GE::Delay(10);<br/>
<br/>
WARNING! The delay duration changes by the Sound-interrupt frequency when Sound-interrupt is set.
**/
procedure Delay(DelayTicks : global integer);
begin
	Asm("
	    ld A,[GE_DelayTicks]
	delay_loop:    
	    halt
	    dec A
	    jr nz,delay_loop
	    ");
end;


/**
Visszaadja, hogy a paraméterben átadott byte páratlan szám-e.<br/>
<br/>
Paraméter:<br/>
Nr: tetszőleges byte típusú változó vagy érték<br/>
<br/>
A függvény visszatérő értékei:<br/>
True: a paraméterben átadott szám páratlan<br/>
False: a paraméterben átadott szám páros<br/>
<br/>
Példa a használatára:<br/>
if (GE::Odd(i)) then X := X + 1;<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Return true if the byte param is odd<br/>
<br/>
Example: if (GE::Odd(Counter)) then MoveEnemies;<br/>
<br/>
**/
function Odd (Nr : global byte) : boolean;
begin
	Asm("
	    ld  A,[GE_Nr]
	    and 1
			");
end;


/**
A paraméterben átadott integer típusú változót vagy értéket string-re konvertálja<br/>
<br/>
A konvertálás után a numerikus érték kiíratható lesz a GE::WriteText utasítással.<br/>
<br/>
Paraméter:<br/>
IntNum: tetszőleges integer típusú változó vagy érték<br/>
<br/>
A konvertálás eredménye a GE::NumStr változóban lesz, amit a példában mutatott módon lehet kiratni.
<br/>
Példa a használatára:<br/>
var Szam : integer = 12345;<br/>
<br/>
GE::IntToStr(Szam);<br/>
GE::WriteText(0, 0, #GE_NumStr);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Convert an integer to a string<br/> 
The result is placed in the GE::NumStr variable.
<br/>
Example:<br/>
GE::IntToStr(Number);<br/>
GE::WriteText(0, 0, #GE_NumStr);<br/>
**/
procedure IntToStr(IntNum : global integer);
begin	
	for i := 0 to 5 do
	  NumStr[i] := 0;	  
	i := 0;
	IntNum2 := 10000;
	if (IntNum >= IntNum2) then
	begin				
		X := 0;
		while (IntNum >= IntNum2) do
		begin
			IntNum -= IntNum2;
			inc (X);
		end;
		NumStr[i] := 48 + X;
		Inc(i);
	end;
	IntNum2 := 1000;
	if (IntNum >= IntNum2) then
	begin				
		X := 0;
		while (IntNum >= IntNum2) do
		begin
			IntNum -= IntNum2;
			inc (X);
		end;
		NumStr[i] := 48 + X;
		Inc(i);
	end
	else
	begin
		if (i > 0) then
		begin
			NumStr[i] := 48; // ASCII "0"
			Inc(i);
		end;
	end;
	IntNum2 := 100;
	if (IntNum >= IntNum2) then
	begin				
		X := 0;
		while (IntNum >= IntNum2) do
		begin
			IntNum -= IntNum2;
			inc (X);
		end;
		NumStr[i] := 48 + X;
		Inc(i);
	end
	else
	begin
		if (i > 0) then
		begin
			NumStr[i] := 48; // ASCII "0"
			Inc(i);
		end;
	end;
	IntNum2 := 10;
	if (IntNum >= IntNum2) then
	begin				
		X := 0;
		while (IntNum >= IntNum2) do
		begin
			IntNum -= IntNum2;
			inc (X);
		end;
		NumStr[i] := 48 + X;
		Inc(i);
	end
	else
	begin
		if (i > 0) then
		begin
			NumStr[i] := 48; // ASCII "0"
			Inc(i);
		end;
	end;
	X := IntNum;
	NumStr[i] := 48 + X;
end;


/**
A paraméterben átadott byte típusú változót vagy értéket string-re konvertálja<br/>
<br/>
A konvertálás után a numerikus érték kiíratható lesz a GE::WriteText utasítással.<br/>
<br/>
Paraméter:<br/>
Nr: tetszőleges byte típusú változó vagy érték<br/>
<br/>
A konvertálás eredménye a GE::NumStr változóban lesz, amit a példában mutatott módon lehet kiratni.
<br/>
Példa a használatára:<br/>
GE::IntToStr(Sprite.X);<br/>
GE::WriteText(0, 0, #GE_NumStr);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Convert a byte to a string<br/> 
The result is placed in the NumStr variable.
<br/>
Example:<br/>
GE::ByteToStr(Sprite.X);<br/>
GE::WriteText(#GE_NumStr);<br/>
**/
procedure ByteToStr(Nr : global byte);
begin	
	for i := 0 to 3 do
	  NumStr[i] := 0;
	i := 0;
	if (Nr >= 100) then
	begin
		X := 0;
		while (Nr >= 100) do
		begin
			Nr := Nr - 100;	
			Inc (X);
		end;
		NumStr[i] := 48 + X;
		Inc(i);
		if (Nr < 10) then
		begin
			NumStr[i] := 48; // ASCII "0"
			Inc(i);
		end;	
	end;
	if (Nr >= 10) then
	begin
		X := 0;
		while (Nr >= 10) do
		begin
			Nr := Nr - 10;	
			Inc (X);
		end;
		NumStr[i] := 48 + X;
		Inc(i);
	end;
	NumStr[i] := 48 + Nr;
end;


/**
Memóriaterület feltöltése a megadott byte mintával<br/>
Paraméterek:
<ul>
<li>MemAddr: a kezdő memóriacím</li>
<li>Size: a kitöltendő memóriaterület mérete</li>
<li>Pattern: a minta byte a kitöltéshez</li>
</ul>
<br/>
Példa a használatára:<br/>
var Buffer : array[200] of byte;<br/>
<br/>
// 200 darab 1-essel feltölti a Buffer tömböt<br/>
GE::FillMem(Buffer, 200, 1);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Fill memory with a specified byte<br/>
Params:
<ul>
<li>MemAddr - the memory address where starts the filling</li>
<li>Size - how many bytes to fill with the pattern</li>
<li>Pattern - the byte that is used for filling</li>
</ul>
<br/>
Example: GE::FillMem(Buffer, 200, 0);<br/>
<br/>
**/
procedure FillMem(MemAddr : global integer; Size : global integer; Pattern : global byte);
begin
	Asm("
			  ld  HL,[GE_MemAddr]
			  ld  BC,[GE_Size]
			  ld  A,[GE_Pattern]
				ld	E,L
				ld	D,H			;// DE = HL
				inc	DE			;// DE = HL + 1
				ld	(HL),A
				dec	BC
				ldir
				ret
			");
end; /* FillMem */  


/**
Átmásol a forrás memóriacímről a cél memóriacímre megadott számú byte-ot<br/>
<br/>
Paraméterek
<ul>
<li>SourcePtr: a forrás memóriacím</li>
<li>DestPtr: a cél memóriacím</li>
<li>Size: a másolandó byte-ok száma</li>
</ul>
<br/>
Példa a használatára:<br/>
var TitleImage : incbin("resources/images/Title.bin");<br/>
// Átmásol egy teljes képernyő méretű képet a TitlePicture változóból a képernyő kezdőcímére:<br/>
GE::MemCopy(#TitleImage, GE::ScreenAddr, GE::SCREEN_SIZE);<br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Copy data from the source memory address to the destination memory address. 
<ul>
<li>SourcePtr: pointer to the source memory address</li>
<li>DestPtr: pointer to destination memory address</li>
<li>Size: number of bytes to copy</li>
</ul>
<br/>
Example:<br/>
var TitleImage : incbin("resources/images/Title.bin");<br/>
<br/>
// Copies a full-screen size image from the TitlePicture variable to the screen:<br/>
GE::MemCopy(#TitleImage, GE::ScreenAddr, GE::SCREEN_SIZE);<br/><br/>
<br/>
**/
procedure MemCopy(SourcePtr, DestPtr: global pointer; Size: global integer);
begin
  Asm("
  		ld  HL,[GE_SourcePtr]
			ld  DE,[GE_DestPtr]
			ld  BC,[GE_Size]
			ldir
			");
end;


/**
Kicsomagol egy ZX7 tömörítéssel becsomagolt adatot a megadott memóriacímre<br/>
Paraméterek:
<ul>
<li>SourcePtr: tömörített adat memóracíme</li>
<li>DestPtr: a memóriacím, ahová kicsomagolja</li>
</ul>
<br/>
Példa a használatára:<br/>
// A ZX7 tömörítésű címkép:<br/>
var TitleImageZX7 : incbin("resources/images/TitlePic.zx7");<br/>
// A tömörített kép kicsomagolása a képernyő kezdőcímére:<br/>
GE::ZX7Decompress(#TitleImageZX7, GE::ScreenAddr);<br/><br/>
<br/>
<br/>
ENGLISH:<br/>
-------------<br/>
Decompress the ZX7 compressed data to the specified memory address<br/>
<ul>
<li>SourcePtr: pointer to the ZX7 compressed data</li>
<li>DestPtr: pointer to destination memory address</li>
</ul>
<br/>
Example:<br/>
var TitlePicZX7 : incbin("resources/images/TitlePic.zx7");<br/>
<br/>
GE::ZX7Decompress(#TitlePicZX7, $8000);<br/><br/>
<br/>
**/
procedure ZX7Decompress(SourcePtr, DestPtr: global pointer);
begin
	Asm("
	    ld  HL,[GE_SourcePtr]	;// HL -> compressed data
			ld  DE,[GE_DestPtr]   ;// DE -> destination memory address
	DZX7STANDARD:		
			ld	A,$80
	COPYBYTELOOPEV:
			ldi										;// copy literal byte
	MAINLOOPEV:
			add	A,A								;// check next bit
			jr	Z,LOADBITS1				;// no more bits left?
			jr	C,LENSIZESTARTOD	;// next bit indicates either literal or sequence				
	COPYBYTELOOPOD:
			ldi										;//copy literal byte
	MAINLOOPOD:
			add	A,A								;//  check next bit
			jr	NC,COPYBYTELOOPEV	;// next bit indicates either literal or sequence
      ;// determine number of bits used for length (Elias gamma coding)
	LENSIZESTARTEV:
			push	DE
			ld	BC,1
			ld	D,B
	LENSIZELOOPEV:
			inc	D
			add	A,A								;// check next bit
			jr	Z,LOADBITS2EV			;// no more bits left?
			jr	NC,LENSIZELOOPEV
			jp	LENVALUESTARTEV
      ;// determine number of bits used for length (Elias gamma coding)
	LENSIZESTARTOD:		
			push	DE
			ld	BC,1
			ld	D,B
	LENSIZELOOPOD:	
			inc	D
			add	A,A								;// check next bit
			jr	Z,LOADBITS2OD			;// no more bits left?
			jr	NC,LENSIZELOOPOD
			jp	LENVALUESTARTOD
      ;// determine length
	LENVALUELOOPEV:		
			add	A,A								;// check next bit
			jr	Z,LOADBITS3EV			;// no more bits left?
			rl	C
			rl	B
			jr	C,EXITEV		
			;// check end marker
	LENVALUESTARTEV:		
			dec	D
			jr	NZ,LENVALUELOOPEV
			inc	BC								;// adjust length
      ;// determine offset
	OFFSETSTARTOD:
			ld	E,(HL)						;// load offset flag (1 bit) + offset value (7 bits)
			inc	HL
			db  $CB,$33           ;// sll	E	- opcode for undocumented instruction SLL E aka SLS E
			jr	NC,OFFSETENDOD		;// if offset flag is set,load 4 extra bits
			add	A,A								;// check next bit
			rl	D									;// insert first bit into D
			add	A,A								;// check next bit
			jr	Z,LOADBITS4				;// no more bits left?
			rl	D									;// insert second bit into D
			add	A,A								;// check next bit
			rl	D									;// insert third bit into D
			add	A,A								;// check next bit
			jr	Z,LOADBITS5				;// no more bits left?
			ccf
			jr	C,OFFSETENDOD
	OFFSETINCOD:
			inc	D									;// equivalent to adding 128 to DE
	OFFSETENDOD:	
			rr	E									;// insert inverted fourth bit into E
      ;// copy previous sequence
			ex	(SP),HL						;// store source,restore destination
			push	HL							;// store destination
			sbc	HL,DE							;// HL = destination - offset - 1
			pop	DE								;// DE = destination
			ldir
			pop	HL								;// restore source address (compressed data)
			jp	MAINLOOPOD				
	LOADBITS1:
			ld	A,(HL)						;// load another group of 8 bits
			inc	HL
			rla
			jr	C,LENSIZESTARTOD	;// next bit indicates either literal or sequence
			jp	COPYBYTELOOPOD				
	LOADBITS2EV:		
			ld	A,(HL)						;// load another group of 8 bits
			inc	HL
			rla
			jr	NC,LENSIZELOOPEV
			jp	LENVALUESTARTEV				
	LOADBITS2OD:	
			ld	A,(HL)						;// load another group of 8 bits
			inc	HL
			rla
			jr	NC,LENSIZELOOPOD
			jp	LENVALUESTARTOD				
	LOADBITS3EV:	
			ld	A,(HL)						;// load another group of 8 bits
			inc	HL
			rla
			rl	C
			rl	B
			jp	NC,LENVALUESTARTEV ;// check end marker
	EXITEV:
			pop	DE
			ret				
	LOADBITS4:
			ld	A,(HL)						;// load another group of 8 bits
			inc	HL
			rla
			rl	D									;// insert second bit into D
			add	A,A								;// check next bit
			rl	D									;// insert third bit into D
			add	A,A								;// check next bit
			ccf
			jr	C,OFFSETENDOD
			jp	OFFSETINCOD				
	LOADBITS5:	
			ld	A,(HL)						;// load another group of 8 bits
			inc	HL
			rla
			ccf
			jr	C,OFFSETENDOD
			jp	OFFSETINCOD
      ;// determine length
	LENVALUELOOPOD:
			add	A,A								;// check next bit
			jr	Z,LOADBITS3OD			;// no more bits left?
			rl	C
			rl	B
			jr	C,EXITOD					;// check end marker
	LENVALUESTARTOD:		
			dec	D
			jr	NZ,LENVALUELOOPOD
			inc	BC								;// adjust length                              
      ;// determine offset
	OFFSETSTARTEV:
			ld	E,(HL)						;// load offset flag (1 bit) + offset value (7 bits)
			inc	HL
			db  $CB, $33          ;// sll	E	- opcode for undocumented instruction SLL E aka SLS E
			jr	NC,OFFSETENDEV		;// if offset flag is set,load 4 extra bits
			add	A,A								;// check next bit
			jr	Z,LOADBITS6				;// no more bits left?
			rl	D									;// insert first bit into D
			add	A,A								;// check next bit
			rl	D									;// insert second bit into D
			add	A,A								;// check next bit
			jr	Z,LOADBITS7				;// no more bits left?
			rl	D									;// insert third bit into D
			add	A,A								;// check next bit
			ccf
			jr	C,OFFSETENDEV
	OFFSETINCEV:
			inc	D									;// equivalent to adding 128 to DE
	OFFSETENDEV:	
			rr	E									;// insert inverted fourth bit into E
      ;// copy previous sequence
			ex	(SP),HL						;// store source,restore destination
			push	HL							;// store destination
			sbc	HL,DE							;// HL = destination - offset - 1
			pop	DE								;// DE = destination
			ldir
			pop	HL								;// restore source address (compressed data)
			jp	MAINLOOPEV				
	LOADBITS3OD:	
			ld	A,(HL)						;// load another group of 8 bits
			inc	HL
			rla
			rl	C
			rl	B
			jp	NC,LENVALUESTARTOD ;// check end marker
	EXITOD:
			pop	DE
			ret				
	LOADBITS6:
			ld	A,(HL)						;// load another group of 8 bits
			inc	HL
			rla
			rl	D									;// insert first bit into D
			add	A,A								;// check next bit
			rl	D									;// insert second bit into D
			add	A,A								;// check next bit
			rl	D									;// insert third bit into D
			add	A,A								;// check next bit
			ccf
			jr	C,OFFSETENDEV
			jp	OFFSETINCEV				
	LOADBITS7:	
			ld	A,(HL)						;// load another group of 8 bits
			inc	HL
			rla
			rl	D									;// insert third bit into D
			add	A,A								;// check next bit
			ccf
			jr	C,OFFSETENDEV
			jp	OFFSETINCEV
			ret
	    ");
end; /* ZX7Decompress */	

 
end.