program SzinSorok;
@use "TVC"

/* GRAPHICS2 (2 szín, 512x240): fekete papír, rajta egy kör és egy X (tinta = 1. paletta),
   a tinta színét (port $61) soronként váltjuk a 16 színen át, ismétlődve.
   A rajz egyszer készül (Rascal), a raszter-ciklus (asm) csak a palettát írja.
   Időzítés: saját megszakítás-kezelő (csak nyugtáz), halt = szinkron a raszter-IT-re
   (a 239. sor végén), utána di alatt pontosan 200 T-s sorok (1 sor = 64 us @ 3,125 MHz). */

var
	Szinek		:	array[16] of byte = (0, 1, 4, 5, 16, 17, 20, 21, 64, 65, 68, 69, 80, 81, 84, 85);
	Sorszin		:	array[240] of byte;
	Elo_Sorok	:	byte = 72;	// ennyi sor várakozás az IT (239. sor vége) után a 0. sorig
	Finom		:	byte = 10;	// finom eltolás (13 T lépés): a színváltás vízszintes helye a soron belül
	i, j		:	byte;
	/* rajzoláshoz */
	Maszk		:	array[8] of byte = (128, 64, 32, 16, 8, 4, 2, 1);
	p			:	pointer;
	ofs, t		:	integer;
	kx, ky		:	integer;
	lx, ly, acc	:	integer;
	s, r2		:	integer;

const KOR_X : integer = 256;	// kör közepe (pixel)
const KOR_Y : integer = 120;
const KOR_R : integer = 110;	// sugár függőleges pixelben (vízszintesen 2x, mert a pixel fél széles)

/* egy pixel tintára állítása (VID a $8000-on kell legyen) */
Procedure Pont(px, py : integer);
var b : byte;
begin
	if (px < 512) then
		if (py < 240) then
		begin
			ofs := py * 64;
			t := px / 8;
			ofs := ofs + t;
			p := $8000;
			p := p + ofs;
			t := t * 8;
			t := px - t;
			b := t;
			p[0] := p[0] | Maszk[b];
		end;
end;

/* a kör 8 szimmetrikus pontja; vízszintesen 2 pixel (a négyzetes kép miatt) */
Procedure Kor8(a, b : integer);
var a2, b2 : integer;
begin
	a2 := a * 2;
	b2 := b * 2;
	Pont(KOR_X + a2, KOR_Y + b);	Pont(KOR_X + a2 + 1, KOR_Y + b);
	Pont(KOR_X - a2, KOR_Y + b);	Pont(KOR_X - a2 + 1, KOR_Y + b);
	Pont(KOR_X + a2, KOR_Y - b);	Pont(KOR_X + a2 + 1, KOR_Y - b);
	Pont(KOR_X - a2, KOR_Y - b);	Pont(KOR_X - a2 + 1, KOR_Y - b);
	Pont(KOR_X + b2, KOR_Y + a);	Pont(KOR_X + b2 + 1, KOR_Y + a);
	Pont(KOR_X - b2, KOR_Y + a);	Pont(KOR_X - b2 + 1, KOR_Y + a);
	Pont(KOR_X + b2, KOR_Y - a);	Pont(KOR_X + b2 + 1, KOR_Y - a);
	Pont(KOR_X - b2, KOR_Y - a);	Pont(KOR_X - b2 + 1, KOR_Y - a);
end;

/* kör: y 0-tól felfelé, x a legnagyobb, amire x*x + y*y <= r*r (előjel nélküli számolás) */
Procedure Kor();
begin
	r2 := KOR_R * KOR_R;
	kx := KOR_R;
	ky := 0;
	while (ky <= kx) do
	begin
		s := kx * kx;
		t := ky * ky;
		s := s + t;
		while (s > r2) do
		begin
			kx := kx - 1;
			s := kx * kx;
			s := s + t;
		end;
		Kor8(kx, ky);
		ky := ky + 1;
	end;
end;

/* X: bal felső -> jobb alsó és jobb felső -> bal alsó, teljes 512-es felbontással */
Procedure Kereszt();
begin
	lx := 0;
	ly := 0;
	acc := 0;
	while (lx < 512) do
	begin
		Pont(lx, ly);
		Pont(511 - lx, ly);
		acc := acc + 239;
		if (acc >= 511) then
		begin
			acc := acc - 511;
			ly := ly + 1;
		end;
		lx := lx + 1;
	end;
end;

begin
	TVC::SetGraphicsMode(TVC::GRAPHICS2);
	TVC::SetRasterInterruptPos(239);	// a VMODE után: raszter-IT a 239. sor végére
	TVC::SetPalette(0, TVC::PALETTE_BLACK);
	TVC::SetBorder(TVC::BORDER_BLACK);

	/* soronkénti színtábla: 0..15 ismétlődve, 240 sorra */
	i := 0;
	j := 0;
	while (i < 240) do
	begin
		Sorszin[i] := Szinek[j];
		j := j + 1;
		if (j = 16) then j := 0;
		i := i + 1;
	end;

	/* rajz egyszer: törlés feketére (papír), majd kör + X a videó-RAM-ba */
	TVC::ClearScreen();
	/* felirat az 1. sorba, középre (ROM szövegkiírás, 64 oszlop; 39 karakter -> X=13) */
	TVC::SetColor(1);
	TVC::TextBackground(0);
	TVC::WriteAt(13, 1, "GRAPHICS 2 MODBAN 16 SZIN MEGJELENITESE");
	TVC::SetMemory(TVC::MEM_VID_ON);
	Kor();
	Kereszt();
	TVC::SetMemory(TVC::MEM_DEFAULT);

	asm("
		di
		;// saját megszakítás-kezelő: $38 -> JP SzS_Isr
		ld hl,$38
		ld (hl),195
		ld de,SzS_Isr
		inc hl
		ld (hl),e
		inc hl
		ld (hl),d
		ei

SzS_Frame:
		halt
		di
		;// várakozás Elo_Sorok sorig (200 T / sor)
		ld a,[Elo_Sorok]
		ld c,a
SzS_Elo:
		ld b,14
SzS_EloB:
		djnz SzS_EloB
		dec c
		jr nz,SzS_Elo
		;// finom eltolás
		ld a,[Finom]
		ld b,a
SzS_Fin:
		djnz SzS_Fin

		;// 240 sor: soronként új tintaszín, PONTOSAN 200 T / sor
		ld hl,Sorszin
		ld de,240
SzS_Sor:
		ld a,(hl)			;// 7
		out ($61),a			;// 11
		inc hl				;// 6
		dec de				;// 6
		ld a,d				;// 4
		or e				;// 4
		jp z,SzS_Kesz		;// 10  (= 48)
		ld b,10				;// 7
SzS_Var:
		djnz SzS_Var		;// 9*13+8 = 125  (= 180)
		jp SzS_J			;// 10
SzS_J:
		jp SzS_Sor			;// 10  (= 200)
SzS_Kesz:
		ei
		jp SzS_Frame

SzS_Isr:
		out ($7),a			;// IT nyugtázása
		ei
		ret
	");
end.
