<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="utf-8">
<title>Sprite16 szerkesztő</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
:root{--bg:#1b1d23;--panel:#252830;--panel2:#2e323c;--text:#e6e6e6;--muted:#9aa0ab;--accent:#4aa3ff;--border:#3a3f4b}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:13px system-ui,"Segoe UI",sans-serif;display:flex;height:100vh;overflow:hidden}
#side{width:240px;flex:none;background:var(--panel);border-right:1px solid var(--border);overflow-y:auto;padding:8px 10px}
#main{flex:1;display:flex;flex-direction:column;min-width:0}
#top{background:var(--panel);border-bottom:1px solid var(--border);padding:6px 10px;display:flex;flex-wrap:wrap;gap:6px;align-items:center}
#work{flex:1;display:flex;min-height:0}
#canvasWrap{flex:1;overflow:auto;padding:16px;background:#131418}
#right{width:300px;flex:none;background:var(--panel);border-left:1px solid var(--border);overflow:auto;padding:8px 10px}
#status{background:var(--panel);border-top:1px solid var(--border);padding:4px 10px;color:var(--muted);font-size:12px;min-height:22px}
h1{font-size:14px;margin:4px 0 6px}
h3{margin:12px 0 6px;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
button,select,input{font:inherit;color:var(--text)}
button{background:var(--panel2);border:1px solid var(--border);border-radius:4px;padding:5px 8px;cursor:pointer}
button:hover{border-color:var(--accent)}
button.on{background:var(--accent);border-color:var(--accent);color:#000}
button:disabled{opacity:.4;cursor:default}
input[type=number],input[type=text],select{background:var(--panel2);border:1px solid var(--border);border-radius:4px;padding:4px 6px}
input[type=number]{width:62px}
label{display:inline-flex;align-items:center;gap:4px;cursor:pointer}
.tools{display:grid;grid-template-columns:1fr 1fr;gap:4px}
.tools button{text-align:left}
.tools kbd{float:right;color:var(--muted);font-size:11px}
button.on kbd{color:#000}
.pal{display:grid;grid-template-columns:repeat(4,1fr);gap:4px}
.sw{height:30px;border:2px solid var(--border);border-radius:3px;cursor:pointer;position:relative;font-size:11px;font-weight:bold}
.sw b{position:absolute;top:1px;padding:0 3px;border-radius:2px;background:#000;color:#fff}
.sw b.l{left:1px}.sw b.r{right:1px}
.sw.tr{background:repeating-conic-gradient(#3d3d52 0 25%,#2b2b3a 0 50%) 0 0/10px 10px}
.sw.dis{opacity:.25;cursor:default}
.cur{display:flex;gap:8px;margin-top:6px}
.cur div{flex:1;text-align:center;font-size:11px;color:var(--muted)}
.cur i{display:block;height:22px;border:1px solid var(--border);border-radius:3px;margin-bottom:2px}
.row{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:4px 0}
.sep{width:1px;height:22px;background:var(--border);margin:0 4px}
canvas{image-rendering:pixelated;display:block}
#cv{cursor:crosshair;box-shadow:0 0 0 1px #000,0 0 0 2px var(--border)}
#pvWrap{background:#000;padding:8px;overflow:auto;border:1px solid var(--border);border-radius:4px;max-height:420px}
pre{background:var(--panel2);border:1px solid var(--border);border-radius:4px;padding:6px;font-size:11px;white-space:pre-wrap;word-break:break-all;margin:4px 0}
.muted{color:var(--muted);font-size:12px}
</style>
</head>
<body>

<div id="side">
  <h1>Sprite16 szerkesztő</h1>
  <div class="muted">TVC 16 színű mód (GRAPHICS16), Bery-féle GE sprite .bin</div>

  <h3>Eszközök</h3>
  <div class="tools" id="tools">
    <button data-t="pen">Pont <kbd>P</kbd></button>
    <button data-t="fill">Festés <kbd>F</kbd></button>
    <button data-t="line">Vonal <kbd>L</kbd></button>
    <button data-t="rect">Téglalap <kbd>R</kbd></button>
    <button data-t="circle">Kör/ellipszis <kbd>C</kbd></button>
    <button data-t="pick">Színválasztó <kbd>I</kbd></button>
  </div>
  <div class="row"><label><input type="checkbox" id="filled"> Kitöltött alakzat</label></div>
  <div class="muted">Shift: vonal 45°, téglalap/kör a képernyőn négyzet/kör arányú.</div>

  <h3>Paletta</h3>
  <div class="pal" id="pal"></div>
  <div class="cur">
    <div><i id="curL"></i>Bal gomb</div>
    <div><i id="curR"></i>Jobb gomb</div>
  </div>
  <div class="muted" style="margin-top:4px">Bal katt = bal szín, jobb katt (vagy Ctrl) = jobb szín. X: a két szín csere.</div>

  <h3>Háttér</h3>
  <div class="row"><label><input type="radio" name="mask" value="1" checked> Maszkolt (átlátszó)</label></div>
  <div class="row"><label><input type="radio" name="mask" value="0"> Nem maszkolt</label></div>

  <h3>Méret (pixel)</h3>
  <div class="row">Szél. <input type="number" id="inW" min="2" max="128" step="2"> Mag. <input type="number" id="inH" min="1" max="240"></div>
  <div class="row"><button id="bResize">Átméretez</button><span class="muted">szélesség páros (2 pixel = 1 byte), max 128x240</span></div>

  <h3>Műveletek</h3>
  <div class="row">
    <button id="bUndo" title="Ctrl+Z">Vissza</button>
    <button id="bRedo" title="Ctrl+Y">Előre</button>
    <button id="bClear">Törlés</button>
  </div>
  <div class="row">
    <button id="bMirH">Tükör ↔</button>
    <button id="bMirV">Tükör ↕</button>
  </div>
  <div class="row">
    Eltolás:
    <button data-sh="-1,0">←</button><button data-sh="1,0">→</button>
    <button data-sh="0,-1">↑</button><button data-sh="0,1">↓</button>
  </div>
</div>

<div id="main">
  <div id="top">
    <label>Név <input type="text" id="inName" value="sprite16" style="width:130px"></label>
    <button id="bSave">Mentés .bin</button>
    <button id="bLoad">Betöltés .bin</button>
    <div class="sep"></div>
    <button id="bImport">Kép importálása</button>
    <label><input type="checkbox" id="impSize"> a kép méretével</label>
    <button id="bPng">PNG mentés (1:1)</button>
    <div class="sep"></div>
    Nagyítás <select id="zoom"></select>
    <label><input type="checkbox" id="grid" checked> Rács <kbd class="muted">G</kbd></label>
    <input type="file" id="fBin" accept=".bin" hidden>
    <input type="file" id="fImg" accept="image/*,.bmp" hidden>
  </div>
  <div id="work">
    <div id="canvasWrap"><canvas id="cv"></canvas></div>
    <div id="right">
      <h3>Előnézet (TVC arány)</h3>
      <div class="row">
        Méret <select id="pvScale"><option value="1">1x</option><option value="2" selected>2x</option><option value="3">3x</option></select>
        Háttér <select id="pvBg"></select>
      </div>
      <div id="pvWrap"><canvas id="pv"></canvas></div>
      <div class="muted" style="margin-top:4px">A TVC 16 színű módjában egy pixel kétszer olyan széles, mint magas (128x240 kép).</div>

      <h3>Fájl</h3>
      <div id="info" class="muted"></div>
      <h3>TRSE használat</h3>
      <pre id="snippet"></pre>
      <h3>Formátum</h3>
      <div class="muted">
        Fejléc 3 byte: típus (1 = nem maszkolt, 2 = maszkolt), szélesség byte-ban (pixel/2), magasság sorban.
        Utána soronként: nem maszkolt = 1 adat-byte / 2 pixel; maszkolt = bytepár (MASZK, ADAT).
        Egy byte: bal pixel = 7,5,3,1. bit, jobb pixel = 6,4,2,0. bit (I,G,R,B).
        Színindex = I*8 + G*4 + R*2 + B (mint a GE::GR16_COLOR_* sorrend).
      </div>
    </div>
  </div>
  <div id="status">&nbsp;</div>
</div>

<script>
"use strict";
/* ---------- Paletta: index = I*8 + G*4 + R*2 + B ---------- */
const NAMES=["Fekete","Sötétkék","Sötétvörös","Sötétbíbor","Sötétzöld","Sötétcián","Sötétsárga","Szürke",
             "Fekete 2","Kék","Vörös","Bíbor","Zöld","Cián","Sárga","Fehér"];
const PAL=[];
for(let i=0;i<16;i++){const B=i&1,R=(i>>1)&1,G=(i>>2)&1,I=(i>>3)&1,v=I?255:128;PAL.push([R*v,G*v,B*v]);}
const TR=-1;                               // átlátszó (csak maszkolt módban)
const CHK=[[43,43,58],[61,61,82]];         // átlátszó sakktábla a szerkesztőben
const css=c=>c<0?"transparent":`rgb(${PAL[c].join(",")})`;

/* ---------- Állapot ---------- */
let W=16,H=16,pix=new Int8Array(W*H).fill(TR),masked=true;
let colL=15,colR=TR,tool="pen",zoom=16;
let undoSt=[],redoSt=[];
const $=id=>document.getElementById(id);
const cv=$("cv"),ctx=cv.getContext("2d");
const base=document.createElement("canvas"),bctx=base.getContext("2d");
const pv=$("pv"),pctx=pv.getContext("2d");

/* ---------- Pixel-kódolás ---------- */
function encPix(c,left){ // c 0..15 -> a byte bitjei
  const B=c&1,R=(c>>1)&1,G=(c>>2)&1,I=(c>>3)&1;
  return left ? (B<<1)|(R<<3)|(G<<5)|(I<<7) : B|(R<<2)|(G<<4)|(I<<6);
}
function decPix(b,left){
  if(left) b>>=1;
  return (b&1)|((b>>2)&1)<<1|((b>>4)&1)<<2|((b>>6)&1)<<3;
}
function buildBin(){
  const bw=W/2,out=[masked?2:1,bw,H];
  for(let y=0;y<H;y++)for(let bx=0;bx<bw;bx++){
    const a=pix[y*W+bx*2],b=pix[y*W+bx*2+1];
    let m=0,d=0;
    if(a<0)m|=0xAA;else d|=encPix(a,true);
    if(b<0)m|=0x55;else d|=encPix(b,false);
    if(masked)out.push(m,d);else out.push(d);   // nem maszkolt: az átlátszó = 0 (fekete)
  }
  return new Uint8Array(out);
}
function parseBin(u){
  if(u.length<3)throw "Túl rövid fájl.";
  const t=u[0],bw=u[1],h=u[2];
  if((t!==1&&t!==2)||bw<1||bw>64||h<1||h>240)throw "Nem Bery-féle sprite fejléc ("+[t,bw,h].join(",")+").";
  const per=bw*h*(t===2?2:1);
  if(u.length<3+per)throw "A fájl rövidebb, mint a fejléc szerinti méret.";
  const frames=Math.floor((u.length-3)/per);
  const w=bw*2,p=new Int8Array(w*h);
  let k=3;
  for(let y=0;y<h;y++)for(let bx=0;bx<bw;bx++){
    let m=0,d;
    if(t===2){m=u[k++];d=u[k++];}else d=u[k++];
    p[y*w+bx*2]  =(m&0xAA)===0xAA?TR:decPix(d,true);
    p[y*w+bx*2+1]=(m&0x55)===0x55?TR:decPix(d,false);
  }
  return {w,h,p,masked:t===2,frames};
}

/* ---------- Rajzolás a képernyőre ---------- */
function renderBase(d){
  if(base.width!==W||base.height!==H){base.width=W;base.height=H;}
  const img=bctx.createImageData(W,H),a=img.data;
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){
    const i=y*W+x,o=i*4;let c=d[i];
    let rgb=c<0?(masked?CHK[(x+y)&1]:PAL[0]):PAL[c];
    a[o]=rgb[0];a[o+1]=rgb[1];a[o+2]=rgb[2];a[o+3]=255;
  }
  bctx.putImageData(img,0,0);
}
function draw(d){
  d=d||pix;
  renderBase(d);
  const cw=W*2*zoom,ch=H*zoom;
  if(cv.width!==cw||cv.height!==ch){cv.width=cw;cv.height=ch;}
  ctx.imageSmoothingEnabled=false;
  ctx.drawImage(base,0,0,cw,ch);
  if($("grid").checked&&zoom>=4){
    ctx.lineWidth=1;
    for(let x=1;x<W;x++){
      ctx.strokeStyle=(x%2===0)?"rgba(255,255,255,.28)":"rgba(255,255,255,.08)";
      ctx.beginPath();ctx.moveTo(x*2*zoom+.5,0);ctx.lineTo(x*2*zoom+.5,ch);ctx.stroke();
    }
    for(let y=1;y<H;y++){
      ctx.strokeStyle=(y%8===0)?"rgba(255,255,255,.22)":"rgba(255,255,255,.08)";
      ctx.beginPath();ctx.moveTo(0,y*zoom+.5);ctx.lineTo(cw,y*zoom+.5);ctx.stroke();
    }
  }
  drawPreview(d);
}
function drawPreview(d){
  const s=+$("pvScale").value,bg=+$("pvBg").value;
  const w=W*2*s,h=H*s;
  if(pv.width!==w||pv.height!==h){pv.width=w;pv.height=h;}
  const img=pctx.createImageData(W,H),a=img.data;
  for(let i=0;i<W*H;i++){const c=d[i];const rgb=PAL[c<0?(masked?bg:0):c];a[i*4]=rgb[0];a[i*4+1]=rgb[1];a[i*4+2]=rgb[2];a[i*4+3]=255;}
  const t=document.createElement("canvas");t.width=W;t.height=H;t.getContext("2d").putImageData(img,0,0);
  pctx.imageSmoothingEnabled=false;pctx.drawImage(t,0,0,w,h);
}

/* ---------- UI: paletta, eszközök, info ---------- */
function buildPalette(){
  const el=$("pal");el.innerHTML="";
  const list=[...Array(16).keys(),TR];
  for(const c of list){
    const d=document.createElement("div");
    d.className="sw"+(c<0?" tr":"")+(c<0&&!masked?" dis":"");
    if(c>=0)d.style.background=css(c);
    d.title=c<0?"Átlátszó (csak maszkolt)":`${c}: ${NAMES[c]}`;
    if(c===colL)d.innerHTML+='<b class="l">L</b>';
    if(c===colR)d.innerHTML+='<b class="r">R</b>';
    d.onmousedown=e=>{e.preventDefault();if(c<0&&!masked)return;
      if(e.button===2||e.ctrlKey)colR=c;else colL=c;uiRefresh();};
    d.oncontextmenu=e=>e.preventDefault();
    el.appendChild(d);
  }
  for(const [id,c] of [["curL",colL],["curR",colR]]){
    const i=$(id);i.className=c<0?"sw tr":"";i.style.background=c<0?"":css(c);
    i.title=c<0?"Átlátszó":NAMES[c];
  }
}
function uiRefresh(){
  if(!masked){if(colL<0)colL=0;if(colR<0)colR=0;}
  buildPalette();
  document.querySelectorAll("#tools button").forEach(b=>b.classList.toggle("on",b.dataset.t===tool));
  $("inW").value=W;$("inH").value=H;
  document.querySelector(`input[name=mask][value="${masked?1:0}"]`).checked=true;
  $("bUndo").disabled=!undoSt.length;$("bRedo").disabled=!redoSt.length;
  const nm=safeName(),size=3+W/2*H*(masked?2:1),Cap=nm.charAt(0).toUpperCase()+nm.slice(1);
  let tr=0;for(const c of pix)if(c<0)tr++;
  $("info").innerHTML=`${W}x${H} pixel = ${W/2} byte x ${H} sor<br>${masked?"Maszkolt (típus 2)":"Nem maszkolt (típus 1)"}<br>Fájlméret: ${size} byte`+
    (!masked&&tr?`<br><span style="color:#fc6">${tr} átlátszó pixel feketeként mentődik.</span>`:"");
  $("snippet").textContent=
`${Cap}_Data : incbin("resources\\tvc_sprites\\${nm}.bin");
${Cap} : GE::Sprite;

GE::SetGraphics(GE::GRAPHICS16);
${Cap}.Init(#${Cap}_Data, X, Y, ${masked?"True":"False"});
${masked?`// maszkolt: Draw (háttérpufferrel)
${Cap}.SetPosition();
${Cap}.SaveBackground();
${Cap}.Draw();`:`// nem maszkolt: Put (bélyegző)
${Cap}.SetPosition();
${Cap}.Put();`}`;
  draw();
  save();
}
function safeName(){return ($("inName").value.trim()||"sprite16").replace(/[^A-Za-z0-9_]/g,"_");}

/* ---------- Visszavonás ---------- */
function pushUndo(){undoSt.push({W,H,pix:pix.slice()});if(undoSt.length>200)undoSt.shift();redoSt=[];}
function restore(st){W=st.W;H=st.H;pix=st.pix;}
function doUndo(){if(!undoSt.length)return;redoSt.push({W,H,pix:pix.slice()});restore(undoSt.pop());uiRefresh();}
function doRedo(){if(!redoSt.length)return;undoSt.push({W,H,pix:pix.slice()});restore(redoSt.pop());uiRefresh();}

/* ---------- Rajzoló primitívek ---------- */
function plot(d,x,y,c){if(x>=0&&y>=0&&x<W&&y<H)d[y*W+x]=c;}
function line(d,x0,y0,x1,y1,c){
  let dx=Math.abs(x1-x0),dy=-Math.abs(y1-y0),sx=x0<x1?1:-1,sy=y0<y1?1:-1,e=dx+dy;
  for(;;){plot(d,x0,y0,c);if(x0===x1&&y0===y1)break;const e2=2*e;if(e2>=dy){e+=dy;x0+=sx;}if(e2<=dx){e+=dx;y0+=sy;}}
}
function rect(d,x0,y0,x1,y1,c,fill){
  const ax=Math.min(x0,x1),bx=Math.max(x0,x1),ay=Math.min(y0,y1),by=Math.max(y0,y1);
  for(let y=ay;y<=by;y++)for(let x=ax;x<=bx;x++)
    if(fill||x===ax||x===bx||y===ay||y===by)plot(d,x,y,c);
}
function ellipse(d,x0,y0,x1,y1,c,fill){
  const ax=Math.min(x0,x1),bx=Math.max(x0,x1),ay=Math.min(y0,y1),by=Math.max(y0,y1);
  const cx=(ax+bx)/2,cy=(ay+by)/2,rx=(bx-ax)/2+.5,ry=(by-ay)/2+.5;
  const inside=(x,y)=>{const u=(x-cx)/rx,v=(y-cy)/ry;return u*u+v*v<=1.0001;};
  for(let y=ay;y<=by;y++)for(let x=ax;x<=bx;x++){
    if(!inside(x,y))continue;
    if(fill||!inside(x-1,y)||!inside(x+1,y)||!inside(x,y-1)||!inside(x,y+1))plot(d,x,y,c);
  }
}
function flood(x,y,c){
  const t=pix[y*W+x];if(t===c)return;
  const st=[[x,y]];
  while(st.length){
    const [px,py]=st.pop();
    if(px<0||py<0||px>=W||py>=H||pix[py*W+px]!==t)continue;
    pix[py*W+px]=c;st.push([px+1,py],[px-1,py],[px,py+1],[px,py-1]);
  }
}
function constrain(s,p){ // Shift: a képernyőn arányos alak (1 pixel = 2 egység széles)
  let dx=p.x-s.x,dy=p.y-s.y;
  if(tool==="line"){ // 0°, 45° (képernyőn), 90°
    const vx=Math.abs(dx)*2,vy=Math.abs(dy);
    if(vy<vx/2)dy=0;else if(vx<vy/2)dx=0;else{const m=Math.max(vx,vy);dx=Math.sign(dx)*Math.round(m/2);dy=Math.sign(dy)*m;}
  }else{
    const m=Math.max(Math.abs(dx)*2,Math.abs(dy));
    dx=(Math.sign(dx)||1)*Math.round(m/2);dy=(Math.sign(dy)||1)*m;
  }
  return {x:s.x+dx,y:s.y+dy};
}
function shape(d,s,p,c){
  const f=$("filled").checked;
  if(tool==="line")line(d,s.x,s.y,p.x,p.y,c);
  else if(tool==="rect")rect(d,s.x,s.y,p.x,p.y,c,f);
  else if(tool==="circle")ellipse(d,s.x,s.y,p.x,p.y,c,f);
}

/* ---------- Egér ---------- */
let drag=null;
function cell(e){const r=cv.getBoundingClientRect();return {x:Math.floor((e.clientX-r.left)/(2*zoom)),y:Math.floor((e.clientY-r.top)/zoom)};}
cv.addEventListener("contextmenu",e=>e.preventDefault());
cv.addEventListener("pointerdown",e=>{
  e.preventDefault();
  const p=cell(e),right=e.button===2||e.ctrlKey,c=right?colR:colL;
  if(p.x<0||p.y<0||p.x>=W||p.y>=H)return;
  if(tool==="pick"){const v=pix[p.y*W+p.x];if(right)colR=v;else colL=v;uiRefresh();return;}
  pushUndo();
  if(tool==="fill"){flood(p.x,p.y,c);uiRefresh();return;}
  cv.setPointerCapture(e.pointerId);
  drag={s:p,last:p,c};
  if(tool==="pen"){plot(pix,p.x,p.y,c);draw();}
  else{const t=pix.slice();shape(t,p,p,c);draw(t);}
});
cv.addEventListener("pointermove",e=>{
  const p=cell(e);status(p);
  if(!drag)return;
  if(tool==="pen"){line(pix,drag.last.x,drag.last.y,p.x,p.y,drag.c);drag.last=p;draw();}
  else{const q=e.shiftKey?constrain(drag.s,p):p;const t=pix.slice();shape(t,drag.s,q,drag.c);draw(t);drag.last=q;}
});
cv.addEventListener("pointerup",e=>{
  if(!drag)return;
  if(tool!=="pen"){const p=cell(e);const q=e.shiftKey?constrain(drag.s,p):p;shape(pix,drag.s,q,drag.c);}
  drag=null;uiRefresh();
});
cv.addEventListener("pointerleave",()=>{if(!drag)$("status").innerHTML="&nbsp;";});
function status(p){
  if(p.x<0||p.y<0||p.x>=W||p.y>=H){$("status").innerHTML="&nbsp;";return;}
  const c=pix[p.y*W+p.x];
  $("status").textContent=`X: ${p.x}  Y: ${p.y}   byte-oszlop: ${p.x>>1} (${p.x&1?"jobb":"bal"} pixel)   szín: ${c<0?"átlátszó":c+" "+NAMES[c]}`;
}

/* ---------- Műveletek ---------- */
function resize(nw,nh){
  nw=Math.max(2,Math.min(128,nw|0));if(nw%2)nw++;nh=Math.max(1,Math.min(240,nh|0));
  if(nw===W&&nh===H)return;
  pushUndo();
  const n=new Int8Array(nw*nh).fill(masked?TR:0);
  for(let y=0;y<Math.min(H,nh);y++)for(let x=0;x<Math.min(W,nw);x++)n[y*nw+x]=pix[y*W+x];
  W=nw;H=nh;pix=n;uiRefresh();
}
function transform(f){pushUndo();const n=new Int8Array(W*H);for(let y=0;y<H;y++)for(let x=0;x<W;x++){const [sx,sy]=f(x,y);n[y*W+x]=pix[sy*W+sx];}pix=n;uiRefresh();}
$("bResize").onclick=()=>resize(+$("inW").value,+$("inH").value);
$("bUndo").onclick=doUndo;$("bRedo").onclick=doRedo;
$("bClear").onclick=()=>{pushUndo();pix.fill(masked?TR:0);uiRefresh();};
$("bMirH").onclick=()=>transform((x,y)=>[W-1-x,y]);
$("bMirV").onclick=()=>transform((x,y)=>[x,H-1-y]);
document.querySelectorAll("[data-sh]").forEach(b=>b.onclick=()=>{const [dx,dy]=b.dataset.sh.split(",").map(Number);
  transform((x,y)=>[(x-dx+W)%W,(y-dy+H)%H]);});
document.querySelectorAll("#tools button").forEach(b=>b.onclick=()=>{tool=b.dataset.t;uiRefresh();});
document.querySelectorAll("input[name=mask]").forEach(r=>r.onchange=()=>{masked=r.value==="1";uiRefresh();});
$("grid").onchange=()=>draw();
$("pvScale").onchange=$("pvBg").onchange=()=>draw();
$("inName").oninput=()=>uiRefresh();
for(const z of [2,4,6,8,10,12,16,20,24,32]){const o=document.createElement("option");o.value=z;o.textContent=z+"x";$("zoom").appendChild(o);}
$("zoom").onchange=()=>{zoom=+$("zoom").value;draw();save();};
for(let i=0;i<16;i++){const o=document.createElement("option");o.value=i;o.textContent=i+" "+NAMES[i];$("pvBg").appendChild(o);}
$("pvBg").value=7;

/* ---------- Fájlok ---------- */
function download(name,blob){const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},500);}
$("bSave").onclick=()=>download(safeName()+".bin",new Blob([buildBin()],{type:"application/octet-stream"}));
$("bLoad").onclick=()=>$("fBin").click();
$("fBin").onchange=async e=>{
  const f=e.target.files[0];e.target.value="";if(!f)return;
  try{
    const r=parseBin(new Uint8Array(await f.arrayBuffer()));
    pushUndo();W=r.w;H=r.h;pix=r.p;masked=r.masked;
    $("inName").value=f.name.replace(/\.bin$/i,"");
    uiRefresh();
    if(r.frames>1)alert(`A fájl ${r.frames} fázist tartalmaz, az elsőt töltöttem be (a többfázisú szerkesztés még nincs kész).`);
  }catch(err){alert("Betöltési hiba: "+err);}
};
$("bImport").onclick=()=>$("fImg").click();
$("fImg").onchange=e=>{
  const f=e.target.files[0];e.target.value="";if(!f)return;
  const img=new Image();
  img.onload=()=>{
    let w=W,h=H;
    if($("impSize").checked){w=Math.min(128,img.width);if(w%2)w++;h=Math.min(240,img.height);}
    const t=document.createElement("canvas");t.width=w;t.height=h;const tc=t.getContext("2d");
    tc.imageSmoothingEnabled=false;tc.drawImage(img,0,0,w,h);
    const a=tc.getImageData(0,0,w,h).data,n=new Int8Array(w*h);
    for(let i=0;i<w*h;i++){
      if(a[i*4+3]<128){n[i]=masked?TR:0;continue;}
      let best=0,bd=1e9;
      for(let c=0;c<16;c++){if(c===8)continue;const q=PAL[c],dd=(q[0]-a[i*4])**2+(q[1]-a[i*4+1])**2+(q[2]-a[i*4+2])**2;if(dd<bd){bd=dd;best=c;}}
      n[i]=best;
    }
    pushUndo();W=w;H=h;pix=n;uiRefresh();URL.revokeObjectURL(img.src);
  };
  img.onerror=()=>alert("A képet nem sikerült betölteni.");
  img.src=URL.createObjectURL(f);
};
$("bPng").onclick=()=>{
  const t=document.createElement("canvas");t.width=W;t.height=H;const tc=t.getContext("2d");
  const img=tc.createImageData(W,H),a=img.data;
  for(let i=0;i<W*H;i++){const c=pix[i];if(c<0)continue;const q=PAL[c];a[i*4]=q[0];a[i*4+1]=q[1];a[i*4+2]=q[2];a[i*4+3]=255;}
  tc.putImageData(img,0,0);t.toBlob(b=>download(safeName()+".png",b),"image/png");
};

/* ---------- Billentyűk ---------- */
document.addEventListener("keydown",e=>{
  if(e.target.tagName==="INPUT"&&e.target.type!=="checkbox"&&e.target.type!=="radio")return;
  const k=e.key.toLowerCase();
  if(e.ctrlKey&&k==="z"){e.preventDefault();doUndo();return;}
  if(e.ctrlKey&&(k==="y"||(e.shiftKey&&k==="z"))){e.preventDefault();doRedo();return;}
  if(e.ctrlKey)return;
  const map={p:"pen",f:"fill",l:"line",r:"rect",c:"circle",i:"pick"};
  if(map[k]){tool=map[k];uiRefresh();}
  else if(k==="g"){$("grid").checked=!$("grid").checked;draw();}
  else if(k==="x"){[colL,colR]=[colR,colL];uiRefresh();}
  else if(k==="+"||k==="="){const s=$("zoom");s.selectedIndex=Math.min(s.options.length-1,s.selectedIndex+1);s.onchange();}
  else if(k==="-"){const s=$("zoom");s.selectedIndex=Math.max(0,s.selectedIndex-1);s.onchange();}
});

/* ---------- Automatikus mentés (böngésző) ---------- */
const KEY="waterpump_sprite16_v1";
function save(){try{localStorage.setItem(KEY,JSON.stringify({W,H,pix:Array.from(pix),masked,colL,colR,zoom,name:$("inName").value,tool}));}catch(e){}}
function load(){
  try{const s=JSON.parse(localStorage.getItem(KEY)||"null");
    if(s&&s.W&&s.H&&s.pix&&s.pix.length===s.W*s.H){W=s.W;H=s.H;pix=Int8Array.from(s.pix);masked=!!s.masked;colL=s.colL;colR=s.colR;zoom=s.zoom||16;tool=s.tool||"pen";$("inName").value=s.name||"sprite16";}
  }catch(e){}
  $("zoom").value=zoom;if(!$("zoom").value){zoom=16;$("zoom").value=16;}
}
load();uiRefresh();

/* teszthez: window.__s16 */
window.__s16={encPix,decPix,buildBin,parseBin,get:()=>({W,H,pix,masked}),set:(w,h,p,m)=>{W=w;H=h;pix=Int8Array.from(p);masked=m;uiRefresh();}};
</script>
</body>
</html>
