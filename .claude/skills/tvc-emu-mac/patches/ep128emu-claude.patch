+// ---- Claude-hid (Mac, WaterPumpGame): parancsfajl -> kepmentes / memoriamentes, ablaktol fuggetlenul ----
+// Mappa: ~/Library/Application Support/ep128emu/claude/ . A "parancs.txt" sorai (vegrehajtas utan torlodik):
+//   (a fajlnev a sor maradeka, lehet benne szokoz; relativ nev = a claude mappaban)
+//   kep <fajl.png>                      - a kovetkezo kepkocka PNG-be
+//   folyam <ms> <db> <elotag>           - <db> kep <ms> ezredmasodpercenkent: <elotag>_0001.png ...
+//   mem <U0|U1|U2|U3|VID|CPU|seg> <kezdo hex> <hossz hex> <fajl>   - nyers memoria (CPU = a mostani lapozas)
+//   gepel <szoveg>                      - "=Shift+2 ~=ESC(End) |=Enter <=Backspace, nagybetu = Shift+betu
+//   gomb <nev>[+<nev>..] [ms]           - gomb(ok) nyomva tartasa (enter esc fel le bal jobb szokoz shift ...)
+//   var <ms>                            - szunet a billentyusorban
+// Minden vegrehajtott parancs utan a "kesz.txt"-be irodik egy sor (sorszam + parancs + eredmeny).
+#include <sys/stat.h>
+#include <chrono>
+#include <sstream>
+static std::string  claudeDir_()
+{
+  const char *h = std::getenv("HOME");
+  return std::string(h ? h : "/tmp") + "/Library/Application Support/ep128emu/claude/";
+}
+struct ClaudeShot_ {
+  bool        pending = false;
+  std::string fName;
+  // folyam
+  int         streamMs = 0, streamLeft = 0, streamIdx = 0;
+  std::string streamPrefix;
+  std::chrono::steady_clock::time_point streamNext;
+  std::chrono::steady_clock::time_point lastPoll;
+  int         seq = 0;
+};
+static ClaudeShot_  claudeShot_;
+// billentyu-sor: (FLTK kod, le/fel, ennyi ms-mal az elozo utan)
+struct ClaudeKey_ { int key; bool down; int delayMs; };
+static std::vector<ClaudeKey_>  claudeKeys_;
+static size_t                   claudeKeyPos_ = 0;
+static std::chrono::steady_clock::time_point claudeKeyNext_;
+static void claudeTap_(int key, bool shift, int holdMs = 60)
+{
+  if (shift) claudeKeys_.push_back({FL_Shift_L, true, 40});
+  claudeKeys_.push_back({key, true, shift ? 40 : 60});
+  claudeKeys_.push_back({key, false, holdMs});
+  if (shift) claudeKeys_.push_back({FL_Shift_L, false, 30});
+}
+static int claudeNamedKey_(const std::string& n)
+{
+  if (n == "enter") return FL_Enter;
+  if (n == "esc" || n == "end") return FL_End;
+  if (n == "fel" || n == "up") return FL_Up;
+  if (n == "le" || n == "down") return FL_Down;
+  if (n == "bal" || n == "left") return FL_Left;
+  if (n == "jobb" || n == "right") return FL_Right;
+  if (n == "szokoz" || n == "space") return ' ';
+  if (n == "shift") return FL_Shift_L;
+  if (n == "bs") return FL_BackSpace;
+  if (n == "tab") return FL_Tab;
+  if (n == "ctrl") return FL_Control_L;
+  if (n == "alt") return FL_Alt_L;
+  if (n.size() > 1 && n[0] == 'F' && n[1] >= '0' && n[1] <= '9') return FL_F + std::atoi(n.c_str() + 1);
+  if (n.size() > 2 && n[0] == '0' && n[1] == 'x') return int(std::strtol(n.c_str(), (char **) 0, 16));
+  if (n.size() == 1) return (unsigned char) std::tolower((unsigned char) n[0]);
+  return -1;
+}
+// a sor maradeka fajlnevkent (szokoz lehet benne); relativ nev -> a claude mappaba
+static std::string claudeRest_(std::istringstream& ls, const std::string& dflt)
+{
+  std::string r;
+  std::getline(ls, r);
+  size_t a = r.find_first_not_of(" \t\r"), b = r.find_last_not_of(" \t\r");
+  r = (a == std::string::npos ? std::string() : r.substr(a, b - a + 1));
+  if (r.empty()) r = dflt;
+  if (r[0] != '/') r = claudeDir_() + r;
+  return r;
+}
+static void claudeLog_(const std::string& line)
+{
+  std::FILE *f = std::fopen((claudeDir_() + "kesz.txt").c_str(), "a");
+  if (f) { std::fprintf(f, "%d %s\n", ++claudeShot_.seq, line.c_str()); std::fclose(f); }
+}
+static void claudeShotCallback_(void *userData, const unsigned char *buf, int w_, int h_)
+{
+  (void) userData;
+  ClaudeShot_& c = claudeShot_;
+  c.pending = false;
+  try {
+    std::string tmp = c.fName + ".tmp";
+    Ep128Emu::writePNGImage(tmp.c_str(), buf, w_, h_, 256, true, 32768);
+    std::rename(tmp.c_str(), c.fName.c_str());
+    claudeLog_("kep " + c.fName + " ok");
+  }
+  catch (std::exception& e) {
+    claudeLog_("kep " + c.fName + " HIBA " + e.what());
+  }
+}
+// ---- Claude-hid vege ----
+
 void Ep128EmuGUI::fltkCheckCallback(void *userData)
 {
   Ep128EmuGUI&  gui_ = *(reinterpret_cast<Ep128EmuGUI *>(userData));
+  try {
+    ClaudeShot_&  c = claudeShot_;
+    auto  now = std::chrono::steady_clock::now();
+    while (claudeKeyPos_ < claudeKeys_.size() && now >= claudeKeyNext_) {
+      const ClaudeKey_& k = claudeKeys_[claudeKeyPos_++];
+      int n = (k.key < 0 ? -1 : gui_.config.convertKeyCode(k.key));
+      if (n >= 0)
+        gui_.vmThread.setKeyboardState(uint8_t(n), k.down);
+      if (claudeKeyPos_ < claudeKeys_.size())
+        claudeKeyNext_ = now + std::chrono::milliseconds(claudeKeys_[claudeKeyPos_].delayMs);
+      else {
+        claudeKeys_.clear();
+        claudeKeyPos_ = 0;
+        claudeLog_("billentyuk kesz");
+      }
+    }
+    if (now - c.lastPoll >= std::chrono::milliseconds(50)) {
+      c.lastPoll = now;
+      std::string dir = claudeDir_();
+      // folyam: a kovetkezo kep, ha esedekes es nincs fuggoben
+      if (c.streamLeft > 0 && !c.pending && now >= c.streamNext) {
+        char  nb[16];
+        std::snprintf(nb, sizeof(nb), "_%04d.png", ++c.streamIdx);
+        c.fName = c.streamPrefix + nb;
+        c.pending = true;
+        c.streamLeft--;
+        c.streamNext = now + std::chrono::milliseconds(c.streamMs);
+        gui_.flDisplay->setScreenshotCallback(&claudeShotCallback_, (void *) 0);
+      }
+      std::string cmdFile = dir + "parancs.txt";
+      struct stat st;
+      if (::stat(cmdFile.c_str(), &st) == 0) {
+        std::string  text;
+        if (std::FILE *f = std::fopen(cmdFile.c_str(), "rb")) {
+          char  b[4096];
+          size_t n;
+          while ((n = std::fread(b, 1, sizeof(b), f)) > 0)
+            text.append(b, n);
+          std::fclose(f);
+        }
+        std::remove(cmdFile.c_str());
+        std::istringstream  lines(text);
+        std::string  line;
+        while (std::getline(lines, line)) {
+          std::istringstream  ls(line);
+          std::string  cmd;
+          if (!(ls >> cmd))
+            continue;
+          if (cmd == "kep") {
+            std::string fn = claudeRest_(ls, "kep.png");
+            if (c.pending) { claudeLog_("kep " + fn + " HIBA foglalt"); continue; }
+            c.fName = fn;
+            c.pending = true;
+            gui_.flDisplay->setScreenshotCallback(&claudeShotCallback_, (void *) 0);
+          }
+          else if (cmd == "folyam") {
+            int ms = 0, db = 0;
+            ls >> ms >> db;
+            std::string pre = claudeRest_(ls, "folyam");
+            c.streamMs = (ms < 20 ? 20 : ms);
+            c.streamLeft = db;
+            c.streamIdx = 0;
+            c.streamPrefix = pre;
+            c.streamNext = now;
+            claudeLog_(line + " indul");
+          }
+          else if (cmd == "mem") {
+            std::string seg;
+            unsigned int start = 0, len = 0;
+            ls >> seg >> std::hex >> start >> len >> std::dec;
+            std::string fn = claudeRest_(ls, "mem.bin");
+            int segNo = -1;
+            if (seg == "U0") segNo = 0xF8;
+            else if (seg == "U1") segNo = 0xF9;
+            else if (seg == "U2") segNo = 0xFA;
+            else if (seg == "U3") segNo = 0xFB;
+            else if (seg == "VID") segNo = 0xFC;
+            else if (seg != "CPU") segNo = int(std::strtol(seg.c_str(), (char **) 0, 16));
+            if (fn.empty() || len == 0 || len > 0x400000) { claudeLog_(line + " HIBA parameter"); continue; }
+            std::vector<unsigned char> buf(len);
+            if (gui_.lockVMThread()) {
+              for (unsigned int i = 0; i < len; i++) {
+                if (segNo < 0)
+                  buf[i] = gui_.vm.readMemory((start + i) & 0xFFFFU, true);
+                else
+                  buf[i] = gui_.vm.readMemory((uint32_t(segNo) << 14) + start + i, false);
+              }
+              gui_.unlockVMThread();
+              std::string tmp = fn + ".tmp";
+              if (std::FILE *f = std::fopen(tmp.c_str(), "wb")) {
+                std::fwrite(&buf[0], 1, len, f);
+                std::fclose(f);
+                std::rename(tmp.c_str(), fn.c_str());
+                claudeLog_(line + " ok");
+              }
+              else
+                claudeLog_(line + " HIBA iras");
+            }
+            else
+              claudeLog_(line + " HIBA lock");
+          }
+          else if (cmd == "gepel") {
+            // a sor maradeka: betuk/szamok/szokoz; "=Shift+2  ~=ESC(End)  |=Enter  <=Backspace  nagybetu=Shift+betu
+            std::string t;
+            std::getline(ls, t);
+            if (!t.empty() && t[0] == ' ') t.erase(0, 1);
+            bool wasEmpty = claudeKeys_.empty();
+            for (char ch : t) {
+              if (ch == '"') claudeTap_('2', true);
+              else if (ch == '~') claudeTap_(FL_End, false);
+              else if (ch == '|') claudeTap_(FL_Enter, false);
+              else if (ch == '<') claudeTap_(FL_BackSpace, false);
+              else if (ch >= 'A' && ch <= 'Z') claudeTap_(ch - 'A' + 'a', true);
+              else if ((unsigned char) ch >= 32 && (unsigned char) ch < 127) claudeTap_((unsigned char) ch, false);
+            }
+            if (wasEmpty) { claudeKeyPos_ = 0; claudeKeyNext_ = now; }
+            claudeLog_("gepel " + t);
+          }
+          else if (cmd == "gomb") {
+            // gomb <nev>[+<nev>...] [ms]  - egyszerre nyomva tartja (pl. jobb+szokoz 500); nevek: enter esc fel le bal
+            // jobb szokoz shift bs tab ctrl alt F1.. 0x<FLTK kod> vagy egy karakter
+            std::string names;
+            int ms = 100;
+            ls >> names >> ms;
+            std::vector<int> keys;
+            size_t a = 0;
+            while (a <= names.size()) {
+              size_t b = names.find('+', a);
+              if (b == std::string::npos) b = names.size();
+              int k = claudeNamedKey_(names.substr(a, b - a));
+              if (k >= 0) keys.push_back(k);
+              a = b + 1;
+            }
+            if (keys.empty()) { claudeLog_(line + " HIBA nev"); continue; }
+            bool wasEmpty = claudeKeys_.empty();
+            for (size_t i = 0; i < keys.size(); i++)
+              claudeKeys_.push_back({keys[i], true, i == 0 ? 30 : 20});
+            for (size_t i = 0; i < keys.size(); i++)
+              claudeKeys_.push_back({keys[i], false, i == 0 ? (ms < 20 ? 20 : ms) : 0});
+            if (wasEmpty) { claudeKeyPos_ = 0; claudeKeyNext_ = now; }
+            claudeLog_(line);
+          }
+          else if (cmd == "var") {
+            // var <ms> : a kovetkezo parancsok (ebben a fajlban) varnak - itt csak a billentyusorba tesz szunetet
+            int ms = 0;
+            ls >> ms;
+            claudeKeys_.push_back({-1, false, ms});
+            claudeLog_(line);
+          }
+          else
+            claudeLog_(line + " HIBA ismeretlen");
+        }
+      }
+    }
+  }
+  catch (...) {
+  }
   try {
     if (gui_.flDisplay->checkEvents())
       gui_.emulatorWindow->redraw();
