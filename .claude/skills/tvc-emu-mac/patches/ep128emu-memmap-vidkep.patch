+void TvcMemMapWindow::setVideoState(uint8_t mode, const uint8_t *pal5, const uint8_t *regs18, const uint8_t *disp)
+{
+  vidMode_ = mode & 3;
+  std::memcpy(vidPal_, pal5, 5);
+  std::memcpy(crtc_, regs18, 18);
+  if (disp) std::memcpy(vidDisp_, disp, 16384);
+  haveVid_ = (disp != 0);
+}
+
+// a kepernyo sorai (R6 karaktersor x (R9+1) pixelsor, legfeljebb 288) es egy sor bajtjai (R1)
+int TvcMemMapWindow::vidLines_() const
+{
+  int n = int(crtc_[6] & 0x7F) * (int(crtc_[9] & 0x1F) + 1);
+  if (n <= 0 || n > 288) n = 240;
+  return n;
+}
+
+int TvcMemMapWindow::vidCols_() const
+{
+  int n = crtc_[1];
+  if (n <= 0 || n > 64) n = 64;
+  return n;
+}
+
+// a TVC videocim-kepzese (mint a tvcvideo.cpp): MA = kezdocim + karaktersor * R1 + oszlop, RA = pixelsor a karaktersoron belul
+int TvcMemMapWindow::vidAddr_(int y, int c) const
+{
+  int rows = int(crtc_[9] & 0x1F) + 1;
+  int ma = ((int(crtc_[12] & 0x3F) << 8) | crtc_[13]) + (y / rows) * vidCols_() + c;
+  int ra = y % rows;
+  return (((ra & 3) << 6) | (ma & 0x3F) | ((ma & 0xFC0) << 2)) & 0x3FFF;
+}
+
+// VID: a kepernyo kepe a TVC szineivel (2/4/16 szinu mod, aktualis paletta) - ugyanaz, mint az emulator kepe
+void TvcMemMapWindow::drawVidScreen_(const Box& r)
+{
+  const int lines = vidLines_(), cols = vidCols_();
+  const int sub = 8;                              // egy bajt = 8 alpixel (2 szin: 8 px, 4 szin: 4 x 2, 16 szin: 2 x 4)
+  int pw = r.w, ph = r.h;
+  for (int py = 0; py < ph; py++) {
+    int y = (py * lines) / ph;
+    for (int px = 0; px < pw; px++) {
+      int sx = (px * cols * sub) / pw;
+      int c = sx / sub, k = sx % sub;
+      uint8_t v = vidDisp_[vidAddr_(y, c)];
+      uint8_t pix;
+      if (vidMode_ == 0)                          // 2 szin: bit 7..0 -> paletta 0/1
+        pix = vidPal_[(v >> (7 - k)) & 1];
+      else if (vidMode_ == 1) {                   // 4 szin: pixel n: also bit = bit(7-n), felso = bit(3-n)
+        int n = k >> 1;
+        pix = vidPal_[((v >> (7 - n)) & 1) | (((v >> (3 - n)) & 1) << 1)];
+      }
+      else                                        // 16 szin: bal pixel = a paros (AA), jobb = a paratlan (55) bitek
+        pix = (k < 4 ? (v & 0xAA) : (v & 0x55));
+      unsigned char *p = &img_[(size_t(py) * pw + px) * 3];
+      // a TVCVideo::convertPixelToRGB szerint: R = 0x0C, G = 0x30, B = 0x03 bitpar, intenzitas = 0xC0; sotet = 4/7
+      int hi = (pix & 0xC0) ? 255 : 146;
+      p[0] = (pix & 0x0C) ? hi : 0;
+      p[1] = (pix & 0x30) ? hi : 0;
+      p[2] = (pix & 0x03) ? hi : 0;
+    }
+  }
+  fl_draw_image(&img_[0], r.x, r.y, pw, ph, 3);
+}
