+// TVC memoriaterkep-ablak (Mac, WaterPumpGame / Claude kiegeszites) - lasd memmap.hpp
+#include "memmap.hpp"
+#include "pngwrite.hpp"
+
+#include <FL/Fl.H>
+#include <FL/fl_draw.H>
+#include <FL/x.H>
+#include <cstdio>
+#include <cstring>
+
+namespace {
+  const int M = 8;          // margo
+  const int LBL = 78;       // a bal oldali lap-felirat oszlop
+  const int HDR = 40;       // a negyzetek feletti harom soros fejlec
+  const int STATUS = 30;    // also allapotsor
+  const Fl_Color BG = fl_rgb_color(30, 30, 36);
+  const Fl_Color PANEL = fl_rgb_color(22, 22, 28);
+  const Fl_Color TXT = fl_rgb_color(225, 225, 225);
+  const Fl_Color DIM = fl_rgb_color(150, 150, 160);
+  const Fl_Color YEL = fl_rgb_color(255, 210, 40);
+  const Fl_Color GRN = fl_rgb_color(110, 220, 110);
+  const Fl_Color ORA = fl_rgb_color(255, 150, 60);
+  const unsigned char ZERO_RGB[3] = { 26, 26, 34 };
+  const unsigned char FREE_RGB[3] = { 20, 56, 32 };
+
+  std::string ezres(int n)        // 12843 -> "12 843"
+  {
+    char b[32];
+    std::snprintf(b, sizeof(b), "%d", n);
+    std::string s(b), r;
+    int k = int(s.size());
+    for (int i = 0; i < k; i++) {
+      r += s[i];
+      int left = k - 1 - i;
+      if (left > 0 && left % 3 == 0) r += ' ';
+    }
+    return r;
+  }
+}
+
+TvcMemMapWindow::TvcMemMapWindow()
+  : Fl_Double_Window(660, 900, "TVC memóriatérkép"),
+    side_(128), haveData_(false), paused_(false),
+    hoverSeg_(-1), hoverOff_(0), selSeg_(-1), selOff_(0)
+{
+  std::memset(mem_, 0, sizeof(mem_));
+  std::memset(pages_, 0, sizeof(pages_));
+  std::memset(stat_, 0, sizeof(stat_));
+  pauseBtn_ = new Fl_Button(0, 0, 80, 22, "Szünet");
+  pauseBtn_->labelsize(12);
+  pauseBtn_->callback(&pauseCb_, (void *) this);
+  end();
+  resizable(this);
+  size_range(360, 420);
+  layout_();
+}
+
+TvcMemMapWindow::~TvcMemMapWindow()
+{
+}
+
+int TvcMemMapWindow::segNumber(int s)
+{
+  static const int n[SEG_N] = { 0xF8, 0xF9, 0xFA, 0xFC, 0xFB };
+  return n[s];
+}
+
+int TvcMemMapWindow::baseAddr_(int s)
+{
+  static const int a[SEG_N] = { 0x0000, 0x4000, 0x8000, 0x8000, 0xC000 };
+  return a[s];
+}
+
+const char * TvcMemMapWindow::segName_(int s)
+{
+  static const char *n[SEG_N] = { "U0", "U1", "U2", "VID", "U3" };
+  return n[s];
+}
+
+std::string TvcMemMapWindow::pageName_(uint8_t seg)
+{
+  switch (seg) {
+  case 0xF8: return "U0";
+  case 0xF9: return "U1";
+  case 0xFA: return "U2";
+  case 0xFB: return "U3";
+  case 0xFC: return "VID";
+  case 0xFD: return "VID1";
+  case 0xFE: return "VID2";
+  case 0xFF: return "VID3";
+  case 0x00: return "SYS ROM";
+  case 0x01: return "CART";
+  case 0x02: return "EXT/IO";
+  }
+  char b[8];
+  std::snprintf(b, sizeof(b), "$%02X", seg);
+  return b;
+}
+
+void TvcMemMapWindow::setPages(const uint8_t *p)
+{
+  for (int i = 0; i < 4; i++) pages_[i] = p[i];
+}
+
+void TvcMemMapWindow::dataUpdated()
+{
+  haveData_ = true;
+  computeStats_();
+  redraw();
+}
+
+void TvcMemMapWindow::computeStats_()
+{
+  for (int s = 0; s < SEG_N; s++) {
+    const uint8_t *d = mem_[s];
+    int used = 0, bestS = 0, bestL = 0, runS = 0, runL = 0;
+    for (int i = 0; i < 16384; i++) {
+      if (d[i]) {
+        used++;
+        if (runL > bestL) { bestL = runL; bestS = runS; }
+        runL = 0;
+      }
+      else {
+        if (runL == 0) runS = i;
+        runL++;
+      }
+    }
+    if (runL > bestL) { bestL = runL; bestS = runS; }
+    stat_[s].used = used;
+    stat_[s].freeStart = bestS;
+    stat_[s].freeLen = bestL;
+  }
+}
+
+void TvcMemMapWindow::layout_()
+{
+  int sw = (w() - LBL - 3 * M) / 2;
+  int sh = (h() - STATUS - M - 4 * (HDR + M)) / 4;
+  side_ = (sw < sh ? sw : sh);
+  if (side_ < 32) side_ = 32;
+  int x1 = M + LBL, x2 = x1 + side_ + M;
+  int rowH = HDR + side_ + M;
+  for (int i = 0; i < 4; i++) {
+    int y = M + i * rowH + HDR;
+    int s = (i == 0 ? SEG_U0 : (i == 1 ? SEG_U1 : (i == 2 ? SEG_U2 : SEG_U3)));
+    r_[s].x = x1; r_[s].y = y; r_[s].w = side_; r_[s].h = side_;
+  }
+  r_[SEG_VID] = r_[SEG_U2];
+  r_[SEG_VID].x = x2;
+  info_.x = x2; info_.y = M; info_.w = side_; info_.h = 2 * rowH - M;
+  legend_.x = x2; legend_.y = M + 3 * rowH; legend_.w = side_; legend_.h = HDR + side_;
+  int sy = M + 4 * rowH;
+  pauseBtn_->resize(x2 + side_ - 80, sy, 80, 22);
+  img_.resize(size_t(side_) * size_t(side_) * 3);
+}
+
+void TvcMemMapWindow::resize(int x_, int y_, int w_, int h_)
+{
+  Fl_Double_Window::resize(x_, y_, w_, h_);
+  layout_();
+  redraw();
+}
+
+void TvcMemMapWindow::valueColor_(int v, unsigned char *rgb)
+{
+  // 1 -> sotetkek, $40 -> turkiz, $80 -> zold, $C0 -> sarga, $FF -> feher
+  static const int st[5][4] = {
+    {   1,  40,  60, 170 }, {  64,   0, 165, 210 }, { 128,  50, 205,  70 },
+    { 192, 235, 210,  40 }, { 255, 255, 255, 255 } };
+  if (v <= 0) { rgb[0] = ZERO_RGB[0]; rgb[1] = ZERO_RGB[1]; rgb[2] = ZERO_RGB[2]; return; }
+  int k = 0;
+  while (k < 3 && v > st[k + 1][0]) k++;
+  int a = st[k][0], b = st[k + 1][0];
+  int t = (b > a ? ((v - a) * 256) / (b - a) : 0);
+  for (int c = 0; c < 3; c++)
+    rgb[c] = (unsigned char) (st[k][c + 1] + (((st[k + 1][c + 1] - st[k][c + 1]) * t) >> 8));
+}
+
+void TvcMemMapWindow::drawSeg_(int s)
+{
+  const Box& r = r_[s];
+  const uint8_t *d = mem_[s];
+  const Stat& st = stat_[s];
+  int sn = segNumber(s);
+  int mappedPage = -1;
+  for (int i = 0; i < 4; i++) {
+    if (pages_[i] == sn || (s == SEG_VID && pages_[i] >= 0xFC)) { mappedPage = i; break; }
+  }
+  // fejlec
+  char b[160];
+  fl_font(FL_HELVETICA_BOLD, 12);
+  fl_color(TXT);
+  std::snprintf(b, sizeof(b), "%s  $%04X–$%04X", segName_(s), baseAddr_(s), baseAddr_(s) + 0x3FFF);
+  fl_push_clip(r.x, r.y - HDR, r.w, HDR);
+  fl_draw(b, r.x, r.y - HDR + 12);
+  if (mappedPage >= 0) {
+    int tw = int(fl_width(b));
+    std::snprintf(b, sizeof(b), "  ▶ %d. lap", mappedPage);
+    fl_color(YEL);
+    fl_draw(b, r.x + tw, r.y - HDR + 12);
+  }
+  fl_font(FL_HELVETICA, 10);
+  fl_color(DIM);
+  if (haveData_) {
+    std::string t = "foglalt: " + ezres(st.used) + " / 16 384 bájt (" + std::to_string((st.used * 100 + 8191) / 16384) + "%)";
+    fl_draw(t.c_str(), r.x, r.y - 17);
+    if (st.freeLen > 0) {
+      std::snprintf(b, sizeof(b), "max. szabad: $%04X–$%04X (%s)", baseAddr_(s) + st.freeStart,
+                    baseAddr_(s) + st.freeStart + st.freeLen - 1, ezres(st.freeLen).c_str());
+      fl_draw(b, r.x, r.y - 5);
+    }
+  }
+  fl_pop_clip();
+  // kep: pixelenkent a lefedett bajtok maximuma (kicsinyitesnel sem tunik el a nem nulla bajt)
+  int n = side_;
+  int fs = st.freeStart, fe = st.freeStart + st.freeLen;
+  for (int py = 0; py < n; py++) {
+    int by0 = (py * 128) / n, by1 = ((py + 1) * 128) / n;
+    if (by1 <= by0) by1 = by0 + 1;
+    for (int px = 0; px < n; px++) {
+      int bx0 = (px * 128) / n, bx1 = ((px + 1) * 128) / n;
+      if (bx1 <= bx0) bx1 = bx0 + 1;
+      int mx = 0;
+      for (int yy = by0; yy < by1; yy++)
+        for (int xx = bx0; xx < bx1; xx++) {
+          int v = d[yy * 128 + xx];
+          if (v > mx) mx = v;
+        }
+      unsigned char *p = &img_[(size_t(py) * n + px) * 3];
+      int off = by0 * 128 + bx0;
+      if (mx == 0 && haveData_ && off >= fs && off < fe) {
+        p[0] = FREE_RGB[0]; p[1] = FREE_RGB[1]; p[2] = FREE_RGB[2];
+      }
+      else
+        valueColor_(mx, p);
+    }
+  }
+  fl_draw_image(&img_[0], r.x, r.y, n, n, 3);
+  // keret: sarga = be van lapozva
+  if (mappedPage >= 0) {
+    fl_color(YEL);
+    fl_rect(r.x - 2, r.y - 2, r.w + 4, r.h + 4);
+    fl_rect(r.x - 1, r.y - 1, r.w + 2, r.h + 2);
+  }
+  else {
+    fl_color(fl_rgb_color(80, 80, 90));
+    fl_rect(r.x - 1, r.y - 1, r.w + 2, r.h + 2);
+  }
+  // kijelolt sor es egermutato
+  if (selSeg_ == s) {
+    int y0 = r.y + ((selOff_ >> 7) * n) / 128, y1 = r.y + (((selOff_ >> 7) + 1) * n) / 128;
+    fl_color(FL_WHITE);
+    fl_rect(r.x - 1, y0 - 1, r.w + 2, (y1 - y0) + 2);
+  }
+  if (hoverSeg_ == s) {
+    int bx = hoverOff_ & 127, by = hoverOff_ >> 7;
+    int x0 = r.x + (bx * n) / 128, x1 = r.x + ((bx + 1) * n) / 128;
+    int y0 = r.y + (by * n) / 128, y1 = r.y + ((by + 1) * n) / 128;
+    fl_color(fl_rgb_color(255, 60, 200));
+    fl_rect(x0 - 2, y0 - 2, (x1 - x0) + 4, (y1 - y0) + 4);
+  }
+}
+
+void TvcMemMapWindow::drawInfo_()
+{
+  const Box& r = info_;
+  fl_color(PANEL);
+  fl_rectf(r.x, r.y, r.w, r.h);
+  fl_color(fl_rgb_color(80, 80, 90));
+  fl_rect(r.x, r.y, r.w, r.h);
+  fl_push_clip(r.x + 1, r.y + 1, r.w - 2, r.h - 2);
+  int x = r.x + 6, y = r.y + 16;
+  char b[200];
+  fl_font(FL_HELVETICA_BOLD, 12);
+  fl_color(TXT);
+  fl_draw("Részletek", x, y);
+  y += 18;
+  fl_font(FL_COURIER, 11);
+  if (hoverSeg_ >= 0) {
+    int v = mem_[hoverSeg_][hoverOff_];
+    std::snprintf(b, sizeof(b), "%s $%04X = $%02X (%d)", segName_(hoverSeg_),
+                  baseAddr_(hoverSeg_) + hoverOff_, v, v);
+    fl_color(fl_rgb_color(255, 120, 220));
+    fl_draw(b, x, y);
+  }
+  else {
+    fl_color(DIM);
+    fl_font(FL_HELVETICA, 11);
+    fl_draw("(vidd az egeret a térképre)", x, y);
+  }
+  y += 20;
+  if (selSeg_ < 0) {
+    fl_color(DIM);
+    fl_font(FL_HELVETICA, 11);
+    fl_draw("Kattints egy sorra: hexa nézet", x, y);
+    fl_pop_clip();
+    return;
+  }
+  int a0 = selOff_ & ~127;
+  std::snprintf(b, sizeof(b), "%s $%04X–$%04X", segName_(selSeg_),
+                baseAddr_(selSeg_) + a0, baseAddr_(selSeg_) + a0 + 127);
+  fl_color(FL_WHITE);
+  fl_draw(b, x, y);
+  y += 16;
+  fl_font(FL_COURIER, 11);
+  int bpl = 16;
+  while (bpl > 4 && fl_width("0000 ") + fl_width("00 ") * bpl > r.w - 10) bpl /= 2;
+  const uint8_t *d = mem_[selSeg_];
+  for (int o = a0; o < a0 + 128 && y < r.y + r.h - 4; o += bpl) {
+    int n = std::snprintf(b, sizeof(b), "%04X ", baseAddr_(selSeg_) + o);
+    for (int k = 0; k < bpl && n < int(sizeof(b)) - 4; k++)
+      n += std::snprintf(b + n, sizeof(b) - n, "%02X ", d[o + k]);
+    fl_color((hoverSeg_ == selSeg_ && hoverOff_ >= o && hoverOff_ < o + bpl) ? fl_rgb_color(255, 120, 220) : TXT);
+    fl_draw(b, x, y);
+    y += 13;
+  }
+  fl_pop_clip();
+}
+
+void TvcMemMapWindow::drawLegend_()
+{
+  const Box& r = legend_;
+  fl_push_clip(r.x, r.y, r.w, r.h);
+  int x = r.x + 4, y = r.y + 12;
+  fl_font(FL_HELVETICA_BOLD, 12);
+  fl_color(TXT);
+  fl_draw("Érték nézet", x, y);
+  y += 10;
+  int bw = r.w - 8;
+  unsigned char rgb[3];
+  for (int i = 0; i < bw; i++) {
+    valueColor_(1 + (i * 254) / (bw > 1 ? bw - 1 : 1), rgb);
+    fl_color(rgb[0], rgb[1], rgb[2]);
+    fl_yxline(x + i, y, y + 12);
+  }
+  y += 24;
+  fl_font(FL_HELVETICA, 10);
+  fl_color(DIM);
+  fl_draw("$01", x, y);
+  fl_draw("$80", x + bw / 2 - 8, y);
+  fl_draw("$FF", x + bw - 18, y);
+  y += 16;
+  struct { const unsigned char *c; Fl_Color fc; const char *t; } it[3] = {
+    { ZERO_RGB, 0, "0 = üres bájt" },
+    { FREE_RGB, 0, "leghosszabb szabad (nullás) szakasz" },
+    { 0, YEL, "sárga keret = be van lapozva" } };
+  for (int i = 0; i < 3; i++) {
+    if (it[i].c) { fl_color(it[i].c[0], it[i].c[1], it[i].c[2]); fl_rectf(x, y - 9, 12, 10); }
+    else { fl_color(it[i].fc); fl_rect(x, y - 9, 12, 10); }
+    fl_color(DIM);
+    fl_draw(it[i].t, x + 18, y);
+    y += 15;
+  }
+  y += 4;
+  fl_draw("Egy sor = $80 bájt; kicsinyítve egy pont", x, y); y += 13;
+  fl_draw("a lefedett bájtok legnagyobbika.", x, y);
+  fl_pop_clip();
+}
+
+void TvcMemMapWindow::drawStatus_()
+{
+  int y = M + 4 * (HDR + side_ + M) + 15;
+  fl_font(FL_HELVETICA, 11);
+  std::string t;
+  if (paused_) t = "SZÜNET · ";
+  t += "Lapozás:";
+  for (int i = 0; i < 4; i++) t += "  " + std::to_string(i) + "=" + pageName_(pages_[i]);
+  fl_color(paused_ ? ORA : TXT);
+  fl_push_clip(M, y - 14, pauseBtn_->x() - 2 * M, 22);
+  fl_draw(t.c_str(), M, y);
+  fl_pop_clip();
+}
+
+void TvcMemMapWindow::draw()
+{
+  fl_color(BG);
+  fl_rectf(0, 0, w(), h());
+  // bal oszlop: CPU-lapok, mi van bennuk
+  int rowH = HDR + side_ + M;
+  static const uint8_t natural[4] = { 0xF8, 0xF9, 0xFA, 0xFB };
+  for (int i = 0; i < 4; i++) {
+    int y = M + i * rowH + HDR;
+    char b[32];
+    fl_font(FL_HELVETICA_BOLD, 12);
+    fl_color(TXT);
+    std::snprintf(b, sizeof(b), "%d. lap", i);
+    fl_draw(b, M, y + 12);
+    fl_font(FL_HELVETICA, 10);
+    fl_color(DIM);
+    std::snprintf(b, sizeof(b), "$%04X", i * 0x4000);
+    fl_draw(b, M, y + 26);
+    uint8_t pg = pages_[i];
+    bool nat = (pg == natural[i]) || (i == 2 && pg >= 0xFC);
+    fl_font(FL_HELVETICA_BOLD, 10);
+    fl_color(nat ? GRN : ORA);
+    fl_draw(("▶ " + pageName_(pg)).c_str(), M, y + 44);
+  }
+  for (int s = 0; s < SEG_N; s++) drawSeg_(s);
+  drawInfo_();
+  drawLegend_();
+  drawStatus_();
+  if (!haveData_) {
+    fl_font(FL_HELVETICA_BOLD, 14);
+    fl_color(ORA);
+    fl_draw("nincs adat (fut a TVC?)", r_[SEG_U0].x + 8, r_[SEG_U0].y + 24);
+  }
+  draw_children();
+}
+
+int TvcMemMapWindow::hit_(int mx, int my, int& off) const
+{
+  for (int s = 0; s < SEG_N; s++) {
+    const Box& r = r_[s];
+    if (mx >= r.x && mx < r.x + r.w && my >= r.y && my < r.y + r.h) {
+      int bx = ((mx - r.x) * 128) / r.w, by = ((my - r.y) * 128) / r.h;
+      if (bx > 127) bx = 127;
+      if (by > 127) by = 127;
+      off = by * 128 + bx;
+      return s;
+    }
+  }
+  return -1;
+}
+
+int TvcMemMapWindow::handle(int ev)
+{
+  switch (ev) {
+  case FL_ENTER:
+    Fl_Double_Window::handle(ev);
+    return 1;
+  case FL_MOVE:
+  case FL_DRAG:
+    {
+      int off = 0;
+      int s = hit_(Fl::event_x(), Fl::event_y(), off);
+      if (s != hoverSeg_ || (s >= 0 && off != hoverOff_)) {
+        hoverSeg_ = s;
+        hoverOff_ = off;
+        redraw();
+      }
+    }
+    break;
+  case FL_LEAVE:
+    if (hoverSeg_ >= 0) { hoverSeg_ = -1; redraw(); }
+    break;
+  case FL_PUSH:
+    {
+      int off = 0;
+      int s = hit_(Fl::event_x(), Fl::event_y(), off);
+      if (s >= 0) {
+        selSeg_ = s;
+        selOff_ = off;
+        redraw();
+        return 1;
+      }
+    }
+    break;
+  }
+  return Fl_Double_Window::handle(ev);
+}
+
+void TvcMemMapWindow::pauseCb_(Fl_Widget *w, void *v)
+{
+  (void) w;
+  TvcMemMapWindow *mw = reinterpret_cast<TvcMemMapWindow *>(v);
+  mw->paused_ = !mw->paused_;
+  mw->pauseBtn_->label(mw->paused_ ? "Folytat" : "Szünet");
+  mw->redraw();
+}
+
+bool TvcMemMapWindow::snapshot(const std::string& fileName, std::string& err)
+{
+  int ww = w(), hh = h();
+  Fl_Offscreen off = fl_create_offscreen(ww, hh);
+  if (!off) { err = "offscreen"; return false; }
+  fl_begin_offscreen(off);
+  draw();
+  unsigned char *buf = fl_read_image((unsigned char *) 0, 0, 0, ww, hh);
+  fl_end_offscreen();
+  fl_delete_offscreen(off);
+  if (!buf) { err = "read_image"; return false; }
+  try {
+    std::string tmp = fileName + ".tmp";
+    Ep128Emu::writePNGImage(tmp.c_str(), buf, ww, hh, 0, false, 32768);
+    std::rename(tmp.c_str(), fileName.c_str());
+  }
+  catch (std::exception& e) {
+    delete[] buf;
+    err = e.what();
+    return false;
+  }
+  delete[] buf;
+  return true;
+}
