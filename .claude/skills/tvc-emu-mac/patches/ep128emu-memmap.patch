+// TVC memoriaterkep-ablak (Mac, WaterPumpGame / Claude kiegeszites)
+// Az U0, U1, U2, U3 RAM-lap egymas alatt, a VID az U2 mellett; lapokent 128 x 128 bajt (egy sor = $80 bajt).
+// Az adatot a gui.cpp tolti (segData + setPages + dataUpdated), az ablak csak rajzol.
+#ifndef EP128EMU_MEMMAP_HPP
+#define EP128EMU_MEMMAP_HPP
+
+#include <FL/Fl_Double_Window.H>
+#include <FL/Fl_Button.H>
+#include <stdint.h>
+#include <string>
+#include <vector>
+
+class TvcMemMapWindow : public Fl_Double_Window {
+ public:
+  enum { SEG_U0 = 0, SEG_U1, SEG_U2, SEG_VID, SEG_U3, SEG_N };
+  TvcMemMapWindow();
+  virtual ~TvcMemMapWindow();
+  // a lap fizikai szegmensszama (F8..FC)
+  static int segNumber(int s);
+  uint8_t *segData(int s) { return mem_[s]; }
+  void setPages(const uint8_t *p);
+  void dataUpdated();
+  bool isPaused() const { return paused_; }
+  // az ablak kepe PNG-be (kepernyon kivuli rajzolassal - akkor is mukodik, ha az ablak takarva van)
+  bool snapshot(const std::string& fileName, std::string& err);
+  virtual void draw();
+  virtual int handle(int ev);
+  virtual void resize(int x_, int y_, int w_, int h_);
+ private:
+  struct Stat { int used; int freeStart; int freeLen; };
+  struct Box { int x, y, w, h; };
+  uint8_t   mem_[SEG_N][16384];
+  uint8_t   pages_[4];
+  Stat      stat_[SEG_N];
+  Box       r_[SEG_N];          // a terkep-negyzetek (fejlec nelkul)
+  Box       info_;              // reszletek panel (jobb oszlop, az U2 sora felett)
+  Box       legend_;            // jelmagyarazat (jobb oszlop, az U3 soraban)
+  int       side_;
+  bool      haveData_;
+  bool      paused_;
+  int       hoverSeg_, hoverOff_;
+  int       selSeg_, selOff_;
+  std::vector<unsigned char> img_;
+  Fl_Button *pauseBtn_;
+  void layout_();
+  void computeStats_();
+  int hit_(int mx, int my, int& off) const;
+  void drawSeg_(int s);
+  void drawInfo_();
+  void drawLegend_();
+  void drawStatus_();
+  static void pauseCb_(Fl_Widget *w, void *v);
+  static void valueColor_(int v, unsigned char *rgb);
+  static int baseAddr_(int s);
+  static const char *segName_(int s);
+  static std::string pageName_(uint8_t seg);
+};
+
+#endif  // EP128EMU_MEMMAP_HPP
