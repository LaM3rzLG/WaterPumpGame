program SzinGyors;
@use "TVC"

/* GRAPHICS2 (2 szín, 512x240): fekete háttér, csak a felirat tinta (1. paletta, port $61).
   Függőleges színcsíkok soron belüli palettaváltással: out (c),r = 12 T / váltás
   (GRAPHICS2-ben 2 T = 1 byte = 8 pixel, tehát 12 T = 6 byte = 48 pixel széles csík).
   Soronként 14 váltás (6 szín: B,D,E,H,L,A), a sorszámláló a másik regiszterkészletben (exx), 1 sor = 200 T.
   Szinkron: EGYETLEN halt induláskor (a 239. sor végén), utána megszakítás NÉLKÜL, órajel-pontos
   képkocka-ciklus: 78 x 4 + 2 = 314 sor = 62800 T.

   FINOM GÖRGETÉS: képkockánként 1 T-vel később indulnak a sor out-jai (k = 0..11 T késleltetés)
   = 4 pixel / képkocka jobbra. 12 lépés (egy csík) után k visszaáll 0-ra, és ugyanakkor a színek
   eggyel elfordulnak - a kép ott pontosan folytatódik, nincs ugrás. A képkocka végén 11-k T-vel
   várunk (a 62800 T állandó). A fázis p = 0..71 (12 lépés x 6 szín), minden táblából olvasva,
   elágazás nélkül - minden képkocka azonos ideig tart. */

var
	i			:	byte;
	SzP			:	byte = 71;		// fázis 0..71; 71-ről indul, így az első képkockán 0 (k = 0)
	SzPNext		:	array[72] of byte;	// p -> p+1 (71 -> 0)
	SzK2		:	array[72] of byte;	// p -> k*2       (k = p mod 12; a késleltető-tábla eltolása)
	SzK2b		:	array[72] of byte;	// p -> (11-k)*2  (a kiegyenlítő késleltetés)
	SzRt		:	array[72] of byte;	// p -> színforgatás r = (6 - (p div 12)) mod 6
	SzSzin		:	array[12] of byte = (68, 80, 65, 84, 81, 69, 68, 80, 65, 84, 81, 69);	// piros, zöld, kék, sárga, cián, lila (2x)
	pp, kk, qq	:	byte;

begin
	TVC::SetGraphicsMode(TVC::GRAPHICS2);
	TVC::SetRasterInterruptPos(239);	// a VMODE után: raszter-IT a 239. sor végére
	TVC::SetPalette(0, TVC::PALETTE_BLACK);
	TVC::SetBorder(TVC::BORDER_BLACK);

	/* fázistáblák */
	pp := 0;
	kk := 0;
	qq := 0;
	while (pp < 72) do
	begin
		SzPNext[pp] := pp + 1;
		SzK2[pp] := kk * 2;
		SzK2b[pp] := (11 - kk) * 2;
		if (qq = 0) then SzRt[pp] := 0 else SzRt[pp] := 6 - qq;
		kk := kk + 1;
		if (kk = 12) then
		begin
			kk := 0;
			qq := qq + 1;
		end;
		pp := pp + 1;
	end;
	SzPNext[71] := 0;

	/* képernyő törlése feketére (papír = 0. paletta); csak a szöveg tinta */
	TVC::ClearScreen();

	/* szöveg 10x egymás alá, a kép közepére (ROM kiírás, még a ROM megszakítás-kezelőjével):
	   36 karakter -> X = (64-36)/2+1 = 15; 10 sor a 24-ből -> a 8..17. szövegsor (80..179. pixelsor).
	   Színes betűk (tinta = 1. paletta, a csíkok színe), fekete háttéren (papír = 0. paletta). */
	TVC::SetColor(1);
	TVC::TextBackground(0);
	i := 8;
	while (i < 18) do
	begin
		TVC::WriteAt(15, i, "VIDEOTON TV-COMPUTER GRAPHICS 2 MODE");
		i := i + 1;
	end;

	asm("
		di
		;// saját megszakítás-kezelő: $38 -> JP SzG_Isr
		ld hl,$38
		ld (hl),195
		ld de,SzG_Isr
		inc hl
		ld (hl),e
		inc hl
		ld (hl),d

		;// hang ki, hang-megszakítás tiltva (port $05: bit4 = hang tiltás, bit5 = 0 -> nincs hang-IT)
		ld a,$10
		out ($5),a

		;// szinkron, utána nincs több megszakítás. A di alatt beragadt régi IT-kérést előbb
		;// nyugtázzuk, és két halt: az első egy esetleg még függő kérésre ébredhet, a második a valódi
		out ($7),a
		ei
		halt
		halt
		di
		;// egyszeri fázis-eltolás 157 T: a szinkrontól az első out-ig ugyanannyi idő (14819 T),
		;// mint az álló változatban (ott mérve: a sor 1. out-ja a látható rész bal szélén)
		ld b,11				;// 7
SzG_F:
		djnz SzG_F			;// 10 x 13 + 8 = 138  (= 145)
		nop					;// 4
		nop					;// 4
		nop					;// 4  (= 157)
		jp SzG_Var			;// 10

		;// ===== egy képkocka = PONTOSAN 62800 T =====
SzG_Kep:
		;// --- p := SzPNext[p] (65) ---
		ld a,[SzP]			;// 13
		ld e,a				;// 4
		ld d,0				;// 7
		ld hl,SzPNext		;// 10
		add hl,de			;// 11
		ld a,(hl)			;// 7
		ld [SzP],a			;// 13
		;// --- a := k*2 (32) ---
		ld e,a				;// 4
		ld hl,SzK2			;// 10
		add hl,de			;// 11
		ld a,(hl)			;// 7
		;// --- ugrás a k T-s késleltetőre, vissza az SzG_K1-re (74) ---
		ld hl,SzG_DT		;// 10
		ld c,a				;// 4
		ld b,0				;// 7
		add hl,bc			;// 11
		ld a,(hl)			;// 7
		inc hl				;// 6
		ld h,(hl)			;// 7
		ld l,a				;// 4
		ld ix,SzG_K1		;// 14
		jp (hl)				;// 4   (65 + 32 + 74 = 171)
SzG_K1:
		;// --- színek a regiszterekbe, r-rel elforgatva (168) ---
		ld a,[SzP]			;// 13
		ld e,a				;// 4
		ld d,0				;// 7
		ld hl,SzRt			;// 10
		add hl,de			;// 11
		ld e,(hl)			;// 7   e = r
		ld hl,SzSzin		;// 10
		add hl,de			;// 11
		ld b,(hl)			;// 7   1. szín
		inc hl				;// 6
		ld d,(hl)			;// 7   2.
		inc hl				;// 6
		ld e,(hl)			;// 7   3.
		inc hl				;// 6
		ld c,(hl)			;// 7   4. (átmenetileg C-ben)
		inc hl				;// 6
		ld a,(hl)			;// 7   5. (átmenetileg A-ban)
		inc hl				;// 6
		ld l,(hl)			;// 7   6. (átmenetileg L-ben)
		ld h,c				;// 4   H = 4.
		ld c,a				;// 4
		ld a,l				;// 4   A = 6.
		ld l,c				;// 4   L = 5.
		ld c,$61			;// 7   C = tinta paletta port   (= 168)
		exx					;// 4
		ld b,240			;// 7   sorszámláló (a másik készletben)
		jp SzG_Sor			;// 10  (= 189)

		;// egy sor = PONTOSAN 200 T (240 sor = 48000 T, az utolsó djnz 5 T-vel rövidebb)
SzG_Sor:
		exx					;// 4   -> színregiszterek
		out (c),b			;// 12
		out (c),d			;// 12
		out (c),e			;// 12
		out (c),h			;// 12
		out (c),l			;// 12
		out (c),a			;// 12
		out (c),b			;// 12
		out (c),d			;// 12
		out (c),e			;// 12
		out (c),h			;// 12
		out (c),l			;// 12
		out (c),a			;// 12
		out (c),b			;// 12
		out (c),a			;// 12  (14 x 12 = 168) - a kör 1. színe ELŐTTI szín (a 6.): a sor eleji, az 1. out előtti rész ezt mutatja, így görgetéskor balról az előző csík csúszik be
		nop					;// 4
		ld c,$61			;// 7   (kitöltés, C változatlan)
		exx					;// 4   -> számláló
		djnz SzG_Sor		;// 13  (= 200)
		exx					;// 4

		;// --- kiegyenlítő késleltetés: (11-k) T, vissza az SzG_K2-re (126) ---
		ld a,[SzP]			;// 13
		ld e,a				;// 4
		ld d,0				;// 7
		ld hl,SzK2b			;// 10
		add hl,de			;// 11
		ld a,(hl)			;// 7
		ld hl,SzG_DT		;// 10
		ld c,a				;// 4
		ld b,0				;// 7
		add hl,bc			;// 11
		ld a,(hl)			;// 7
		inc hl				;// 6
		ld h,(hl)			;// 7
		ld l,a				;// 4
		ld ix,SzG_K2		;// 14
		jp (hl)				;// 4   (= 126)
SzG_K2:
		;// a képkocka többi része: 62800 - 48538 = 14262 T
		;// (171 + 16+k + 189 + 47995 + 4 + 126 + 16+(11-k) + 10 = 48538)
SzG_Var:
		ld c,71				;// 7
SzG_V1:
		ld b,14				;// 7
SzG_V2:
		djnz SzG_V2			;// 177
		dec c				;// 4
		jr nz,SzG_V1		;// 12 (utolsó: 7)  -> 71 x 200 - 5 + 7 = 14202
		ld b,4				;// 7
SzG_V3:
		djnz SzG_V3			;// 3 x 13 + 8 = 47  (= 14256)
		inc hl				;// 6   (= 14262)
		jp SzG_Kep			;// 10

		;// --- késleltetők: 8+k T + jp (ix) 8 T = 16+k T (k = 0..11) ---
SzG_D0:
		nop					;// 4
		nop					;// 4   (8)
		jp (ix)
SzG_D1:
		ld a,i				;// 9
		jp (ix)
SzG_D2:
		nop					;// 4
		inc hl				;// 6   (10)
		jp (ix)
SzG_D3:
		nop					;// 4
		ld a,0				;// 7   (11)
		jp (ix)
SzG_D4:
		nop
		nop
		nop					;// 12
		jp (ix)
SzG_D5:
		nop					;// 4
		ld a,i				;// 9   (13)
		jp (ix)
SzG_D6:
		nop
		nop					;// 8
		inc hl				;// 6   (14)
		jp (ix)
SzG_D7:
		nop
		nop					;// 8
		ld a,0				;// 7   (15)
		jp (ix)
SzG_D8:
		nop
		nop
		nop
		nop					;// 16
		jp (ix)
SzG_D9:
		nop
		nop					;// 8
		ld a,i				;// 9   (17)
		jp (ix)
SzG_D10:
		nop
		nop
		nop					;// 12
		inc hl				;// 6   (18)
		jp (ix)
SzG_D11:
		nop
		nop
		nop					;// 12
		ld a,0				;// 7   (19)
		jp (ix)

SzG_DT:
		dw SzG_D0, SzG_D1, SzG_D2, SzG_D3, SzG_D4, SzG_D5
		dw SzG_D6, SzG_D7, SzG_D8, SzG_D9, SzG_D10, SzG_D11

SzG_Isr:
		out ($7),a			;// IT nyugtázása
		ei
		ret
	");
end.
