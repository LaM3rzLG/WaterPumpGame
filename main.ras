program WaterPumpGame;
@use "TVC"
@use "GE"
 
var
		Pumpa_Data			:	incbin("resources\tvc_sprites\Pumpa.bin");
		Pumpa				:	GE::Sprite;
		
Procedure ProgramInit();
	begin
		GE::SetGraphics(GE::GRAPHICS4);
		GE::SetPalette(0,GE::PALETTE_Gray);
		GE::SetPalette(1,GE::PALETTE_Black);
		GE::SetPalette(2,GE::PALETTE_Green);
		GE::SetPalette(3,GE::PALETTE_Blue);
		Pumpa.Init(#Pumpa_Data,32,100,False);
		Pumpa.InitAnimation(7,20,GE::LOOP_FORWARD);
		GE::Init(GE::DIRECT_TO_SCREEN);
		GE::SetMemory(GE::MEM_VID_ON);
		Pumpa.AnimSet:=	#Pumpa_Data+3;
		Pumpa.AnimPhaseNr:=	1;
	end;

Procedure PumpaKirak();
	begin
		Pumpa.Animation;
		Pumpa.Put;
	end;	

begin
	ProgramInit;
	while not GE::Pressed(GE::KEY_SPACE) do
		begin
			GE::WaitForSync();

			PumpaKirak;
			GE::GetKeyboard();
		end;


	GE::SetBorder(GE::Border_DarkRed);

end.


