program WaterPumpGame;
@use "TVC"
@use "GE"
@use "random"
@use "WaterPump"

var
		/* Sprite-képek (bináris grafikai adatok) */
		/* A sprite- és hangadatok az U3-ban ($C000..$DCxx), 256 byte-os rekeszekben (a meteor 512): a játék MEM_48K_VID lapozással fut (ProgramInit) */
		Pumpa_Data						:	incbin("resources\tvc_sprites\Pumpa.bin", $D100);
		Talaj1_Data						:	incbin("resources\tvc_sprites\talaj1.bin", $D200);
		Talaj2_Data						:	incbin("resources\tvc_sprites\talaj2.bin", $D300);
		Talaj3_Data						:	incbin("resources\tvc_sprites\talaj3.bin", $D400);	/* 8x8, NEM maszkolt (talaj3.bmp) */
		Keret_Data						:	incbin("resources\tvc_sprites\keret.bin", $D500);
		Keret2_Data						:	incbin("resources\tvc_sprites\keret2.bin", $D600);	/* 2. játékos Kerete (2 player teszt) */
		Enemy_Data						:	incbin("resources\tvc_sprites\enemy.bin", $D700);
		Fal_Data						:	incbin("resources\tvc_sprites\fal.bin", $D800);
		Meteor_Data						:	incbin("resources\tvc_sprites\meteor.bin", $D900);
		Bomba_Data						:	incbin("resources\tvc_sprites\bomba.bin", $DB00);
ExplosionSFX				:	incbin("resources\sfx\explosion.bin", $C000);	/* robbanás digi hang (2x4 bit, 4 kHz) */
TickSFX						:	incbin("resources\sfx\tick.bin", $D000);	/* pumpa-lerakás: rövid tick (2x4 bit, 4 kHz) */
BombaIkon_Data				:	incbin("resources\tvc_sprites\bombaikon.bin", $DC00);
		/* A sprite-objektumok: Pumpa (animált szivattyú), Talaj1 (üres talaj mező), Keret */
		Pumpa							:	GE::Sprite;
		Talaj1						 	:	GE::Sprite;
		Talaj2							:	GE::Sprite;
		Talaj3						:	GE::Sprite;	/* 3. talajtípus (blokkoló), nem maszkolt */
		Keret							:	GE::Sprite;
		Keret2							:	GE::Sprite;	/* 2. játékos Kerete: mindig a Keret FÖLÖTT (z-sorrend) */
		Enemy							:	GE::Sprite;
		Fal								:	GE::Sprite;
		Meteor							:	GE::Sprite;
		/* Bomba: a B gombos Bomba_Ledob() zuhanás-animációjához */
		Bomba							:	GE::Sprite;
BombaIkon					:	GE::Sprite;	/* 8x8 bombaikon az árak sorához */
		/* Meteor mozgás: MINDEN képkockán METEOR_LE_PX px LE */
		const METEOR_LE_PX				:	byte = 3;	/* ennyi pixelt megy LEFELÉ képkockánként */
		const METEOR_ANIM_UTEM			:	byte = 3;	/* ennyi képkockánként lép a szikla animációs fázisa (0..3 körbe) */
		const METEOR_START_Y			:	byte = 26;	/* belépő px-Y (fent) - fix */
		const METEOR_X_MIN				:	byte = 2;	/* belépő byte-X: 2..59 (a 12 px = 3 byte széles szikla a pálya teljes szélességében) */
		const METEOR_X_RND				:	byte = 58;
		const METEOR_Y_MIN				:	byte = 70;	/* leállási px-Y minimum */
		const METEOR_Y_RND				:	byte = 130;	/* út-hossz szórása -> leáll Y = 70..199 */
		const METEOR_FAZ_DB				:	byte = 4;
		const METEOR_FAZIS_MERET		:	byte = 96;	/* maszkolt fázis: 3 byte x 16 sor x 2 (maszk+adat) */

		CharSet 							: 	incbin("resources\tvc_sprites\CharSetGR4.bin");
		CashStr 							: 	string = ("CASH$:");
		PumpStr							:	string = ("PUMP:");
		LevelStr					:	string = ("LEVEL:");
		SlashStr					:	string = ("/");
		LivesStr					:	string = ("LIVES:");
		ColonStr					:	string = (":");

		/* A Keret aktuális képernyő-pozíciója pixelben/byte-ban */
		Keret_X_ScreenPOS				: 	byte = 29;
		Keret_Y_ScreenPOS				:	byte = 128;
		/* A Keret aktuális rács (mező) pozíciója */
		Keret_X_Pos						:	byte = 15;
		Keret_Y_Pos						:	byte = 9;
		/* A Keret ELŐZŐ (legutóbb ténylegesen frissített) rács-pozíciója */
		Keret_Elozo_X_Pos				:	byte = 15;
		Keret_Elozo_Y_Pos				:	byte = 9;
		/* 2. játékos Kerete (WASD): rács-pozíció és az utoljára kirajzolt pozíció */
		Keret2_X_Pos					:	byte = 30;
		Keret2_Y_Pos					:	byte = 9;
		Keret2_Elozo_X_Pos				:	byte = 30;
		Keret2_Elozo_Y_Pos				:	byte = 9;
		/* A Keret (kurzor) mozgásának lassítása */
		Keret_Mozog_Utem				:	byte = 5;
		Keret_Mozog_Frame				:	byte = 0;

		/* A játéktér 30x18 mezős rácsa */
		const TERKEP_MERET				:	integer = 18*30;	/* a Map[] mérete (540) */
		Map								:	array	[TERKEP_MERET] of byte at $0BF0;	/* 3056..3595: a GE szerint szabad (nincs fájlművelet) -> nem foglal helyet a programban */
		/* PÁLYÁK: a térképek és a pályánkénti értékek (a terkep_szerkeszto.html adja ki, a teljes blokk cserélhető) */
		const PALYA_DB		:	byte = 10;	/* a pályák száma */
		const INDULO_PALYA	:	byte = 8;	/* induló pálya sorszáma 1-től (próbához; élesben 1) */
		/* Terkepek: pályánként 30x18 = 540 érték egymás után (index: palya*540 + x-1 + (y-1)*30); 10 = Talaj1, 13 = Talaj3 (blokkolt) */
		Terkepek	:	array[10*540] of byte = (
