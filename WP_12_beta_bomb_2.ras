program WaterPumpGame;
@use "TVC"
@use "GE"
@use "random"
@use "WaterPump"

var
		/* Sprite-képek (bináris grafikai adatok) */
		Pumpa_Data						:	incbin("resources\tvc_sprites\Pumpa.bin");
		Talaj1_Data						:	incbin("resources\tvc_sprites\talaj1.bin");
		Talaj2_Data						:	incbin("resources\tvc_sprites\talaj2.bin");	/* 8x8, NEM maszkolt - a felhasználó saját rajza (talaj2.bmp) alapján konvertálva */
		Keret_Data						:	incbin("resources\tvc_sprites\keret.bin");
		Enemy_Data						:	incbin("resources\tvc_sprites\enemy.bin");
		Fal_Data						:	incbin("resources\tvc_sprites\fal.bin");
		Meteor_Data						:	incbin("resources\tvc_sprites\meteor.bin");
		Bomba_Data						:	incbin("resources\tvc_sprites\bomba.bin");	/* 20x16, MASZKOLT, 1 fázis - a felhasználó saját rajza (bomba1.bmp) alapján konvertálva */
		/* A sprite-objektumok: Pumpa (animált szivattyú), Talaj1 (üres talaj mező),
		   Keret (a játékos által mozgatott kurzor - "keretezi" az aktuális mezőt),
		   Enemy (zöld "paca" ellenség, 8x8, nem maszkolt, 5 növekvő animfázis),
		   Fal (8x8 tégla, nem maszkolt, NEM animált - mint a Talaj1),
		   Meteor (20x16 = a vírus 2.5x-e, MASZKOLT áttetsző, fekete+kék pöttyös
		   szikladarab - MASZKOLT -> Draw kell -> Init(...,True) KÖTELEZŐ, hogy
		   a háttérpuffere ne legyen 0 [lásd CLAUDE.md]).
		   FONTOS: KIZÁRÓLAG a Pumpa kirakása megy a WaterPump unit
		   WaterPump::PutAt() tábla-alapú rutinján (lásd lent) - ez volt a
		   felhasználó kifejezett kérése ("csak a pumpákra vonatkozóan").
		   Talaj1/Fal/Enemy TOVÁBBRA IS a Bery-féle GE::Sprite.Put()-tal
		   rajzolódik (Mezo_ByteX_Tab/Mezo_SorCim_Tab pozíciótáblákkal,
		   lásd lent) - ÚGY, MINT a WaterPump_Meteor_10.ras-ban. (2026-09-14:
		   egy korábbi kör ezeket is átállította WaterPump::PutAtRaw-ra,
		   de az torz/hiányos vírus- és pumpa-grafikát eredményezett -
		   visszaállítva a bevált GE útra, a gyökérok további vizsgálat
		   nélkül még nyitott - lásd CLAUDE.md.) Keret és Meteor MARAD
		   GE::Sprite.Draw-on (maszkoltak, azt a mi unitunk nem tudja). */
		Pumpa							:	GE::Sprite;
		Talaj1						 	:	GE::Sprite;
		Talaj2							:	GE::Sprite;	/* 2. talajtípus - nem maszkolt, bélyegzőként Put-olva, mint a Talaj1/Fal */
		Keret							:	GE::Sprite;
		Enemy							:	GE::Sprite;
		Fal								:	GE::Sprite;
		Meteor							:	GE::Sprite;
		/* Bomba: a B gombos Bomba_Ledob() zuhanás-animációjához (a képernyő
		   tetejéről a Keret soráig esik, lásd Bomba_Ledob) - MASZKOLT, ezért
		   Init(...,True) kell (Draw különben a $0000-ra írna, lásd CLAUDE.md). */
		Bomba							:	GE::Sprite;
		/* Meteor mozgás: MINDEN képkockán METEOR_LE_PX px LE.
		   Oldalra PIXELENKÉNT: MINDEN METEOR_OLDAL_UTEM. képkockán 1 px balra -
		   a szikla 4 animfázisa (0..3) van 0/1/2/3 px-lel balra tolva, tehát
		   az első 3 oldal-"lépés" csak fázist vált, a 4. után megy egy VALÓDI
		   Meteor.X -= 1 byte + vissza a 0. fázisra. Net: 1 px / oldal-lépés.
		   BELÉPŐ X: RANDOM (METEOR_X_MIN + rnd%METEOR_X_RND). ÚT-HOSSZ: RANDOM,
		   a meteor Y = Meteor_Y_Cel (=METEOR_Y_MIN + rnd%METEOR_Y_RND) -nél áll
		   meg és tűnik el (a becsapódási pont -> talaj-roncsolás). */
		const METEOR_LE_PX				:	byte = 3;	/* ennyi pixelt megy LEFELÉ képkockánként */
		const METEOR_OLDAL_UTEM			:	byte = 3;	/* HANGOLHATÓ: ennyi képkockánként 1 PIXEL balra (nagyobb = meredekebb). */
		const METEOR_START_Y			:	byte = 26;	/* belépő px-Y (fent) - fix */
		const METEOR_X_MIN				:	byte = 6;	/* belépő byte-X minimum (a pálya bal széle felé is essen!) */
		const METEOR_X_RND				:	byte = 52;	/* belépő X szórása -> X = 6..57 (szinte a teljes pályaszélesség) */
		const METEOR_Y_MIN				:	byte = 70;	/* leállási px-Y minimum */
		const METEOR_Y_RND				:	byte = 130;	/* út-hossz szórása -> leáll Y = 70..199 */
		const METEOR_X_CEL				:	byte = 2;	/* eddig lép balra: az 1. MAP oszlop byte-ja (gx=1 -> byte 2), onnan már csak zuhan */
		const METEOR_FAZ_DB				:	byte = 4;	/* meteor.bin animfázisai (0/1/2/3 px balra tolva) */
		const METEOR_FAZIS_MERET		:	byte = 160;	/* egy fázis mérete bájtban: MASZKOLT -> Width*Height*2 = 5*16*2 */

		CharSet 							: 	incbin("resources\tvc_sprites\CharSetGR4.bin");
		CashStr 							: 	string = ("CASH$:");
		PumpStr							:	string = ("PUMP:");
		PosStr							:	string = ("POZX:   POZY:");

		/* A Keret aktuális képernyő-pozíciója pixelben/byte-ban */
		Keret_X_ScreenPOS				: 	byte = 29;
		Keret_Y_ScreenPOS				:	byte = 128;
		/* A Keret aktuális rács (mező) pozíciója: X: 1-30, Y: 1-18 */
		Keret_X_Pos						:	byte = 15;
		Keret_Y_Pos						:	byte = 9;
		/* A Keret ELŐZŐ (legutóbb ténylegesen frissített) rács-pozíciója - ebből
		   tudja a Keret_Frissit, hogy mozgott-e a Keret (lásd ott). */
		Keret_Elozo_X_Pos				:	byte = 15;
		Keret_Elozo_Y_Pos				:	byte = 9;
		/* A Keret (kurzor) mozgásának lassítása: csak minden Keret_Mozog_Utem.
		   képkockán léphet egyet. Nagyobb érték = lassabb kurzor. */
		Keret_Mozog_Utem				:	byte = 2;
		Keret_Mozog_Frame				:	byte = 0;

		/* A játéktér 30x18 mezős rácsa. EGYETLEN állapot-tömb: a pumpa
		   animációs FÁZISA is a Map[]-ben van kódolva (Map[i]=PumpaMap+fázis,
		   1..8), a vírusé ugyanígy (Map[i]=VirusMap+fázis) - nincs külön
		   pumpa-pool/tömb, a WaterPump unit is ezt az indexelést használja
		   a ScreenAddrTab-jában. */
		const TERKEP_MERET				:	integer = 18*30;	/* a Map[] mérete (540) */
		Map								:	array	[TERKEP_MERET] of byte;

		MapPos							:	integer;	/* Keret alatti mező indexe a Map tömbben */
		Drill_Cash						:	integer = 9000;	/* összegyűjtött pénz (kijelzéshez, max 4 jegy) */
		Pumpa_price						:	integer = 50;	/* egy pumpa ára */
		Tegla_price						:	integer = 10;	/* egy fal-tégla ára (F gomb) */
		Bomba_price						:	integer = 1000;	/* egy bomba ára (B gomb) */
		Pumpa_termel					:	integer = 1;	/* egy pumpa hozama Termel_Utem képkockánként - integer, hogy a Pumpa_db*Pumpa_termel szorzat ne csorduljon túl */
		Pumpa_db						:	byte = 0;		/* eddig lerakott pumpák száma (csak számláló, a pumpa a Map[]-ben él) */
		Termel_Frame					:	integer = 0;	/* képkocka-SZÁMLÁLÓ a termeléshez (0-tól Termel_Utem-ig számol) */
		Termel_Utem						:	integer = 40;	/* HANGOLHATÓ: ennyi képkockánként termelnek a pumpák (kb. 50 kép = 1 mp) */

		/* -----------------------------------------------------------------
		   PUMPA-ANIMÁCIÓ: lépésközös (strided) Map[]-scan, EGYETLEN,
		   folyamatosan haladó mutatóval (PumpaScanPos) - lásd WaterPump.tru
		   fejlécét is. Képkockánként PUMPAK_CHUNK db Map-mezőt vizsgálunk,
		   PUMPA_STEP távolságra egymástól (nem egymás után!), hogy a gyors
		   egymásutánban, szomszédos Map-mezőkre lerakott pumpák NE
		   tűnjenek "összehangolt" animációnak (lásd a WaterPumpGame.ras
		   korábbi, megerősített/működő verzióját).
		   PUMPA_STEP-nek relatív prímnek kell lennie TERKEP_MERET-tel
		   (540 = 2^2*3^3*5), különben nem fedi le mind az 540 mezőt.
		   ----------------------------------------------------------------- */
		const PUMPA_STEP				:	integer = 7;	/* lépésköz - relatív prím kell legyen TERKEP_MERET-hez (540) */
		const PUMPAK_CHUNK				:	byte = 15;	/* ennyi mezőt vizsgálunk/frissítünk képkockánként - fő perf-hangoló */
		PumpaScanPos					:	integer = 0;	/* hol tartottunk a mintázásban - a következő képkocka innen folytatja */

		const PUMPA_FAZISOK				:	byte = 8;	/* a Pumpa sprite animációs fázisainak száma */
		const PUMPA_FAZIS_MERET			:	byte = 16;	/* egy fázis mérete bájtban (Pumpa.bin/enemy.bin: nem maszkolt 2x8 = 16) */
		const ENEMY_FAZ_DB				:	byte = 5;	/* enemy.bin fázisainak száma (0..4) */

		/* Körbeforgó induló-fázis számláló pumpa-lerakáskor (KIZÁRÓLAG
		   megjelenítési célra - lásd DrillLerak). */
		Pumpa_Uj_Faz					:	byte = 0;

		/* --- KÖZÖS POZÍCIÓ-TÁBLÁK a Talaj1/Fal/Enemy-hez (Bery/GE::Sprite
		   Put úton maradnak - lásd a var blokk elején lévő megjegyzést:
		   a WaterPump::PutAt() KIZÁRÓLAG a pumpánál marad, a felhasználó
		   kifejezett kérésére). A ProgramInit tölti fel EGYSZER: rács-
		   koordináta -> képernyő. --- */
		const MEZO_BX_DB				:	byte = 31;	/* Mezo_ByteX_Tab mérete (rács-X 0..30, a 0 nincs használva) */
		const MEZO_SY_DB				:	byte = 19;	/* Mezo_SorCim_Tab mérete (rács-Y 0..18, a 0 nincs használva) */
		Mezo_ByteX_Tab					:	array	[MEZO_BX_DB] of byte;	/* rács-X 1..30 -> képernyő byte-X (x*2) */
		Mezo_SorCim_Tab					:	array	[MEZO_SY_DB] of integer;	/* rács-Y 1..18 -> a képsor kezdő címe (ScreenAddr + (30+y*10)*64) */

		/* Vírus-fázis -> kész bitmap-pointer tábla (a Pumpa mintájára, de az
		   Enemy sprite-hoz). */
		Enemy_FazPtr_Tab				:	array	[ENEMY_FAZ_DB] of integer;	/* vírus-fázis 0..4 -> kész bitmap-pointer (Enemy.AnimSet + faz*16) */
		Meteor_FazPtr_Tab				:	array	[METEOR_FAZ_DB] of integer;	/* meteor-fázis 0..3 -> kész bitmap-pointer (AnimSet + faz*160, MASZKOLT - marad GE-s) */

		/* ================================================================
		   ENEMY / VÍRUS - a C64-es aqualiquex (units.tru / raster.tru)
		   viselkedésének 1:1 lemodellezése. A raszter-időzítés NEM számít:
		   a C64 raszter-IRQ-ja = nálunk egy fociklus-iteráció (GE::WaitForSync).

		   A vírus TELJES állapota MAGÁBAN A Map-ben van (mint a C64-nél a
		   képernyő-karakterekben) - NINCS külön pool/tömb!
		     Map[mp] = VirusMap + faz, ahol
		     - faz 0 .. ENEMY_MAX_FAZIS-1 : NÖVEKVŐ kolónia   (C64: 192..201)
		     - faz = ENEMY_MAX_FAZIS       : KIFEJLETT vírus   (C64: 202..208),
		       ez már NEM nő tovább, viszont EBBŐL terjed (ha be van kapcsolva
		       a terjedés). NINCS wrap 4->0 (a C64 sem csinál ilyet).
		   ================================================================ */
		const ENEMY_MAX_FAZIS			:	byte = 4;	/* enemy.bin utolsó (kifejlett) fázisa; C64: virusAnimFramesStart */
		/* C64 raster.tru: "for i:=0 to 15" -> képkockánként 16 véletlen minta.
		   NÁLUNK viszont egy Enemy_Kirak (SW sprite Put) SOKKAL drágább, mint
		   a C64 putChar (1 byte poke), és képkockánként kevés a raszter-idő a
		   sprite-ok kirakására. Ezért 16 helyett CSAK ENNYI mintát (=> ennyi
		   virus-Put-ot) végzünk hívásonként. Ez a fő RASZTER-BUDGET szabályzó:
		   ha akadozik/szakad a kép, csökkentsd; ha van tartalék raszter-idő és
		   lassúnak tűnik a vírus, óvatosan növeld (vagy Enemy_Utem-et 1-en). */
		const ENEMY_PROBA_DB			:	byte = 6;
		/* C64 units.tru: maxColonies=10 - ennyi VETETT (nem terjedéssel
		   keletkezett) kolónia után új kolónia már nem jön, csak terjedés. */
		const ENEMY_MAX_KOLONIA			:	byte = 10;

		Rnd_Porgeto						:	byte = 0;		/* főciklusonként ide megy egy RandomByte() - entrópia */
		Start_Wait						:	byte = 1;		/* 1 = a kezdőképernyőn állunk, várunk a SPACE-re */

		/* --- Kolónia-vetés ütemezése (C64: raster.tru newSecond, ~50 frame) --- */
		Enemy_Sec_Frame					:	integer = 0;	/* frame-számláló a "másodperchez" */
		Enemy_Kolonia_db				:	byte = 0;		/* eddig VETETT kolóniák száma (C64: noOfColonies) */
		Enemy_Terjedhet					:	byte = 0;		/* C64: doVirusSpread. 1 = a kifejlett vírus terjedhet a szomszédba */
		Enemy_Coin						:	byte = 0;		/* a "másodperces" 50%-os érme-dobás (Rnd_Porgeto mod 2) */

		/* --- A vírus MŰKÖDÉSE (Enemyk_Mukodnek) --- lásd az ENEMY_Szekcio-t --- */
		/* HANGOLHATÓ: ennyi frame-enként fut Enemyk_Mukodnek. 1 = minden
		   képkockán (sima, nem bursztös, mert ENEMY_PROBA_DB kicsi). Ha még
		   így is sok a virus-Put, emeld 2-3-ra (ritkább, de bursztösebb). */
		Enemy_Utem						:	byte = 1;
		Enemy_Frame						:	byte = 0;	/* frame-számláló hozzá */

		/* --- METEOR (nem blokkoló, a főciklusból random időnként) --- */
		Meteor_Aktiv					:	byte = 0;	/* 1 = éppen zuhan */
		Meteor_Faz						:	byte = 0;	/* meteor aktuális animfázisa 0..3 (0/1/2/3 px balra tolt szikla) */
		Meteor_UtemFrame				:	byte = 0;	/* oldallépés-ütemező (METEOR_OLDAL_UTEM-ig számol) */
		Meteor_Y_Cel					:	byte = 110;	/* ennél az Y-nál áll meg és tűnik el a meteor (Meteor_Indit random állítja) */
		Meteor_TriggerFrame				:	integer = 60;	/* visszaszámláló a következő zuhanásig */



/*		MAP értékadások jelentései
		Pumpa (a fázis is IDE van kódolva, lásd fent):	PumpaMap..PumpaMap+PUMPA_FAZISOK-1 (1-8)
		Talaj típusok:			10-19
		Vírusos talaj:			20-29								*/

		PumpaMap						:	byte=1;
		Talaj1Map						:	byte=10;		/* Talaj1 sprite értéke */
		FalMap							:	byte=11;		/* fal mező (talaj-tartomány 10-19); a vírus NEM megy át rajta */
		Talaj2Map						:	byte=12;		/* Talaj2 = a Bomba_Ledob() becsapódásakor keletkező "kráter" - nincs rá pumpa-lerakás (a DrillLerak/
														   TeglaLerak csak Talaj1Map-ra enged) - és a TELJES rombusz-zóna
														   Talaj2Map-pá válik, amikor a bomba becsapódik (lásd Bomba_Ledob).
														   A Meteor_Becsapodas() sem rongálja (lásd ott). */
		VirusMap						:	byte=20;		/* vírusos mező alapértéke (Map[]=20+faz) */

/* ============================================================
   Játék indításakor egyszer lefutó beállítások: grafikus mód,
   paletta, karakterkészlet, Game Engine indítása, sprite-ok
   inicializálása, a WaterPump unit tábláinak felépítése.
   ============================================================ */
Procedure ProgramInit();
	var f, xx, yy						:	byte;	/* tábla-feltöltés ciklusváltozói */
		p, a							:	integer;
	begin
		GE::SetGraphics(GE::GRAPHICS4);
		GE::SetPalette(0,GE::PALETTE_Gray);
		GE::SetPalette(1,GE::PALETTE_Black);
		GE::SetPalette(2,GE::PALETTE_Green);
		GE::SetPalette(3,GE::PALETTE_Blue);
		GE::SetBorder(GE::BORDER_Gray);		/* border szürke = a szürke pályához simul -> plasztikusabb kép */
		GE::InitCharSet(#CharSet, 118, 2, 7);
		GE::Init(GE::DIRECT_TO_SCREEN);
		GE::SetMemory(GE::MEM_VID_ON);
      	GE::SetRasterInterruptPos(239);

		/* Pumpa: EGY megosztott "bélyegző", nincs háttérpuffere (False) -
		   a tényleges kirakás a WaterPump unit WaterPump::PutAt() tábla-
		   alapú rutinján megy (lásd PumpakKirak/DrillLerak), ez az
		   objektum csak az AnimSet-számításhoz kell (BuildPumpaFazTab).
		   Talaj1/Fal/Enemy VISZONT továbbra is a saját .Put()-jukkal
		   rajzolódnak (lásd Enemy_Kirak/Fal_Kirak/Talaj1_Kirak lent) -
		   a felhasználó kérése szerint a WaterPump unit KIZÁRÓLAG a
		   pumpánál marad. */
		Pumpa.Init(#Pumpa_Data,0,0,False);
		Pumpa.AnimSet:=	#Pumpa_Data+3;		/* +3: átugorja a típus+szélesség+magasság header byte-jait */
		Talaj1.Init(#Talaj1_Data,0,0,False);
		Talaj2.Init(#Talaj2_Data,0,0,False);
		Fal.Init(#Fal_Data,0,0,False);		/* mint a Talaj1: 1 fázis, bélyegzőként Put */
		Enemy.Init(#Enemy_Data,0,0,False);	/* mint a Talaj1: bélyegzőként Put-oljuk egy mezőre */
		Enemy.AnimSet:=	#Enemy_Data+3;		/* 5 növekvő fázis; +3: header átugrása */
		/* Meteor: MASZKOLT (áttetsző) -> Draw-val rajzoljuk -> KELL a
		   háttérpuffer (True), különben a Draw a $0000-ra írna - ez MARAD
		   a Bery-féle GE úton, a mi unitunk nem tud maszkolt sprite-ot. */
		Meteor.Init(#Meteor_Data,30,95,True);
		Meteor.AnimSet:=	#Meteor_Data+3;		/* 4 fázis; +3: header átugrása */
		/* Bomba: MASZKOLT, 1 fázis (nincs AnimSet-re szükség) - a kezdő
		   X/Y itt lényegtelen, a Start_Kepernyo() explicit beállítja. */
		Bomba.Init(#Bomba_Data,0,0,True);

		/* --- POZÍCIÓ-TÁBLÁK Talaj1/Fal/Enemy-hez (a fő .ras oldalán,
		   Bery/GE::Sprite Put úton maradnak) - rács-koordináta ->
		   képernyő, EGYSZER feltöltve. Utána a rajzolás (Enemy_Kirak,
		   Fal_Kirak, Talaj1_Kirak) nulla szorzást/osztást végez. --- */
		/* rács-X (1..30) -> képernyő byte-X = x*2 */
		xx:=1;
		while (xx<=30) do
			begin;
				Mezo_ByteX_Tab[xx]:=xx*2;
				xx:=xx+1;
			end;
		/* rács-Y (1..18) -> a képsor kezdő címe: a Pumpa SetPosition-jével,
		   X=0-nál (ez ScreenAddr + (30+y*10)*64-et számol). */
		yy:=1;
		while (yy<=18) do
			begin;
				Pumpa.X:=0;
				Pumpa.Y:=30+yy*10;
				Pumpa.SetPosition;
				p:=Pumpa.Position;
				Mezo_SorCim_Tab[yy]:=p;
				yy:=yy+1;
			end;

		/* --- A WaterPump unit saját tábláinak felépítése (EGYSZER) ---
		   BuildScreenAddrTab: MINDEN Map-index (0..539) -> kész
		   képernyőcím (a WaterPump::PutAt() ezt használja - KIZÁRÓLAG a
		   pumpához). BuildPumpaFazTab: a pumpa fázis (0..7) -> kész
		   Data-pointer tábla, szintén a unitban (PumpaFazPtr_Tab), a
		   PutAt() belülről használja. */
		WaterPump::BuildScreenAddrTab();
		a:=Pumpa.AnimSet;
		WaterPump::BuildPumpaFazTab(a);

		/* Vírus fázis-pointerek: Enemy.AnimSet + faz*16 (faz 0..4; enemy.bin
		   is 8x8 nem maszkolt, tehát egy fázis szintén 16 bájt). */
		a:=Enemy.AnimSet;
		f:=0;
		while (f<ENEMY_FAZ_DB) do
			begin;
				p:=f;
				p:=p*PUMPA_FAZIS_MERET;
				p:=p+a;
				Enemy_FazPtr_Tab[f]:=p;
				f:=f+1;
			end;
		/* meteor fázis-pointerek: AnimSet + faz*160 (MASZKOLT -> W*H*2 / fázis) */
		a:=Meteor.AnimSet;
		f:=0;
		while (f<METEOR_FAZ_DB) do
			begin;
				p:=f;
				p:=p*METEOR_FAZIS_MERET;
				p:=p+a;
				Meteor_FazPtr_Tab[f]:=p;
				f:=f+1;
			end;

		Keret_X_ScreenPOS:=(Keret_X_Pos*2)-1;
		Keret_Y_ScreenPOS:=28+(Keret_Y_Pos*10);
		/* A Keret VAN háttérpufferrel (True), mert maszkolt (átlátszó) sprite:
		   mozgás előtt vissza kell tudni állítani az alatta lévő valós képet.
		   Ez MARAD a Bery-féle GE úton (a mi unitunk nem tud maszkolt sprite-ot). */
		Keret.Init(#Keret_Data,Keret_X_ScreenPOS,Keret_Y_ScreenPOS,True);
		Keret.SaveBackground();

		/* A pumpának/vírusnak nincs poolja (a Map hordozza az állapotot),
		   így itt nincs mit üríteni. A Random unitot sem seedeljük (a
		   SetRSeed 0-ra ragadhat); a szórást a fociklusban pörgetett
		   RandomByte() adja. */

	end;



/* Feltölti a teljes Map tömböt üres talajjal (induláskor mindenhol Talaj1 van). */
Procedure MapReset();
	var	mapx,mapy							:	byte;
		data							:	integer;
	begin;
	data:=0;
		fori mapy:=1 to 18 do
			fori mapx:=1 to 30 do
			begin;
			Map[data]:=Talaj1Map;				/* Talaj1 sprite értéke */
			data:=data+1;
			end;
	end;

/* Egy byte kiírása a HUD-ra MINDIG 2 karakteren, vezető nullával
   (pl. 9 -> "09"). Így a rövidebb szám felülírja a korábbi hosszabb érték
   helyiértékeit, nem kell külön törölni (a törlés villogott mozgás közben).
   x = a bal karakterhely byte-pozíciója; egy karakter 2 byte széles. */
Procedure HUD_Num2(ertek: byte; x: byte);
	begin
		if ertek < 10 then
			begin
				GE::WriteText(x, 4, "0");
				GE::ByteToStr(ertek);
				GE::WriteText(x + 2, 4, #GE_NumStr);
			end
		else
			begin
				GE::ByteToStr(ertek);
				GE::WriteText(x, 4, #GE_NumStr);
			end;
	end;

/* Egy integer kiírása a HUD-ra MINDIG 4 karakteren, vezető nullákkal
   (pl. 5 -> "0005", 100 -> "0100"). A számjegyeket kézzel bontjuk ki
   (ezres/százas/tízes/egyes), és mindet külön kiírjuk - így pontosan 4
   karakter íródik x, x+2, x+4, x+6 pozícióra, a vezető nullák magukat
   rajzolják, nem kell külön törölni. x = a bal karakterhely byte-pozíciója.
   Értéktartomány: 0-9999. */
Procedure HUD_Num4(ertek: integer; x: byte);
	var maradek, d : integer;
	begin
		maradek := ertek;
		d := maradek / 1000;
		GE::IntToStr(d);
		GE::WriteText(x, 4, #GE_NumStr);
		maradek := maradek - d * 1000;
		d := maradek / 100;
		GE::IntToStr(d);
		GE::WriteText(x + 2, 4, #GE_NumStr);
		maradek := maradek - d * 100;
		d := maradek / 10;
		GE::IntToStr(d);
		GE::WriteText(x + 4, 4, #GE_NumStr);
		d := maradek - d * 10;
		GE::IntToStr(d);
		GE::WriteText(x + 6, 4, #GE_NumStr);
	end;

/* Mint a HUD_Num4, de 3 jegyen, vezető nullákkal (000-999). byte bemenet
   (a pumpaszám max 540, byte-nak kevés lenne, de a HUD csak 3 jegyet mutat -
   Pumpa_db byte marad, mert a gyakorlatban messze a 255 alatt lesz). x, x+2, x+4 pozíció. */
Procedure HUD_Num3(ertek: byte; x: byte);
	var maradek, d : byte;
	begin
		maradek := ertek;
		d := maradek / 100;
		GE::ByteToStr(d);
		GE::WriteText(x, 4, #GE_NumStr);
		maradek := maradek - d * 100;
		d := maradek / 10;
		GE::ByteToStr(d);
		GE::WriteText(x + 2, 4, #GE_NumStr);
		d := maradek - d * 10;
		GE::ByteToStr(d);
		GE::WriteText(x + 4, 4, #GE_NumStr);
	end;

/* A teljes térkép egyszeri kirajzolása induláskor (minden mező végigjárása,
   Talaj1 kirakása a szokásos Bery/GE::Sprite Put-tal), valamint a felső HUD
   sáv (CASH, PUMP feliratok és értékek) kiírása. */
Procedure MapToScreen();
	var	mapx,mapy							:	byte;
		data							:	integer;

	begin;
	data:=0;
		fori mapy:=1 to 18 do
			fori mapx:=1 to 30 do
			begin;
			if Map[data]=Talaj1Map then
				begin;
					Talaj1.X:=mapx*2;
					Talaj1.Y:=30+mapy*10;
					Talaj1.SetPosition;
					Talaj1.Put;
				end;
			data:=data+1;
			end;
	/* HUD háttérsáv és feliratok kirajzolása a képernyő tetején */
	GE::FillRect(1, 12, 62, 2, 255);
	GE::WriteText(4, 4, #CashStr);
	HUD_Num4(Drill_Cash, 16);

	GE::WriteText(28, 4, #PumpStr);			/* "PUMP:" a CASH mellett, egy sorban */
	HUD_Num3(Pumpa_db, 38);					/* 3 jegyű pumpaszám */

	// GE::WriteText(32, 4, #PosStr);		// X/Y POZÍCIÓ-KIJELZŐ IDEIGLENESEN KI
	// HUD_Num2(Keret_X_Pos, 42);
	// HUD_Num2(Keret_Y_Pos, 58);

	end;

/* Egy enemy ("zöld paca" ellenség) kirajzolása a megadott rács-mezőre
   (x: 1-30, y: 1-18), a megadott animációs fázisban (faz: 0..4, növekvő
   méret - 0=2x2 pötty, 4=teli paca). A fázist a Pumpa mintájára, kézi
   Data-pointerrel választjuk (Enemy_FazPtr_Tab). Bélyegzőként Put-oljuk
   (Bery/GE::Sprite, a szokásos Mezo_ByteX_Tab/Mezo_SorCim_Tab pozícióval),
   nincs háttérpuffer. */
Procedure Enemy_Kirak(x, y, faz : byte);
	var p : integer;
	begin;
		p:=Mezo_SorCim_Tab[y];
		p:=p+Mezo_ByteX_Tab[x];			/* kész képernyőcím, nulla szorzás/SetPosition */
		Enemy.Position:=p;
		Enemy.Data:=Enemy_FazPtr_Tab[faz];	/* kész fázis-pointer táblából */
		Enemy.Put;
	end;

/* Egy fal-tégla kirajzolása a megadott rács-mezőre (x: 1-30, y: 1-18).
   NEM animált (1 fázis), a Talaj1 mintájára bélyegzőként Put-oljuk. */
Procedure Fal_Kirak(x, y : byte);
	var p : integer;
	begin;
		p:=Mezo_SorCim_Tab[y];
		p:=p+Mezo_ByteX_Tab[x];
		Fal.Position:=p;			/* Fal nem animált -> a Data-t az Init beállította, csak Position + Put kell */
		Fal.Put;
	end;

/* Üres talaj (Talaj1) kirajzolása egy rács-mezőre - a Fal_Kirak mintájára.
   A meteor-becsapódás használja a roncsolt mezők "letakarítására". */
Procedure Talaj1_Kirak(x, y : byte);
	var p : integer;
	begin;
		p:=Mezo_SorCim_Tab[y];
		p:=p+Mezo_ByteX_Tab[x];
		Talaj1.Position:=p;
		Talaj1.Put;
	end;

/* 2. talajtípus kirajzolása egy rács-mezőre - a Talaj1_Kirak mintájára.
   NEM animált, bélyegzőként Put-olva. A Bomba_Ledob() hívja a rombusz
   ("kráter") minden mezőjére becsapódáskor. */
Procedure Talaj2_Kirak(x, y : byte);
	var p : integer;
	begin;
		p:=Mezo_SorCim_Tab[y];
		p:=p+Mezo_ByteX_Tab[x];
		Talaj2.Position:=p;
		Talaj2.Put;
	end;

/* A Keret 3x3 rács-környezetében lévő vírusos mezők újrarajzolása a SAJÁT
   fázisukban. Azért kell, mert a Keret (kurzor) mozgásakor a
   Keret.RestoreBackground() a Keret alá/mellé eső mezőkre egy ELAVULT
   képkockát ken vissza - a vírus a Map-ben tovább nőtt, de a képernyőn a
   régi fázis ragad be. A Keret_Frissit() a restore UTÁN, a Keret
   újrarajzolása ELŐTT hívja (csak ha mozgott).
   Nincs pool: közvetlenül a Map 9 celláját nézzük a Keret körül (O(9),
   akárhány vírusmező van a pályán). A fázis = Map[mi]-VirusMap.
   Deklaráció-sorrend miatt itt kell állnia, a Keret_Frissit ELŐTT. */
Procedure Enemyk_Ujrarajzol();
	var dx, dy, cx, cy, f : byte;
		mi : integer;
	begin;
		dy:=0;
		while (dy<3) do
			begin;
				dx:=0;
				while (dx<3) do
					begin;
						cx:=Keret_X_Pos-1+dx;		/* Keret_X_Pos-1 .. +1 */
						cy:=Keret_Y_Pos-1+dy;
						if ((cx>=1) and (cx<=30)) then
						if ((cy>=1) and (cy<=18)) then
							begin;
								mi:=cx-1+(cy-1)*30;
								if (Map[mi] >= VirusMap) then
									begin;
										f:=Map[mi]-VirusMap;
										Enemy_Kirak(cx, cy, f);
									end;
							end;
						dx:=dx+1;
					end;
				dy:=dy+1;
			end;
	end;

/* Csak a Keret X/Y koordinátáit írja ki a HUD-ra (a szöveges kijelzőt frissíti,
   a sprite-okat nem érinti). */
Procedure Keret_OSD();
	begin
		// IDEIGLENESEN KIKAPCSOLVA - nem kell az X/Y pozíció kiírás:
		// HUD_Num2(Keret_X_Pos, 42);
		// HUD_Num2(Keret_Y_Pos, 58);
	end;

/* A pénz (Drill_Cash) kiírása a HUD-ra, 4 jegyen, vezető nullákkal. */
Procedure Cash_OSD();
	begin
		HUD_Num4(Drill_Cash, 16);
	end;

/* A lerakott pumpák száma (Pumpa_db) a HUD-ra, 3 jegyen. */
Procedure Pump_OSD();
	begin
		HUD_Num3(Pumpa_db, 38);
	end;

/* A rács-koordinátákból (Keret_X_Pos/Keret_Y_Pos) kiszámolja a Keret sprite
   képernyő-pozícióját (Keret.X / Keret.Y). Ezt még nem érvényesíti a sprite-on -
   ahhoz a Keret.SetPosition() hívás is kell (lásd Keret_SpriteKirak). */
Procedure Keret_XY_Calc();
	begin;
		Keret_X_ScreenPOS:=(Keret_X_Pos*2)-1;
		Keret_Y_ScreenPOS:=28+(Keret_Y_Pos*10);
		Keret.X:=Keret_X_ScreenPOS;
		Keret.Y:=Keret_Y_ScreenPOS;
	end;

/* A Keret sprite tényleges kirajzolása az aktuális (Keret.X/Y-ban beállított)
   pozícióra. A Keret MASZKOLT, ezért ez marad a Bery-féle GE::Sprite Draw
   úton (a mi unitunk csak nem-maszkolt, fix-méretű blitre való). Sorrend:
   pozíció érvényesítése -> a Keret alatti terület elmentése háttérként ->
   a keret grafika kirajzolása -> "utolsó pozíció" frissítése. */
Procedure Keret_SpriteKirak();
	begin;
		Keret.SetPosition();
		Keret.SaveBackground();
		Keret.Draw;
		Keret.UpdateLastPos;
	end;

/* Egy pumpa kivétele - a vírus vagy a meteor "megette". Mivel a pumpa
   TELJES állapota a Map[]-ben van (nincs külön pool), itt nincs mit
   keresgélni: csak a számlálót csökkentjük és frissítjük a HUD-ot - a
   Map[]-be írást (Talaj1Map vagy VirusMap) a HÍVÓ végzi el közvetlenül
   utána (lásd Enemy_Terjed_Ide / Meteor_Becsapodas). */
Procedure Pumpa_Torol(x, y : byte);
	var mp								:	integer;
	begin;
		mp:=x-1+(y-1)*30;
		if ((Map[mp]>=PumpaMap) and (Map[mp]<PumpaMap+PUMPA_FAZISOK)) then
			begin;
				if (Pumpa_db>0) then Pumpa_db:=Pumpa_db-1;
				Pump_OSD();				/* pumpaszám-kijelző frissítése */
			end;
	end;

/* SZÁMOLÁSI fázis (vsync ELŐTT): lépésközös (strided) mintavételezés a
   teljes Map[]-en - PUMPAK_CHUNK db mezőt néz meg, egymástól PUMPA_STEP
   távolságra (idx, idx+STEP, idx+2*STEP, ...), PumpaScanPos-tól indulva.
   Ahol pumpa van, ott lépteti a fázist (közvetlenül a Map[]-ben) -
   máskülönben nem csinál semmit, DE a vizsgálandó helyek száma MINDKÉT
   esetben fogy. Nem rajzol. A PumpaScanPos-t a PumpakKirak() lépteti
   tovább (az UTOLSÓ vizsgált hely UTÁNI pozícióra, lásd ott), hogy a
   Szamol és a Kirak ugyanazt a mintát dolgozza fel egy adott képkockán
   belül. */
Procedure PumpakSzamol();
	var idx							:	integer;
		i							:	byte;
		faz							:	byte;
	begin;
		idx:=PumpaScanPos;
		i:=0;
		while (i<PUMPAK_CHUNK) do
			begin;
				if ((Map[idx]>=PumpaMap) and (Map[idx]<PumpaMap+PUMPA_FAZISOK)) then
					begin;
						faz:=Map[idx]-PumpaMap;
						faz:=faz+1;
						if (faz>=PUMPA_FAZISOK) then faz:=0;
						Map[idx]:=PumpaMap+faz;
					end;
				idx:=idx+PUMPA_STEP;
				if (idx>=TERKEP_MERET) then idx:=idx-TERKEP_MERET;
				i:=i+1;
			end;
	end;

/* KIRAKÁSI fázis (vsync UTÁN, a rajzolási fázisban hívandó): ugyanazt a
   lépésközös mintát rajzolja ki, amit a PumpakSzamol() az imént léptetett
   (WaterPump::PutAt()-tal, csak a FÁZIS értékét adva át - a unit maga
   keresi ki a kész Data-pointert a saját PumpaFazPtr_Tab-jából, és a kész
   képernyőcímet a saját ScreenAddrTab-jából). A 10./15. vizsgálat UTÁN a
   mutató (idx) OTT áll, ahol abbahagytuk - EZT (nem egy külön +1-et)
   mentjük PumpaScanPos-ba. */
Procedure PumpakKirak();
	var idx							:	integer;
		i							:	byte;
		faz							:	byte;
	begin;
		idx:=PumpaScanPos;
		i:=0;
		while (i<PUMPAK_CHUNK) do
			begin;
				if ((Map[idx]>=PumpaMap) and (Map[idx]<PumpaMap+PUMPA_FAZISOK)) then
					begin;
						faz:=Map[idx]-PumpaMap;
						WaterPump::PutAt(idx,faz);
					end;
				idx:=idx+PUMPA_STEP;
				if (idx>=TERKEP_MERET) then idx:=idx-TERKEP_MERET;
				i:=i+1;
			end;

		PumpaScanPos:=idx;	/* idx itt már garantáltan <TERKEP_MERET (a ciklusbeli wrap miatt) */
	end;

/* Mindent egy eljárásban végez el a Keret körül, a helyes sorrendben:
     1) eldönti, kell-e frissíteni (mozgott VAGY pumpa van alatta - az
        animálódhat), és ha igen, MÁR ITT elvégzi a RestoreBackground-ot;
     2) lefuttatja a PumpakKirak()-ot (a pumpák animációjának forgó
        kirajzolása, a PumpakSzamol() már a vsync ELŐTT lelépegette a
        fázisokat) - ez azért van KÖZBEN, mert ha a Keret alatti pumpa
        pont ekkor lép fázist, a friss képkockának a RestoreBackground UTÁN,
        de a SaveBackground ELŐTT kell megjelennie a képernyőn, különben a
        Keret alatti pumpa animációja "befagyna" (a Keret mindig egy régi,
        elmentett fázist állítana vissza rá);
     3) ha kellett a frissítés, elmenti a (már friss pumpa-animációt is
        tartalmazó) hátteret és ráteszi a Keret kerekét;
     4) a HUD-ot mindig frissíti, függetlenül attól, hogy a sprite
        frissült-e.
   (Korábban ez két külön eljárásra volt bontva egy globális boolean
   jelzővel közöttük - az ELÉG VOLT, hogy a TRSE fordító összeomoljon
   [exit code 3221225477 / access violation]. Ez az egy-eljárásos, csak
   lokális boolean-okat használó forma bizonyítottan fordul.) */
Procedure Keret_Frissit();
	var mozgott						:	boolean;
		pumpavan						:	boolean;
	begin;
		MapPos:=Keret_X_Pos-1+(Keret_Y_Pos-1)*30;
		mozgott:=((Keret_X_Pos<>Keret_Elozo_X_Pos) or (Keret_Y_Pos<>Keret_Elozo_Y_Pos));
		pumpavan:=((Map[MapPos]>=PumpaMap) and (Map[MapPos]<PumpaMap+PUMPA_FAZISOK));
		if (mozgott or pumpavan) then Keret.RestoreBackground();

		PumpakKirak();

		if (mozgott or pumpavan) then
			begin;
				/* A RestoreBackground által elkent vírus-mezők helyreállítása a
				   valós fázisukra - CSAK ha a Keret MOZGOTT. Álló Keretnél
				   (pumpán ülve) a 16x12-es folt nem vándorol, tehát nincs mit
				   helyreállítani; viszont ez a sweep MINDEN aktív kolóniát
				   Put-ol, és a folyamatosan terjedő vírusnál ez képkockánként
				   sok Put -> pumpán állva "minden animáció nagyon lelassul".
				   Ezért itt a mozgás a feltétel, nem a (mozgott or pumpavan). */
				if (mozgott) then Enemyk_Ujrarajzol();
				Keret_XY_Calc();
				Keret_SpriteKirak();
				Keret_Elozo_X_Pos:=Keret_X_Pos;
				Keret_Elozo_Y_Pos:=Keret_Y_Pos;
			end;
		Keret_OSD();
	end;

/* A Keret_MoveXXX eljárások CSAK a rács-koordinátát (Keret_X_Pos/Y_Pos)
   módosítják - a tényleges háttér-visszaállítást és újrarajzolást a
   főciklus végi Keret_Frissit() végzi el (ami észleli a mozgást és emiatt
   restore-ol+újrarajzol), egyszer képkockánként. Ez azért fontos, mert ha
   itt is rajzolnánk, a Keret duplán rajzolódna ki minden mozgásnál. */
Procedure Keret_MoveLeft();
	begin
		Keret_X_Pos:=Keret_X_Pos-1;
	end;

Procedure Keret_MoveRight();
	begin
		Keret_X_Pos:=Keret_X_Pos+1;
	end;

Procedure Keret_MoveUp();
	begin
		Keret_Y_Pos:=Keret_Y_Pos-1;
	end;

Procedure Keret_MoveDown();
	begin
		Keret_Y_Pos:=Keret_Y_Pos+1;
	end;

/* Pumpa lerakása a Keret alatti mezőre (Space lenyomásakor hívódik).
   Saját, önálló restore->lerakás->mentés+rajzolás sorrendet használ, hogy a
   pumpa AZONNAL látszódjon (lásd a WaterPumpGame.ras korábbi, megerősített
   verziójának megjegyzését a sorrend fontosságáról).
   Nincs pool-kapacitás-ellenőrzés többé: a Map[] természetes módon korlátoz
   (nem lehet több pumpa, mint ahány szabad mező van a pályán). */
Procedure DrillLerak();
	begin
		MapPos:=Keret_X_Pos-1+(Keret_Y_Pos-1)*30;
		if ((Map[MapPos]=Talaj1Map) and (Drill_Cash>=Pumpa_price)) then
			begin;
				Keret.RestoreBackground();		/* a keret alatti valós talajt tesszük láthatóvá lerakás előtt */
				Map[MapPos]:=PumpaMap+Pumpa_Uj_Faz;
				WaterPump::PutAt(MapPos,Pumpa_Uj_Faz);
				Pumpa_Uj_Faz:=Pumpa_Uj_Faz+1;
				if (Pumpa_Uj_Faz>=PUMPA_FAZISOK) then Pumpa_Uj_Faz:=0;
				Drill_Cash:=Drill_Cash-Pumpa_price;	/* a pumpa ára levonva a pénzből */
				Pumpa_db:=Pumpa_db+1;					/* termeléshez: hány pumpa van összesen */
				Cash_OSD();							/* pénz-kijelző frissítése */
				Pump_OSD();							/* pumpaszám-kijelző frissítése */
				Keret_SpriteKirak();			/* elmenti a friss (pumpát tartalmazó) hátteret, majd ráteszi a keretet */
				Keret_OSD();
			end;
	end;

/* Fal-tégla lerakása a Keret alatti mezőre (F gomb). A DrillLerak mintájára
   önálló restore->lerakás->mentés+rajzolás. Csak SZABAD TALAJRA (Talaj1Map -
   ez kizárja a pumpát, vírust és a már lerakott falat is), és csak ha van rá
   Tegla_price fedezet. A falra ezután pumpa sem rakható (DrillLerak ugyanígy
   Talaj1Map-ot vár), és a vírus sem terjed rá (Enemy_Terjed_Ide). */
Procedure TeglaLerak();
	begin
		MapPos:=Keret_X_Pos-1+(Keret_Y_Pos-1)*30;
		if ((Map[MapPos]=Talaj1Map) and (Drill_Cash>=Tegla_price)) then
			begin;
				Keret.RestoreBackground();
				Map[MapPos]:=FalMap;
				Fal_Kirak(Keret_X_Pos, Keret_Y_Pos);
				Drill_Cash:=Drill_Cash-Tegla_price;
				Cash_OSD();
				Keret_SpriteKirak();
				Keret_OSD();
			end;
	end;

/* BOMBA (B gomb, ha van rá Bomba_price fedezet). KÉT FÁZISBAN fut:

   1) BLOKKOLÓ zuhanás-animáció: a Bomba sprite a képernyő TETEJÉRŐL
      (Y=0) indul, X-e a Keret OSZLOPÁNAK közepéhez igazítva RÖGZÍTETT
      (zuhanás közben nem változik - csak függőlegesen esik, a felhasználó
      kérése szerint "semmi extra"), és képkockánként 4 pixelt esik lefelé
      (`Bomba.MoveDownBy4()` - a Bery/GE beépített, gyors pozíció-mozgató
      eljárása, a Meteor esési mintáját véve alapul), amíg az orra (a
      sprite ALJA, Y+16) el nem éri a Keret SORÁNAK közepét. Ez a ciklus a
      JÁTÉK FŐCIKLUSÁTÓL FÜGGETLENÜL, ÖNMAGA hívja a GE::WaitForSync()-et
      minden lépésnél (mint a Start_Kepernyo() saját várakozó ciklusa) -
      amíg tart, semmi más (pumpa-animáció, vírus, termelés) nem fut,
      nincs szükség képkocka-számlálásra/ütemezésre - a Meteorral
      ELLENTÉTBEN, ami a főciklusba ágyazva, KÉPKOCKÁNKÉNT egy lépést tesz
      (nem blokkol), itt viszont egy önálló, blokkoló ciklus fut végig a
      teljes eséstől a becsapódásig.
      **KRITIKUS, KONFIRMÁLT hiba+javítás (2026-09-14): a `GE.tru` forrása
      szerint `RestoreBackground()` NEM a `Sprite.Position`-t használja
      célként, hanem a KÜLÖN `Sprite.LastPosition` mezőt - ezt viszont
      KIZÁRÓLAG a `Sprite.UpdateLastPos()` (vagy az `Init`) állítja be,
      a `Draw()`/`SaveBackground()`/`MoveDownBy4()` egyike SEM. Az első
      verzió nem hívta az `UpdateLastPos()`-t minden `Draw()` után, ezért
      a `RestoreBackground()` MINDIG a kezdeti (Init-ből maradt) helyre
      próbált visszaállítani a tényleges legutóbbi rajzolt hely helyett -
      ez adta a "csíkot húz" (a bomba minden korábbi pozíciója a
      képernyőn maradt) hibát. Javítás: minden `Draw()` UTÁN azonnal
      `Bomba.UpdateLastPos();` (pontosan úgy, ahogy a Keret/Meteor is
      teszi a saját rajzoló ciklusában - ez volt az EGYETLEN lépés, ami
      hiányzott, a Restore/Save/Draw hármas maga már az első verzióban is
      megvolt). Mivel a Keret eközben NEM mozog/rajzolódik újra, nincs
      szükség a Meteornál bevezetett z-sorrendes átfedés-kezelésre
      (egyetlen mozgó sprite egy statikus háttér fölött).
   2) Amint az orra elérte a célt, a bomba eltűnik (RestoreBackground), és
      jön a Manhattan-távolság alapú ROMBUSZ (gyémánt) alakú roncsolás -
      7x7 befoglaló doboz (Keret_X_Pos-3..+3, Keret_Y_Pos-3..+3), egy mező
      akkor tartozik bele, ha |dx|+|dy|<=3 - ez 25 mezőt érint a 49-ből (a
      sarkok kimaradnak, ezért "rombusz", nem négyzet). Ha ott PUMPA volt
      (bármely fázisban) -> Pumpa_Torol (mint a Meteor_Becsapodas-nál - a
      Pumpa_db csökken + PUMP HUD frissül). **A TELJES rombusz Talaj2Map-
      pá ("kráter") válik** (NEM Talaj1Map-pá, mint korábban) -
      `Map[mp]:=Talaj2Map; Talaj2_Kirak(gx,gy);` minden érintett cellára,
      függetlenül attól, mi volt ott (pumpa/fal/vírus/sima talaj -
      mindegyiket felülírja). A Talaj2Map mezőre a DrillLerak/TeglaLerak
      már eddig sem enged pumpát/falat rakni (csak Talaj1Map-ra enged),
      így a kráter automatikusan "beépíthetetlen" marad. A `Meteor_
      Becsapodas()` a Talaj2Map mezőket KIHAGYJA (nem rongálja a krátert
      - lásd ott). A `dy`/`dx` ciklusváltozók 0..6-ig futnak (a -3..+3 eltolást +3-mal
      tolva el, hogy byte maradjon), a tényleges rács-koordinátát (gx/gy)
      a Meteor_Becsapodas-nál bevált "kivonás, majd tartomány-ellenőrzés"
      mintával számoljuk (byte-alulcsordulásnál a `gy>=1`/`gx>=1` check
      biztonságosan kiszűri, lásd CLAUDE.md). */
Procedure Bomba_Ledob();
	var dx, dy, gx, gy, tavx, tavy, tav		:	byte;
		celY, noseY								:	byte;
		mp										:	integer;
	begin
		if (Drill_Cash>=Bomba_price) then
			begin;
				/* --- 1) Zuhanás-animáció --- */
				Bomba.X:=(Keret_X_Pos*2)-2;	/* vízszintesen a Keret oszlopának közepére igazítva, nem változik zuhanás közben */
				Bomba.Y:=0;						/* a képernyő tetejéről indul */
				Bomba.SetPosition();
				Bomba.SaveBackground();
				Bomba.Draw();
				Bomba.UpdateLastPos();			/* KRITIKUS: RestoreBackground a LastPosition-t használja (NEM a Position-t!) -
												   enélkül a következő RestoreBackground a régi/kezdő helyre állna vissza,
												   nem a legutóbb rajzolt helyre -> ez okozta a "csíkot húz" hibát */
				celY:=28+(Keret_Y_Pos*10)+6;	/* a Keret sorának közepe (Keret_XY_Calc képlete +6, a Keret magasságának fele) */
				noseY:=Bomba.Y+16;				/* a bomba orra = a sprite alja */
				while (noseY<celY) do
					begin;
						GE::WaitForSync();
						Bomba.RestoreBackground();		/* a LastPosition-ön (= legutóbb rajzolt hely) állítja vissza a hátteret */
						Bomba.MoveDownBy4();			/* Bery-féle beépített mozgatás (Position += 4*SCREEN_WIDTH, Y+=4) - gyorsabb, mint Y:=Y+4 + SetPosition() */
						Bomba.SaveBackground();		/* az ÚJ (Position-ön lévő) hely hátterét menti el */
						Bomba.Draw();
						Bomba.UpdateLastPos();			/* a most rajzolt hely lesz a KÖVETKEZŐ RestoreBackground célja */
						noseY:=Bomba.Y+16;
					end;
				Bomba.RestoreBackground();		/* a bomba eltűnik, mielőtt a talaj törlődik */

				/* --- 2) Rombusz alakú roncsolás (változatlan) --- */
				Keret.RestoreBackground();
				dy:=0;
				while (dy<7) do
					begin;
						if (dy<3) then tavy:=3-dy else tavy:=dy-3;	/* |dy-3| = távolság a Kerettől függőlegesen */
						gy:=Keret_Y_Pos-3+dy;
						if (gy>=1) then
						if (gy<=18) then
							begin;
								dx:=0;
								while (dx<7) do
									begin;
										if (dx<3) then tavx:=3-dx else tavx:=dx-3;	/* |dx-3| = távolság vízszintesen */
										tav:=tavx+tavy;
										if (tav<=3) then			/* csak a rombuszon belüli mezők (Manhattan-távolság) */
											begin;
												gx:=Keret_X_Pos-3+dx;
												if (gx>=1) then
												if (gx<=30) then
													begin;
														mp:=gx-1+(gy-1)*30;
														if ((Map[mp]>=PumpaMap) and (Map[mp]<PumpaMap+PUMPA_FAZISOK)) then
															Pumpa_Torol(gx, gy);
														Map[mp]:=Talaj2Map;	/* a bomba a TELJES rombuszt "kráterré" (Talaj2) alakítja, nem sima Talaj1-gyé */
														Talaj2_Kirak(gx, gy);
													end;
											end;
										dx:=dx+1;
									end;
							end;
						dy:=dy+1;
					end;
				Drill_Cash:=Drill_Cash-Bomba_price;
				Cash_OSD();
				Keret_XY_Calc();
				Keret_SpriteKirak();
				Keret_OSD();
			end;
	end;

/* A lerakott pumpák termelése: a Drill_Cash annyiszor Pumpa_termel értékkel nő,
   ahány pumpa le lett rakva (Pumpa_db). A főciklus Termel_Utem képkockánként hívja.
   A szorzatot integer-ben számoljuk (Pumpa_db * Pumpa_termel akár 800 is lehet,
   ami byte-ban túlcsordulna), és 9999-re vágjuk, mert a HUD_Num4 csak 4 jegyet
   tud kiírni. */
Procedure Pumpak_Termelnek();
	var termeny : integer;
	begin
		if (Pumpa_db > 0) then
			begin
				termeny:=Pumpa_db;
				termeny:=termeny*Pumpa_termel;
				Drill_Cash:=Drill_Cash+termeny;
				if (Drill_Cash > 9999) then Drill_Cash:=9999;
				Cash_OSD();
			end;
	end;

/* ============================================================
   ENEMY_Szekcio - a terjedő "vírus" - a C64-es aqualiquex (units.tru +
   raster.tru) viselkedésének 1:1 lemodellezése (a raszter-időzítés nélkül;
   nálunk egy fociklus-iteráció = egy C64 raszter-IRQ).

   C64 megfeleltetések:
     units::makeVirus(x,y)      -> Enemy_Terjed_Ide(x,y)
     units::doVirusSpread       -> Enemy_Terjedhet (0/1)
     units::noOfColonies        -> Enemy_Kolonia_db  (VETETT kolóniák)
     units::maxColonies (10)    -> ENEMY_MAX_KOLONIA
     virusStart..-1  (192..201) -> Map = VirusMap + (0 .. ENEMY_MAX_FAZIS-1)  (NÖVEKVŐ)
     virusAnimFrames (202..208) -> Map = VirusMap +  ENEMY_MAX_FAZIS          (KIFEJLETT)
     raster.tru "for i:=0 to 15" -> Enemyk_Mukodnek, ENEMY_PROBA_DB minta/frame

   Menet:
   1) KOLÓNIA-VETÉS (fociklus, ~50 frame-enként = "másodperc"): 50% eséllyel
      (a C64-nél a másik 50% a meteor) egy véletlen mezőre Enemy_Terjed_Ide,
      amíg Enemy_Kolonia_db < ENEMY_MAX_KOLONIA (10). A 10. VETETT kolónia
      után új nem jön: Enemy_Terjedhet := 1.
   2) NÖVEKEDÉS + TERJEDÉS (Enemyk_Mukodnek, minden frame): ENEMY_PROBA_DB
      véletlen minta. Növekvő vírus -> egy fázissal előre (nem terjed).
      Kifejlett vírus -> nem nő; ha Enemy_Terjedhet=1, a 3x3 környezet
      (átlók is!) egy véletlen mezőjére terjed (Enemy_Terjed_Ide).
   3) PUMPAEVÉS: Enemy_Terjed_Ide pumpára esve Pumpa_Torol (C64: makeVirus ->
      removeDrill). FAL blokkol.
   ============================================================ */

/* C64 units::makeVirus(x,y) 1:1 mása. Az (x,y) rács-mezőn a mező 0. fázisú
   vírus lesz (C64: putChar(x,y, virusStart)):
   - ha ott FAL van -> a vírus NEM megy át (C64: makeVirus a fal-tartományt
     kihagyja) -> nem történik semmi;
   - ha ott PUMPA volt (BÁRMELY animációs fázisban) -> a vírus MEGESZI
     (Pumpa_Torol; C64: removeDrill), azután a mező vírus lesz;
   - ha ott SZABAD TALAJ volt -> egyszerűen vírus lesz;
   - ha ott MÁR VÍRUS volt -> a fázis VISSZAUGRIK 0-ra (a szomszédra vagy
     önmagára eső terjedés visszafiatalít - a C64 makeVirus is felülír).
   NINCS pool: a Map hordozza a teljes állapotot. */
Procedure Enemy_Terjed_Ide(x, y : byte);
	var mp								:	integer;
	begin;
		mp:=x-1+(y-1)*30;
		if (Map[mp]<>FalMap) then						/* FAL blokkol */
			begin;
				if ((Map[mp]>=PumpaMap) and (Map[mp]<PumpaMap+PUMPA_FAZISOK)) then
					Pumpa_Torol(x, y);					/* pumpát megeszi, bármely fázisban */
				Map[mp]:=VirusMap;							/* 0. fázisú vírus */
				Enemy_Kirak(x, y, 0);
			end;
	end;

/* Egy véletlen rács-mezőre vírust rak (C64: a kolónia-vetés
   makeVirus(rnd%40, rnd%23+1) hívása). RandomByte 0-255 -> mod 30/18 -> +1. */
Procedure Enemy_Random_Lerak();
	var rx, ry : byte;
	begin;
		rx:=Random::RandomByte();
		ry:=Random::RandomByte();
		rx:=1 + (rx - (rx/30)*30);
		ry:=1 + (ry - (ry/18)*18);
		Enemy_Terjed_Ide(rx, ry);
	end;

/* A vírus NÖVEKEDÉSE + TERJEDÉSE - a C64 raster.tru "for i:=0 to 15" ciklusának
   1:1 mása. A fociklus Enemy_Utem frame-enként hívja (C64-modell: minden
   képkockán, Enemy_Utem=1). Hívásonként ENEMY_PROBA_DB db VÉLETLEN cellát
   mintavételez. Minden mintára (rx,ry):
   - Map[mp] < VirusMap (nincs ott vírus)         -> semmi;
   - NÖVEKVŐ vírus (faz < ENEMY_MAX_FAZIS)        -> faz := faz+1 + újrarajz
     (NINCS terjedés, NINCS wrap; faz ENEMY_MAX_FAZIS-nál "beérik");
   - KIFEJLETT vírus (faz = ENEMY_MAX_FAZIS)      -> nem nő tovább; ha
     Enemy_Terjedhet=1, akkor TERJED: a 3x3 KÖRNYEZET (átlók is!) egy
     véletlen mezőjére Enemy_Terjed_Ide (a self-eset (dx=dy=0) visszafiatalítja
     a saját mezőjét - ez a C64-ben is így van).
   A fázist a Map-ből olvassuk, nincs pool-kereső ciklus mintánként. */
Procedure Enemyk_Mukodnek();
	var faz, nx, ny, dx, dy, rx, ry, p : byte;
		mp : integer;
	begin;
		p:=0;
		while (p<ENEMY_PROBA_DB) do
			begin;
				rx:=Random::RandomByte();
				ry:=Random::RandomByte();
				rx:=1 + (rx - (rx/30)*30);
				ry:=1 + (ry - (ry/18)*18);
				mp:=rx-1+(ry-1)*30;
				if (Map[mp] >= VirusMap) then
					begin;
						faz:=Map[mp]-VirusMap;
						if (faz < ENEMY_MAX_FAZIS) then
							begin;
								/* NÖVEKVŐ: egy lépcső előre (C64: putChar(tmp+1)) */
								faz:=faz+1;
								Map[mp]:=VirusMap+faz;
								Enemy_Kirak(rx, ry, faz);
							end
						else
							begin;
								/* KIFEJLETT: nem nő; terjed, ha engedélyezve */
								if (Enemy_Terjedhet=1) then
									begin;
										/* 3x3 környezet: dx,dy fuggetlenul -1/0/+1
										   (C64: x + rnd%3 - 1). +1-gyel eltolva a
										   byte-underflow ellen: 0..2 -> nx = rx-1+dx */
										dx:=Random::RandomByte();
										dx:=dx-(dx/3)*3;
										dy:=Random::RandomByte();
										dy:=dy-(dy/3)*3;
										nx:=rx-1+dx;			/* rx-1 .. rx+1 */
										ny:=ry-1+dy;
										/* clamp a rácsra (C64: 0..39 / 1..24) */
										if (nx<1)  then nx:=1;
										if (nx>30) then nx:=30;
										if (ny<1)  then ny:=1;
										if (ny>18) then ny:=18;
										Enemy_Terjed_Ide(nx, ny);
									end;
							end;
					end;
				p:=p+1;
			end;
	end;

/* ============================================================
   KEZDOKEPERNYO / RND-beallitas
   Letorli a kepernyot, kiirja kozepre a felhivast, es VAR a SPACE-re.
   A varakozas alatt minden kepkockan porget egyet a Random generatoron
   -> a seed a jatekos reakcioidejetol fugg (boot-onkent mas). TVC-n
   nincs jobb entropiaforras induláskor.
   MEGJ.: a felirat ekezet nelkuli - a CharSetGR4.bin ekezetkeszlete
   nem biztos, hogy teljes.
   ============================================================ */
Procedure Start_Kepernyo();
	begin;
		GE::ClearScreen(0);
		GE::WriteText(10, 116, "SPACE-RE INDUL A JATEK");
		Start_Wait:=1;
		while (Start_Wait = 1) do
			begin;
				GE::GetKeyboard();
				Rnd_Porgeto:=Random::RandomByte();
				if (GE::Pressed(GE::KEY_SPACE)) then Start_Wait:=0;
				GE::WaitForSync();
			end;
		GE::ClearScreen(0);
	end;

/* ============================================================
   METEOR - NEM BLOKKOLÓ. A főciklusból random időnként elindul egy
   zuhanás (Meteor_Indit), és amíg tart, a "3." lépésben a
   Meteor_Keret_Frissit() fut a Keret_Frissit HELYETT (lásd ott a fejlécet)
   - eközben a pumpák / vírus TOVÁBB futnak.
   Pálya: RANDOM belépő X-ről, MINDEN képkockán METEOR_LE_PX px LE; MINDEN
   METEOR_OLDAL_UTEM. képkockán 1 px BALRA (lépcsőzve, METEOR_X_CEL-ig).
   Y=Meteor_Y_Cel (RANDOM út-hossz) -nél ELTŰNIK. Maszkolt -> Draw + puffer,
   ez MARAD a Bery-féle GE úton. */
/* A TELJES fal-réteg újrarajzolása a Map-ból (minden FalMap mező). Egyszer
   fut le, amikor a meteor eltűnik - így a meteor útjába lerakott, a meteor
   elavult háttérpuffere által "letörölt" falak visszakerülnek. (A pumpát a
   strided scan magától újrarajzolja, a fal statikus, ezért kell ez.)
   ~540 Map-olvasás egyszeri spike-ban - a meteor pont eltűnt, nem látszik. */
Procedure Fal_Mind_Kirak();
	var gx, gy : byte;
		mp : integer;
	begin;
		mp:=0;
		fori gy:=1 to 18 do
			fori gx:=1 to 30 do
				begin;
					if (Map[mp]=FalMap) then Fal_Kirak(gx, gy);
					mp:=mp+1;
				end;
	end;

/* METEOR BECSAPÓDÁS - a ciklus végén (a meteor eltűnésekor) fut le.
   A meteor UTOLSÓ képernyő-koordinátáiból (Meteor.X byte / Meteor.Y px)
   kiszámolja, melyik 3x3 rács-mező fölött állt (a meteor közepe köré
   centrálva), és MINDET üres talajjá roncsolja: a Map-ban Talaj1Map, a
   képen Talaj1 bélyegző. Ha ott PUMPA volt (bármely fázisban) -> Pumpa_Torol
   (poolból ki - illetve most csak számláló csökkentés, Pumpa_db--, PUMP HUD).
   Ha FAL vagy VÍRUS volt -> a Map felülírás + a talaj kirajzolása magától
   kitörli. **Talaj2Map (a Bomba_Ledob() által létrehozott "kráter") mezőt
   a meteor NEM rongálja** (a felhasználó kérésére, 2026-09-14) - ha
   `Map[mp]=Talaj2Map`, az egész roncsoló blokk (Pumpa_Torol/Map-írás/
   Talaj1_Kirak) ki van hagyva, a kráter érintetlen marad.
   gx0 = Meteor.X/2 (a becsapódás közepének rács-oszlopa) - a vízszintes
   zóna KÖZÉPRE IGAZÍTVA gx0 köré: [gx0-1, gx0, gx0+1] (2026-09-14: ez
   KONFIRMÁLT+JAVÍTOTT hiba volt - korábban [gx0, gx0+1, gx0+2] futott,
   azaz egy teljes oszloppal JOBBRA csúszva a tényleges középponttól, ezért
   a becsapódás közepétől BALRA eső pumpák/mezők rendszeresen kimaradtak a
   roncsolásból - "úgy tűnt eltalálta, mégsem tűnt el a pumpa"). gy0 =
   (Meteor.Y-22)/10 = a sprite KÖZEPÉNÉL lévő rács-sor -> a 3x3 innen LEFELÉ
   3 sor (ez SZÁNDÉKOSAN aszimmetrikus - a zuhanó meteor törmeléke lefelé
   hull, nem a csóva felé - NEM hiba). Clamp 1..30 / 1..18. */
Procedure Meteor_Becsapodas();
	var gx, gy, gx0, gy0, tx, ty, mx, my : byte;
		mp : integer;
	begin;
		mx:=Meteor.X;							/* sprite-mezők SIMA byte lokálba (a bare "Meteor.X/2" gyanús a TRSE-nek) */
		my:=Meteor.Y;
		gx0:=(mx + 1) / 2;						/* mint a működő 2x2-ben, csak 3x3-ra bővítve */
		gy0:=(my - 22) / 10;
		ty:=0;
		while (ty<3) do
			begin;
				gy:=gy0+ty;
				if (gy>=1) then
				if (gy<=18) then
					begin;
						tx:=0;
						while (tx<3) do
							begin;
								gx:=gx0-1+tx;	/* KÖZÉPRE igazítva (gx0-1..gx0+1) - lásd a fenti hiba-megjegyzést */
								if (gx>=1) then
								if (gx<=30) then
									begin;
										mp:=gx-1+(gy-1)*30;
										if (Map[mp]<>Talaj2Map) then	/* a meteor nem rongálja a bomba-krátert (Talaj2Map) */
											begin;
												if ((Map[mp]>=PumpaMap) and (Map[mp]<PumpaMap+PUMPA_FAZISOK)) then
													Pumpa_Torol(gx, gy);
												Map[mp]:=Talaj1Map;
												Talaj1_Kirak(gx, gy);
											end;
									end;
								tx:=tx+1;
							end;
					end;
				ty:=ty+1;
			end;
	end;

Procedure Meteor_Indit();
	var r : byte;
	begin;
		/* a meteor közeledtének JELZÉSE: CSAK a 3. index (kék) -> sötétkék.
		   A szürkéhez / zöldhöz / border-hez NEM nyúlunk. Vissza a meteor VÉGÉN. */
		GE::SetPalette(3,GE::PALETTE_DarkBlue);
		Meteor_Faz:=0;
		Meteor.Data:=Meteor_FazPtr_Tab[0];	/* 0. fázis (szikla1) */
		/* RANDOM belépő X (METEOR_X_MIN .. METEOR_X_MIN+METEOR_X_RND-1) */
		r:=Random::RandomByte();
		r:=r - (r/METEOR_X_RND)*METEOR_X_RND;
		Meteor.X:=METEOR_X_MIN + r;
		Meteor.Y:=METEOR_START_Y;			/* belépő Y fix, fent */
		/* RANDOM út-hossz: ennél az Y-nál áll meg (becsapódási pont) */
		r:=Random::RandomByte();
		r:=r - (r/METEOR_Y_RND)*METEOR_Y_RND;
		Meteor_Y_Cel:=METEOR_Y_MIN + r;
		Meteor.SetPosition();
		Meteor.SaveBackground();
		Meteor.Draw;
		Meteor.UpdateLastPos;
		Meteor_Aktiv:=1;
		Meteor_UtemFrame:=0;
	end;

/* Meteor AKTÍV állapotban EZ fut a Keret_Frissit HELYETT a főciklusban -
   mert két, EGYMÁST ÁTFEDŐ maszkolt sprite (Keret + Meteor) külön
   háttérpufferrel "szemetel", ha nem szigorú z-sorrendben restore-oljuk /
   rajzoljuk (a GE::RenderAllSprites elve kézzel, 2 sprite-ra):
     1) fordított z-sorrendben LE:  Keret.Restore -> Meteor.Restore
     2) az alsó animált réteg:      PumpakKirak (+ vírus, ha mozgott)
     3) Meteor lépés + rajz:        SetPosition/SaveBackground(map+pumpák)/Draw
     4) Keret LEGFELÜL:             SetPosition/SaveBackground(+meteor)/Draw
   Így minden sprite háttérpuffere PONTOSAN a saját maga alatti réteget
   tartalmazza -> a következő képkocka restore-jai nem írnak vissza elavult
   idegen pixeleket (nincs "szellem-Keret", nincs lyuk a meteorban). */
Procedure Meteor_Keret_Frissit();
	var mozgott						:	boolean;
	begin;
		MapPos:=Keret_X_Pos-1+(Keret_Y_Pos-1)*30;
		mozgott:=((Keret_X_Pos<>Keret_Elozo_X_Pos) or (Keret_Y_Pos<>Keret_Elozo_Y_Pos));

		Keret.RestoreBackground();			/* 1) legfelső réteg le */
		Meteor.RestoreBackground();			/* 1) középső réteg le (régi pozíción) */

		PumpakKirak();							/* 2) alsó animált réteg */
		if (mozgott) then Enemyk_Ujrarajzol();

		/* 3) meteor lépés: MINDEN képkockán METEOR_LE_PX px LE; MINDEN
		   METEOR_OLDAL_UTEM. képkockán 1 PIXEL balra - a szikla 4 fázisával
		   (0->1->2->3 = 3 px), a 4. oldal-lépésnél VALÓDI Meteor.X -= 1 byte
		   + vissza a 0. fázisra. Csak amíg X > METEOR_X_CEL. Ha Y elérte
		   Meteor_Y_Cel-t (RANDOM) -> eltűnik + a fal-réteg egyszeri újrarajza. */
		if (Meteor.Y < Meteor_Y_Cel) then
			begin;
				Meteor.Y:=Meteor.Y+METEOR_LE_PX;			/* LE, képkockánként */
				Meteor_UtemFrame:=Meteor_UtemFrame+1;
				if (Meteor_UtemFrame>=METEOR_OLDAL_UTEM) then
					begin;
						Meteor_UtemFrame:=0;
						if (Meteor.X > METEOR_X_CEL) then
							begin;
								if (Meteor_Faz < 3) then
									Meteor_Faz:=Meteor_Faz+1		/* 0..3: pixelenként balra a fázissal */
								else
									begin;
										Meteor_Faz:=0;				/* 4. lépés: vissza a 0. fázisra ... */
										Meteor.X:=Meteor.X-1;		/* ... és 1 byte (4 px) balra -> net 1 px */
									end;
								Meteor.Data:=Meteor_FazPtr_Tab[Meteor_Faz];
							end;
					end;
			end
		else
			begin;
				Meteor_Aktiv:=0;			/* megérkezett -> nem rajzoljuk többet (a Restore törölte) */
				GE::SetPalette(3,GE::PALETTE_Blue);		/* meteor vége -> vissza világoskék */
				Meteor_Becsapodas();		/* a ~3x3 becsapódási mező roncsolása -> üres talaj (Map + kép); a Pumpa_Torol maga frissíti a PUMP HUD-ot */
				Fal_Mind_Kirak();			/* a meteor útjába lerakott, "letörölt" falak visszarajzolása */
			end;
		if (Meteor_Aktiv=1) then
			begin;
				Meteor.SetPosition();
				Meteor.SaveBackground();
				Meteor.Draw;
				Meteor.UpdateLastPos;
			end;

		/* 4) Keret LEGFELÜL, minden képkockán (a meteor rajzolhatott rá) */
		Keret_XY_Calc();
		Keret.SetPosition();
		Keret.SaveBackground();
		Keret.Draw;
		Keret.UpdateLastPos;
		Keret_Elozo_X_Pos:=Keret_X_Pos;
		Keret_Elozo_Y_Pos:=Keret_Y_Pos;
		Keret_OSD();
	end;

/* ============================================================
   FŐPROGRAM
   ============================================================ */
begin
	/* Egyszeri indítási beállítások. */
	ProgramInit;

	/* Kezdőképernyő: "SPACE-RE INDUL A JÁTÉK" - eddig NEM történik semmi
	   más, csak a szöveg látszik, és a Random generátor pörög. SPACE-re
	   megy tovább. */
	Start_Kepernyo();

	/* Térkép feltöltése és kirajzolása, a Keret kezdő kirajzolása. */
	MapReset;
	MapToScreen;


	/* Kezdő kirajzolás FELTÉTEL NÉLKÜL (nem a Keret_Frissit-en keresztül, mert az
	   mostantól csak mozgás/pumpa esetén frissít - induláskor viszont mindig
	   látszódnia kell a Keretnek). RestoreBackground-ot itt szándékosan NEM
	   hívunk: a ProgramInit-ben elmentett háttér még a MapToScreen előttről,
	   "üres" állapotból származna, annak visszaállítása most elrontaná a már
	   kirajzolt térképet. */
	Keret_XY_Calc();
	Keret_SpriteKirak();
	Keret_Elozo_X_Pos:=Keret_X_Pos;
	Keret_Elozo_Y_Pos:=Keret_Y_Pos;
	Keret_OSD();

	/* ENEMY_Szekcio: nincs külön kezdő-késleltetés (a C64 sem csinál ilyet).
	   A vírus a fociklus "5." lépésében kezd el kolóniákat vetni ~50
	   képkockánként ("másodperc"), az első ~1-2 mp-en belül megjelenik. */

    while (true) do
	begin

		/* 1. Bemenetkezelés: billentyűzet/joystick lekérdezése, és ez alapján
		   a Keret rács-pozíciójának módosítása vagy pumpa lerakása.
		   Ezek a lépések itt még NEM rajzolnak semmit a képernyőre. */
		GE::GetKeyboard();
		GE::GetJoysticks();

		/* A véletlenszám-generátort minden képkockán pörgetjük, hogy a
		   későbbi vírus-terjedés iránya se legyen determinisztikus. */
		Rnd_Porgeto:=Random::RandomByte();

		/* Keret-mozgás LASSÍTÁSA: csak minden Keret_Mozog_Utem. képkockán
		   léphet egyet a kurzor (Keret_Mozog_Utem kezdő értéke 2). */
		Keret_Mozog_Frame:=Keret_Mozog_Frame+1;
		if (Keret_Mozog_Frame >= Keret_Mozog_Utem) then
			begin;
				Keret_Mozog_Frame:=0;
				if (GE::Joystick(1, GE::JOY_LEFT) and (Keret_X_Pos > 1)) then Keret_MoveLeft();
				if (GE::Joystick(1, GE::JOY_RIGHT) and (Keret_X_Pos < 30)) then Keret_MoveRight();
				if (GE::Joystick(1, GE::JOY_UP) and (Keret_Y_Pos > 1)) then Keret_MoveUp();
				if (GE::Joystick(1, GE::JOY_DOWN) and (Keret_Y_Pos < 18)) then Keret_MoveDown();
			end;
		if (GE::Pressed(GE::KEY_SPACE)) then DrillLerak();
		if (GE::Pressed(GE::KEY_F)) then TeglaLerak();		/* F = fal-tégla lerakás */
		if (GE::Pressed(GE::KEY_B)) then Bomba_Ledob();	/* B = bomba (rombusz alakú roncsolás) */

		/* 1b. Pumpa-animáció SZÁMOLÁSI fázisa - KÖTELEZŐEN a WaitForSync
		   ELŐTT (csak fázis-léptetés a Map[]-ben, nem rajzol). A hozzá
		   tartozó KIRAKÁSI fázis (PumpakKirak) a "3." rajzolási lépésben,
		   a Keret_Frissit()/Meteor_Keret_Frissit() belsejében fut. */
		PumpakSzamol();

		/* 2. Várakozás a képfrissítésre (raszter-megszakítás), hogy a
		   rajzolás ne okozzon szakadást/villogást a képen. */
		GE::WaitForSync();

		/* 3. Rajzolási fázis. Ha a meteor ÉPPEN zuhan, a Meteor_Keret_Frissit
		   fut a Keret_Frissit HELYETT: szigorú z-sorrendben restore-ol/rajzol,
		   hogy a két átfedő maszkolt sprite (Keret + Meteor) ne szemeteljen.
		   Egyébként a normál Keret_Frissit (pumpák + Keret). */
		if (Meteor_Aktiv = 1) then
			Meteor_Keret_Frissit()
		else
			Keret_Frissit();

		/* 4. Pumpák termelése: Termel_Utem képkockánként egyszer. */
		Termel_Frame:=Termel_Frame+1;
		if (Termel_Frame >= Termel_Utem) then
			begin
				Termel_Frame:=0;
				Pumpak_Termelnek();
			end;

		/* 5. KOLÓNIA-VETÉS - C64: aqualiquex.ras "if raster::newSecond".
		   ~50 képkockánként ("másodperc"): 50% eséllyel (a C64 másik 50%-a a
		   meteor) egy véletlen mezőre vírust vetünk, amíg
		   Enemy_Kolonia_db < ENEMY_MAX_KOLONIA. A 10. vetett kolónia után
		   nincs új: Enemy_Terjedhet := 1 (C64: doVirusSpread). */
		Enemy_Sec_Frame:=Enemy_Sec_Frame+1;
		if (Enemy_Sec_Frame >= 50) then
			begin;
				Enemy_Sec_Frame:=0;
				/* 50% (C64: mod(rnd,2)=0). Rnd_Porgeto = ebben a frame-ben
				   sorsolt RandomByte (lásd fentebb). */
				Enemy_Coin:=Rnd_Porgeto - (Rnd_Porgeto/2)*2;
				if (Enemy_Coin = 0) then
					begin;
						if (Enemy_Kolonia_db < ENEMY_MAX_KOLONIA) then
							begin;
								Enemy_Random_Lerak();
								Enemy_Kolonia_db:=Enemy_Kolonia_db+1;
							end
						else
							Enemy_Terjedhet:=1;
					end;
			end;

		/* 6. NÖVEKEDÉS + TERJEDÉS - C64: raster.tru "for i:=0 to 15".
		   Enemy_Utem frame-enként (C64-modell: minden frame, =1). */
		Enemy_Frame:=Enemy_Frame+1;
		if (Enemy_Frame >= Enemy_Utem) then
			begin;
				Enemy_Frame:=0;
				Enemyk_Mukodnek();
			end;

		/* 7. METEOR trigger: ha NEM zuhan épp, visszaszámlálás a következő
		   random zuhanásig (100..299 képkocka ~ 2..6 mp). A zuhanás magát
		   a "3." lépés Meteor_Keret_Frissit-je végzi. */
		if (Meteor_Aktiv = 0) then
			begin;
				Meteor_TriggerFrame:=Meteor_TriggerFrame-1;
				if (Meteor_TriggerFrame <= 0) then
					begin;
						Meteor_Indit();
						/* 0..199 (byte-aritmetika), majd integer-ben +100 -> 100..299 */
						Meteor_TriggerFrame:=Rnd_Porgeto - (Rnd_Porgeto/200)*200;
						Meteor_TriggerFrame:=Meteor_TriggerFrame + 100;
					end;
			end;

	end;

//	GE::SetBorder(GE::Border_DarkRed);
end.
