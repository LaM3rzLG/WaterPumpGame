program SzinSorok;
@use "TVC"

/* GRAPHICS2 (2 szín, 512x240): fekete papír, a tinta (1. paletta, port $61) színe soronként
   vált: a 7 sötét szín oda-vissza (bordás), fekete nélkül, a TELJES képen.
   Egy felirat pattog fel-le a kép tetejétől az aljáig, így áthalad a színsávokon.
   Időzítés: saját megszakítás-kezelő (csak nyugtáz), halt = szinkron a raszter-IT-re
   (a 239. sor végén). A képváltás alatti várakozásban (72 sor) FIX idő alatt mozgatjuk a
   feliratot, utána di alatt pontosan 200 T-s sorok (1 sor = 64 us @ 3,125 MHz). */

var
	/* sötétkék, sötétpiros, sötétlila, sötétzöld, sötétcián, sötétsárga, szürke - majd vissza */
	Szinek		:	array[14] of byte = (1, 4, 5, 16, 17, 20, 21, 21, 20, 17, 16, 5, 4, 1);
	Sorszin		:	array[240] of byte;
	Elo_Sorok	:	byte = 37;	// a felirat-mozgatás (~35 sor) után ennyi sor várakozás a 0. sorig (összesen 72)
	Finom		:	byte = 18;	// finom eltolás (13 T lépés): a színváltás vízszintes helye a soron belül
	i, j, r, c	:	byte;
	p			:	pointer;
	k, ofs		:	integer;
	/* a felirat képe: 12 sor x 24 byte (1 üres sor + 10 sor szöveg + 1 üres sor);
	   az üres szélső sorok mozgáskor letörlik az előző helyzet maradékát */
	TxtBuf		:	array[288] of byte;
	SzY			:	byte = 0;		// a felirat-kép felső sora (0..228)
	SzD			:	byte = 1;		// lépés: 1 = le, $FF = fel
	SzDD		:	integer = 64;	// címlépés: +64 / -64
	SzCim		:	integer = $8014;// a felirat-kép bal felső byte-ja a videó-RAM-ban ($8000 + SzY*64 + 20)
	SzHatar		:	byte = 228;		// ennél a sornál fordul (228 lefelé, 0 felfelé)

const SAV_KEZD  : integer = 110;	// a középső tömör sáv első pixelsora
const SAV_MAGAS : integer = 20;		// a sáv magassága (sor)

begin
	TVC::SetGraphicsMode(TVC::GRAPHICS2);
	TVC::SetRasterInterruptPos(239);	// a VMODE után: raszter-IT a 239. sor végére
	TVC::SetPalette(0, TVC::PALETTE_BLACK);
	TVC::SetBorder(TVC::BORDER_BLACK);

	/* soronkénti színtábla: a 14 elemes oda-vissza sor ismétlődve, 240 sorra */
	i := 0;
	j := 0;
	while (i < 240) do
	begin
		Sorszin[i] := Szinek[j];
		j := j + 1;
		if (j = 14) then j := 0;
		i := i + 1;
	end;

	/* a felirat kirajzolása a ROM-mal (1. sor, középre: 24 karakter -> X=21, a 20. byte-tól),
	   majd kimásolása a TxtBuf-ba, és a képernyő törlése */
	TVC::ClearScreen();
	TVC::SetColor(1);
	TVC::TextBackground(0);
	TVC::WriteAt(21, 1, "GRAPHICS 2 - MORE COLORS");

	k := 0;
	while (k < 288) do
	begin
		TxtBuf[k] := 0;
		k := k + 1;
	end;
	TVC::SetMemory(TVC::MEM_VID_ON);
	r := 0;
	while (r < 10) do
	begin
		p := $8014;
		ofs := r * 64;
		p := p + ofs;
		k := r * 24;
		k := k + 24;
		c := 0;
		while (c < 24) do
		begin
			TxtBuf[k] := p[c];
			k := k + 1;
			c := c + 1;
		end;
		r := r + 1;
	end;
	TVC::SetMemory(TVC::MEM_DEFAULT);
	TVC::ClearScreen();

	/* tömör $FF sáv a kép közepén: 20 sor (110..129), teljes szélesség; a felirat áthaladva kitörli (nincs háttérmentés) */
	TVC::SetMemory(TVC::MEM_VID_ON);
	p := $8000 + SAV_KEZD * 64;
	k := 0;
	while (k < SAV_MAGAS * 64) do
	begin
		p[0] := $FF;
		p := p + 1;
		k := k + 1;
	end;
	TVC::SetMemory(TVC::MEM_DEFAULT);

	asm("
		di
		;// saját megszakítás-kezelő: $38 -> JP SzS_Isr
		ld hl,$38
		ld (hl),195
		ld de,SzS_Isr
		inc hl
		ld (hl),e
		inc hl
		ld (hl),d
		ei

SzS_Frame:
		halt
		di
		;// ---- felirat kirakása a mostani helyére (FIX idő) ----
		ld a,$50			;// U0,U1,VID,SYS: videó-RAM a $8000-on
		out ($2),a			;// 18 (a fenti ld-vel)
		ld de,[SzCim]		;// 20
		ld hl,TxtBuf		;// 10
		ld a,12				;// 7
SzS_Cp:
		ld bc,24			;// 10
		ldir				;// 23*21+16 = 499
		ex de,hl			;// 4
		ld bc,40			;// 10
		add hl,bc			;// 11
		ex de,hl			;// 4
		dec a				;// 4
		jp nz,SzS_Cp		;// 10  (= 552 / sor, x12 = 6624)
		ld a,$70			;// alap lapozás vissza
		out ($2),a			;// 18

		;// ---- következő helyzet (mindkét ágon azonos idő) ----
		ld a,[SzY]			;// 13
		ld hl,SzD			;// 10
		add a,(hl)			;// 7
		ld [SzY],a			;// 13
		ld hl,[SzCim]		;// 16
		ld de,[SzDD]		;// 20
		add hl,de			;// 11
		ld [SzCim],hl		;// 16  (= 106)
		ld hl,SzHatar		;// 10
		cp (hl)				;// 7
		jp z,SzS_Ford		;// 10  (= 27)
		ld b,8				;// 7
SzS_Pad:
		djnz SzS_Pad		;// 7*13+8 = 99
		nop					;// 4
		nop					;// 4
		inc hl				;// 6
		jp SzS_Ut			;// 10  (= 130)
SzS_Ford:
		ld a,[SzD]			;// 13  irányváltás: SzD, SzDD negálása
		neg					;// 8
		ld [SzD],a			;// 13
		ld hl,0				;// 10
		ld de,[SzDD]		;// 20
		or a				;// 4
		sbc hl,de			;// 15
		ld [SzDD],hl		;// 16
		ld a,228			;// 7   a másik határ: 228 - SzHatar
		ld hl,SzHatar		;// 10
		sub (hl)			;// 7
		ld (hl),a			;// 7   (= 130)
SzS_Ut:
		;// kiegészítés 40 T: a mozgatás így összesen 6960 + 40 = 7000 T = 35 sor (+ Elo_Sorok 37 = 72 sor)
		nop
		nop
		nop
		nop
		nop
		nop
		nop
		nop
		nop
		nop

		;// várakozás Elo_Sorok sorig (200 T / sor)
		ld a,[Elo_Sorok]
		ld c,a
SzS_Elo:
		ld b,14
SzS_EloB:
		djnz SzS_EloB
		dec c
		jr nz,SzS_Elo
		;// finom eltolás
		ld a,[Finom]
		ld b,a
SzS_Fin:
		djnz SzS_Fin

		;// 240 sor: soronként új tintaszín, PONTOSAN 200 T / sor
		ld hl,Sorszin
		ld de,240
SzS_Sor:
		ld a,(hl)			;// 7
		out ($61),a			;// 11
		inc hl				;// 6
		dec de				;// 6
		ld a,d				;// 4
		or e				;// 4
		jp z,SzS_Kesz		;// 10  (= 48)
		ld b,10				;// 7
SzS_Var:
		djnz SzS_Var		;// 9*13+8 = 125  (= 180)
		jp SzS_J			;// 10
SzS_J:
		jp SzS_Sor			;// 10  (= 200)
SzS_Kesz:
		ei
		jp SzS_Frame

SzS_Isr:
		out ($7),a			;// IT nyugtázása
		ei
		ret
	");
end.
