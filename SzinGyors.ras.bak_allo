program SzinGyors;
@use "TVC"

/* GRAPHICS2 (2 szín, 512x240): a képernyő tele $FF-fel (minden pixel tinta = 1. paletta, port $61).
   TESZT: milyen gyorsan tudunk tintaszínt váltani egy soron BELÜL.
   A leggyorsabb mód: out (c),r előre betöltött regiszterekből = 12 T / váltás
   (GRAPHICS2-ben 2 T = 1 byte = 8 pixel, tehát 12 T = 6 byte = 48 pixel széles csík).
   Soronként 14 váltás (6 szín körben: B,D,E,H,L,A), a sorszámláló a másik regiszterkészletben (exx),
   így egy sor pontosan 200 T, a minta áll (függőleges csíkok).
   Szinkron: EGYETLEN halt induláskor (a 239. sor végén), utána megszakítás NÉLKÜL, órajel-pontos
   képkocka-ciklus: a CRTC szerint 78 x 4 + 2 = 314 sor = 62800 T. (A halt 0..3 T-s bizonytalansága
   minden képkockán 8..16 pixeles rázkódást okozott, így csak egyszer, induláskor számít.) */

var
	i			:	byte;

begin
	TVC::SetGraphicsMode(TVC::GRAPHICS2);
	TVC::SetRasterInterruptPos(239);	// a VMODE után: raszter-IT a 239. sor végére
	TVC::SetPalette(0, TVC::PALETTE_BLACK);
	TVC::SetBorder(TVC::BORDER_BLACK);

	asm("
		di
		;// képernyő feltöltése $FF-fel (VID a $8000-on)
		ld a,$50
		ld ($3),a
		out ($2),a
		ld hl,$8000
		ld (hl),$FF
		ld de,$8001
		ld bc,16383
		ldir
		ld a,$70
		ld ($3),a
		out ($2),a
		ei
	");

	/* szöveg 10x egymás alá, a kép közepére (ROM kiírás, még a ROM megszakítás-kezelőjével):
	   36 karakter -> X = (64-36)/2+1 = 15; 10 sor a 24-ből -> a 8..17. szövegsor (80..179. pixelsor).
	   Színes betűk (tinta = 1. paletta, a csíkok színe), fekete dobozban (papír = 0. paletta); a dobozokon kívül a teli $FF csíkos marad. */
	TVC::SetColor(1);
	TVC::TextBackground(0);
	i := 8;
	while (i < 18) do
	begin
		TVC::WriteAt(15, i, "VIDEOTON TV-COMPUTER GRAPHICS 2 MODE");
		i := i + 1;
	end;

	asm("
		di
		;// saját megszakítás-kezelő: $38 -> JP SzG_Isr
		ld hl,$38
		ld (hl),195
		ld de,SzG_Isr
		inc hl
		ld (hl),e
		inc hl
		ld (hl),d

		;// hang ki, hang-megszakítás tiltva (port $05: bit4 = hang tiltás, bit5 = 0 -> nincs hang-IT)
		ld a,$10
		out ($5),a

		;// szinkron, utána nincs több megszakítás. A di alatt beragadt régi IT-kérést előbb
		;// nyugtázzuk, és két halt: az első egy esetleg még függő kérésre ébredhet, a második a valódi
		out ($7),a
		ei
		halt
		halt
		di
		;// egyszeri fázis-eltolás 4 T (a képből mérve: 204 T = 1 sor + 4 T adta a jó vízszintes
		;// helyzetet, de egy sorral később indult): a sor 1. out-ja a látható rész bal szélére esik,
		;// a sorvégi adminisztráció (32 T) pedig a kioltásba
		nop					;// 4
		jp SzG_Var

		;// ===== egy képkocka = PONTOSAN 62800 T =====
		;// színek a regiszterekbe, C = tinta paletta port
SzG_Kep:
		ld c,$61			;// 7
		ld b,68				;// 7  piros
		ld d,80				;// 7  zöld
		ld e,65				;// 7  kék
		ld h,84				;// 7  sárga
		ld l,81				;// 7  cián
		ld a,69				;// 7  lila   (= 49)
		exx					;// 4
		ld b,240			;// 7  sorszámláló (a másik készletben)
		jp SzG_Sor			;// 10 (= 70)

		;// egy sor = PONTOSAN 200 T (240 sor = 48000 T, az utolsó djnz 5 T-vel rövidebb)
SzG_Sor:
		exx					;// 4   -> színregiszterek
		out (c),b			;// 12
		out (c),d			;// 12
		out (c),e			;// 12
		out (c),h			;// 12
		out (c),l			;// 12
		out (c),a			;// 12
		out (c),b			;// 12
		out (c),d			;// 12
		out (c),e			;// 12
		out (c),h			;// 12
		out (c),l			;// 12
		out (c),a			;// 12
		out (c),b			;// 12
		out (c),b			;// 12  (14 x 12 = 168) - ugyanaz, mint az 1.: a sor eleji kioltásból kilógó rész is piros
		nop					;// 4
		ld c,$61			;// 7   (kitöltés, C változatlan)
		exx					;// 4   -> számláló
		djnz SzG_Sor		;// 13  (= 200)
		exx					;// 4   (70 + 47995 + 4 = 48069)

		;// a képkocka többi része: 62800 - 48069 = 14731 T
SzG_Var:
		ld c,73				;// 7
SzG_V1:
		ld b,14				;// 7
SzG_V2:
		djnz SzG_V2			;// 177
		dec c				;// 4
		jr nz,SzG_V1		;// 12 (utolsó: 7)  -> 73 x 200 - 5 + 7 = 14602
		ld b,9				;// 7
SzG_V3:
		djnz SzG_V3			;// 8 x 13 + 8 = 112  (= 14721)
		jp SzG_Kep			;// 10 (= 14731)

SzG_Isr:
		out ($7),a			;// IT nyugtázása
		ei
		ret
	");
end.
