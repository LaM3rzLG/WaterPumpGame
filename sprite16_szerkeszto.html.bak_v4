<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="utf-8">
<title>Sprite16 szerkesztő</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
:root{--bg:#1b1d23;--panel:#252830;--panel2:#2e323c;--text:#e6e6e6;--muted:#9aa0ab;--accent:#4aa3ff;--border:#3a3f4b}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:13px system-ui,"Segoe UI",sans-serif;display:flex;flex-direction:column;height:100vh;overflow:hidden}
#tabs{display:flex;align-items:center;gap:4px;background:#1f2128;border-bottom:1px solid var(--border);padding:6px 10px 0}
#tabs .tab{border-radius:6px 6px 0 0;border-bottom:none;padding:6px 14px;background:var(--panel2)}
#tabs .tab.on{background:var(--panel);color:var(--text);border-color:var(--border);box-shadow:inset 0 2px 0 var(--accent)}
#tabs .title{font-weight:bold;margin-right:12px}
#tabs .grow{flex:1}
#tabs .proj{margin-bottom:6px}
.view{flex:1;display:none;min-height:0}
.view.on{display:flex}
.side{width:240px;flex:none;background:var(--panel);border-right:1px solid var(--border);overflow-y:auto;padding:8px 10px}
.main{flex:1;display:flex;flex-direction:column;min-width:0}
.top{background:var(--panel);border-bottom:1px solid var(--border);padding:6px 10px;display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.work{flex:1;display:flex;min-height:0}
.canvasWrap{flex:1;overflow:auto;padding:16px;background:#131418}
.right{width:310px;flex:none;background:var(--panel);border-left:1px solid var(--border);overflow:auto;padding:8px 10px}
#status{background:var(--panel);border-top:1px solid var(--border);padding:4px 10px;color:var(--muted);font-size:12px;min-height:22px}
h3{margin:12px 0 6px;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
button,select,input{font:inherit;color:var(--text)}
button{background:var(--panel2);border:1px solid var(--border);border-radius:4px;padding:5px 8px;cursor:pointer}
button:hover{border-color:var(--accent)}
button.on{background:var(--accent);border-color:var(--accent);color:#000}
button:disabled{opacity:.4;cursor:default}
input[type=number],input[type=text],select{background:var(--panel2);border:1px solid var(--border);border-radius:4px;padding:4px 6px}
input[type=number]{width:62px}
label{display:inline-flex;align-items:center;gap:4px;cursor:pointer}
.tools{display:grid;grid-template-columns:1fr 1fr;gap:4px}
.tools button{text-align:left}
.tools kbd{float:right;color:var(--muted);font-size:11px}
button.on kbd{color:#000}
.pal{display:grid;grid-template-columns:repeat(4,1fr);gap:4px}
.sw{height:30px;border:2px solid var(--border);border-radius:3px;cursor:pointer;position:relative;font-size:11px;font-weight:bold}
.sw b{position:absolute;top:1px;padding:0 3px;border-radius:2px;background:#000;color:#fff}
.sw b.l{left:1px}.sw b.r{right:1px}
.tr{background:repeating-conic-gradient(#3d3d52 0 25%,#2b2b3a 0 50%) 0 0/10px 10px}
.sw.dis{opacity:.25;cursor:default}
.cur{display:flex;gap:8px;margin-top:6px}
.cur div{flex:1;text-align:center;font-size:11px;color:var(--muted)}
.cur i{display:block;height:22px;border:1px solid var(--border);border-radius:3px;margin-bottom:2px}
.row{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:4px 0}
.sep{width:1px;height:22px;background:var(--border);margin:0 4px}
canvas{image-rendering:pixelated;display:block}
#cv,#sc{box-shadow:0 0 0 1px #000,0 0 0 2px var(--border)}
#cv{cursor:crosshair}
#pvWrap{background:#000;padding:8px;overflow:auto;border:1px solid var(--border);border-radius:4px;max-height:360px}
pre{background:var(--panel2);border:1px solid var(--border);border-radius:4px;padding:6px;font-size:11px;white-space:pre-wrap;word-break:break-all;margin:4px 0;max-height:260px;overflow:auto}
.muted{color:var(--muted);font-size:12px}
.list{display:flex;flex-direction:column;gap:3px;max-height:300px;overflow:auto;border:1px solid var(--border);border-radius:4px;padding:3px;background:#1e2027}
.item{display:flex;align-items:center;gap:8px;padding:3px 5px;border-radius:3px;cursor:pointer;border:1px solid transparent}
.item:hover{border-color:var(--border)}
.item.on{background:#2c4a6e;border-color:var(--accent)}
.item.place{background:#4a3f1e;border-color:#e0b040}
.item .th{width:56px;height:34px;flex:none;display:flex;align-items:center;justify-content:center;background:#000;border-radius:2px}
.item .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.item .sz{color:var(--muted);font-size:11px}
.item .co{color:var(--muted);font-size:11px;font-family:Consolas,monospace}
</style>
</head>
<body>

<div id="tabs">
  <span class="title">Sprite16</span>
  <button class="tab on" data-view="edit">Sprite szerkesztő</button>
  <button class="tab" data-view="scene">Képernyő</button>
  <span class="grow"></span>
  <button class="proj" id="bProjSave" title="Az összes sprite + a képernyő egy fájlban">Projekt mentése</button>
  <button class="proj" id="bProjLoad">Projekt megnyitása</button>
  <input type="file" id="fProj" accept=".json" hidden>
</div>

<!-- ================= SPRITE SZERKESZTŐ ================= -->
<div class="view on" id="view-edit">
  <div class="side">
    <h3>Eszközök</h3>
    <div class="tools" id="tools">
      <button data-t="pen">Pont <kbd>P</kbd></button>
      <button data-t="fill">Festés <kbd>F</kbd></button>
      <button data-t="line">Vonal <kbd>L</kbd></button>
      <button data-t="rect">Téglalap <kbd>R</kbd></button>
      <button data-t="circle">Kör/ellipszis <kbd>C</kbd></button>
      <button data-t="pick">Színválasztó <kbd>I</kbd></button>
      <button data-t="spray">Spray <kbd>S</kbd></button>
      <button data-t="select">Kijelölés <kbd>M</kbd></button>
    </div>
    <div class="row"><label><input type="checkbox" id="filled"> Kitöltött alakzat</label></div>
    <div class="muted">Shift: vonal 45°, téglalap/kör a képernyőn négyzet/kör arányú.</div>
    <div class="row">Spray: sugár <input type="number" id="spR" min="1" max="40" value="6" style="width:46px" title="sorban (a képernyőn kör alakú)"> sűrűség <input type="number" id="spD" min="1" max="50" value="6" style="width:46px" title="pont / tick"></div>

    <h3>Paletta</h3>
    <div class="pal" id="pal"></div>
    <div class="cur">
      <div><i id="curL"></i>Bal gomb</div>
      <div><i id="curR"></i>Jobb gomb</div>
    </div>
    <div class="muted" style="margin-top:4px">Bal katt = bal szín, jobb katt (vagy Ctrl) = jobb szín. X: a két szín csere.</div>

    <h3>Háttér</h3>
    <div class="row"><label><input type="radio" name="mask" value="1" checked> Maszkolt (átlátszó)</label></div>
    <div class="row"><label><input type="radio" name="mask" value="0"> Nem maszkolt</label></div>

    <h3>Méret (pixel)</h3>
    <div class="row">Szél. <input type="number" id="inW" min="2" max="128" step="2"> Mag. <input type="number" id="inH" min="1" max="240"></div>
    <div class="row"><button id="bResize">Átméretez</button><span class="muted">szélesség páros (2 pixel = 1 byte), max 128x240</span></div>

    <h3>Műveletek</h3>
    <div class="row">
      <button id="bUndo" title="Ctrl+Z">Vissza</button>
      <button id="bRedo" title="Ctrl+Y">Előre</button>
      <button id="bClear">Törlés</button>
    </div>
    <div class="row">
      <button id="bMirH">Tükör ↔</button>
      <button id="bMirV">Tükör ↕</button>
    </div>
    <div class="row">
      Eltolás:
      <button data-sh="-1,0">←</button><button data-sh="1,0">→</button>
      <button data-sh="0,-1">↑</button><button data-sh="0,1">↓</button>
    </div>

    <h3>Kijelölés</h3>
    <div class="row">
      <button id="bCopySel" title="Ctrl+C">Másolás</button>
      <button id="bCutSel" title="Ctrl+X">Kivágás</button>
      <button id="bPasteSel" title="Ctrl+V">Beillesztés</button>
    </div>
    <div class="row">
      <button id="bDelSel" title="Delete">Törlés</button>
      <button id="bAllSel" title="Ctrl+A">Mind</button>
      <button id="bSelNew">Új sprite belőle</button>
    </div>
    <div class="row"><label><input type="checkbox" id="pasteTr" checked> átlátszó pixel nem ír felül</label></div>
    <div class="muted">Kijelölés eszköz: húzással jelölsz; a kijelölésbe kattintva elmozdíthatod. Beillesztés után húzd a helyére, Enter / kattintás mellé = lerakás, Esc = mégse. Nyilak: 1 pixel. A vágólap sprite-ok között is működik.</div>

    <h3>Cartoon effekt</h3>
    <div class="row">Háttér <select id="ctBg" title="ami nem része a rajznak"></select></div>
    <div class="row">Kontúr <select id="ctOut"></select></div>
    <div class="row"><label><input type="checkbox" id="ctDiag" checked> átlósan is (vastagabb sarok)</label></div>
    <div class="row"><label><input type="checkbox" id="ctIso" checked> magányos pixelek törlése</label></div>
    <div class="row"><label><input type="checkbox" id="ctShad" checked> árnyék jobbra-lent</label> <select id="ctShC"></select></div>
    <div class="row"><button id="bCartoon">Cartoon alkalmazása</button></div>
    <div class="muted">A kontúr a rajz köré, a háttér-pixelekre kerül (a sprite széléig). Visszavonható.</div>
  </div>

  <div class="main">
    <div class="top">
      <label>Név <input type="text" id="inName" style="width:130px"></label>
      <button id="bSave">Mentés .bin</button>
      <button id="bLoad" title="Egy vagy több .bin, mindegyik új sprite lesz">Betöltés .bin</button>
      <div class="sep"></div>
      <button id="bImport">Kép importálása</button>
      <label><input type="checkbox" id="impSize"> a kép méretével</label>
      <button id="bPng">PNG mentés (1:1)</button>
      <div class="sep"></div>
      Nagyítás <select id="zoom"></select>
      <label><input type="checkbox" id="grid" checked> Rács <kbd class="muted">G</kbd></label>
      <input type="file" id="fBin" accept=".bin" multiple hidden>
      <input type="file" id="fImg" accept="image/*,.bmp" hidden>
    </div>
    <div class="work">
      <div class="canvasWrap"><canvas id="cv"></canvas></div>
      <div class="right">
        <h3>Sprite-ok</h3>
        <div class="list" id="spList"></div>
        <div class="row">
          <button id="bNew">Új</button>
          <button id="bDup">Másolat</button>
          <button id="bDel">Törlés</button>
          <button id="bUp" title="Feljebb">▲</button>
          <button id="bDown" title="Lejjebb">▼</button>
        </div>

        <h3>Előnézet (TVC arány)</h3>
        <div class="row">
          Méret <select id="pvScale"><option value="1">1x</option><option value="2" selected>2x</option><option value="3">3x</option></select>
          Háttér <select id="pvBg"></select>
        </div>
        <div id="pvWrap"><canvas id="pv"></canvas></div>

        <h3>Fájl</h3>
        <div id="info" class="muted"></div>
        <h3>TRSE használat</h3>
        <pre id="snippet"></pre>
        <h3>Formátum</h3>
        <div class="muted">
          Fejléc 3 byte: típus (1 = nem maszkolt, 2 = maszkolt), szélesség byte-ban (pixel/2), magasság sorban.
          Utána soronként: nem maszkolt = 1 adat-byte / 2 pixel; maszkolt = bytepár (MASZK, ADAT). Több fázis = egymás után.
          Egy byte: bal pixel = 7,5,3,1. bit, jobb pixel = 6,4,2,0. bit (I,G,R,B). Színindex = I*8 + G*4 + R*2 + B.
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ================= KÉPERNYŐ (JELENET) ================= -->
<div class="view" id="view-scene">
  <div class="side">
    <h3>Lerakás</h3>
    <div class="muted">Válassz egy sprite-ot, majd kattints a képernyőre (több is lerakható). Esc / jobb katt: kilépés a lerakásból.</div>
    <div class="list" id="scList" style="margin-top:6px;max-height:420px"></div>

    <h3>Képernyő</h3>
    <div class="row">Border <select id="scBorder"></select></div>
    <div class="row">Háttér <select id="scBg"></select></div>
    <div class="row">Nagyítás <select id="scZoom"><option value="1">1x</option><option value="2">2x</option><option value="3">3x</option><option value="4">4x</option></select></div>
    <div class="row"><label><input type="checkbox" id="scGrid"> Rács (8 byte / 16 sor)</label></div>
    <div class="muted">128x240 pixel = 64 byte x 240 sor. A sprite X koordinátája byte-ban (1 byte = 2 pixel), Y sorban - ahogy a GE::Sprite.X / .Y.</div>
  </div>

  <div class="main">
    <div class="work">
      <div class="canvasWrap"><canvas id="sc"></canvas></div>
      <div class="right">
        <h3>Lerakott sprite-ok</h3>
        <div class="list" id="itList"></div>
        <div class="row">
          <button id="iUp" title="Előrébb (fölé)">Előre ▲</button>
          <button id="iDown" title="Hátrébb (alá)">Hátra ▼</button>
          <button id="iDup">Másolat</button>
          <button id="iDel">Törlés</button>
        </div>
        <div class="row" id="iEdit">X (byte) <input type="number" id="iX" min="0" max="63"> Y <input type="number" id="iY" min="0" max="239"></div>
        <div class="muted">Kijelölt: nyilak = 1 byte / 1 sor, Shift+nyíl = 4 byte / 8 sor, Delete = törlés. Húzással mozgatható.</div>

        <h3>Koordináták (TRSE)</h3>
        <div class="row"><button id="bCopy">Másolás vágólapra</button></div>
        <pre id="coords"></pre>
      </div>
    </div>
  </div>
</div>

<div id="status">&nbsp;</div>

<script>
"use strict";
/* ================= Közös: paletta, kódolás ================= */
const NAMES=["Fekete","Sötétkék","Sötétvörös","Sötétbíbor","Sötétzöld","Sötétcián","Sötétsárga","Szürke",
             "Fekete 2","Kék","Vörös","Bíbor","Zöld","Cián","Sárga","Fehér"];
const PAL=[];
for(let i=0;i<16;i++){const B=i&1,R=(i>>1)&1,G=(i>>2)&1,I=(i>>3)&1,v=I?255:128;PAL.push([R*v,G*v,B*v]);}
const TR=-1;
const CHK=[[43,43,58],[61,61,82]];
const css=c=>c<0?"transparent":`rgb(${PAL[c].join(",")})`;
const $=id=>document.getElementById(id);
const HEX="0123456789abcdef";
const encStr=p=>Array.from(p,c=>c<0?".":HEX[c]).join("");
const decStr=s=>Int8Array.from(s,ch=>ch==="."?TR:parseInt(ch,16));

function encPix(c,left){const B=c&1,R=(c>>1)&1,G=(c>>2)&1,I=(c>>3)&1;
  return left?(B<<1)|(R<<3)|(G<<5)|(I<<7):B|(R<<2)|(G<<4)|(I<<6);}
function decPix(b,left){if(left)b>>=1;return (b&1)|((b>>2)&1)<<1|((b>>4)&1)<<2|((b>>6)&1)<<3;}
function buildBin(s){
  const bw=s.W/2,out=[s.masked?2:1,bw,s.H];
  for(const f of s.frames)for(let y=0;y<s.H;y++)for(let bx=0;bx<bw;bx++){
    const a=f[y*s.W+bx*2],b=f[y*s.W+bx*2+1];let m=0,d=0;
    if(a<0)m|=0xAA;else d|=encPix(a,true);
    if(b<0)m|=0x55;else d|=encPix(b,false);
    if(s.masked)out.push(m,d);else out.push(d);
  }
  return new Uint8Array(out);
}
function parseBin(u){
  if(u.length<3)throw "Túl rövid fájl.";
  const t=u[0],bw=u[1],h=u[2];
  if((t!==1&&t!==2)||bw<1||bw>64||h<1||h>240)throw "Nem Bery-féle sprite fejléc ("+[t,bw,h].join(",")+").";
  const per=bw*h*(t===2?2:1);
  if(u.length<3+per)throw "A fájl rövidebb, mint a fejléc szerinti méret.";
  const n=Math.floor((u.length-3)/per),w=bw*2,frames=[];let k=3;
  for(let fi=0;fi<n;fi++){const p=new Int8Array(w*h);
    for(let y=0;y<h;y++)for(let bx=0;bx<bw;bx++){
      let m=0,d;if(t===2){m=u[k++];d=u[k++];}else d=u[k++];
      p[y*w+bx*2]  =(m&0xAA)===0xAA?TR:decPix(d,true);
      p[y*w+bx*2+1]=(m&0x55)===0x55?TR:decPix(d,false);
    }
    frames.push(p);}
  return {W:w,H:h,masked:t===2,frames};
}
function download(name,blob){const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},500);}
const safeName=n=>(String(n||"").trim()||"sprite").replace(/[^A-Za-z0-9_]/g,"_");
const capName=n=>{n=safeName(n);return n.charAt(0).toUpperCase()+n.slice(1);};

/* ================= Projekt-állapot ================= */
// sprite: {id,name,W,H,masked,frames:[Int8Array],cf,undo:[],redo:[]}  (frames: előkészítés az animátorhoz)
// scene item: {sid,x (byte),y (sor)}
let nextId=1;
function newSprite(name,W,H,masked,frames){return {id:nextId++,name,W,H,masked,frames:frames||[new Int8Array(W*H).fill(masked?TR:0)],cf:0,undo:[],redo:[]};}
const P={sprites:[],cur:0,scene:{border:7,bg:0,zoom:2,grid:false,items:[],sel:-1,place:-1}};
let colL=15,colR=TR,tool="pen",zoom=16,view="edit";

const sp=()=>P.sprites[P.cur];
const px=()=>sp().frames[sp().cf];
const byId=id=>P.sprites.find(s=>s.id===id);

/* ================= Miniatűr ================= */
function thumb(s,mw,mh,bg){
  const f=s.frames[0],sc=Math.max(1,Math.min(Math.floor(mw/(s.W*2)),Math.floor(mh/s.H)))||1;
  const t=document.createElement("canvas");t.width=s.W;t.height=s.H;
  const x=t.getContext("2d"),img=x.createImageData(s.W,s.H),a=img.data;
  for(let i=0;i<s.W*s.H;i++){const c=f[i];const rgb=PAL[c<0?(s.masked?bg:0):c];a[i*4]=rgb[0];a[i*4+1]=rgb[1];a[i*4+2]=rgb[2];a[i*4+3]=255;}
  x.putImageData(img,0,0);
  const o=document.createElement("canvas");
  let w=s.W*2*sc,h=s.H*sc;const k=Math.min(1,mw/w,mh/h);w=Math.max(1,Math.round(w*k));h=Math.max(1,Math.round(h*k));
  o.width=w;o.height=h;const oc=o.getContext("2d");oc.imageSmoothingEnabled=false;oc.drawImage(t,0,0,w,h);
  return o;
}
function spriteRow(s,cls,extra){
  const d=document.createElement("div");d.className="item "+cls;
  const th=document.createElement("div");th.className="th";th.appendChild(thumb(s,56,34,0));d.appendChild(th);
  const nm=document.createElement("div");nm.className="nm";
  nm.innerHTML=`${safeName(s.name)}<div class="sz">${s.W}x${s.H} px${s.masked?", maszkolt":""}${s.frames.length>1?", "+s.frames.length+" fázis":""}${extra||""}</div>`;
  d.appendChild(nm);return d;
}

/* ================= SPRITE SZERKESZTŐ ================= */
const cv=$("cv"),ctx=cv.getContext("2d");
const base=document.createElement("canvas"),bctx=base.getContext("2d");
const pv=$("pv"),pctx=pv.getContext("2d");

function draw(d){
  const s=sp();d=d||px();const W=s.W,H=s.H;
  if(flt&&flt.sid===s.id){d=d.slice();stamp(d,flt);}
  if(base.width!==W||base.height!==H){base.width=W;base.height=H;}
  const img=bctx.createImageData(W,H),a=img.data;
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){const i=y*W+x,c=d[i];
    const rgb=c<0?(s.masked?CHK[(x+y)&1]:PAL[0]):PAL[c];a[i*4]=rgb[0];a[i*4+1]=rgb[1];a[i*4+2]=rgb[2];a[i*4+3]=255;}
  bctx.putImageData(img,0,0);
  const cw=W*2*zoom,ch=H*zoom;
  if(cv.width!==cw||cv.height!==ch){cv.width=cw;cv.height=ch;}
  ctx.imageSmoothingEnabled=false;ctx.drawImage(base,0,0,cw,ch);
  if($("grid").checked&&zoom>=4){
    ctx.lineWidth=1;
    for(let x=1;x<W;x++){ctx.strokeStyle=(x%2===0)?"rgba(255,255,255,.28)":"rgba(255,255,255,.08)";
      ctx.beginPath();ctx.moveTo(x*2*zoom+.5,0);ctx.lineTo(x*2*zoom+.5,ch);ctx.stroke();}
    for(let y=1;y<H;y++){ctx.strokeStyle=(y%8===0)?"rgba(255,255,255,.22)":"rgba(255,255,255,.08)";
      ctx.beginPath();ctx.moveTo(0,y*zoom+.5);ctx.lineTo(cw,y*zoom+.5);ctx.stroke();}
  }
  const r=flt&&flt.sid===s.id?{x:flt.x,y:flt.y,w:flt.w,h:flt.h}:(sel&&sel.sid===s.id?selRect():null);
  if(r){ctx.save();ctx.lineWidth=2;
    for(const [col,off] of [["#000",0],[flt?"#e0b040":"#fff",4]]){ctx.strokeStyle=col;ctx.setLineDash([4,4]);ctx.lineDashOffset=off;
      ctx.strokeRect(r.x*2*zoom+1,r.y*zoom+1,r.w*2*zoom-2,r.h*zoom-2);}
    ctx.restore();}
  // előnézet
  const scl=+$("pvScale").value,bg=+$("pvBg").value,w=W*2*scl,h=H*scl;
  if(pv.width!==w||pv.height!==h){pv.width=w;pv.height=h;}
  const im2=pctx.createImageData(W,H),b=im2.data;
  for(let i=0;i<W*H;i++){const c=d[i];const rgb=PAL[c<0?(s.masked?bg:0):c];b[i*4]=rgb[0];b[i*4+1]=rgb[1];b[i*4+2]=rgb[2];b[i*4+3]=255;}
  const t=document.createElement("canvas");t.width=W;t.height=H;t.getContext("2d").putImageData(im2,0,0);
  pctx.imageSmoothingEnabled=false;pctx.drawImage(t,0,0,w,h);
}
function buildPalette(){
  const s=sp(),el=$("pal");el.innerHTML="";
  for(const c of [...Array(16).keys(),TR]){
    const d=document.createElement("div");
    d.className="sw"+(c<0?" tr":"")+(c<0&&!s.masked?" dis":"");
    if(c>=0)d.style.background=css(c);
    d.title=c<0?"Átlátszó (csak maszkolt)":`${c}: ${NAMES[c]}`;
    if(c===colL)d.innerHTML+='<b class="l">L</b>';
    if(c===colR)d.innerHTML+='<b class="r">R</b>';
    d.onmousedown=e=>{e.preventDefault();if(c<0&&!s.masked)return;if(e.button===2||e.ctrlKey)colR=c;else colL=c;uiRefresh();};
    d.oncontextmenu=e=>e.preventDefault();
    el.appendChild(d);
  }
  for(const [id,c] of [["curL",colL],["curR",colR]]){const i=$(id);i.className=c<0?"tr":"";i.style.background=c<0?"":css(c);i.title=c<0?"Átlátszó":NAMES[c];}
}
function buildSpriteList(){
  const el=$("spList");el.innerHTML="";
  P.sprites.forEach((s,i)=>{const d=spriteRow(s,i===P.cur?"on":"");d.onclick=()=>{P.cur=i;uiRefresh();};el.appendChild(d);});
  $("bDel").disabled=P.sprites.length<2;$("bUp").disabled=P.cur===0;$("bDown").disabled=P.cur===P.sprites.length-1;
}
function uiRefresh(){
  if(flt&&flt.sid!==sp().id)commitFloat();if(sel&&sel.sid!==sp().id)sel=null;
  const s=sp();
  if(!s.masked){if(colL<0)colL=0;if(colR<0)colR=0;}
  buildPalette();buildSpriteList();if(typeof ctDefault==="function")ctDefault();
  document.querySelectorAll("#tools button").forEach(b=>b.classList.toggle("on",b.dataset.t===tool));
  $("inW").value=s.W;$("inH").value=s.H;
  if(document.activeElement!==$("inName"))$("inName").value=s.name;
  document.querySelector(`input[name=mask][value="${s.masked?1:0}"]`).checked=true;
  $("bUndo").disabled=!s.undo.length;$("bRedo").disabled=!s.redo.length;
  const nm=safeName(s.name),Cap=capName(s.name),size=3+s.W/2*s.H*(s.masked?2:1)*s.frames.length;
  let tr=0;for(const f of s.frames)for(const c of f)if(c<0)tr++;
  $("info").innerHTML=`${s.W}x${s.H} pixel = ${s.W/2} byte x ${s.H} sor${s.frames.length>1?", "+s.frames.length+" fázis":""}<br>${s.masked?"Maszkolt (típus 2)":"Nem maszkolt (típus 1)"}<br>Fájlméret: ${size} byte`+
    (!s.masked&&tr?`<br><span style="color:#fc6">${tr} átlátszó pixel feketeként mentődik.</span>`:"");
  $("snippet").textContent=
`${Cap}_Data : incbin("resources\\tvc_sprites\\${nm}.bin");
${Cap} : GE::Sprite;

GE::SetGraphics(GE::GRAPHICS16);
${Cap}.Init(#${Cap}_Data, X, Y, ${s.masked?"True":"False"});
${s.masked?`// maszkolt: Draw (háttérpufferrel)
${Cap}.SetPosition();
${Cap}.SaveBackground();
${Cap}.Draw();`:`// nem maszkolt: Put (bélyegző)
${Cap}.SetPosition();
${Cap}.Put();`}`;
  clampItems();
  draw();
  if(view==="scene")sceneRefresh();
  save();
}

/* ---- visszavonás (sprite-onként, minden fázist ment) ---- */
function snap(s){return {W:s.W,H:s.H,frames:s.frames.map(f=>f.slice())};}
function pushUndoRaw(){const s=sp();s.undo.push(snap(s));if(s.undo.length>100)s.undo.shift();s.redo=[];}
function pushUndo(){commitFloat();pushUndoRaw();}   // minden módosítás előtt a lebegő beillesztés lerakódik
function doUndo(){const s=sp();if(flt){flt=null;}if(!s.undo.length)return;s.redo.push(snap(s));Object.assign(s,s.undo.pop());if(s.cf>=s.frames.length)s.cf=0;uiRefresh();}
function doRedo(){const s=sp();if(!s.redo.length)return;s.undo.push(snap(s));Object.assign(s,s.redo.pop());if(s.cf>=s.frames.length)s.cf=0;uiRefresh();}

/* ---- rajzoló primitívek ---- */
function plot(d,x,y,c){const s=sp();if(x>=0&&y>=0&&x<s.W&&y<s.H)d[y*s.W+x]=c;}
function line(d,x0,y0,x1,y1,c){let dx=Math.abs(x1-x0),dy=-Math.abs(y1-y0),sx=x0<x1?1:-1,sy=y0<y1?1:-1,e=dx+dy;
  for(;;){plot(d,x0,y0,c);if(x0===x1&&y0===y1)break;const e2=2*e;if(e2>=dy){e+=dy;x0+=sx;}if(e2<=dx){e+=dx;y0+=sy;}}}
function rect(d,x0,y0,x1,y1,c,fill){const ax=Math.min(x0,x1),bx=Math.max(x0,x1),ay=Math.min(y0,y1),by=Math.max(y0,y1);
  for(let y=ay;y<=by;y++)for(let x=ax;x<=bx;x++)if(fill||x===ax||x===bx||y===ay||y===by)plot(d,x,y,c);}
function ellipse(d,x0,y0,x1,y1,c,fill){const ax=Math.min(x0,x1),bx=Math.max(x0,x1),ay=Math.min(y0,y1),by=Math.max(y0,y1);
  const cx=(ax+bx)/2,cy=(ay+by)/2,rx=(bx-ax)/2+.5,ry=(by-ay)/2+.5;
  const ins=(x,y)=>{const u=(x-cx)/rx,v=(y-cy)/ry;return u*u+v*v<=1.0001;};
  for(let y=ay;y<=by;y++)for(let x=ax;x<=bx;x++){if(!ins(x,y))continue;
    if(fill||!ins(x-1,y)||!ins(x+1,y)||!ins(x,y-1)||!ins(x,y+1))plot(d,x,y,c);}}
function flood(x,y,c){const s=sp(),p=px(),t=p[y*s.W+x];if(t===c)return;const st=[[x,y]];
  while(st.length){const [a,b]=st.pop();if(a<0||b<0||a>=s.W||b>=s.H||p[b*s.W+a]!==t)continue;p[b*s.W+a]=c;st.push([a+1,b],[a-1,b],[a,b+1],[a,b-1]);}}
function constrain(s,p){let dx=p.x-s.x,dy=p.y-s.y;
  if(tool==="line"){const vx=Math.abs(dx)*2,vy=Math.abs(dy);
    if(vy<vx/2)dy=0;else if(vx<vy/2)dx=0;else{const m=Math.max(vx,vy);dx=Math.sign(dx)*Math.round(m/2);dy=Math.sign(dy)*m;}}
  else{const m=Math.max(Math.abs(dx)*2,Math.abs(dy));dx=(Math.sign(dx)||1)*Math.round(m/2);dy=(Math.sign(dy)||1)*m;}
  return {x:s.x+dx,y:s.y+dy};}
function shape(d,s,p,c){const f=$("filled").checked;
  if(tool==="line")line(d,s.x,s.y,p.x,p.y,c);else if(tool==="rect")rect(d,s.x,s.y,p.x,p.y,c,f);else if(tool==="circle")ellipse(d,s.x,s.y,p.x,p.y,c,f);}

/* ---- egér a szerkesztőben ---- */
let drag=null;
function cell(e){const r=cv.getBoundingClientRect();return {x:Math.floor((e.clientX-r.left)/(2*zoom)),y:Math.floor((e.clientY-r.top)/zoom)};}
cv.addEventListener("contextmenu",e=>e.preventDefault());
cv.addEventListener("pointerdown",e=>{
  e.preventDefault();const s=sp(),p=cell(e),right=e.button===2||e.ctrlKey,c=right?colR:colL;
  if(p.x<0||p.y<0||p.x>=s.W||p.y>=s.H)return;
  if(tool==="pick"){const v=px()[p.y*s.W+p.x];if(right)colR=v;else colL=v;uiRefresh();return;}
  if(tool==="select"){selDown(e,p,right);return;}
  pushUndo();
  if(tool==="fill"){flood(p.x,p.y,c);uiRefresh();return;}
  cv.setPointerCapture(e.pointerId);drag={s:p,last:p,c};
  if(tool==="spray"){sprayAt(p,c);draw();drag.timer=setInterval(()=>{if(drag){sprayAt(drag.last,drag.c);draw();}},40);return;}
  if(tool==="pen"){plot(px(),p.x,p.y,c);draw();}else{const t=px().slice();shape(t,p,p,c);draw(t);}
});
function sprayAt(p,c){ // a képernyőn kör alakú folt: vízszintesen fele annyi pixel (1 pixel = 2 egység széles)
  const r=Math.max(1,+$("spR").value||1),n=Math.max(1,+$("spD").value||1);
  for(let k=0;k<n;k++){const a=Math.random()*Math.PI*2,d=r*Math.sqrt(Math.random());
    plot(px(),p.x+Math.round(d*Math.cos(a)/2),p.y+Math.round(d*Math.sin(a)),c);}
}
function cartoon(){
  const s=sp(),W=s.W,H=s.H,src=px(),bg=+$("ctBg").value,out=+$("ctOut").value;
  const isBg=c=>c===bg;
  const inS=(x,y)=>x>=0&&y>=0&&x<W&&y<H;
  const filled=(d,x,y)=>inS(x,y)&&!isBg(d[y*W+x]);
  let d=src.slice();
  if($("ctIso").checked){const t=d.slice();
    for(let y=0;y<H;y++)for(let x=0;x<W;x++)if(filled(d,x,y)&&!filled(d,x-1,y)&&!filled(d,x+1,y)&&!filled(d,x,y-1)&&!filled(d,x,y+1))t[y*W+x]=bg;
    d=t;}
  if($("ctShad").checked){const t=d.slice(),sc=+$("ctShC").value;
    for(let y=0;y<H;y++)for(let x=0;x<W;x++){if(!filled(d,x,y))continue;
      if(!filled(d,x+1,y)||!filled(d,x,y+1)){const c=d[y*W+x];t[y*W+x]=sc<0?(c>=8?c-8:c):sc;}}
    d=t;}
  const t=d.slice(),diag=$("ctDiag").checked;
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){if(filled(d,x,y))continue;
    let e=filled(d,x-1,y)||filled(d,x+1,y)||filled(d,x,y-1)||filled(d,x,y+1);
    if(!e&&diag)e=filled(d,x-1,y-1)||filled(d,x+1,y-1)||filled(d,x-1,y+1)||filled(d,x+1,y+1);
    if(e)t[y*W+x]=out;}
  pushUndo();s.frames[s.cf]=t;uiRefresh();
}
/* ---- kijelölés, vágólap, lebegő beillesztés ---- */
let sel=null,flt=null,clip=null,lastCell=null;   // sel:{sid,x0,y0,x1,y1}  flt:{sid,x,y,w,h,data}  clip:{w,h,data}
function selRect(){const x=Math.min(sel.x0,sel.x1),y=Math.min(sel.y0,sel.y1);return {x,y,w:Math.abs(sel.x1-sel.x0)+1,h:Math.abs(sel.y1-sel.y0)+1};}
const inRect=(p,r)=>p.x>=r.x&&p.y>=r.y&&p.x<r.x+r.w&&p.y<r.y+r.h;
const bgCol=()=>sp().masked?TR:0;
function stamp(d,f){const s=byId(f.sid)||sp(),tr=$("pasteTr").checked;
  for(let y=0;y<f.h;y++)for(let x=0;x<f.w;x++){const tx=f.x+x,ty=f.y+y;if(tx<0||ty<0||tx>=s.W||ty>=s.H)continue;
    let c=f.data[y*f.w+x];if(c<0){if(tr)continue;if(!s.masked)c=0;}d[ty*s.W+tx]=c;}}
function commitFloat(){if(!flt)return;const f=flt,s=byId(f.sid);flt=null;if(!s)return;
  stamp(s.frames[s.cf],f);
  const x0=Math.max(0,f.x),y0=Math.max(0,f.y),x1=Math.min(s.W-1,f.x+f.w-1),y1=Math.min(s.H-1,f.y+f.h-1);
  sel=(x0<=x1&&y0<=y1)?{sid:s.id,x0,y0,x1,y1}:null;}
function grab(){const s=sp(),r=selRect(),p=px(),d=new Int8Array(r.w*r.h);
  for(let y=0;y<r.h;y++)for(let x=0;x<r.w;x++)d[y*r.w+x]=p[(r.y+y)*s.W+r.x+x];return {w:r.w,h:r.h,data:d};}
function clearRect(r){const s=sp(),p=px(),b=bgCol();for(let y=r.y;y<r.y+r.h;y++)for(let x=r.x;x<r.x+r.w;x++)p[y*s.W+x]=b;}
function lift(){pushUndoRaw();const r=selRect(),g=grab();clearRect(r);flt={sid:sp().id,x:r.x,y:r.y,w:g.w,h:g.h,data:g.data};sel=null;}
function selDown(e,p,right){
  if(right){commitFloat();sel=null;uiRefresh();return;}
  cv.setPointerCapture(e.pointerId);
  if(flt&&inRect(p,flt)){drag={sel:"move",ox:p.x-flt.x,oy:p.y-flt.y};return;}
  if(flt)commitFloat();
  if(sel&&sel.sid===sp().id&&inRect(p,selRect())){const r=selRect();lift();drag={sel:"move",ox:p.x-r.x,oy:p.y-r.y};draw();return;}
  sel={sid:sp().id,x0:p.x,y0:p.y,x1:p.x,y1:p.y};drag={sel:"new"};draw();
}
function selMove(p){const s=sp();
  if(drag.sel==="new"){sel.x1=Math.max(0,Math.min(s.W-1,p.x));sel.y1=Math.max(0,Math.min(s.H-1,p.y));}
  else if(flt){flt.x=p.x-drag.ox;flt.y=p.y-drag.oy;}
  draw();}
function copySel(){if(flt){clip={w:flt.w,h:flt.h,data:flt.data.slice()};return;}if(sel&&sel.sid===sp().id)clip=grab();}
function cutSel(){if(flt){copySel();flt=null;uiRefresh();return;}if(!sel||sel.sid!==sp().id)return;copySel();pushUndo();clearRect(selRect());uiRefresh();}
function pasteSel(){if(!clip)return;commitFloat();pushUndoRaw();const s=sp();let x=0,y=0;
  if(sel&&sel.sid===s.id){const r=selRect();x=r.x;y=r.y;}else if(lastCell&&lastCell.x>=0&&lastCell.y>=0&&lastCell.x<s.W&&lastCell.y<s.H){x=lastCell.x;y=lastCell.y;}
  flt={sid:s.id,x,y,w:clip.w,h:clip.h,data:clip.data.slice()};sel=null;tool="select";uiRefresh();}
function delSel(){if(flt){flt=null;uiRefresh();return;}if(!sel||sel.sid!==sp().id)return;pushUndo();clearRect(selRect());uiRefresh();}
function allSel(){commitFloat();const s=sp();sel={sid:s.id,x0:0,y0:0,x1:s.W-1,y1:s.H-1};tool="select";uiRefresh();}
function cancelFloat(){if(flt)doUndo();}
function selToNew(){const s=sp();let g=null;if(flt)g={w:flt.w,h:flt.h,data:flt.data};else if(sel&&sel.sid===s.id)g=grab();if(!g)return;
  commitFloat();const w=Math.max(2,g.w+(g.w%2)),n=newSprite(uniqueName(s.name+"_r"),w,g.h,s.masked);
  for(let y=0;y<g.h;y++)for(let x=0;x<g.w;x++){let c=g.data[y*g.w+x];if(c<0&&!s.masked)c=0;n.frames[0][y*w+x]=c;}
  P.sprites.splice(P.cur+1,0,n);P.cur++;sel=null;uiRefresh();}
function nudge(dx,dy){if(!flt){if(!sel||sel.sid!==sp().id)return;lift();}flt.x+=dx;flt.y+=dy;draw();}
$("bCopySel").onclick=copySel;$("bCutSel").onclick=cutSel;$("bPasteSel").onclick=pasteSel;
$("bDelSel").onclick=delSel;$("bAllSel").onclick=allSel;$("bSelNew").onclick=selToNew;
$("pasteTr").onchange=()=>draw();

cv.addEventListener("pointermove",e=>{
  const s=sp(),p=cell(e);
  if(p.x>=0&&p.y>=0&&p.x<s.W&&p.y<s.H){const c=px()[p.y*s.W+p.x];
    $("status").textContent=`X: ${p.x}  Y: ${p.y}   byte-oszlop: ${p.x>>1} (${p.x&1?"jobb":"bal"} pixel)   szín: ${c<0?"átlátszó":c+" "+NAMES[c]}`;}
  lastCell=p;
  if(tool==="select"&&!drag&&p.x>=0&&p.y>=0&&p.x<s.W&&p.y<s.H){const r=flt?flt:(sel?selRect():null);
    if(r)$("status").textContent+=`   ${flt?"beillesztés":"kijelölés"}: ${r.x},${r.y}  ${r.w}x${r.h}`;}
  if(!drag)return;
  if(drag.sel){selMove(p);return;}
  if(tool==="spray"){drag.last=p;return;}
  if(tool==="pen"){line(px(),drag.last.x,drag.last.y,p.x,p.y,drag.c);drag.last=p;draw();}
  else{const q=e.shiftKey?constrain(drag.s,p):p;const t=px().slice();shape(t,drag.s,q,drag.c);draw(t);}
});
cv.addEventListener("pointerup",e=>{if(!drag)return;
  if(drag.sel){drag=null;uiRefresh();return;}
  if(drag.timer)clearInterval(drag.timer);
  if(tool!=="pen"&&tool!=="spray"){const p=cell(e),q=e.shiftKey?constrain(drag.s,p):p;shape(px(),drag.s,q,drag.c);}
  drag=null;uiRefresh();});
$("bCartoon").onclick=cartoon;

/* ---- műveletek ---- */
function resize(nw,nh){const s=sp();
  nw=Math.max(2,Math.min(128,nw|0));if(nw%2)nw++;nh=Math.max(1,Math.min(240,nh|0));
  if(nw===s.W&&nh===s.H)return;pushUndo();
  s.frames=s.frames.map(f=>{const n=new Int8Array(nw*nh).fill(s.masked?TR:0);
    for(let y=0;y<Math.min(s.H,nh);y++)for(let x=0;x<Math.min(s.W,nw);x++)n[y*nw+x]=f[y*s.W+x];return n;});
  s.W=nw;s.H=nh;uiRefresh();}
function transform(fn){const s=sp();pushUndo();const p=px(),n=new Int8Array(s.W*s.H);
  for(let y=0;y<s.H;y++)for(let x=0;x<s.W;x++){const [a,b]=fn(x,y);n[y*s.W+x]=p[b*s.W+a];}s.frames[s.cf]=n;uiRefresh();}
$("bResize").onclick=()=>resize(+$("inW").value,+$("inH").value);
$("bUndo").onclick=doUndo;$("bRedo").onclick=doRedo;
$("bClear").onclick=()=>{pushUndo();px().fill(sp().masked?TR:0);uiRefresh();};
$("bMirH").onclick=()=>transform((x,y)=>[sp().W-1-x,y]);
$("bMirV").onclick=()=>transform((x,y)=>[x,sp().H-1-y]);
document.querySelectorAll("[data-sh]").forEach(b=>b.onclick=()=>{const [dx,dy]=b.dataset.sh.split(",").map(Number),s=sp();
  transform((x,y)=>[(x-dx+s.W)%s.W,(y-dy+s.H)%s.H]);});
document.querySelectorAll("#tools button").forEach(b=>b.onclick=()=>{setTool(b.dataset.t);});
function setTool(t){if(t!=="select")commitFloat();tool=t;uiRefresh();}
document.querySelectorAll("input[name=mask]").forEach(r=>r.onchange=()=>{sp().masked=r.value==="1";uiRefresh();});
$("grid").onchange=()=>draw();
$("pvScale").onchange=$("pvBg").onchange=()=>draw();
$("inName").oninput=()=>{sp().name=$("inName").value;uiRefresh();};
for(const z of [2,4,6,8,10,12,16,20,24,32]){const o=document.createElement("option");o.value=z;o.textContent=z+"x";$("zoom").appendChild(o);}
$("zoom").onchange=()=>{zoom=+$("zoom").value;draw();save();};
for(const id of ["pvBg","scBorder","scBg"])for(let i=0;i<16;i++){const o=document.createElement("option");o.value=i;o.textContent=i+" "+NAMES[i];$(id).appendChild(o);}
$("pvBg").value=7;
function addOpt(id,v,t){const o=document.createElement("option");o.value=v;o.textContent=t;$(id).appendChild(o);}
addOpt("ctBg",TR,"Átlátszó");addOpt("ctShC",TR,"sötétebb árnyalat");
for(let i=0;i<16;i++)for(const id of ["ctBg","ctOut","ctShC"])addOpt(id,i,i+" "+NAMES[i]);
$("ctOut").value=0;$("ctShC").value=TR;
let ctKey="";   // a cartoon háttér alapértéke kövesse a kijelölt sprite maszkolását
function ctDefault(){const s=sp(),k=s.id+":"+s.masked;if(k!==ctKey){ctKey=k;$("ctBg").value=s.masked?TR:0;}}

/* ---- sprite-lista ---- */
function uniqueName(n){let b=safeName(n),k=b,i=2;while(P.sprites.some(s=>safeName(s.name)===k))k=b+"_"+i++;return k;}
$("bNew").onclick=()=>{const s=sp();P.sprites.splice(P.cur+1,0,newSprite(uniqueName("sprite"),s.W,s.H,s.masked));P.cur++;uiRefresh();};
$("bDup").onclick=()=>{const s=sp();P.sprites.splice(P.cur+1,0,newSprite(uniqueName(s.name+"_m"),s.W,s.H,s.masked,s.frames.map(f=>f.slice())));P.cur++;uiRefresh();};
$("bDel").onclick=()=>{if(P.sprites.length<2)return;const s=sp(),n=P.scene.items.filter(it=>it.sid===s.id).length;
  if(!confirm(`Törlöd a(z) "${safeName(s.name)}" sprite-ot?`+(n?`\nA képernyőről is eltűnik (${n} db).`:"")))return;
  P.scene.items=P.scene.items.filter(it=>it.sid!==s.id);P.scene.sel=-1;P.scene.place=-1;
  P.sprites.splice(P.cur,1);P.cur=Math.min(P.cur,P.sprites.length-1);uiRefresh();};
function moveSprite(d){const j=P.cur+d;if(j<0||j>=P.sprites.length)return;[P.sprites[P.cur],P.sprites[j]]=[P.sprites[j],P.sprites[P.cur]];P.cur=j;uiRefresh();}
$("bUp").onclick=()=>moveSprite(-1);$("bDown").onclick=()=>moveSprite(1);

/* ---- fájlok ---- */
$("bSave").onclick=()=>{commitFloat();uiRefresh();download(safeName(sp().name)+".bin",new Blob([buildBin(sp())],{type:"application/octet-stream"}));};
$("bLoad").onclick=()=>$("fBin").click();
$("fBin").onchange=async e=>{
  const files=[...e.target.files];e.target.value="";const errs=[];
  for(const f of files){try{const r=parseBin(new Uint8Array(await f.arrayBuffer()));
      P.sprites.push(newSprite(uniqueName(f.name.replace(/\.bin$/i,"")),r.W,r.H,r.masked,r.frames));P.cur=P.sprites.length-1;}
    catch(err){errs.push(f.name+": "+err);}}
  uiRefresh();if(errs.length)alert("Betöltési hiba:\n"+errs.join("\n"));
};
$("bImport").onclick=()=>$("fImg").click();
$("fImg").onchange=e=>{
  const f=e.target.files[0];e.target.value="";if(!f)return;const img=new Image();
  img.onload=()=>{const s=sp();let w=s.W,h=s.H;
    if($("impSize").checked){w=Math.min(128,img.width);if(w%2)w++;h=Math.min(240,img.height);}
    const t=document.createElement("canvas");t.width=w;t.height=h;const tc=t.getContext("2d");
    tc.imageSmoothingEnabled=false;tc.drawImage(img,0,0,w,h);
    const a=tc.getImageData(0,0,w,h).data,n=new Int8Array(w*h);
    for(let i=0;i<w*h;i++){if(a[i*4+3]<128){n[i]=s.masked?TR:0;continue;}
      let best=0,bd=1e9;for(let c=0;c<16;c++){if(c===8)continue;const q=PAL[c],dd=(q[0]-a[i*4])**2+(q[1]-a[i*4+1])**2+(q[2]-a[i*4+2])**2;if(dd<bd){bd=dd;best=c;}}
      n[i]=best;}
    pushUndo();
    if(w!==s.W||h!==s.H){s.frames=s.frames.map(()=>new Int8Array(w*h).fill(s.masked?TR:0));s.W=w;s.H=h;}
    s.frames[s.cf]=n;uiRefresh();URL.revokeObjectURL(img.src);};
  img.onerror=()=>alert("A képet nem sikerült betölteni.");
  img.src=URL.createObjectURL(f);
};
$("bPng").onclick=()=>{commitFloat();uiRefresh();const s=sp(),p=px(),t=document.createElement("canvas");t.width=s.W;t.height=s.H;const tc=t.getContext("2d");
  const img=tc.createImageData(s.W,s.H),a=img.data;
  for(let i=0;i<s.W*s.H;i++){const c=p[i];if(c<0)continue;const q=PAL[c];a[i*4]=q[0];a[i*4+1]=q[1];a[i*4+2]=q[2];a[i*4+3]=255;}
  tc.putImageData(img,0,0);t.toBlob(b=>download(safeName(s.name)+".png",b),"image/png");};

/* ================= KÉPERNYŐ (JELENET) ================= */
const SW=128,SH=240;             // TVC GRAPHICS16: 128x240 pixel, 64 byte/sor
const BX=32,BY=24;               // border szélessége (vászon-egységben: 1 TVC pixel = 2 egység széles, 1 magas)
const sc=$("sc"),sctx=sc.getContext("2d");
const scBuf=document.createElement("canvas");scBuf.width=SW;scBuf.height=SH;const sbctx=scBuf.getContext("2d");
let sdrag=null,hover=null;

function clampItem(it){const s=byId(it.sid);if(!s)return;
  it.x=Math.max(0,Math.min(SW/2-s.W/2,it.x|0));it.y=Math.max(0,Math.min(SH-s.H,it.y|0));}
function clampItems(){P.scene.items.forEach(clampItem);}
function sceneRender(){
  const S=P.scene,z=S.zoom,img=sbctx.createImageData(SW,SH),a=img.data,buf=new Int8Array(SW*SH).fill(S.bg);
  for(const it of S.items){const s=byId(it.sid);if(!s)continue;const f=s.frames[0],x0=it.x*2;
    for(let y=0;y<s.H;y++){const yy=it.y+y;if(yy<0||yy>=SH)continue;
      for(let x=0;x<s.W;x++){const xx=x0+x;if(xx<0||xx>=SW)continue;let c=f[y*s.W+x];
        if(c<0){if(s.masked)continue;c=0;}buf[yy*SW+xx]=c;}}}
  for(let i=0;i<SW*SH;i++){const q=PAL[buf[i]];a[i*4]=q[0];a[i*4+1]=q[1];a[i*4+2]=q[2];a[i*4+3]=255;}
  sbctx.putImageData(img,0,0);
  const cw=(SW*2+BX*2)*z,ch=(SH+BY*2)*z;
  if(sc.width!==cw||sc.height!==ch){sc.width=cw;sc.height=ch;}
  sctx.fillStyle=css(S.border);sctx.fillRect(0,0,cw,ch);
  sctx.imageSmoothingEnabled=false;sctx.drawImage(scBuf,BX*z,BY*z,SW*2*z,SH*z);
  if(S.grid){sctx.lineWidth=1;sctx.strokeStyle="rgba(255,255,255,.18)";
    for(let b=8;b<64;b+=8){const x=(BX+b*4)*z+.5;sctx.beginPath();sctx.moveTo(x,BY*z);sctx.lineTo(x,(BY+SH)*z);sctx.stroke();}
    for(let r=16;r<SH;r+=16){const y=(BY+r)*z+.5;sctx.beginPath();sctx.moveTo(BX*z,y);sctx.lineTo((BX+SW*2)*z,y);sctx.stroke();}}
  // lerakás előnézete
  if(S.place>=0&&hover){const s=P.sprites[S.place];if(s){const g=placePos(s,hover);
    sctx.globalAlpha=.6;sctx.drawImage(thumbExact(s,S.bg),(BX+g.x*4)*z,(BY+g.y)*z,s.W*2*z,s.H*z);sctx.globalAlpha=1;
    outline(g.x,g.y,s,"#e0b040",[4,3]);}}
  if(S.sel>=0&&S.items[S.sel]){const it=S.items[S.sel],s=byId(it.sid);if(s)outline(it.x,it.y,s,"#4aa3ff",[5,3]);}
}
function thumbExact(s,bg){const t=document.createElement("canvas");t.width=s.W;t.height=s.H;const x=t.getContext("2d"),img=x.createImageData(s.W,s.H),a=img.data,f=s.frames[0];
  for(let i=0;i<s.W*s.H;i++){let c=f[i];if(c<0){if(s.masked)continue;c=0;}const q=PAL[c];a[i*4]=q[0];a[i*4+1]=q[1];a[i*4+2]=q[2];a[i*4+3]=255;}
  x.putImageData(img,0,0);return t;}
function outline(bx,y,s,col,dash){const z=P.scene.zoom;sctx.save();sctx.setLineDash(dash);sctx.lineWidth=2;sctx.strokeStyle=col;
  sctx.strokeRect((BX+bx*4)*z-1,(BY+y)*z-1,s.W*2*z+2,s.H*z+2);sctx.restore();}
function scPos(e){const r=sc.getBoundingClientRect(),z=P.scene.zoom;
  const ux=(e.clientX-r.left)/z-BX,uy=(e.clientY-r.top)/z-BY;
  return {bx:Math.floor(ux/4),px:Math.floor(ux/2),y:Math.floor(uy),inside:ux>=0&&uy>=0&&ux<SW*2&&uy<SH};}
function placePos(s,p){const it={sid:s.id,x:p.bx,y:p.y};clampItem(it);return it;}
function hitItem(p){const S=P.scene;for(let i=S.items.length-1;i>=0;i--){const it=S.items[i],s=byId(it.sid);if(!s)continue;
  if(p.px>=it.x*2&&p.px<it.x*2+s.W&&p.y>=it.y&&p.y<it.y+s.H)return i;}return -1;}

function sceneRefresh(){
  const S=P.scene;
  $("scBorder").value=S.border;$("scBg").value=S.bg;$("scZoom").value=S.zoom;$("scGrid").checked=S.grid;
  // lerakható sprite-ok
  const l=$("scList");l.innerHTML="";
  P.sprites.forEach((s,i)=>{const d=spriteRow(s,i===S.place?"place":"");
    d.onclick=()=>{S.place=S.place===i?-1:i;S.sel=-1;sceneRefresh();};l.appendChild(d);});
  // lerakottak
  const il=$("itList");il.innerHTML="";
  S.items.forEach((it,i)=>{const s=byId(it.sid);if(!s)return;
    const d=spriteRow(s,i===S.sel?"on":"",`<div class="co">#${i+1}  X=${it.x} (px ${it.x*2})  Y=${it.y}</div>`);
    d.onclick=()=>{S.sel=i;S.place=-1;sceneRefresh();};il.appendChild(d);});
  if(!S.items.length)il.innerHTML='<div class="muted" style="padding:6px">Még nincs lerakott sprite.</div>';
  const has=S.sel>=0&&S.items[S.sel];
  for(const id of ["iUp","iDown","iDup","iDel","iX","iY"])$(id).disabled=!has;
  if(has){const it=S.items[S.sel];if(document.activeElement!==$("iX"))$("iX").value=it.x;if(document.activeElement!==$("iY"))$("iY").value=it.y;}
  else{$("iX").value="";$("iY").value="";}
  // koordináta-lista
  const lines=[];
  S.items.forEach((it,i)=>{const s=byId(it.sid);if(!s)return;const C=capName(s.name);
    lines.push(`${C}.X:=${it.x}; ${C}.Y:=${it.y}; ${C}.SetPosition(); ${C}.${s.masked?"Draw":"Put"}();  // #${i+1} px ${it.x*2},${it.y}`);});
  $("coords").textContent=lines.length?`// képernyő: border ${S.border} (${NAMES[S.border]}), háttér ${S.bg} (${NAMES[S.bg]})\n`+lines.join("\n"):"";
  sceneRender();
  save();
}
sc.addEventListener("contextmenu",e=>{e.preventDefault();P.scene.place=-1;P.scene.sel=-1;sceneRefresh();});
sc.addEventListener("pointerdown",e=>{
  if(e.button!==0)return;e.preventDefault();const S=P.scene,p=scPos(e);
  if(S.place>=0){if(!p.inside)return;const s=P.sprites[S.place];S.items.push(placePos(s,p));S.sel=S.items.length-1;sceneRefresh();return;}
  const i=hitItem(p);S.sel=i;
  if(i>=0){const it=S.items[i];sdrag={i,ox:p.bx-it.x,oy:p.y-it.y};sc.setPointerCapture(e.pointerId);}
  sceneRefresh();
});
sc.addEventListener("pointermove",e=>{
  const S=P.scene,p=scPos(e);hover=p.inside?p:null;
  $("status").textContent=p.inside?`X: byte ${p.bx} (pixel ${p.px})   Y: ${p.y}`+(S.place>=0?`   lerakás: ${safeName(P.sprites[S.place].name)}`:""):" ";
  if(sdrag){const it=S.items[sdrag.i],nx=p.bx-sdrag.ox,ny=p.y-sdrag.oy;
    if(nx!==it.x||ny!==it.y){it.x=nx;it.y=ny;clampItem(it);sceneRefresh();}return;}
  if(S.place>=0)sceneRender();
});
sc.addEventListener("pointerup",()=>{sdrag=null;});
sc.addEventListener("pointerleave",()=>{hover=null;if(P.scene.place>=0)sceneRender();});
$("scBorder").onchange=()=>{P.scene.border=+$("scBorder").value;sceneRefresh();};
$("scBg").onchange=()=>{P.scene.bg=+$("scBg").value;sceneRefresh();};
$("scZoom").onchange=()=>{P.scene.zoom=+$("scZoom").value;sceneRefresh();};
$("scGrid").onchange=()=>{P.scene.grid=$("scGrid").checked;sceneRefresh();};
function moveItemZ(d){const S=P.scene,j=S.sel+d;if(S.sel<0||j<0||j>=S.items.length)return;[S.items[S.sel],S.items[j]]=[S.items[j],S.items[S.sel]];S.sel=j;sceneRefresh();}
$("iUp").onclick=()=>moveItemZ(1);$("iDown").onclick=()=>moveItemZ(-1);
$("iDup").onclick=()=>{const S=P.scene,it=S.items[S.sel];if(!it)return;const n={sid:it.sid,x:it.x+2,y:it.y+8};clampItem(n);S.items.push(n);S.sel=S.items.length-1;sceneRefresh();};
function delItem(){const S=P.scene;if(S.sel<0)return;S.items.splice(S.sel,1);S.sel=-1;sceneRefresh();}
$("iDel").onclick=delItem;
$("iX").onchange=$("iY").onchange=()=>{const S=P.scene,it=S.items[S.sel];if(!it)return;it.x=+$("iX").value;it.y=+$("iY").value;clampItem(it);sceneRefresh();};
$("bCopy").onclick=()=>{const t=$("coords").textContent;if(navigator.clipboard)navigator.clipboard.writeText(t).catch(()=>{});};

/* ================= Fülek ================= */
function setView(v){commitFloat();view=v;
  document.querySelectorAll("#tabs .tab").forEach(b=>b.classList.toggle("on",b.dataset.view===v));
  $("view-edit").classList.toggle("on",v==="edit");$("view-scene").classList.toggle("on",v==="scene");
  $("status").innerHTML="&nbsp;";
  if(v==="scene"){clampItems();sceneRefresh();}else uiRefresh();save();}
document.querySelectorAll("#tabs .tab").forEach(b=>b.onclick=()=>setView(b.dataset.view));

/* ================= Billentyűk ================= */
document.addEventListener("keydown",e=>{
  const tg=e.target;if(tg.tagName==="INPUT"&&tg.type!=="checkbox"&&tg.type!=="radio")return;if(tg.tagName==="SELECT")return;
  const k=e.key.toLowerCase();
  if(view==="scene"){const S=P.scene;
    if(k==="escape"){S.place=-1;S.sel=-1;sceneRefresh();return;}
    if((k==="delete"||k==="backspace")&&S.sel>=0){e.preventDefault();delItem();return;}
    const it=S.items[S.sel];if(!it)return;
    const st=e.shiftKey;const mv={arrowleft:[-(st?4:1),0],arrowright:[st?4:1,0],arrowup:[0,-(st?8:1)],arrowdown:[0,st?8:1]}[k];
    if(mv){e.preventDefault();it.x+=mv[0];it.y+=mv[1];clampItem(it);sceneRefresh();}
    return;}
  if(e.ctrlKey&&k==="z"){e.preventDefault();doUndo();return;}
  if(e.ctrlKey&&(k==="y"||(e.shiftKey&&k==="z"))){e.preventDefault();doRedo();return;}
  if(e.ctrlKey){const f={c:copySel,x:cutSel,v:pasteSel,a:allSel}[k];if(f){e.preventDefault();f();}return;}
  if(k==="delete"||k==="backspace"){if(flt||sel){e.preventDefault();delSel();}return;}
  if(k==="enter"){if(flt){commitFloat();uiRefresh();}return;}
  if(k==="escape"){if(flt)cancelFloat();else{sel=null;draw();}return;}
  if((flt||sel)&&k.startsWith("arrow")){e.preventDefault();const st=e.shiftKey?8:1;
    nudge(k==="arrowleft"?-st:k==="arrowright"?st:0,k==="arrowup"?-st:k==="arrowdown"?st:0);return;}
  const map={p:"pen",f:"fill",l:"line",r:"rect",c:"circle",i:"pick",s:"spray",m:"select"};
  if(map[k]){setTool(map[k]);}
  else if(k==="g"){$("grid").checked=!$("grid").checked;draw();}
  else if(k==="x"){[colL,colR]=[colR,colL];uiRefresh();}
  else if(k==="+"||k==="="){const s=$("zoom");s.selectedIndex=Math.min(s.options.length-1,s.selectedIndex+1);s.onchange();}
  else if(k==="-"){const s=$("zoom");s.selectedIndex=Math.max(0,s.selectedIndex-1);s.onchange();}
});

/* ================= Mentés: projekt fájl + böngésző ================= */
function serialize(){
  const idx=new Map(P.sprites.map((s,i)=>[s.id,i]));
  return {format:"sprite16-projekt",version:2,cur:P.cur,
    sprites:P.sprites.map(s=>({name:s.name,W:s.W,H:s.H,masked:s.masked,frames:s.frames.map(encStr)})),
    scene:{border:P.scene.border,bg:P.scene.bg,zoom:P.scene.zoom,grid:P.scene.grid,
      items:P.scene.items.filter(it=>idx.has(it.sid)).map(it=>({s:idx.get(it.sid),x:it.x,y:it.y}))},
    ui:{colL,colR,zoom,tool,view}};
}
function deserialize(o){
  if(!o||!Array.isArray(o.sprites)||!o.sprites.length)throw "Nem sprite16 projekt.";
  const sprites=o.sprites.map(s=>{if(!s.W||!s.H||!s.frames||!s.frames.length)throw "Hibás sprite: "+s.name;
    const fr=s.frames.map(decStr);if(fr.some(f=>f.length!==s.W*s.H))throw "Hibás méret: "+s.name;return newSprite(s.name,s.W,s.H,!!s.masked,fr);});
  P.sprites=sprites;P.cur=Math.min(Math.max(0,o.cur|0),sprites.length-1);
  const sn=o.scene||{};
  P.scene={border:sn.border??7,bg:sn.bg??0,zoom:sn.zoom||2,grid:!!sn.grid,sel:-1,place:-1,
    items:(sn.items||[]).filter(it=>sprites[it.s]).map(it=>({sid:sprites[it.s].id,x:it.x|0,y:it.y|0}))};
  if(o.ui){colL=o.ui.colL??15;colR=o.ui.colR??TR;zoom=o.ui.zoom||16;tool=o.ui.tool||"pen";view=o.ui.view==="scene"?"scene":"edit";}
}
const KEY="waterpump_sprite16_v2",KEY1="waterpump_sprite16_v1";
let saveT=0;
function save(){clearTimeout(saveT);saveT=setTimeout(()=>{try{localStorage.setItem(KEY,JSON.stringify(serialize()));}catch(e){}},300);}
function load(){
  let ok=false;
  try{const s=JSON.parse(localStorage.getItem(KEY)||"null");if(s){deserialize(s);ok=true;}}catch(e){}
  if(!ok){try{const s=JSON.parse(localStorage.getItem(KEY1)||"null"); // régi, 1 sprite-os mentés átvétele
    if(s&&s.W&&s.H&&s.pix&&s.pix.length===s.W*s.H){P.sprites=[newSprite(s.name||"sprite16",s.W,s.H,!!s.masked,[Int8Array.from(s.pix)])];colL=s.colL??15;colR=s.colR??TR;zoom=s.zoom||16;ok=true;}}catch(e){}}
  if(!ok)P.sprites=[newSprite("sprite16",16,16,true)];
  $("zoom").value=zoom;if(!$("zoom").value){zoom=16;$("zoom").value=16;}
}
$("bProjSave").onclick=()=>download("sprite16_projekt.json",new Blob([JSON.stringify(serialize())],{type:"application/json"}));
$("bProjLoad").onclick=()=>$("fProj").click();
$("fProj").onchange=async e=>{const f=e.target.files[0];e.target.value="";if(!f)return;
  try{deserialize(JSON.parse(await f.text()));$("zoom").value=zoom;setView(view);}catch(err){alert("Megnyitási hiba: "+err);}};

load();setView(view);

/* teszthez */
window.__s16={encPix,decPix,buildBin,parseBin,P,serialize,deserialize,setView,newSprite,uiRefresh,sceneRefresh,cartoon,sprayAt,px,api:()=>({get sel(){return sel},set sel(v){sel=v},get flt(){return flt},get clip(){return clip},copySel,cutSel,pasteSel,delSel,allSel,commitFloat,cancelFloat,selToNew,nudge,setTool})};
</script>
</body>
</html>
