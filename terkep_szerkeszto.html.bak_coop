<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>WaterPump pályaszerkesztő</title>
<style>
  :root { --bg:#14181c; --panel:#1d2329; --line:#2c353d; --ink:#d8e0e6; --dim:#8b98a3; --ok:#6ed26e; --blk:#0b0d0f; --acc:#3255c3; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font:14px/1.4 system-ui, "Segoe UI", sans-serif; }
  main { max-width: 1240px; margin: 0 auto; padding: 16px; }
  h1 { font-size: 18px; margin: 0 0 4px; }
  .sub { color: var(--dim); margin: 0 0 12px; }
  .wrap { display:flex; gap:18px; flex-wrap:wrap; align-items:flex-start; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:12px; }
  #boardbox { overflow:auto; max-width:100%; }
  #board { display:grid; grid-template-columns: 22px repeat(30, 22px); grid-auto-rows: 22px; gap:1px; user-select:none; touch-action:none; }
  .cell { display:flex; align-items:center; justify-content:center; font:700 13px ui-monospace, Consolas, monospace; cursor:crosshair; background:#26402a; color:#a9d9a9; border-radius:2px; }
  .cell.b { background:var(--blk); color:#e0a040; box-shadow: inset 0 0 0 1px #4a3a1a; }
  .rule { display:flex; align-items:center; justify-content:center; font:11px ui-monospace, Consolas, monospace; color:var(--dim); }
  .rule.c5 { color:var(--ink); }
  .side { flex:1 1 400px; min-width:330px; display:flex; flex-direction:column; gap:12px; }
  .row { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
  button { background:#2a333b; color:var(--ink); border:1px solid #3a4651; border-radius:6px; padding:6px 10px; font:inherit; cursor:pointer; }
  button:hover { background:#34404a; }
  button.on { background:var(--acc); border-color:#5b7ee0; color:#fff; }
  button.pri { background:#2f5d31; border-color:#4a8a4d; }
  button.tab { min-width:38px; padding:6px 8px; }
  label { color:var(--dim); font-size:12px; }
  input[type=text], input[type=number], select { background:#10151a; color:var(--ink); border:1px solid #3a4651; border-radius:6px; padding:5px 8px; font:inherit; }
  input[type=number] { width:78px; }
  textarea { width:100%; background:#10151a; color:var(--ink); border:1px solid #3a4651; border-radius:6px; padding:8px; font:12px/1.35 ui-monospace, Consolas, monospace; resize:vertical; white-space:pre; overflow:auto; }
  .stat { color:var(--dim); font-size:12px; }
  .msg { min-height:18px; font-size:12px; color:var(--ok); }
  .msg.err { color:#ff8a8a; }
  h2 { font-size:13px; margin:0 0 6px; color:var(--dim); font-weight:600; letter-spacing:.02em; text-transform:uppercase; }
  .grid2 { display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:8px 14px; }
  .grid2 label { display:flex; flex-direction:column; gap:3px; }
  .chk { display:flex; flex-direction:row !important; align-items:center; gap:6px !important; color:var(--ink); font-size:13px; }
</style>
</head>
<body>
<main>
  <h1>WaterPump pályaszerkesztő</h1>
  <p class="sub">Legfeljebb 10 pálya. Minden pályának saját térképe, célja, árai és tiltásai vannak. Bal gomb = a kiválasztott eszköz, jobb gomb = a másik, húzással festhetsz. Minden módosítás automatikusan mentődik a böngészőbe.</p>

  <div class="panel" style="margin-bottom:12px">
    <div class="row" id="tabs"></div>
  </div>

  <div class="wrap">
    <div class="panel" id="boardbox"><div id="board"></div></div>

    <div class="side">
      <div class="panel">
        <h2>Térkép eszközök</h2>
        <div class="row">
          <button id="toolFree" class="on" title="Gyorsbillentyű: .">.&nbsp; normál talaj</button>
          <button id="toolBlock" title="Gyorsbillentyű: x">x&nbsp; blokkolt</button>
          <span class="stat" id="stat"></span>
        </div>
        <div class="row" style="margin-top:8px">
          <button id="bClear">Mind .</button>
          <button id="bAll">Mind x</button>
          <button id="bBorder">Szegély x</button>
          <button id="bInvert">Invertálás</button>
          <button id="bMirror">Tükrözés ↔</button>
          <button id="bUndo" title="Ctrl+Z">Vissza</button>
        </div>
      </div>

      <div class="panel">
        <h2>A pálya adatai</h2>
        <div class="grid2">
          <label>Név <input type="text" id="pName"></label>
          <label>Cél: pumpák száma (legfeljebb 255) <input type="number" id="pCel" min="1" max="255"></label>
          <label>Pumpa ára <input type="number" id="pPumpaAr" min="0" max="32000"></label>
          <label>Fal ára <input type="number" id="pFalAr" min="0" max="32000"></label>
          <label>Bomba ára <input type="number" id="pBombaAr" min="0" max="32000"></label>
          <label>Kezdő pénz <input type="number" id="pPenz" min="0" max="9999"></label>
          <label>Pumpa termelése (ütemenként) <input type="number" id="pTermel" min="0" max="1000"></label>
          <span></span>
          <label class="chk"><input type="checkbox" id="pMeteor"> Meteor lesz</label>
          <label class="chk"><input type="checkbox" id="pVirus"> Vírus lesz</label>
          <label class="chk"><input type="checkbox" id="pFal"> Falat lehet építeni</label>
          <label class="chk"><input type="checkbox" id="pBomba"> Bombát lehet használni</label>
        </div>
      </div>

      <div class="panel">
        <h2>Mentés / betöltés (az összes pálya)</h2>
        <div class="row">
          <button id="bDownload">Projekt letöltése (.json)</button>
          <button id="bOpen">Projekt megnyitása…</button>
          <input type="file" id="file" accept=".json,application/json" hidden>
        </div>
        <div class="msg" id="msg"></div>
      </div>

      <div class="panel">
        <h2>Az aktuális térkép szövegesen ( . és x ) — szerkeszthető, beilleszthető</h2>
        <textarea id="ascii" rows="19" spellcheck="false"></textarea>
        <div class="row" style="margin-top:8px"><button id="bCopyAscii">Másolás vágólapra</button></div>
      </div>

      <div class="panel">
        <h2>.ras adat — az ÖSSZES pálya (a var blokkba illeszthető)</h2>
        <div class="row">
          <label>normál érték <input type="number" id="vFree" value="10" min="0" max="255"></label>
          <label>blokkolt érték <input type="number" id="vBlock" value="13" min="0" max="255"></label>
          <label class="chk"><input type="checkbox" id="cAscii"> ASCII rajz kommentként</label>
        </div>
        <textarea id="ras" rows="14" spellcheck="false" readonly></textarea>
        <div class="row" style="margin-top:8px"><button id="bCopyRas" class="pri">Másolás vágólapra (.ras)</button></div>
        <p class="stat" style="margin:8px 0 0">Ez váltja le a korábbi <code>Terkepek</code> / <code>Palya_*</code> tömböket és a <code>PALYA_DB</code> értékét. Index: <b>palya*540 + x-1 + (y-1)*30</b>. Normál = <code>Talaj1Map</code> (10), blokkolt = <code>Talaj3Map</code> (13).</p>
      </div>
    </div>
  </div>
</main>

<script>
(function () {
  var W = 30, H = 18, N = W * H, MAXP = 10;
  var KEY = 'waterpump_projekt_v2';
  var $ = function (id) { return document.getElementById(id); };
  var board = $('board'), cellEls = [];
  var tool = 0, cur = 0, undoStack = [], msgTimer = null, saveTimer = null;

  // az induló 1. pálya: a jelenlegi Terkep1 a játékból
  var DEFAULT_MAP = [
"xxxxxx..................xxxxxx",
"xxxxx...................xxxxxx",
"xxxxx....................xxxxx",
"xxxx.......................xxx",
"xxx...........................",
"..............................",
"..............................",
"..............................",
"..............................",
"..............................",
"..............................",
"..............................",
"..............................",
"............xxxx..............",
"...........xxxxxxxx...........",
"..........xxxxxxxxxx..........",
".........xxxxxxxxxxxx.........",
".........xxxxxxxxxxxx........."].join('');

  function newLevel(name, ascii) {
    var cells = new Array(N).fill(0);
    if (ascii) for (var i = 0; i < N; i++) cells[i] = ascii.charAt(i) === 'x' ? 1 : 0;
    return { name: name, cells: cells, cel: 250, pumpaAr: 100, falAr: 50, bombaAr: 10, penz: 1000, termel: 2, meteor: 1, virus: 1, fal: 1, bomba: 1 };
  }
  var levels = [newLevel('Pálya 1', DEFAULT_MAP)];
  function L() { return levels[cur]; }

  function msg(t, err) {
    var m = $('msg'); m.textContent = t; m.className = 'msg' + (err ? ' err' : '');
    clearTimeout(msgTimer); msgTimer = setTimeout(function () { m.textContent = ''; }, 4500);
  }

  // ---------- rács ----------
  function build() {
    var frag = document.createDocumentFragment();
    var corner = document.createElement('div'); corner.className = 'rule'; frag.appendChild(corner);
    for (var x = 1; x <= W; x++) { var r = document.createElement('div'); r.className = 'rule' + (x % 5 === 0 ? ' c5' : ''); r.textContent = x; frag.appendChild(r); }
    for (var y = 0; y < H; y++) {
      var l = document.createElement('div'); l.className = 'rule' + ((y + 1) % 5 === 0 ? ' c5' : ''); l.textContent = y + 1; frag.appendChild(l);
      for (var xx = 0; xx < W; xx++) { var c = document.createElement('div'); c.className = 'cell'; c.dataset.i = y * W + xx; frag.appendChild(c); cellEls.push(c); }
    }
    board.appendChild(frag);
  }
  function paintCell(i) { var el = cellEls[i], b = L().cells[i] === 1; el.className = 'cell' + (b ? ' b' : ''); el.textContent = b ? 'x' : '.'; }
  function paintAll() { for (var i = 0; i < N; i++) paintCell(i); }

  function asciiOf(cells) { var out = []; for (var y = 0; y < H; y++) { var s = ''; for (var x = 0; x < W; x++) s += cells[y * W + x] ? 'x' : '.'; out.push(s); } return out.join('\n'); }
  function parseAscii(text) {
    var chars = text.split('').filter(function (c) { return c === '.' || c === 'x' || c === 'X'; });
    return chars.length === N ? chars.map(function (c) { return c === '.' ? 0 : 1; }) : null;
  }

  // ---------- .ras kimenet (minden pálya) ----------
  function rasText() {
    var vf = parseInt($('vFree').value, 10) || 0, vb = parseInt($('vBlock').value, 10) || 0, n = levels.length, o = [];
    o.push('\t\tconst PALYA_DB\t\t:\tbyte = ' + n + ';\t/* a pályák száma */');
    o.push('\t\t/* Terkepek: pályánként 30x18 = 540 érték egymás után (index: palya*540 + x-1 + (y-1)*30); ' + vf + ' = Talaj1, ' + vb + ' = Talaj3 (blokkolt) */');
    o.push('\t\tTerkepek\t:\tarray[' + (n * N) + '] of byte = (');
    levels.forEach(function (lv, k) {
      o.push('\t\t\t/* ' + (k + 1) + '. ' + lv.name.replace(/\*\//g, '') + ' */');
      if ($('cAscii').checked) asciiOf(lv.cells).split('\n').forEach(function (r) { o.push('\t\t\t/* ' + r + ' */'); });
      for (var y = 0; y < H; y++) {
        var row = []; for (var x = 0; x < W; x++) row.push(lv.cells[y * W + x] ? vb : vf);
        o.push('\t\t\t' + row.join(',') + ((k === n - 1 && y === H - 1) ? '' : ','));
      }
    });
    o.push('\t\t);');
    function arr(name, key, type, cmt) {
      o.push('\t\t' + name + '\t:\tarray[' + n + '] of ' + type + ' = (' + levels.map(function (lv) { return lv[key] | 0; }).join(',') + ');\t/* ' + cmt + ' */');
    }
    arr('Palya_Cel', 'cel', 'byte', 'cél: ennyi pumpa kell a pálya teljesítéséhez');
    arr('Palya_PumpaAr', 'pumpaAr', 'integer', 'pumpa ára');
    arr('Palya_FalAr', 'falAr', 'integer', 'fal ára');
    arr('Palya_BombaAr', 'bombaAr', 'integer', 'bomba ára');
    arr('Palya_Penz', 'penz', 'integer', 'kezdő pénz');
    arr('Palya_Termel', 'termel', 'integer', 'egy pumpa termelése ütemenként');
    arr('Palya_Meteor', 'meteor', 'byte', '1 = lesz meteor');
    arr('Palya_Virus', 'virus', 'byte', '1 = lesz vírus');
    arr('Palya_Fal', 'fal', 'byte', '1 = építhető fal');
    arr('Palya_Bomba', 'bomba', 'byte', '1 = használható a bomba');
    return o.join('\n');
  }

  // ---------- felület frissítése ----------
  function fillParams() {
    var l = L();
    $('pName').value = l.name; $('pCel').value = l.cel; $('pPumpaAr').value = l.pumpaAr; $('pFalAr').value = l.falAr;
    $('pBombaAr').value = l.bombaAr; $('pPenz').value = l.penz; $('pTermel').value = l.termel;
    $('pMeteor').checked = !!l.meteor; $('pVirus').checked = !!l.virus; $('pFal').checked = !!l.fal; $('pBomba').checked = !!l.bomba;
  }
  function renderTabs() {
    var t = $('tabs'); t.innerHTML = '';
    levels.forEach(function (lv, i) {
      var b = document.createElement('button'); b.className = 'tab' + (i === cur ? ' on' : ''); b.textContent = (i + 1); b.title = lv.name;
      b.onclick = function () { cur = i; undoStack = []; fillParams(); paintAll(); refresh(); renderTabs(); };
      t.appendChild(b);
    });
    function btn(txt, fn, dis) { var b = document.createElement('button'); b.textContent = txt; b.onclick = fn; if (dis) b.disabled = true; t.appendChild(b); }
    btn('+ Új pálya', function () { if (levels.length >= MAXP) return; levels.push(newLevel('Pálya ' + (levels.length + 1))); cur = levels.length - 1; undoStack = []; fillParams(); paintAll(); refresh(); renderTabs(); }, levels.length >= MAXP);
    btn('Másolat', function () { if (levels.length >= MAXP) return; var c = JSON.parse(JSON.stringify(L())); c.name += ' (másolat)'; levels.splice(cur + 1, 0, c); cur++; undoStack = []; fillParams(); paintAll(); refresh(); renderTabs(); }, levels.length >= MAXP);
    btn('Törlés', function () { if (levels.length <= 1) return; if (!confirm('Törlöd a(z) ' + (cur + 1) + '. pályát?')) return; levels.splice(cur, 1); cur = Math.min(cur, levels.length - 1); undoStack = []; fillParams(); paintAll(); refresh(); renderTabs(); }, levels.length <= 1);
    btn('◀ Előre', function () { if (cur > 0) { var x = levels[cur]; levels[cur] = levels[cur - 1]; levels[cur - 1] = x; cur--; renderTabs(); refresh(); } }, cur === 0);
    btn('Hátra ▶', function () { if (cur < levels.length - 1) { var x = levels[cur]; levels[cur] = levels[cur + 1]; levels[cur + 1] = x; cur++; renderTabs(); refresh(); } }, cur === levels.length - 1);
  }
  function refresh() {
    if ($('ascii') !== document.activeElement) $('ascii').value = asciiOf(L().cells);
    $('ras').value = rasText();
    var b = 0; L().cells.forEach(function (v) { b += v; });
    $('stat').textContent = 'blokkolt: ' + b + ' / ' + N;
    scheduleSave();
  }

  // ---------- automatikus mentés / betöltés ----------
  function scheduleSave() { clearTimeout(saveTimer); saveTimer = setTimeout(function () { try { localStorage.setItem(KEY, JSON.stringify({ levels: levels, cur: cur })); } catch (e) {} }, 400); }
  function sanitize(o) {
    if (!o || !o.levels || !o.levels.length) return false;
    var out = [];
    o.levels.slice(0, MAXP).forEach(function (l, i) {
      var d = newLevel(l.name || ('Pálya ' + (i + 1)));
      if (l.cells && l.cells.length === N) d.cells = l.cells.map(function (v) { return v ? 1 : 0; });
      ['cel', 'pumpaAr', 'falAr', 'bombaAr', 'penz', 'termel'].forEach(function (k) { if (typeof l[k] === 'number') d[k] = l[k]; });
      ['meteor', 'virus', 'fal', 'bomba'].forEach(function (k) { if (l[k] !== undefined) d[k] = l[k] ? 1 : 0; });
      out.push(d);
    });
    levels = out; cur = Math.min(o.cur | 0, levels.length - 1); return true;
  }
  try { var saved = JSON.parse(localStorage.getItem(KEY) || 'null'); if (saved) sanitize(saved); } catch (e) {}

  // ---------- festés ----------
  function pushUndo() { undoStack.push(L().cells.slice()); if (undoStack.length > 60) undoStack.shift(); }
  function undo() { if (!undoStack.length) return; L().cells = undoStack.pop(); paintAll(); refresh(); }
  function setCells(a) { pushUndo(); L().cells = a; paintAll(); refresh(); }
  var painting = false, paintVal = 0, lastIdx = -1;
  function cellAt(e) { var el = document.elementFromPoint(e.clientX, e.clientY); return (el && el.classList && el.classList.contains('cell')) ? parseInt(el.dataset.i, 10) : -1; }
  function applyAt(e) { var i = cellAt(e); if (i < 0 || i === lastIdx) return; lastIdx = i; if (L().cells[i] !== paintVal) { L().cells[i] = paintVal; paintCell(i); refresh(); } }
  board.addEventListener('pointerdown', function (e) {
    var i = cellAt(e); if (i < 0) return; e.preventDefault(); pushUndo(); painting = true; lastIdx = -1;
    paintVal = ((e.button === 2) || e.ctrlKey) ? 1 - tool : tool;
    try { board.setPointerCapture(e.pointerId); } catch (x) {}
    applyAt(e);
  });
  board.addEventListener('pointermove', function (e) { if (painting) applyAt(e); });
  window.addEventListener('pointerup', function () { painting = false; });
  board.addEventListener('contextmenu', function (e) { e.preventDefault(); });
  function setTool(t) { tool = t; $('toolFree').className = t === 0 ? 'on' : ''; $('toolBlock').className = t === 1 ? 'on' : ''; }
  $('toolFree').onclick = function () { setTool(0); };
  $('toolBlock').onclick = function () { setTool(1); };
  window.addEventListener('keydown', function (e) {
    var tag = (document.activeElement && document.activeElement.tagName) || '';
    if (tag === 'TEXTAREA' || tag === 'INPUT' || tag === 'SELECT') return;
    if (e.key === '.') setTool(0); else if (e.key === 'x' || e.key === 'X') setTool(1);
    else if ((e.ctrlKey || e.metaKey) && (e.key === 'z' || e.key === 'Z')) { e.preventDefault(); undo(); }
  });
  $('bClear').onclick = function () { setCells(new Array(N).fill(0)); };
  $('bAll').onclick = function () { setCells(new Array(N).fill(1)); };
  $('bBorder').onclick = function () { var a = L().cells.slice(); for (var y = 0; y < H; y++) for (var x = 0; x < W; x++) if (x === 0 || y === 0 || x === W - 1 || y === H - 1) a[y * W + x] = 1; setCells(a); };
  $('bInvert').onclick = function () { setCells(L().cells.map(function (v) { return 1 - v; })); };
  $('bMirror').onclick = function () { var c = L().cells, a = c.slice(); for (var y = 0; y < H; y++) for (var x = 0; x < W; x++) a[y * W + x] = c[y * W + (W - 1 - x)]; setCells(a); };
  $('bUndo').onclick = undo;

  // ---------- szöveges térkép ----------
  $('ascii').addEventListener('input', function () {
    var a = parseAscii($('ascii').value);
    if (!a) { msg('A szöveg nem ' + N + ' mezős (18 sor × 30 karakter, . és x).', true); return; }
    pushUndo(); L().cells = a; paintAll(); $('ras').value = rasText();
    var b = 0; a.forEach(function (v) { b += v; }); $('stat').textContent = 'blokkolt: ' + b + ' / ' + N; scheduleSave();
  });
  $('ascii').addEventListener('blur', refresh);

  // ---------- pálya-adatok ----------
  function num(id, min, max) { var v = parseInt($(id).value, 10); if (isNaN(v)) v = 0; return Math.max(min, Math.min(max, v)); }
  function readParams() {
    var l = L();
    l.name = $('pName').value || ('Pálya ' + (cur + 1));
    l.cel = num('pCel', 1, 255); l.pumpaAr = num('pPumpaAr', 0, 32000); l.falAr = num('pFalAr', 0, 32000); l.bombaAr = num('pBombaAr', 0, 32000);
    l.penz = num('pPenz', 0, 9999); l.termel = num('pTermel', 0, 1000);
    l.meteor = $('pMeteor').checked ? 1 : 0; l.virus = $('pVirus').checked ? 1 : 0; l.fal = $('pFal').checked ? 1 : 0; l.bomba = $('pBomba').checked ? 1 : 0;
    refresh();
  }
  ['pName', 'pCel', 'pPumpaAr', 'pFalAr', 'pBombaAr', 'pPenz', 'pTermel', 'pMeteor', 'pVirus', 'pFal', 'pBomba'].forEach(function (id) {
    $(id).addEventListener('input', readParams); $(id).addEventListener('change', readParams);
  });
  $('pName').addEventListener('input', function () { var b = $('tabs').children[cur]; if (b) b.title = $('pName').value; });
  ['vFree', 'vBlock', 'cAscii'].forEach(function (id) { $(id).addEventListener('input', refresh); $(id).addEventListener('change', refresh); });

  // ---------- vágólap ----------
  function copyText(text, what) {
    function fallback() {
      var ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select();
      var ok = false; try { ok = document.execCommand('copy'); } catch (e) {} document.body.removeChild(ta);
      msg(ok ? what + ' a vágólapon.' : 'A másolás nem sikerült - jelöld ki a szöveget és Ctrl+C.', !ok);
    }
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(function () { msg(what + ' a vágólapon.'); }, fallback); else fallback();
  }
  $('bCopyAscii').onclick = function () { copyText(asciiOf(L().cells), 'A szöveges térkép'); };
  $('bCopyRas').onclick = function () { copyText(rasText(), 'A .ras adat (' + levels.length + ' pálya)'); };

  // ---------- fájl ----------
  $('bDownload').onclick = function () {
    var blob = new Blob([JSON.stringify({ levels: levels, cur: cur }, null, 1)], { type: 'application/json' });
    var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'waterpump_palyak.json'; document.body.appendChild(a); a.click();
    setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 500);
  };
  $('bOpen').onclick = function () { $('file').click(); };
  $('file').addEventListener('change', function () {
    var f = this.files[0]; if (!f) return; var r = new FileReader();
    r.onload = function () {
      try { if (!sanitize(JSON.parse(String(r.result)))) throw 0; undoStack = []; fillParams(); paintAll(); refresh(); renderTabs(); msg('Betöltve: ' + f.name + ' (' + levels.length + ' pálya)'); }
      catch (e) { msg('A fájl nem érvényes pályaprojekt.', true); }
    };
    r.readAsText(f); this.value = '';
  });

  build(); fillParams(); paintAll(); refresh(); renderTabs();
  window.__waterpump = { levels: function () { return levels; }, rasText: rasText, setCur: function (i) { cur = i; fillParams(); paintAll(); refresh(); renderTabs(); } };
})();
</script>
</body>
</html>
