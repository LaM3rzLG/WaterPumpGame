program WaterPumpGame;
@use "TVC"
@use "GE"
@use "random"
 
var
		Pumpa_Data						:	incbin("resources\tvc_sprites\Pumpa.bin");
		Talaj1_Data						:	incbin("resources\tvc_sprites\talaj1.bin");
		Keret_Data						:	incbin("resources\tvc_sprites\keret.bin");
		Pumpa							:	GE::Sprite;
		Talaj1							:	GE::Sprite;
		Keret							:	GE::Sprite;

		CharSet 							: 	incbin("resources\tvc_sprites\CharSetGR4.bin");
		PenzStr 							: 	string = ("PENZ:");	

		KeretXPos						:	byte 		= 15; 
		KeretYPos						:	byte 		= 9;

		Map								:	array		  [18*30] of byte;
		Pumpa_type =	record
					X,Y,On,
					AnimPhase			: 	byte 		= 0;
					end;    
		Pumpak 							:	array		  [18*30+1] of Pumpa_type;
		
		PumpakPtr						:	integer		= 0;
		PumpaKezd						:	integer		= 1;
		PumpaVeg							:	integer		= 20;
		MapDataPos						:	integer;
		MapX,MapY						:	byte;
		
/*		MAP értékadások jelentései
		Pumpa animációs fázisok:	1-8
		Talaj típusok:			10-19
		Vírusos talaj:			20-29								*/	
	
		PumpaCode						:	byte			= 1;
		Talaj1Code						:	byte			= 10;		/* Talaj1 sprite értéke */
		Penz								:	integer;


Procedure ProgramInit();
	begin
		GE::SetGraphics(GE::GRAPHICS4);
		GE::SetPalette(0,GE::PALETTE_Gray);
		GE::SetPalette(1,GE::PALETTE_Black);
		GE::SetPalette(2,GE::PALETTE_Green);
		GE::SetPalette(3,GE::PALETTE_Blue);
		GE::InitCharSet(#CharSet, 118, 2, 7);
		GE::Init(GE::DIRECT_TO_SCREEN);
		GE::SetMemory(GE::MEM_VID_ON);
      	GE::SetRasterInterruptPos(0);
		
		Pumpa.Init(#Pumpa_Data,0,0,False);
		Pumpa.InitAnimation(7,1,GE::LOOP_FORWARD);
		Talaj1.Init(#Talaj1_Data,0,0,False);

		Keret.X:=(KeretXPos*2)-1;
		Keret.Y:=28+(KeretYPos*10);
		Keret.Init(#Keret_Data,Keret.X,Keret.Y,True);

		Pumpa.AnimSet:=	#Pumpa_Data+3;
		Penz:=0;
	end;

Procedure MapInit();
	begin;
	MapDataPos:=0;
		fori MapY:=1 to 18 do
			fori MapX:=1 to 30 do
			begin;
			Map[MapDataPos]:=Talaj1Code;				/* Talaj1 sprite értéke */
			Talaj1.X:=MapX*2;
			Talaj1.Y:=30+MapY*10;
			Talaj1.SetPosition;	
			Talaj1.Put;
			MapDataPos:=MapDataPos+1;
			end;
	end;
	
Procedure OSDInit;
	Begin;
	GE::FillRect(1, 12, 62, 2, 255);
	GE::WriteText(4, 4, #PenzStr);

	GE::IntToStr(Penz);
	GE::WriteText(16, 4, #GE_NumStr);
	
	Keret.SetPosition();		
	Keret.SaveBackground();
	Keret.Draw;
 	Keret.UpdateLastPos;
 	
 	MapX:=KeretXPos;
 	MapY:=KeretYPos;
	end;

Procedure KeretSpriteKirak();
	begin;
		Keret.RestoreBackground();
		Keret.SetPosition();
		Keret.SaveBackground();
		Keret.Draw;
		Keret.UpdateLastPos;
	end;

Procedure PumpaBejegyez();
	begin

		MapDataPos:=KeretXPos-1+(KeretYPos-1)*30;					// MAP-on Kiszámolom, hogy hova kell rakni			
		if Map[MapDataPos]=Talaj1Code then						// Talaj, van még ott ?
			begin;
				Inc(PumpakPtr);									// Ha igen, akkor 
				Pumpak[PumpakPtr].X:=KeretXPos;					// Pumpák adatbázisába
				Pumpak[PumpakPtr].Y:=KeretYPos;					// leraktam az új pumpát
				Pumpak[PumpakPtr].AnimPhase:=0;					// Ennek az animációs fázisa kezdetben 0
				Pumpak[PumpakPtr].On:=1;
				GE::IntToStr(PumpakPtr);
				GE::WriteText(16, 12, #GE_NumStr);		
				Map[MapDataPos]:=PumpaCode;						// Berakjuk ide is a Pumpa kódját	
			end;

	end;
	
Procedure PumpaToScreen();													// 20-anként frissítjük a pumpákat
	var 						i	:	integer;
			AnimCikl,PhaseCalc	:	byte;
	begin;
	GE::SetBorder(GE::BORDER_DARKRED);
	fori i:=PumpaKezd to PumpaVeg do
			begin;
				if  Pumpak[i].On=1 then										//	Pumpa aktív ?
				begin;
					Pumpa.X:=(Pumpak[i].X*2);								// Igen, számoljuk a koordinátát
					Pumpa.Y:=30+(Pumpak[i].Y*10);
					if Pumpak[i].AnimPhase>0 then								// Animáció számolása
						begin
						PhaseCalc:=Pumpa.AnimPhaseNr+	Pumpak[i].AnimPhase;			       
						fori AnimCikl:=0 to PhaseCalc do Pumpa.Animation();
						end;
					Pumpa.Animation();										// Animációra lépés
					Pumpa.SetPosition;								
					Pumpa.Put;												// Pumpa kirakás
					if Pumpak[i].AnimPhase<7 then Inc(Pumpak[i].AnimPhase) else Pumpak[i].AnimPhase:=0;
				end;
			end;

	if PumpaVeg<540 then												
		begin			
			PumpaKezd:=PumpaKezd+20;
			PumpaVeg:=PumpaVeg+20;
		end
		else
		begin
			PumpaKezd:=1;
			PumpaVeg:=20;
		end;
	GE::SetBorder(GE::BORDER_BLACK);
	GE::Delay(3);
	end;

begin
	ProgramInit();
	MapInit();
	OSDInit();
 	
 	while (true) do
	begin
		GE::WaitForSync();
		PumpaToScreen();
		KeretSpriteKirak();
		GE::GetKeyboard();
		GE::GetJoysticks();
		if (GE::Pressed(GE::KEY_SPACE)) then PumpaBejegyez();
		if (GE::Joystick(1, GE::JOY_LEFT) and (KeretXPos > 1)) then	begin;
																	KeretXPos:=KeretXPos-1;
																	Keret.MoveLeftBy2();
																	end;
		if (GE::Joystick(1, GE::JOY_RIGHT) and (KeretXPos < 30)) then	begin;
																	KeretXPos:=KeretXPos+1;
																	Keret.MoveRightBy2();
																	end;
		if (GE::Joystick(1, GE::JOY_UP) and (KeretYPos > 1)) then		begin;
																	KeretYPos:=KeretYPos-1;
																	Keret.MoveUpBy8();
																	Keret.MoveUpBy2();
																	end;
		if (GE::Joystick(1, GE::JOY_DOWN) and (KeretYPos < 18)) then 	begin;
																	KeretYPos:=KeretYPos+1;
																	Keret.MoveDownBy8();
																	Keret.MoveDownBy2();
																	end;


	end;
 	
 	
end.